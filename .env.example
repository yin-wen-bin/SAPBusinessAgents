# SAPBusinessAgents uses the in-process, GET-only Embedded Provider.
SAP_BASE_URL=
SAP_USERNAME=
SAP_PASSWORD=
SAP_CLIENT=
SAP_VERIFY_SSL=true
SAP_AUTH_TYPE=basic
SAP_ODATA_TIMEOUT_MS=60000
SAPBA_SAP_PAGE_SIZE=1000
SAPBA_SAP_MAX_RESULTS=5000

# Optional protected Embedded Provider credential file. Values are loaded but never copied.
# SAPBA_SAP_ENV_FILE=D:\secure\sapbusinessagents-sap.env

# Local SAPSkillhub checkout used to resolve allowlisted Skill entrypoints.
SAPSKILLHUB_ROOT=C:\Users\wenbi\Documents\SAPSkillhub

# Optional Codex Harness runtime, limits, and model override.
SAPBA_CODEX_MODEL=
SAPBA_FREE_QUERY_RUNTIME=harness
SAPBA_MAX_FREE_QUERY_ITERATIONS=12
SAPBA_MAX_WORKFLOW_CONVERSATION_TURNS=12
SAPBA_INTERNAL_API_URL=http://127.0.0.1:8765
SAPBA_MAX_HARNESS_TURNS=12
SAPBA_MAX_TOOL_CALLS=40
# Set SAPBA_MAX_TOOL_CALLS=0 in the local .env to disable only the tool-call count limit.
SAPBA_MAX_RUN_SECONDS=600
# Workload-specific limits. SAPBA_MAX_RUN_SECONDS remains a compatibility fallback.
SAPBA_MAX_DETERMINISTIC_RUN_SECONDS=600
SAPBA_MAX_FREE_QUERY_SECONDS=1800
SAPBA_FREE_QUERY_INITIAL_SECONDS=900
SAPBA_FREE_QUERY_EXTENSION_SECONDS=300
SAPBA_FREE_QUERY_FINALIZATION_SECONDS=300
SAPBA_LOCAL_DETERMINISTIC_WORKERS=1
SAPBA_LOCAL_FREE_QUERY_WORKERS=1
SAPBA_LOCAL_FEEDBACK_WORKERS=1
SAPBA_LOCAL_ROLE_MATCHING_WORKERS=1
SAPBA_MAX_ROLE_MATCHING_TURNS=12
SAPBA_ROLE_MATCHING_MAX_FILES=500
SAPBA_ROLE_MATCHING_MAX_FILE_MB=50
SAPBA_ROLE_MATCHING_MAX_TOTAL_MB=1024
SAPBA_ROLE_MATCHING_MAX_RUNTIME_CHARS=1500000
SAPBA_MAX_CONCURRENT_SAP_GETS=2
SAPBA_SCHEDULER_LEASE_SECONDS=60
