# Default SAP access path: the in-process, GET-only Provider.
SAP_READ_PROVIDER=embedded
SAP_BASE_URL=
SAP_USERNAME=
SAP_PASSWORD=
SAP_CLIENT=
SAP_VERIFY_SSL=true
SAP_AUTH_TYPE=basic
SAP_ODATA_TIMEOUT_MS=60000
SAPBA_SAP_PAGE_SIZE=1000
SAPBA_SAP_MAX_RESULTS=5000

# Optional transitional credential source. Values are loaded but never copied.
# SAPBA_SAP_ENV_FILE=D:\SAPClaw\env\.env

# Deprecated optional SAPClaw Provider. Used only when SAP_READ_PROVIDER=sapclaw.
SAPCLAW_RUNTIME_URL=http://127.0.0.1:8000
SAPCLAW_API_KEY=

# Local SAPSkillhub checkout used to resolve allowlisted Skill entrypoints.
SAPSKILLHUB_ROOT=C:\Users\wenbi\Documents\SAPSkillhub

# Optional prototype limits and Codex model override.
SAPBA_CODEX_MODEL=
SAPBA_MAX_TOOL_CALLS=20
SAPBA_MAX_RUN_SECONDS=300
