{
  "schema_version": "1.0",
  "skills": [
    {
      "skill_id": "sap-adt-table-export",
      "description": {
        "zh": "通过受保护连接配置和 ADT Data Preview 导出有界、只读的表或 CDS 证据。",
        "en": "Exports bounded read-only table or CDS evidence through a protected ADT Data Preview profile."
      },
      "entrypoint": "skills/Common/sap-adt-table-export/run.py",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "connection_profile", "source_type", "object", "fields", "filters", "max_rows"],
        "properties": {
          "schema_version": {"type": "integer", "const": 1},
          "connection_profile": {"type": "string"},
          "source_type": {"type": "string", "enum": ["table", "cds"]},
          "object": {"type": "string"},
          "fields": {"type": "array"},
          "filters": {"type": "array"},
          "order_by": {"type": "array"},
          "max_rows": {"type": "integer"}
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "skill_id", "run_id", "status", "read_only", "validated", "source", "scope", "rows", "row_count", "completeness", "validation_issues", "started_at", "completed_at", "artifacts"],
        "properties": {
          "schema_version": {"type": "integer", "const": 1},
          "skill_id": {"type": "string", "const": "sap-adt-table-export"},
          "run_id": {"type": "string"},
          "status": {"type": "string", "enum": ["complete", "partial", "failed"]},
          "read_only": {"type": "boolean", "const": true},
          "validated": {"type": "boolean"},
          "source": {"type": "object"},
          "scope": {"type": "object"},
          "rows": {"type": "array"},
          "row_count": {"type": "integer"},
          "completeness": {"type": "object"},
          "validation_issues": {"type": "array"},
          "started_at": {"type": "string"},
          "completed_at": {"type": "string"},
          "artifacts": {"type": "array"}
        }
      },
      "read_only": true,
      "validated": true,
      "timeout": 300
    }
  ]
}
