{
  "name": "sap-business-agents-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "catalog": "node scripts/generate-agent-catalog.mjs",
    "validate": "node scripts/validate-agent-catalog.mjs",
    "dev": "npm run catalog && astro dev",
    "check": "npm run catalog && astro check",
    "build": "npm run validate && npm run catalog && astro build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/react": "6.0.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@lucide/astro": "^1.21.0",
    "@xyflow/react": "^12.8.5",
    "astro": "6.4.8",
    "fuse.js": "^7.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "typescript": "5.9.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7"
  },
  "overrides": {
    "vite": "^7.3.6"
  }
}
