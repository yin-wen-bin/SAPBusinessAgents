---
import { Bot, FolderGit2, Languages, MessageSquareText, Network, Plug, Settings } from "@lucide/astro";
import { repositoryUrl } from "../lib/siteConfig";
import { agentManagementPath, askPath, homePath, pluginsPath, settingsPath, workflowsPath } from "../lib/urls";
import type { Locale } from "../lib/types";

interface Props {
  locale: Locale;
  alternateHref: string;
}

const { locale, alternateHref } = Astro.props;
const base = import.meta.env.BASE_URL;
const alternateLocale: Locale = locale === "zh" ? "en" : "zh";
---

<header class="site-header">
  <a class="site-brand" href={homePath(base, locale)}>SAP Business Agents</a>
  <nav class="header-actions" aria-label={locale === "zh" ? "全局导航" : "Global navigation"}>
    <a class="header-link" href={askPath(base, locale)}>
      <MessageSquareText size={18} stroke-width={1.8} aria-hidden="true" />
      <span>{locale === "zh" ? "直接询问 SAP" : "Ask SAP"}</span>
    </a>
    <span class="header-divider" aria-hidden="true"></span>
    <a class="header-link" href={workflowsPath(base, locale)}>
      <Network size={18} stroke-width={1.8} aria-hidden="true" />
      <span>{locale === "zh" ? "我的工作流" : "My workflows"}</span>
    </a>
    <span class="header-divider" aria-hidden="true"></span>
    <a class="header-link" href={agentManagementPath(base, locale)}>
      <Bot size={18} stroke-width={1.8} aria-hidden="true" />
      <span>{locale === "zh" ? "Agent 管理" : "Agent management"}</span>
    </a>
    <span class="header-divider" aria-hidden="true"></span>
    <a class="header-link" href={pluginsPath(base, locale)}>
      <Plug size={18} stroke-width={1.8} aria-hidden="true" />
      <span>{locale === "zh" ? "插件" : "Plugins"}</span>
    </a>
    <span class="header-divider" aria-hidden="true"></span>
    <a class="header-link" href={settingsPath(base, locale)}>
      <Settings size={18} stroke-width={1.8} aria-hidden="true" />
      <span>{locale === "zh" ? "系统配置" : "Settings"}</span>
    </a>
    <span class="header-divider" aria-hidden="true"></span>
    <a
      class="header-link"
      href={repositoryUrl}
      target="_blank"
      rel="noreferrer"
      aria-label="GitHub"
    >
      <FolderGit2 size={18} stroke-width={1.8} aria-hidden="true" />
      <span>GitHub</span>
    </a>
    <span class="header-divider" aria-hidden="true"></span>
    <a
      class="language-link"
      href={alternateHref}
      data-language-link={alternateLocale}
      aria-label={locale === "zh" ? "Switch to English" : "切换到中文"}
    >
      <Languages size={18} stroke-width={1.8} aria-hidden="true" />
      <span class:list={{ active: locale === "zh" }}>中文</span>
      <span aria-hidden="true">/</span>
      <span class:list={{ active: locale === "en" }}>EN</span>
    </a>
  </nav>
</header>
