  sdkDefault: "SDK 默认", currentModel: "此 Runtime 的已保存模型", modalities: "输入模态", reasoning: "推理强度", tiers: "服务等级",
  reasoningDefault: "SDK 建议默认", reasoningSaved: "用户已保存", saveReasoning: "保存推理强度", reasoningSavedDone: "推理强度已保存；新会话和该模型草稿的下一轮修改生效，正在运行的轮次不变。", reasoningUnavailable: "当前目录未提供有效推理强度，请刷新目录。", chooseReasoning: "选择推理强度", effortNone: "无", effortMinimal: "最低", effortLow: "低", effortMedium: "中", effortHigh: "高", effortXhigh: "超高", effortMax: "最大", effortUltra: "极高", effortUnconfigured: "未保存",
  checkModel: "检查兼容性", checkingModel: "正在检查…", modelCompatible: "兼容性检查通过", modelCheckRequired: "需要兼容性检查", modelIncompatible: "兼容性检查未通过", modelRetired: "当前 SDK 已不再提供",
  setModel: "设为默认模型", settingModel: "正在设置…", modelSet: "系统默认模型已更新，只影响新会话和新草稿。", upgradeTo: "建议迁移到", emptyModels: "当前完整目录中没有可显示的非隐藏模型。",
  blockerLabels: {
    workbuddy_sdk_integration_required: "SDK 接入认证尚未通过", workbuddy_admission_migration_required: "三层策略尚未受控迁移", workbuddy_sdk_operation_not_certified: "此操作或权限模式尚未取得 SDK 接入认证", runtime_model_protocol_changed: "模型协议已变化，需要兼容检查",
    runtime_control_unknown: "启停状态尚未核对", runtime_status_pending: "资格状态正在核对", status_refresh_timeout: "状态核对超过展示等待时间，后台可能仍在继续", status_binding_changed: "配置已变化，正在核对新状态", status_projection_failed: "状态读取失败",
    runtime_reasoning_effort_invalid: "当前模型未提供所选推理强度，请刷新目录并重新选择", runtime_reasoning_effort_unsupported: "当前 Runtime 适配器尚不能明确传递推理强度",
    runtime_model_probe_timeout: "兼容性检查超时，尚不能确认是否兼容，请重试", runtime_model_authentication_failed: "登录验证失败，请重新登录后检查", runtime_model_access_unavailable: "当前账号无法使用该模型", runtime_model_incompatible: "模型与当前 SDK 或 CLI 不兼容", runtime_model_probe_failed: "模型检查执行失败，请重试", runtime_model_probe_invalid_response: "模型未返回预期的验证响应",
    native_windows_runtime_unavailable: "官方 Runtime 暂不支持原生 Windows", sdk_not_installed: "SDK 尚未安装", platform_not_supported: "当前操作系统不受支持",
    provider_not_implemented: "Runtime Provider 尚未实现", authentication_not_configured: "认证方式尚未配置", authentication_not_checked: "尚未检查本机登录状态",
    authentication_unavailable: "本机登录不可用", free_query_live_acceptance_required: "自由查询真机验收尚未通过", runtime_disabled: "Runtime 已由用户停用",
    workbuddy_authentication_required: "请先完成 CodeBuddy CLI 登录并检查状态", workbuddy_existing_login_unavailable: "锁定 CLI 尚未登录，请按独立安装说明完成登录", workbuddy_operation_validation_required: "WorkBuddy 首期操作尚未全部通过真实验证",
    workbuddy_orchestration_validation_required: "共享业务编排已变化，此操作需要重新进行真实验证；历史验证记录保留",
    workbuddy_environment_invalid: "WorkBuddy 独立安装清单结构无效，请重新准备独立环境", workbuddy_state_invalid: "WorkBuddy 管理状态损坏，已阻止执行，不影响 Codex",
    workbuddy_state_or_cleanup_invalid: "WorkBuddy 管理或进程清理状态异常，已阻止执行，不影响 Codex",
    workbuddy_environment_access_denied: "当前 Windows 用户无法读取 WorkBuddy 独立安装，请核对运行账户与目录权限", workbuddy_environment_digest_mismatch: "WorkBuddy 安装文件或摘要已变化，不能继续使用原资格",
    runtime_model_not_configured: "尚未选择系统默认模型", runtime_model_catalog_unavailable: "当前 Runtime 不支持模型目录发现", runtime_model_catalog_required: "需要读取当前 SDK 模型目录", runtime_model_catalog_stale: "模型目录已过期",
    runtime_model_catalog_incomplete: "模型目录不完整", runtime_model_retired: "当前模型已从 SDK 目录移除", runtime_model_check_required: "当前模型尚未通过兼容性检查",
  },
} : {
  eyebrow: "System settings", title: "Agent Runtimes and SDKs",
  body: "Manage the Runtime, SDK client, and system-default model used by new tasks. Model changes affect only new sessions; fixed Agents and deterministic workflows are unaffected by Runtime enablement.",
  checkAll: "Check all runtimes", loading: "Reading local Agent Runtime information…", unavailable: "Cannot reach the local API. Start SAPBusinessAgents first.",
  noDefault: "No default Runtime is configured. New Runtime tasks are unavailable; fixed Agents remain executable.",
  sdkClient: "SDK and client", runtimeState: "Runtime status", modelCatalog: "Model configuration",
  chooseModel: "Choose model", customModel: "Enter another model ID", modelHint: "Selection is for viewing only. Use the buttons to check or save.", technicalDetails: "Technical details", sdkReportedModel: "SDK-reported model ID",
  current: "SDK version", cliVersion: "Bundled CLI version", latest: "Latest version", package: "Package", ecosystem: "Runtime",
  checkedAt: "Last checked", notChecked: "Not checked", notInstalled: "Not installed", check: "Check installation and login", checking: "Checking…",
  update: "Update to latest", updating: "Updating…", currentState: "Up to date", updateState: "Update available", failedState: "Check failed", pendingState: "Not checked",
  updateDisabled: "This SDK cannot be updated by the platform.", restart: "Target version installed; restart required to take effect. The running service has not switched automatically.", updated: "The target version is confirmed installed.",
  confirmUpdate: "This will update a local SDK dependency. Running tasks will not switch versions automatically. Continue?",
  provider: "Runtime provider", enabled: "Enabled", disabled: "Disabled", enable: "Enable Runtime", enabling: "Enabling…", disable: "Disable Runtime", disabling: "Disabling…",
  confirmDisable: "Enter the Runtime provider ID to confirm disabling:", disabledDone: "The Runtime was disabled. New Runtime tasks will be blocked.", enabledDone: "The Runtime was enabled. Setting it as the default is a separate action.",
  authentication: "Login status", authenticated: "Local login available", unauthenticated: "Login unavailable", authUnknown: "Not checked",
  platform: "Platform compatibility", supported: "Current platform supported", unsupported: "Current platform unsupported", capabilities: "Capabilities", blockers: "Unavailable because",
  selected: "Current default Runtime", select: "Set as default Runtime", selecting: "Switching…", reserved: "Reserved", planned: "Pending acceptance",
  switchConfirm: "Only new tasks will switch. Running and waiting tasks remain pinned to their original Runtime. Continue?", switched: "The default Agent Runtime was updated for new tasks.",
  refreshModels: "Refresh model catalog", refreshingModels: "Refreshing models…", catalogUnavailable: "This Runtime cannot discover models from its current SDK.",
  catalogNotLoaded: "The current SDK model catalog has not been loaded.", catalogIncomplete: "The model catalog is incomplete. Models cannot be checked or saved.", catalogStale: "This is a stale cache. Refresh it before changing the model.", catalogFailed: "The model catalog could not be loaded.",
  sdkDefault: "SDK default", currentModel: "Saved model for this Runtime", modalities: "Input modalities", reasoning: "Reasoning effort", tiers: "Service tiers",
  reasoningDefault: "SDK recommended default", reasoningSaved: "User selection", saveReasoning: "Save reasoning effort", reasoningSavedDone: "Reasoning effort saved for new sessions and the next Agent editing turn using this model; running turns are unchanged.", reasoningUnavailable: "The current catalog does not provide valid reasoning efforts. Refresh it first.", chooseReasoning: "Choose reasoning effort", effortNone: "None", effortMinimal: "Minimal", effortLow: "Low", effortMedium: "Medium", effortHigh: "High", effortXhigh: "Extra high", effortMax: "Maximum", effortUltra: "Ultra", effortUnconfigured: "Not saved",
  checkModel: "Check compatibility", checkingModel: "Checking…", modelCompatible: "Compatibility check passed", modelCheckRequired: "Compatibility check required", modelIncompatible: "Compatibility check failed", modelRetired: "No longer offered by the current SDK",
  setModel: "Set as default model", settingModel: "Setting…", modelSet: "The system-default model was updated for new sessions and drafts only.", upgradeTo: "Recommended upgrade", emptyModels: "The complete catalog contains no visible models.",
  blockerLabels: {
    workbuddy_sdk_integration_required: "SDK integration certification required", workbuddy_admission_migration_required: "Controlled three-layer migration required", workbuddy_sdk_operation_not_certified: "SDK operation or permission mode is not certified", runtime_model_protocol_changed: "Model protocol changed; compatibility check required",
    runtime_control_unknown: "Enablement state is not confirmed", runtime_status_pending: "Qualification status is being checked", status_refresh_timeout: "Status checking exceeded the display wait; background work may still be running", status_binding_changed: "Configuration changed; checking the new state", status_projection_failed: "Status could not be read",
    runtime_reasoning_effort_invalid: "The current model does not offer this reasoning effort. Refresh the catalog and choose again.", runtime_reasoning_effort_unsupported: "This Runtime adapter cannot explicitly send reasoning effort.",
    runtime_model_probe_timeout: "Compatibility check timed out; compatibility remains unconfirmed. Retry the check.", runtime_model_authentication_failed: "Authentication failed. Sign in again before checking.", runtime_model_access_unavailable: "This account cannot access the model.", runtime_model_incompatible: "The model is incompatible with the current SDK or CLI.", runtime_model_probe_failed: "The model check failed. Retry the check.", runtime_model_probe_invalid_response: "The model did not return the expected verification response.",
    native_windows_runtime_unavailable: "The official Runtime does not support native Windows", sdk_not_installed: "The SDK is not installed", platform_not_supported: "The current operating system is unsupported",
    provider_not_implemented: "The Runtime Provider is not implemented", authentication_not_configured: "Authentication is not configured", authentication_not_checked: "The local login has not been checked",
    authentication_unavailable: "The local login is unavailable", free_query_live_acceptance_required: "Live free-query acceptance has not passed", runtime_disabled: "The Runtime was disabled by the user",
    workbuddy_authentication_required: "Sign in to CodeBuddy CLI and check its status first", workbuddy_existing_login_unavailable: "The locked CLI is not signed in. Follow the isolated installation instructions", workbuddy_operation_validation_required: "Not all initial WorkBuddy operations have passed live validation",
    workbuddy_orchestration_validation_required: "Shared orchestration changed. This operation needs new live validation; historical records are retained.",
    workbuddy_environment_invalid: "The isolated WorkBuddy installation manifest is invalid. Prepare a new isolated environment.", workbuddy_state_invalid: "WorkBuddy management state is damaged. Execution is blocked; Codex is unaffected.",
    workbuddy_state_or_cleanup_invalid: "WorkBuddy management or process-cleanup state is invalid. Execution is blocked; Codex is unaffected.",
    workbuddy_environment_access_denied: "The current Windows user cannot read the isolated WorkBuddy installation. Check the account and directory permissions.", workbuddy_environment_digest_mismatch: "WorkBuddy installation files or their digest changed. Previous validation is not applicable.",
    runtime_model_not_configured: "No system-default model is selected", runtime_model_catalog_unavailable: "The Runtime does not support model catalog discovery", runtime_model_catalog_required: "The current SDK model catalog must be loaded", runtime_model_catalog_stale: "The model catalog is stale",
    runtime_model_catalog_incomplete: "The model catalog is incomplete", runtime_model_retired: "The current model was removed from the SDK catalog", runtime_model_check_required: "The current model has not passed compatibility checking",
  },
};
---

<section class="sdk-manager" data-sdk-manager data-api-base={apiBase}>
  <header class="plugin-manager-header">
    <div><p class="runtime-eyebrow"><Settings size={16} aria-hidden="true" />{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.body}</p></div>
  </header>
  <div class="settings-default-strip"><strong data-default-summary>{copy.loading}</strong><button type="button" class="secondary-button" data-reread><RefreshCw size={16} aria-hidden="true" />{locale === "zh" ? "重新读取状态" : "Read status again"}</button></div>
  <div class="settings-runtime-navigation">
    <div role="tablist" aria-label={locale === "zh" ? "查看 Runtime" : "View Runtime"} data-runtime-tabs></div>
    <label class="settings-more" hidden>{locale === "zh" ? "更多" : "More"}<select data-runtime-more aria-label={locale === "zh" ? "更多 Runtime" : "More runtimes"}></select></label>
    <label class="settings-runtime-picker">{locale === "zh" ? "查看 Runtime" : "View Runtime"}<select data-runtime-picker></select></label>
  </div>
  <div class="plugin-alert" data-sdk-alert>{copy.loading}</div>
  <div class="plugin-alert" data-no-default hidden>{copy.noDefault}</div>
  <div class="sdk-grid" data-sdk-grid></div>
  <details class="settings-other"><summary>{locale === "zh" ? "其他 Runtime" : "Other runtimes"}</summary><div data-other-runtimes></div></details>
  <details class="settings-global-maintenance"><summary>{locale === "zh" ? "全局高级维护" : "Global advanced maintenance"}</summary><p>{locale === "zh" ? "执行实际安装与认证检查，不是重新读取展示状态。" : "Runs installation and authentication checks, not a display-state refresh."}</p><button type="button" class="secondary-button" data-check-all><RefreshCw size={16} aria-hidden="true" />{copy.checkAll}</button></details>
</section>

<script is:inline define:vars={{ copy, locale }}>
  const root = document.querySelector("[data-sdk-manager]");
  const grid = root?.querySelector("[data-sdk-grid]");
  const alert = root?.querySelector("[data-sdk-alert]");
  const noDefault = root?.querySelector("[data-no-default]");
  const apiBase = root?.dataset.apiBase;
  const navigationEnabled = Boolean(root?.querySelector("[data-runtime-tabs]"));
  const initialParams = navigationEnabled ? new URL(window.location.href).searchParams : null;
  let viewedProvider = initialParams?.get("provider") || null;
  let viewedSection = initialParams?.get("section") === "history" ? "history" : "runtime";
  const notifySettings = () => { if (navigationEnabled) document.dispatchEvent(new CustomEvent("sapba:settings-state", {detail: {items: [...runtimeViews.values()].filter(view => listedProviders.has(view.sdk.provider_id)).map(view => view.sdk), defaultProviderId: latestDefault}})); };
  const activity = (section, message) => {
    if (!navigationEnabled) return;
    const card = section.closest(".sdk-card"); if (card) { card.dataset.activity = message; card.dataset.busy = String(message === (locale === "zh" ? "操作进行中" : "Operation in progress")); }
    document.dispatchEvent(new CustomEvent("sapba:settings-activity"));
  };
  let stateGeneration = 0;
  const element = (tag, className, text) => { const node = document.createElement(tag); if (className) node.className = className; if (text != null) node.textContent = text; return node; };
  const localized = (value) => value?.[locale] || value?.zh || value?.en || "";
  const checkedTime = (value) => value ? new Date(value).toLocaleString(locale === "zh" ? "zh-CN" : "en-US") : copy.notChecked;
  const blockerText = (value) => copy.blockerLabels?.[value] || value;
  const showMessage = (message, tone = "") => { alert.hidden = false; alert.dataset.tone = tone; alert.textContent = message; };
  const responseFailure = async (response) => { try { const payload = await response.json(); return {
    message: authenticationErrors[payload?.detail?.code] || copy.blockerLabels?.[payload?.detail?.code] || payload?.detail?.message || payload?.detail?.detail?.message || (typeof payload?.detail === "string" ? payload.detail : response.statusText),
    code: payload?.detail?.code, phase: payload?.detail?.detail?.phase, outcome: payload?.detail?.detail?.outcome}; } catch { return {message: response.statusText}; } };
  const responseError = async (response) => (await responseFailure(response)).message;
  const request = async (url, options = {}) => { const response = await fetch(url, options); if (!response.ok) { const failure = await responseFailure(response); const error = new Error(failure.message); error.code = failure.code; error.phase = failure.phase; error.outcome = failure.outcome; error.confirmed = response.status >= 400 && response.status < 500; throw error; } const payload = await response.json(); if (options.method && !["GET", "HEAD"].includes(options.method)) { stateGeneration++; const match = url.match(/\/sdk-runtimes\/([^/]+)\/(default-model|models\/check|models\/[^/]+\/reasoning-effort)$/); if (navigationEnabled && match) { const view = runtimeViews.get(decodeURIComponent(match[1])); if (view) view.acceptedFormChange = true; } } return payload; };
  const workbuddyModelCheck = async (body) => {
    const response = await fetch(`${apiBase}/api/system/sdk-runtimes/workbuddy/models/check`, {
      method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify(body)});
    if (!response.ok) {
      const error = new Error(await responseError(response));
      error.confirmed = response.status >= 400 && response.status < 500;
      throw error;
    }
    const payload = await response.json(); stateGeneration++; if (navigationEnabled && payload.check) { const view = runtimeViews.get("workbuddy"); if (view) view.acceptedFormChange = true; } return payload;
  };

  const stateFor = (sdk) => {
    if (sdk.provider_id === "workbuddy" && sdk.enabled == null && typeof sdk.display_status?.last_confirmed_enabled === "boolean") return {
      key: "pending", text: locale === "zh"
        ? `上次确认${sdk.display_status.last_confirmed_enabled ? "已启用" : "已停用"} · 正在刷新`
        : `Last confirmed ${sdk.display_status.last_confirmed_enabled ? "enabled" : "disabled"} · refreshing`};
    if (sdk.enabled == null) return { key: "pending", text: locale === "zh" ? "状态待核对" : "State not confirmed" };
    if (sdk.control_status && sdk.enabled === true && sdk.status_refresh?.stale) return { key: "ready", text: locale === "zh" ? "已启用 · 资格核对中" : "Enabled · qualification pending" };
    if (sdk.status_refresh?.stale) return { key: "pending", text: copy.notChecked };
    if (sdk.selected && !navigationEnabled) return { key: "ready", text: copy.selected };
    if (!sdk.enabled) return { key: "pending", text: copy.disabled };
    if (["reserved", "reserved_blocked"].includes(sdk.availability)) return { key: "pending", text: copy.reserved };
    if (sdk.availability === "planned") return { key: "pending", text: copy.planned };
    if (sdk.check_status === "failed") return { key: "failed", text: copy.failedState };
    if (!sdk.installed) return { key: "failed", text: copy.notInstalled };
    if (sdk.update_available) return { key: "update", text: copy.updateState };
    return { key: "ready", text: copy.enabled };
  };
  const modelState = (model) => {
    if (model.display_pending) return { key: "pending", text: model.last_confirmed && model.check_status === "compatible"
      ? (locale === "zh" ? "上次兼容通过 · 正在刷新" : "Last confirmed compatible · refreshing")
      : (locale === "zh" ? "已有记录，适用性核对中" : "Saved record; applicability pending") };
    if (model.retired) return { key: "failed", text: copy.modelRetired };
    const status = model.compatibility_applicability?.status;
    const labels = {
      reusable: ["兼容结果有效，可直接保存", "Compatible result reusable; ready to save"],
      authentication_required: ["认证待核对，并非模型不兼容", "Authentication needs review; not a model incompatibility"],
      recovery_pending: ["历史结果待承接，请核对认证绑定；无需先重复检查", "Historical result awaits authentication-binding review; do not repeat the check first"],
      check_required: ["缺少适用结果，需要轻量兼容检查", "No applicable result; a lightweight compatibility check is needed"],
      failed: ["最近兼容检查失败", "The latest compatibility check failed"],
      blocked: ["安装、接入能力或运行条件待核对", "Installation, integration or execution prerequisites need review"],
    };
    if (labels[status]) return { key: status === "reusable" ? "ready" : status === "failed" ? "failed" : "pending", text: labels[status][locale === "zh" ? 0 : 1] };
    if (model.check_status === "compatible") return { key: "ready", text: copy.modelCompatible };
    if (model.check_status === "check_required") return { key: "pending", text: copy.modelCheckRequired };
    if (model.check_status === "not_checked") return { key: "pending", text: copy.notChecked };
    return { key: "failed", text: copy.blockerLabels?.[model.check_status] || copy.modelIncompatible };
  };

  // View selection is local UI state, never the saved Runtime default.
  const modelSelections = new Map();
  const customModelIds = new Map();
  const modelCheckPending = new Map();
  const codexCheckPending = new Set();
  const checkBlocked = (model) => model?.display_pending || ["authentication_required", "recovery_pending", "blocked"].includes(model?.compatibility_applicability?.status);
  const compatibleView = (model) => !model?.compatibility_applicability || model.compatibility_applicability.status === "reusable";
  const modelBinding = (payload, model) => JSON.stringify([
    payload.catalog_digest, payload.environment_digest, payload.service_site_digest,
    model.reasoning_effort, model.check || null]);
  const confirmModelSave = async (sdk, payload, model, requireCompatible = true) => {
    const generation = stateGeneration;
    const latest = await request(`${apiBase}/api/system/sdk-runtimes/${encodeURIComponent(sdk.provider_id)}/models`);
