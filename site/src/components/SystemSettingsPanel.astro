---
import { RefreshCw, Settings } from "@lucide/astro";
import type { Locale } from "../lib/types";

interface Props { locale: Locale }
const { locale } = Astro.props;
const apiBase = import.meta.env.PUBLIC_SAPBA_API_URL || "http://127.0.0.1:8765";
const copy = locale === "zh" ? {
  eyebrow: "系统配置",
  title: "Agent Runtime 与 SDK",
  body: "选择新任务使用的 Agent Runtime，并集中检查安装、登录、平台兼容性和 SDK 版本。固定 Agent 不受此设置影响。",
  checkAll: "检查全部 Runtime",
  loading: "正在读取本机 Agent Runtime 信息…",
  unavailable: "无法连接本机 API，请先启动 SAPBusinessAgents。",
  current: "当前版本",
  latest: "最新版本",
  package: "安装包",
  ecosystem: "运行环境",
  checkedAt: "检查时间",
  notChecked: "尚未检查",
  notInstalled: "未安装",
  check: "检查状态与更新",
  checking: "正在检查…",
  update: "更新到最新版本",
  updating: "正在更新…",
  currentState: "已是最新版本",
  updateState: "发现新版本",
  failedState: "检查失败",
  pendingState: "等待检查",
  updateDisabled: "此 SDK 只能查看版本，不能由平台更新。",
  restart: "更新完成。请重启 SAPBusinessAgents，使新 SDK 版本对所有任务生效。",
  updated: "SDK 更新完成。",
  confirmUpdate: "将更新本机 SDK 依赖，运行中的任务不会自动切换版本。确定继续吗？",
  provider: "Runtime Provider",
  authentication: "登录状态",
  authenticated: "已复用本机登录",
  unauthenticated: "登录不可用",
  authUnknown: "尚未检查",
  platform: "平台兼容性",
  supported: "支持当前平台",
  unsupported: "不支持当前平台",
  capabilities: "平台能力",
  blockers: "不可用原因",
  selected: "当前默认",
  select: "设为默认 Runtime",
  selecting: "正在切换…",
  reserved: "预留",
  planned: "待验收",
  switchConfirm: "只会影响新创建的任务；运行中和等待补充信息的任务继续使用原 Runtime。确定切换吗？",
  switched: "默认 Agent Runtime 已更新，新任务将使用该 Runtime。",
  blockerLabels: {
    native_windows_runtime_unavailable: "官方 Runtime 暂不支持原生 Windows",
    sdk_not_installed: "SDK 尚未安装",
    platform_not_supported: "当前操作系统不受支持",
    provider_not_implemented: "Runtime Provider 尚未实现",
    authentication_not_configured: "认证方式尚未配置",
    authentication_not_checked: "尚未检查本机登录状态",
    authentication_unavailable: "本机登录不可用",
    free_query_live_acceptance_required: "自由 SAP 查询真机验收尚未通过",
  },
} : {
  eyebrow: "System settings",
  title: "Agent Runtimes and SDKs",
  body: "Select the Agent Runtime for new tasks and inspect installation, login, platform compatibility, and SDK versions. Fixed Agents are unaffected.",
  checkAll: "Check all runtimes",
  loading: "Reading local Agent Runtime information…",
  unavailable: "Cannot reach the local API. Start SAPBusinessAgents first.",
  current: "Current version",
  latest: "Latest version",
  package: "Package",
  ecosystem: "Runtime",
  checkedAt: "Last checked",
  notChecked: "Not checked",
  notInstalled: "Not installed",
  check: "Check status and updates",
  checking: "Checking…",
  update: "Update to latest",
  updating: "Updating…",
  currentState: "Up to date",
  updateState: "Update available",
  failedState: "Check failed",
  pendingState: "Not checked",
  updateDisabled: "This SDK is version-visible but cannot be updated by the platform.",
  restart: "Update completed. Restart SAPBusinessAgents so every task uses the new SDK version.",
  updated: "SDK update completed.",
  confirmUpdate: "This will update a local SDK dependency. Running tasks will not switch versions automatically. Continue?",
  provider: "Runtime provider",
  authentication: "Login status",
  authenticated: "Local login available",
  unauthenticated: "Login unavailable",
  authUnknown: "Not checked",
  platform: "Platform compatibility",
  supported: "Current platform supported",
  unsupported: "Current platform unsupported",
  capabilities: "Capabilities",
  blockers: "Unavailable because",
  selected: "Current default",
  select: "Set as default runtime",
  selecting: "Switching…",
  reserved: "Reserved",
  planned: "Pending acceptance",
  switchConfirm: "Only new tasks will switch. Running and waiting tasks remain pinned to their original runtime. Continue?",
  switched: "The default Agent Runtime was updated for new tasks.",
  blockerLabels: {
    native_windows_runtime_unavailable: "The official runtime does not support native Windows",
    sdk_not_installed: "The SDK is not installed",
    platform_not_supported: "The current operating system is unsupported",
    provider_not_implemented: "The Runtime Provider is not implemented",
    authentication_not_configured: "Authentication is not configured",
    authentication_not_checked: "The local login has not been checked",
    authentication_unavailable: "The local login is unavailable",
    free_query_live_acceptance_required: "Live free-SAP-query acceptance has not passed",
  },
};
---

<section class="sdk-manager" data-sdk-manager data-api-base={apiBase}>
  <header class="plugin-manager-header">
    <div>
      <p class="runtime-eyebrow"><Settings size={16} aria-hidden="true" />{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p>{copy.body}</p>
    </div>
    <button type="button" class="secondary-button" data-check-all>
      <RefreshCw size={16} aria-hidden="true" />{copy.checkAll}
    </button>
  </header>

  <div class="plugin-alert" data-sdk-alert>{copy.loading}</div>
  <div class="sdk-grid" data-sdk-grid></div>
</section>

<script is:inline define:vars={{ copy, locale }}>
  const root = document.querySelector("[data-sdk-manager]");
  const grid = root?.querySelector("[data-sdk-grid]");
  const alert = root?.querySelector("[data-sdk-alert]");
  const apiBase = root?.dataset.apiBase;

  const element = (tag, className, text) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text != null) node.textContent = text;
    return node;
  };

  const localized = (value) => value?.[locale] || value?.zh || value?.en || "";
  const checkedTime = (value) => value
    ? new Date(value).toLocaleString(locale === "zh" ? "zh-CN" : "en-US")
    : copy.notChecked;
  const blockerText = (value) => copy.blockerLabels?.[value] || value;

  const responseError = async (response) => {
    try {
      const payload = await response.json();
      return payload?.detail?.message || payload?.detail || response.statusText;
    } catch {
      return response.statusText;
    }
  };

  const stateFor = (sdk) => {
    if (sdk.selected) return { key: "ready", text: copy.selected };
    if (sdk.availability === "reserved" || sdk.availability === "reserved_blocked") {
      return { key: "pending", text: copy.reserved };
    }
    if (sdk.availability === "planned") return { key: "pending", text: copy.planned };
    if (sdk.check_status === "failed") return { key: "failed", text: copy.failedState };
    if (!sdk.installed) return { key: "failed", text: copy.notInstalled };
    if (sdk.update_available) return { key: "update", text: copy.updateState };
    if (sdk.check_status === "checked") return { key: "ready", text: copy.currentState };
    return { key: "pending", text: copy.pendingState };
  };

  const render = (sdks) => {
    grid.replaceChildren();
    alert.hidden = true;
    for (const sdk of sdks) {
      const state = stateFor(sdk);
      const card = element("article", "sdk-card");
      const heading = element("header", "sdk-card-heading");
      const titleWrap = element("div");
      titleWrap.append(
        element("h2", "", localized(sdk.name) || sdk.sdk_id),
        element("p", "", localized(sdk.description)),
      );
      heading.append(titleWrap, element("span", `sdk-status status-${state.key}`, state.text));

      const versions = element("div", "sdk-version-grid");
      const current = element("section", "sdk-version-block");
      current.append(element("span", "", copy.current), element("strong", "", sdk.current_version || copy.notInstalled));
      const latest = element("section", "sdk-version-block");
      latest.append(element("span", "", copy.latest), element("strong", "", sdk.latest_version || copy.notChecked));
      versions.append(current, latest);

      const facts = element("dl", "plugin-facts sdk-facts");
      facts.append(
        element("dt", "", copy.provider), element("dd", "", sdk.provider_id),
        element("dt", "", copy.package), element("dd", "", sdk.package_name),
        element("dt", "", copy.ecosystem), element("dd", "", sdk.ecosystem),
        element("dt", "", copy.authentication),
        element(
          "dd",
          "",
          sdk.authenticated === true
            ? copy.authenticated
            : sdk.authenticated === false
              ? copy.unauthenticated
              : copy.authUnknown,
        ),
        element("dt", "", copy.platform),
        element("dd", "", sdk.platform_supported ? copy.supported : copy.unsupported),
        element("dt", "", copy.capabilities),
        element("dd", "", (sdk.capabilities || []).join(", ") || "—"),
        element("dt", "", copy.checkedAt), element("dd", "", checkedTime(sdk.checked_at)),
      );
      if (sdk.blockers?.length) {
        facts.append(
          element("dt", "", copy.blockers),
          element("dd", "sdk-error", sdk.blockers.map(blockerText).join(locale === "zh" ? "；" : "; ")),
        );
      }
      if (sdk.error?.message) {
        facts.append(element("dt", "", copy.failedState), element("dd", "sdk-error", sdk.error.message));
      }

      const actions = element("footer", "plugin-card-actions sdk-card-actions");
      const check = element("button", "secondary-button", copy.check);
      check.type = "button";
      check.addEventListener("click", async () => {
        check.disabled = true; check.textContent = copy.checking;
        try {
          const response = await fetch(
            apiBase + "/api/system/sdk-runtimes/" + encodeURIComponent(sdk.provider_id) + "/check",
            { method: "POST" },
          );
          if (!response.ok) throw new Error(await responseError(response));
          await load();
        } catch (error) {
          alert.hidden = false; alert.textContent = String(error.message || error);
        } finally {
          check.disabled = false;
        }
      });
      actions.append(check);

      if (sdk.selectable && !sdk.selected) {
        const select = element("button", "sdk-update-button", copy.select);
        select.type = "button";
        select.addEventListener("click", async () => {
          if (!window.confirm(copy.switchConfirm)) return;
          select.disabled = true;
          select.textContent = copy.selecting;
          try {
            const response = await fetch(apiBase + "/api/system/sdk-runtimes/default", {
              method: "PUT",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ provider_id: sdk.provider_id }),
            });
            if (!response.ok) throw new Error(await responseError(response));
            alert.hidden = false;
            alert.dataset.tone = "success";
            alert.textContent = copy.switched;
            await load();
          } catch (error) {
            alert.hidden = false;
            alert.dataset.tone = "error";
            alert.textContent = String(error.message || error);
          } finally {
            select.disabled = false;
          }
        });
        actions.append(select);
      }

      if (sdk.update_available && sdk.update_enabled) {
        const update = element("button", "sdk-update-button", copy.update);
        update.type = "button";
        update.addEventListener("click", async () => {
          if (!window.confirm(copy.confirmUpdate)) return;
          update.disabled = true; update.textContent = copy.updating;
          try {
            const response = await fetch(`${apiBase}/api/system/sdks/${encodeURIComponent(sdk.sdk_id)}/update`, {
              method: "POST",
              headers: { "X-SAPBA-Action": "sdk-update" },
            });
            if (!response.ok) throw new Error(await responseError(response));
            const payload = await response.json();
            alert.hidden = false;
            alert.dataset.tone = "success";
            alert.textContent = payload.restart_required ? copy.restart : copy.updated;
            render([payload.item, ...sdks.filter((item) => item.sdk_id !== sdk.sdk_id)]);
            alert.hidden = false;
          } catch (error) {
            alert.hidden = false; alert.dataset.tone = "error"; alert.textContent = String(error.message || error);
          } finally {
            update.disabled = false;
          }
        });
        actions.append(update);
      } else if (sdk.check_status === "checked" && !sdk.update_enabled) {
        actions.append(element("small", "sdk-update-note", copy.updateDisabled));
      }

      card.append(heading, versions, facts, actions);
      grid.append(card);
    }
  };

  const load = async () => {
    const response = await fetch(apiBase + "/api/system/sdk-runtimes");
    if (!response.ok) throw new Error(await responseError(response));
    const payload = await response.json();
    render(payload.items || []);
  };

  root?.querySelector("[data-check-all]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget;
    button.disabled = true;
    alert.hidden = false; alert.dataset.tone = ""; alert.textContent = copy.checking;
    try {
      const response = await fetch(apiBase + "/api/system/sdk-runtimes/check", { method: "POST" });
      if (!response.ok) throw new Error(await responseError(response));
      const payload = await response.json();
      render(payload.items || []);
    } catch (error) {
      alert.hidden = false; alert.dataset.tone = "error"; alert.textContent = String(error.message || error);
    } finally {
      button.disabled = false;
    }
  });

  load().catch(() => { alert.hidden = false; alert.textContent = copy.unavailable; });
</script>
