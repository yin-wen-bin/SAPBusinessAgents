  root?.querySelector("[data-check-all]")?.addEventListener("click", async (event) => { const button = event.currentTarget; button.disabled = true; showMessage(copy.checking); try { const payload = await request(apiBase + "/api/system/sdk-runtimes/check", { method: "POST" }); render(payload.items || [], payload.default_provider_id); } catch (error) { showMessage(String(error.message || error), "error"); } finally { button.disabled = false; } });
  root?.querySelector("[data-reread]")?.addEventListener("click", () => {
    for (const view of runtimeViews.values()) { view.authenticationKey = null; view.modelSummaryKey = null; }
    load(false, {incremental:true}).catch(() => showMessage(copy.unavailable, "error"));
  });
  if (navigationEnabled) {
    document.addEventListener("sapba:settings-request-state", notifySettings);
    document.addEventListener("sapba:settings-select", event => {
      viewedProvider = event.detail.provider; viewedSection = event.detail.section;
      for (const view of runtimeViews.values()) { view.card.hidden = sdkHidden(view.sdk.provider_id); maybeLoadModels(view.sdk, view); maybeLoadAuthentication(view.sdk, view); }
    });
  }
  load().catch(() => showMessage(copy.unavailable, "error"));
</script>
