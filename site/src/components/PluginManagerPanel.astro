---
import { MailPlus, Plug, RefreshCw, X } from "@lucide/astro";
import type { Locale } from "../lib/types";

interface Props { locale: Locale }
const { locale } = Astro.props;
const apiBase = import.meta.env.PUBLIC_SAPBA_API_URL || "http://127.0.0.1:8765";
const copy = locale === "zh" ? {
  eyebrow: "插件与连接", title: "统一管理本地插件与 Runtime 连接",
  body: "Agent Runtime 负责编排，连接器后端负责外部工具。OAuth 凭据仍由对应 Runtime 管理；SAP 只读执行不会继承外部连接。",
  refresh: "刷新目录与状态", loading: "正在读取插件、Runtime App 与 MCP Server…", unavailable: "无法连接本地 API，请先启动服务。",
  addMail: "添加邮箱服务", setupTitle: "添加邮箱服务", setupBody: "优先安装 Runtime 邮件 App；高级用户也可以配置 Streamable HTTP MCP。",
  all: "全部", local: "本地插件", app: "Runtime App", mcp: "MCP Server", allRuntimes: "全部 Runtime", allStates: "全部状态",
  capability: "工具能力", source: "来源", connection: "连接", authentication: "认证", health: "健康", workflowRefs: "工作流引用",
  connect: "安装 / 连接", refreshState: "刷新状态", disable: "停用", enable: "启用", healthCheck: "健康检查", reconnect: "重新认证", editConfig: "编辑配置",
  configuredByRuntime: "凭据由 Runtime 管理", adapters: "Runtime 适配器", blockers: "当前阻塞项", tools: "工具与规范能力绑定", sourceStatus: "来源状态",
  bind: "保存绑定", chooseOperation: "选择邮件操作", bound: "已绑定", bindingDisabled: "已保存，当前停用", sendDisabled: "邮件发送绑定默认关闭；明确启用后，每封邮件仍需人工审批。", noItems: "没有符合当前筛选条件的项目。",
  missingConnection: "请先完成连接或认证", details: "查看连接、权限与诊断", success: "操作已完成。",
  runtime: "Runtime", method: "配置方式", runtimeApp: "Runtime 邮件 App", customMcp: "自定义 HTTP MCP", chooseApp: "选择邮件 App", noMailApps: "当前没有可用的邮件 App。你仍可配置 HTTP MCP。",
  serverId: "Server ID", displayName: "显示名称", serverUrl: "MCP 地址", authMode: "认证方式", oauth: "OAuth", bearerEnv: "Bearer Token 环境变量", noAuth: "无认证", envName: "环境变量名",
  startupTimeout: "启动超时（秒，可选）", toolTimeout: "工具超时（秒，可选）", enabledTools: "工具白名单（逗号分隔，可选）", cancel: "取消", saveConnect: "保存并连接", validating: "正在校验并保存…",
  sharedWarning: "此配置写入 Codex 用户级 config.toml，会影响同一主机上的 Codex 桌面端、CLI 与 IDE。平台不会保存 Token、邮箱密码或环境变量值。",
  polling: "已打开 OAuth 页面，正在等待 Runtime 完成认证…", pollTimeout: "认证等待超时。完成授权后请点击“刷新状态”。", installedNonCallable: "App 已安装，但尚未发现可调用的 MCP Server。请刷新目录或配置 MCP。",
  fieldErrors: "请修正以下配置：", setupUnavailable: "当前 Runtime 不支持从前台配置邮箱服务。", appSourceFailed: "Runtime App 目录暂不可用；已配置 MCP 与自定义 MCP 仍可使用。",
} : {
  eyebrow: "Plugins & Connections", title: "Manage local plugins and Runtime connections",
  body: "Agent Runtimes compose workflows; integration backends execute external tools. OAuth credentials remain Runtime-owned, and SAP read-only execution never inherits external connections.",
  refresh: "Refresh catalog and status", loading: "Reading plugins, Runtime Apps, and MCP servers…", unavailable: "Cannot reach the local API. Start it first.",
  addMail: "Add mail service", setupTitle: "Add mail service", setupBody: "Install a Runtime mail app when available, or configure a Streamable HTTP MCP as an advanced option.",
  all: "All", local: "Local plugins", app: "Runtime Apps", mcp: "MCP servers", allRuntimes: "All Runtimes", allStates: "All states",
  capability: "Tool capabilities", source: "Source", connection: "Connection", authentication: "Authentication", health: "Health", workflowRefs: "Workflow references",
  connect: "Install / connect", refreshState: "Refresh status", disable: "Disable", enable: "Enable", healthCheck: "Health check", reconnect: "Authenticate again", editConfig: "Edit configuration",
  configuredByRuntime: "Credentials are managed by the Runtime", adapters: "Runtime adapters", blockers: "Current blockers", tools: "Tools and normalized capability bindings", sourceStatus: "Source status",
  bind: "Save binding", chooseOperation: "Choose a mail operation", bound: "Bound", bindingDisabled: "Saved, currently disabled", sendDisabled: "Mail send bindings start disabled. After explicit enablement, every message still requires human approval.", noItems: "No item matches the current filters.",
  missingConnection: "Connect or authenticate first", details: "View connections, permissions, and diagnostics", success: "Operation completed.",
  runtime: "Runtime", method: "Setup method", runtimeApp: "Runtime mail app", customMcp: "Custom HTTP MCP", chooseApp: "Choose a mail app", noMailApps: "No mail app is currently available. You can still configure an HTTP MCP.",
  serverId: "Server ID", displayName: "Display name", serverUrl: "MCP URL", authMode: "Authentication", oauth: "OAuth", bearerEnv: "Bearer token environment variable", noAuth: "No authentication", envName: "Environment variable name",
  startupTimeout: "Startup timeout (seconds, optional)", toolTimeout: "Tool timeout (seconds, optional)", enabledTools: "Tool allowlist (comma-separated, optional)", cancel: "Cancel", saveConnect: "Save and connect", validating: "Validating and saving…",
  sharedWarning: "This writes Codex user-level config.toml and affects Codex Desktop, CLI, and IDE on the same host. The platform never stores token values, mailbox passwords, or environment-variable values.",
  polling: "OAuth opened. Waiting for the Runtime to finish authentication…", pollTimeout: "Authentication wait timed out. Finish authorization, then use Refresh status.", installedNonCallable: "The app is installed, but no callable MCP server was found. Refresh the catalog or configure MCP.",
  fieldErrors: "Fix the following configuration issues:", setupUnavailable: "This Runtime cannot configure mail services from the UI.", appSourceFailed: "The Runtime App catalog is unavailable; configured MCP and custom MCP remain available.",
};
---

<section class="plugin-manager" data-plugin-manager data-api-base={apiBase}>
  <header class="plugin-manager-header">
    <div><p class="runtime-eyebrow"><Plug size={16} aria-hidden="true" />{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.body}</p></div>
    <div class="plugin-manager-header-actions">
      <button type="button" class="secondary-button plugin-accent-button" data-add-mail><MailPlus size={16} aria-hidden="true" />{copy.addMail}</button>
      <button type="button" class="secondary-button" data-rescan><RefreshCw size={16} aria-hidden="true" />{copy.refresh}</button>
    </div>
  </header>

  <section class="plugin-setup-panel" data-setup-panel hidden aria-labelledby="mail-setup-title">
    <header class="plugin-setup-heading">
      <div><p class="runtime-eyebrow"><MailPlus size={16} aria-hidden="true" />{copy.addMail}</p><h2 id="mail-setup-title">{copy.setupTitle}</h2><p>{copy.setupBody}</p></div>
      <button type="button" class="plugin-icon-button" data-close-setup aria-label={copy.cancel}><X size={18} aria-hidden="true" /></button>
    </header>
    <div class="plugin-setup-warning">{copy.sharedWarning}</div>
    <form class="plugin-setup-form" data-setup-form novalidate>
      <div class="plugin-setup-grid">
        <label><span>{copy.runtime}</span><select name="runtime" data-setup-runtime required></select><small data-runtime-blocker></small></label>
        <fieldset class="plugin-setup-method"><legend>{copy.method}</legend><label><input type="radio" name="mode" value="runtime_app" checked />{copy.runtimeApp}</label><label><input type="radio" name="mode" value="http_mcp" />{copy.customMcp}</label></fieldset>
      </div>
      <div data-app-setup>
        <label><span>{copy.chooseApp}</span><select name="catalog_id" data-mail-app></select><small data-app-status></small></label>
      </div>
      <div class="plugin-setup-grid" data-mcp-setup hidden>
        <label><span>{copy.serverId}</span><input name="native_id" maxlength="64" pattern="[A-Za-z0-9_.-]+" autocomplete="off" placeholder="company-mail" required /></label>
        <label><span>{copy.displayName}</span><input name="display_name" maxlength="120" autocomplete="off" placeholder="Company Mail" /></label>
        <label class="plugin-setup-wide"><span>{copy.serverUrl}</span><input name="url" type="url" autocomplete="off" placeholder="https://mail.example.com/mcp" required /></label>
        <label><span>{copy.authMode}</span><select name="auth_mode"><option value="oauth">{copy.oauth}</option><option value="bearer_env">{copy.bearerEnv}</option><option value="none">{copy.noAuth}</option></select></label>
        <label data-env-field hidden><span>{copy.envName}</span><input name="bearer_token_env_var" autocomplete="off" placeholder="MAIL_MCP_TOKEN" /></label>
        <label><span>{copy.startupTimeout}</span><input name="startup_timeout_sec" type="number" min="1" max="600" /></label>
        <label><span>{copy.toolTimeout}</span><input name="tool_timeout_sec" type="number" min="1" max="3600" /></label>
        <label class="plugin-setup-wide"><span>{copy.enabledTools}</span><input name="enabled_tools" autocomplete="off" placeholder="search_mail, read_mail, send_mail" /></label>
      </div>
      <div class="plugin-setup-errors" data-setup-errors hidden></div>
      <footer class="plugin-setup-actions"><button type="button" class="secondary-button" data-cancel-setup>{copy.cancel}</button><button type="submit" class="secondary-button plugin-accent-button" data-submit-setup>{copy.saveConnect}</button></footer>
    </form>
  </section>

  <div class="plugin-catalog-filters">
    <label><span>{copy.source}</span><select data-source-filter><option value="">{copy.all}</option><option value="local_plugin">{copy.local}</option><option value="app">{copy.app}</option><option value="mcp_server">{copy.mcp}</option></select></label>
    <label><span>Runtime</span><select data-runtime-filter><option value="">{copy.allRuntimes}</option></select></label>
    <label><span>{copy.connection}</span><select data-state-filter><option value="">{copy.allStates}</option><option value="ready">ready</option><option value="available">available</option><option value="installation_required">installation_required</option><option value="installed_non_callable">installed_non_callable</option><option value="authentication_required">authentication_required</option><option value="disabled">disabled</option><option value="unhealthy">unhealthy</option></select></label>
  </div>
  <div class="plugin-alert" data-plugin-alert>{copy.loading}</div>
  <section class="plugin-adapter-panel" data-adapter-panel hidden><h2>{copy.adapters}</h2><div class="plugin-adapter-grid" data-adapter-grid></div></section>
  <div class="plugin-grid" data-plugin-grid></div>
</section>

<script is:inline define:vars={{ copy, locale }}>
  const root = document.querySelector("[data-plugin-manager]");
  const grid = root?.querySelector("[data-plugin-grid]");
  const alert = root?.querySelector("[data-plugin-alert]");
  const adapterPanel = root?.querySelector("[data-adapter-panel]");
  const adapterGrid = root?.querySelector("[data-adapter-grid]");
  const sourceFilter = root?.querySelector("[data-source-filter]");
  const runtimeFilter = root?.querySelector("[data-runtime-filter]");
  const stateFilter = root?.querySelector("[data-state-filter]");
  const setupPanel = root?.querySelector("[data-setup-panel]");
  const setupForm = root?.querySelector("[data-setup-form]");
  const setupRuntime = root?.querySelector("[data-setup-runtime]");
  const runtimeBlocker = root?.querySelector("[data-runtime-blocker]");
  const appSetup = root?.querySelector("[data-app-setup]");
  const mcpSetup = root?.querySelector("[data-mcp-setup]");
  const mailApp = root?.querySelector("[data-mail-app]");
  const appStatus = root?.querySelector("[data-app-status]");
  const envField = root?.querySelector("[data-env-field]");
  const setupErrors = root?.querySelector("[data-setup-errors]");
  const submitSetup = root?.querySelector("[data-submit-setup]");
  const apiBase = root?.dataset.apiBase;
  const params = new URLSearchParams(window.location.search);
  const requestedCapability = params.get("capability") || "";
  const requestedOperation = params.get("operation") || "";
  const requestedRuntime = params.get("runtime") || "";
  let catalog = [];
  let setupOptions = [];
  let activeSetupId = null;
  let editingConnectionId = null;
  let pollGeneration = 0;

  const element = (tag, className, text) => { const node = document.createElement(tag); if (className) node.className = className; if (text != null) node.textContent = text; return node; };
  const request = async (path, options) => { const response = await fetch(`${apiBase}${path}`, options); if (!response.ok) { let message = await response.text(); try { const value = JSON.parse(message); message = value?.detail?.message || value?.detail || message; const errors = value?.detail?.errors; if (Array.isArray(errors) && errors.length) message = `${message} ${errors.map((item) => item.message || item.code).join(" ")}`; } catch {} throw new Error(String(message)); } return response.json(); };
  const sourceLabel = (kind) => kind === "local_plugin" ? copy.local : kind === "app" ? copy.app : copy.mcp;
  const capabilityText = (item) => (item.capabilities || []).map((value) => `${value.capability} · ${(value.operations || []).join(", ")}`).join(" · ") || "—";
  const showNotice = (text, tone = "success") => { alert.hidden = false; alert.dataset.tone = tone; alert.textContent = text; };
  const selectedMode = () => setupForm?.querySelector('input[name="mode"]:checked')?.value || "runtime_app";
  const selectedSetupOption = () => setupOptions.find((item) => item.runtime_provider_id === setupRuntime?.value);
  const setFieldValue = (name, value) => { const field = setupForm?.elements.namedItem(name); if (field) field.value = value == null ? "" : String(value); };

  const renderAdapters = (adapters) => {
    adapterGrid.replaceChildren();
    for (const adapter of adapters) {
      const card = element("article", "plugin-adapter-card");
      const head = element("div", "plugin-adapter-heading"); head.append(element("strong", "", adapter.runtime_provider_id), element("code", "", adapter.integration_backend_id));
      card.append(head, element("span", `plugin-status status-${adapter.readiness}`, adapter.readiness));
      card.append(element("p", "", Object.entries(adapter.features || {}).map(([name, ready]) => `${ready ? "✓" : "○"} ${name}`).join(" · ")));
      const sourceEntries = Object.entries(adapter.source_status || {});
      if (sourceEntries.length) card.append(element("small", "plugin-source-status", `${copy.sourceStatus}: ${sourceEntries.map(([name, value]) => `${name}=${value?.status || "unknown"}`).join(" · ")}`));
      if ((adapter.blockers || []).length) card.append(element("small", "plugin-adapter-blocker", `${copy.blockers}: ${adapter.blockers.join(", ")}`));
      adapterGrid.append(card);
      if (![...runtimeFilter.options].some((option) => option.value === adapter.runtime_provider_id)) runtimeFilter.append(new Option(adapter.runtime_provider_id, adapter.runtime_provider_id));
    }
    adapterPanel.hidden = adapters.length === 0;
  };

  const renderSetupRuntime = () => {
    setupRuntime.replaceChildren();
    for (const option of setupOptions) {
      const label = `${option.runtime_provider_id}${option.enabled ? "" : " — unavailable"}`;
      const entry = new Option(label, option.runtime_provider_id, false, option.runtime_provider_id === (requestedRuntime || "codex"));
      entry.disabled = !option.enabled;
      setupRuntime.append(entry);
    }
    if (!setupRuntime.value) setupRuntime.value = setupOptions.find((item) => item.enabled)?.runtime_provider_id || "";
    renderSetupMode();
  };

  const mailApps = () => catalog.filter((item) => item.source_kind === "app" && item.runtime_provider_id === setupRuntime.value && ((item.capabilities || []).some((value) => value.capability === "mail.v1") || /mail|email|outlook|gmail/i.test(`${item.name || ""} ${item.native_id || ""}`)));
  const renderMailApps = () => {
    mailApp.replaceChildren();
    for (const item of mailApps()) mailApp.append(new Option(item.display?.[locale] || item.name || item.native_id, item.catalog_id));
    const adapter = selectedSetupOption();
    const appSource = (adapter?.source_status || {}).app;
    appStatus.textContent = appSource?.status === "error" ? copy.appSourceFailed : mailApp.options.length ? "" : copy.noMailApps;
    submitSetup.disabled = !mailApp.value;
  };

  const renderSetupMode = () => {
    const option = selectedSetupOption();
    const enabledModes = new Set((option?.modes || []).map((item) => item.id));
    for (const radio of setupForm.querySelectorAll('input[name="mode"]')) radio.disabled = !option?.enabled || !enabledModes.has(radio.value);
    runtimeBlocker.textContent = option?.enabled ? "" : `${copy.setupUnavailable}${(option?.blockers || []).length ? ` ${option.blockers.join(", ")}` : ""}`;
    let mode = selectedMode();
    const selectedRadio = setupForm.querySelector(`input[name="mode"][value="${mode}"]`);
    if (selectedRadio?.disabled) {
      const first = [...setupForm.querySelectorAll('input[name="mode"]')].find((radio) => !radio.disabled);
      if (first) { first.checked = true; mode = first.value; }
    }
    appSetup.hidden = mode !== "runtime_app";
    mcpSetup.hidden = mode !== "http_mcp";
    if (mode === "runtime_app") renderMailApps(); else submitSetup.disabled = !option?.enabled;
  };

  const resetSetup = () => {
    setupForm.reset(); activeSetupId = null; editingConnectionId = null; setupErrors.hidden = true; setupErrors.replaceChildren();
    for (const field of setupForm.querySelectorAll("input, select")) field.disabled = false;
    renderSetupRuntime();
  };
  const openSetup = () => { resetSetup(); setupPanel.hidden = false; setupPanel.scrollIntoView({ behavior: "smooth", block: "start" }); };
  const closeSetup = () => { pollGeneration += 1; setupPanel.hidden = true; resetSetup(); };

  const showSetupErrors = (errors) => {
    setupErrors.replaceChildren(element("strong", "", copy.fieldErrors));
    const list = element("ul"); for (const error of errors) list.append(element("li", "", `${error.field ? `${error.field}: ` : ""}${error.message || error.code || error}`));
    setupErrors.append(list); setupErrors.hidden = false;
  };

  const setupPayload = () => {
    const form = new FormData(setupForm);
    const integer = (name) => { const value = String(form.get(name) || "").trim(); return value ? Number(value) : undefined; };
    const tools = String(form.get("enabled_tools") || "").split(",").map((value) => value.trim()).filter(Boolean);
    const configuration = { url: String(form.get("url") || "").trim(), auth_mode: String(form.get("auth_mode") || "oauth") };
    if (configuration.auth_mode === "bearer_env") configuration.bearer_token_env_var = String(form.get("bearer_token_env_var") || "").trim();
    const startupTimeout = integer("startup_timeout_sec"); const toolTimeout = integer("tool_timeout_sec");
    if (startupTimeout != null) configuration.startup_timeout_sec = startupTimeout;
    if (toolTimeout != null) configuration.tool_timeout_sec = toolTimeout;
    if (tools.length) configuration.enabled_tools = tools;
    return { integration_backend_id: selectedSetupOption()?.integration_backend_id, mode: "http_mcp", connection_id: editingConnectionId, native_id: String(form.get("native_id") || "").trim(), display_name: String(form.get("display_name") || "").trim(), configuration };
  };

  const setupUpdatePayload = (payload) => ({ native_id: payload.native_id, display_name: payload.display_name, configuration: payload.configuration });

  const populateSetup = (setup) => {
    activeSetupId = setup.setup_id; editingConnectionId = setup.connection_id || null;
    setupRuntime.value = setup.provider_id; setupRuntime.disabled = true;
    const httpRadio = setupForm.querySelector('input[name="mode"][value="http_mcp"]'); httpRadio.checked = true;
    renderSetupMode(); setupRuntime.disabled = true;
    for (const radio of setupForm.querySelectorAll('input[name="mode"]')) radio.disabled = true;
    setFieldValue("native_id", setup.native_id); setFieldValue("display_name", setup.display_name);
    setFieldValue("url", setup.configuration?.url); setFieldValue("auth_mode", setup.configuration?.auth_mode || "oauth");
    setFieldValue("bearer_token_env_var", setup.configuration?.bearer_token_env_var); setFieldValue("startup_timeout_sec", setup.configuration?.startup_timeout_sec);
    setFieldValue("tool_timeout_sec", setup.configuration?.tool_timeout_sec); setFieldValue("enabled_tools", (setup.configuration?.enabled_tools || []).join(", "));
    setupForm.elements.namedItem("native_id").disabled = Boolean(setup.connection_id);
    envField.hidden = setup.configuration?.auth_mode !== "bearer_env";
  };

  const pollConnection = async (connectionId) => {
    const generation = ++pollGeneration;
    showNotice(copy.polling);
    for (let attempt = 0; attempt < 60 && generation === pollGeneration; attempt += 1) {
      await new Promise((resolve) => window.setTimeout(resolve, 2000));
      try {
        const value = await request(`/api/plugins/connections/${encodeURIComponent(connectionId)}/refresh`, { method: "POST" });
        if (["ready", "disabled"].includes(value.connection?.status)) { showNotice(copy.success); await load(true); return; }
        if (value.connection?.status === "installed_non_callable") { showNotice(copy.installedNonCallable); await load(true); return; }
      } catch (error) { if (attempt === 59) showNotice(error.message, "error"); }
    }
    if (generation === pollGeneration) showNotice(copy.pollTimeout, "error");
  };

  const beginAuthentication = async (connectionId) => {
    const value = await request(`/api/plugins/connections/${encodeURIComponent(connectionId)}/authenticate`, { method: "POST" });
    if (value.url) window.open(value.url, "_blank", "noopener,noreferrer");
    if (value.connection?.connection_id) void pollConnection(value.connection.connection_id);
  };

  const editConnection = async (item) => {
    openSetup();
    try {
      const value = await request("/api/plugins/setup-drafts", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ integration_backend_id: item.integration_backend_id, mode: "http_mcp", connection_id: item.connection.connection_id }) });
      populateSetup(value.setup);
    } catch (error) { showSetupErrors([{ message: error.message }]); }
  };

  const mailOperationsForTool = (item, tool) => {
    const serverIdentity = `${item.native_id || ""} ${item.name || ""}`.toLowerCase();
    const toolIdentity = `${tool.native_tool || ""} ${tool.title || ""}`.toLowerCase();
    if (!["mail", "email", "gmail", "outlook"].some((word) => serverIdentity.includes(word) || toolIdentity.includes(word))) return [];
    const operations = [];
    if (["search", "list", "query", "find"].some((word) => toolIdentity.includes(word))) operations.push("search");
    if (["read", "get", "fetch"].some((word) => toolIdentity.includes(word))) operations.push("read");
    if (["send", "reply", "forward"].some((word) => toolIdentity.includes(word))) operations.push("send");
    return operations;
  };

  const createBindingControl = (item, tool) => {
    const existingBindings = (item.bindings || []).filter((value) => value.capability === "mail.v1" && value.native_tool === tool.native_tool);
    const operations = [...new Set([...mailOperationsForTool(item, tool), ...existingBindings.map((value) => value.operation)])];
    const preferredBinding = existingBindings.find((value) => value.enabled) || existingBindings[0];
    const wrap = element("div", `plugin-tool-binding${existingBindings.length ? " is-bound" : ""}`);
    const summary = element("div");
    summary.append(element("strong", "", tool.title || tool.native_tool), element("code", "", tool.native_tool));
    if (existingBindings.length) {
      const stateText = existingBindings.map((value) => `${copy.bound}: mail.v1/${value.operation}${value.enabled ? "" : ` · ${copy.bindingDisabled}`}`).join(" · ");
      summary.append(element("small", `plugin-binding-state${existingBindings.some((value) => value.enabled) ? " is-active" : " is-disabled"}`, stateText));
    }
    const select = element("select");
    select.append(new Option(copy.chooseOperation, ""));
    for (const operation of operations) select.append(new Option(`mail.v1/${operation}`, operation));
    if (preferredBinding) select.value = preferredBinding.operation;
    const bind = element("button", "secondary-button", copy.bind);
    const syncBindState = () => { bind.disabled = !item.connection || !select.value; };
    select.addEventListener("change", syncBindState);
    syncBindState();
    bind.addEventListener("click", async () => {
      bind.disabled = true;
      try {
        if (!item.connection) throw new Error(copy.missingConnection);
        const operation = select.value;
        if (!operation) return;
        const existing = (item.bindings || []).find((value) => value.capability === "mail.v1" && value.operation === operation && value.native_tool === tool.native_tool);
        const enableBinding = operation !== "send" || Boolean(existing);
        if (operation === "send" && enableBinding && !window.confirm(copy.sendDisabled)) return;
        await request(`/api/plugins/connections/${encodeURIComponent(item.connection.connection_id)}/bindings/mail.v1/${operation}`, { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ native_server: item.native_id, native_tool: tool.native_tool, expected_schema_hash: tool.schema_hash, enabled: enableBinding, argument_mapping: existing?.snapshot?.argument_mapping || {} }) });
        showNotice(operation === "send" && !enableBinding ? copy.sendDisabled : copy.success); await load();
      } catch (error) { showNotice(error.message, "error"); } finally { syncBindState(); }
    });
    wrap.append(summary, select, bind); return wrap;
  };

  const render = () => {
    grid.replaceChildren();
    const visible = catalog.filter((item) => {
      const capabilities = item.capabilities || [];
      const requestedMatch = !requestedCapability || capabilities.some((entry) => entry.capability === requestedCapability && (!requestedOperation || (entry.operations || []).includes(requestedOperation)));
      return requestedMatch && (!sourceFilter.value || item.source_kind === sourceFilter.value) && (!runtimeFilter.value || item.runtime_provider_id === runtimeFilter.value) && (!stateFilter.value || item.connection_status === stateFilter.value);
    });
    if (!visible.length) grid.append(element("p", "plugin-empty", copy.noItems));
    for (const item of visible) {
      const card = element("article", "plugin-card"); const heading = element("header", "plugin-card-heading"); const titleWrap = element("div");
      titleWrap.append(element("h2", "", item.display?.[locale] || item.name || item.native_id), element("code", "", `${item.integration_backend_id} · ${item.native_id}`));
      heading.append(titleWrap, element("span", `plugin-status status-${item.connection_status}`, item.connection_status));
      const facts = element("dl", "plugin-facts"); facts.append(element("dt", "", copy.source), element("dd", "", `${sourceLabel(item.source_kind)}${item.runtime_provider_id ? ` · ${item.runtime_provider_id}` : ""}`), element("dt", "", copy.authentication), element("dd", "", item.auth_status || "—"), element("dt", "", copy.health), element("dd", "", item.health_status || "—"), element("dt", "", copy.workflowRefs), element("dd", "", String(item.workflow_reference_count || 0)));
      const capabilities = element("section", "plugin-card-section"); capabilities.append(element("h3", "", copy.capability), element("p", "", capabilityText(item)));
      if (item.connection_status === "installed_non_callable") capabilities.append(element("p", "plugin-inline-warning", copy.installedNonCallable));
      const detail = element("details", "plugin-card-details"); detail.append(element("summary", "", copy.details)); const detailBody = element("div", "plugin-card-detail-body"); detailBody.append(element("p", "", copy.configuredByRuntime));
      if ((item.compatibility?.blockers || []).length) detailBody.append(element("p", "plugin-adapter-blocker", `${copy.blockers}: ${item.compatibility.blockers.join(", ")}`));
      const callableTools = (item.tools || []).filter((tool) => !tool.display_only && (mailOperationsForTool(item, tool).length || (item.bindings || []).some((binding) => binding.capability === "mail.v1" && binding.native_tool === tool.native_tool)));
      if (callableTools.length) { detailBody.append(element("h3", "", copy.tools)); for (const tool of callableTools) detailBody.append(createBindingControl(item, tool)); } detail.append(detailBody);
      const actions = element("footer", "plugin-card-actions");
      if (item.source_kind === "local_plugin") {
        const health = element("button", "secondary-button", copy.healthCheck); const toggle = element("button", "secondary-button", item.enabled ? copy.disable : copy.enable);
        health.addEventListener("click", async () => { health.disabled = true; try { await request(`/api/plugins/${encodeURIComponent(item.native_id)}/health`, { method: "POST" }); await load(); } catch (error) { showNotice(error.message, "error"); } finally { health.disabled = false; } });
        toggle.addEventListener("click", async () => { toggle.disabled = true; try { await request(`/api/plugins/${encodeURIComponent(item.native_id)}/enabled`, { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ enabled: !item.enabled }) }); await load(); } catch (error) { showNotice(error.message, "error"); } finally { toggle.disabled = false; } }); actions.append(health, toggle);
      } else if (!item.connection) {
        const connect = element("button", "secondary-button", copy.connect); connect.disabled = item.compatibility?.supported === false;
        connect.addEventListener("click", async () => { connect.disabled = true; try { const value = await request(`/api/plugins/catalog/${encodeURIComponent(item.catalog_id)}/connect`, { method: "POST" }); if (value.url) window.open(value.url, "_blank", "noopener,noreferrer"); showNotice(copy.success); if (value.connection?.connection_id && value.outcome === "open_auth_url") void pollConnection(value.connection.connection_id); else await load(true); } catch (error) { showNotice(error.message, "error"); } finally { connect.disabled = false; } }); actions.append(connect);
      } else {
        const refresh = element("button", "secondary-button", copy.refreshState); const toggle = element("button", "secondary-button", item.enabled ? copy.disable : copy.enable);
        refresh.addEventListener("click", async () => { refresh.disabled = true; try { await request(`/api/plugins/connections/${encodeURIComponent(item.connection.connection_id)}/refresh`, { method: "POST" }); await load(); } catch (error) { showNotice(error.message, "error"); } finally { refresh.disabled = false; } });
        toggle.addEventListener("click", async () => { toggle.disabled = true; try { await request(`/api/plugins/connections/${encodeURIComponent(item.connection.connection_id)}/enabled`, { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ enabled: !item.enabled }) }); await load(); } catch (error) { showNotice(error.message, "error"); } finally { toggle.disabled = false; } }); actions.append(refresh, toggle);
        if (["required", "expired", "not_logged_in", "notLoggedIn"].includes(item.auth_status) || item.connection_status === "authentication_required") {
          const authenticate = element("button", "secondary-button", copy.reconnect); authenticate.addEventListener("click", async () => { authenticate.disabled = true; try { await beginAuthentication(item.connection.connection_id); } catch (error) { showNotice(error.message, "error"); } finally { authenticate.disabled = false; } }); actions.append(authenticate);
        }
        if (item.source_kind === "mcp_server" && item.connection.metadata?.configuration_origin === "platform_user_config") {
          const edit = element("button", "secondary-button", copy.editConfig); edit.addEventListener("click", () => void editConnection(item)); actions.append(edit);
        }
      }
      card.append(heading, capabilities, facts, detail, actions); grid.append(card);
    }
  };

  const load = async (force = false) => {
    try {
      const optionsPromise = request("/api/plugins/setup-options?capability=mail.v1").catch(() => ({ items: [] }));
      let catalogResult;
      if (force) catalogResult = await request("/api/plugins/catalog/refresh", { method: "POST" });
      else {
        const items = []; let offset = 0;
        do { const page = await request(`/api/plugins/catalog?offset=${offset}&limit=100`); items.push(...(page.items || [])); offset = page.next_offset == null ? -1 : Number(page.next_offset); } while (offset >= 0);
        catalogResult = { items };
      }
      const [adapterResult, setupResult] = await Promise.all([request("/api/plugins/runtime-adapters"), optionsPromise]);
      catalog = catalogResult.items || []; setupOptions = setupResult.items || [];
      const statusByRuntime = Object.fromEntries((adapterResult.items || []).map((item) => [item.runtime_provider_id, item.source_status || {}]));
      for (const option of setupOptions) option.source_status = statusByRuntime[option.runtime_provider_id] || {};
      renderAdapters(adapterResult.items || []); renderSetupRuntime(); alert.hidden = true; render();
    } catch (error) { showNotice(error?.message || copy.unavailable, "error"); }
  };

  setupRuntime?.addEventListener("change", renderSetupMode);
  for (const radio of setupForm?.querySelectorAll('input[name="mode"]') || []) radio.addEventListener("change", renderSetupMode);
  setupForm?.elements.namedItem("auth_mode")?.addEventListener("change", (event) => { envField.hidden = event.currentTarget.value !== "bearer_env"; });
  setupForm?.addEventListener("submit", async (event) => {
    event.preventDefault(); setupErrors.hidden = true; submitSetup.disabled = true; const oldText = submitSetup.textContent; submitSetup.textContent = copy.validating;
    try {
      if (selectedMode() === "runtime_app") {
        const item = catalog.find((value) => value.catalog_id === mailApp.value); if (!item) throw new Error(copy.noMailApps);
        const result = await request(`/api/plugins/catalog/${encodeURIComponent(item.catalog_id)}/connect`, { method: "POST" });
        if (result.url) window.open(result.url, "_blank", "noopener,noreferrer"); closeSetup(); showNotice(result.outcome === "open_install_url" ? copy.success : copy.polling);
        if (result.connection?.connection_id) void pollConnection(result.connection.connection_id); else window.setTimeout(() => void load(true), 2000);
      } else {
        const payload = setupPayload();
        let setup;
        if (activeSetupId) setup = (await request(`/api/plugins/setup-drafts/${encodeURIComponent(activeSetupId)}`, { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify(setupUpdatePayload(payload)) })).setup;
        else setup = (await request("/api/plugins/setup-drafts", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) })).setup;
        activeSetupId = setup.setup_id;
        const validation = await request(`/api/plugins/setup-drafts/${encodeURIComponent(activeSetupId)}/validate`, { method: "POST" });
        if (!validation.valid) { showSetupErrors(validation.errors || []); return; }
        const result = await request(`/api/plugins/setup-drafts/${encodeURIComponent(activeSetupId)}/commit`, { method: "POST" });
        if (result.url) window.open(result.url, "_blank", "noopener,noreferrer");
        const commitWarning = result.authentication_warning?.message || result.reload_warning?.message;
        closeSetup(); showNotice(commitWarning || (result.outcome === "open_auth_url" ? copy.polling : copy.success), commitWarning ? "error" : "success"); await load(true);
        if (result.connection?.connection_id && result.outcome === "open_auth_url") void pollConnection(result.connection.connection_id);
      }
    } catch (error) { showSetupErrors([{ message: error.message }]); }
    finally { submitSetup.disabled = false; submitSetup.textContent = oldText; }
  });

  for (const control of [sourceFilter, runtimeFilter, stateFilter]) control?.addEventListener("change", render);
  if (requestedRuntime) runtimeFilter.dataset.requestedValue = requestedRuntime;
  root?.querySelector("[data-add-mail]")?.addEventListener("click", openSetup);
  root?.querySelector("[data-close-setup]")?.addEventListener("click", closeSetup);
  root?.querySelector("[data-cancel-setup]")?.addEventListener("click", closeSetup);
  root?.querySelector("[data-rescan]")?.addEventListener("click", async (event) => { event.currentTarget.disabled = true; try { await load(true); } finally { event.currentTarget.disabled = false; } });
  load().then(() => { if (runtimeFilter.dataset.requestedValue) { runtimeFilter.value = runtimeFilter.dataset.requestedValue; render(); } });
</script>
