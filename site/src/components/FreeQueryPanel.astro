---
import { ArrowRight, ChevronDown, MessageSquareText, ShieldCheck } from "@lucide/astro";
import type { Locale } from "../lib/types";
import { runPath } from "../lib/urls";

interface Props { locale: Locale }
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const apiBase = import.meta.env.PUBLIC_SAPBA_API_URL || "http://127.0.0.1:8765";
const destination = runPath(base, locale);
const questionId = `free-query-question-${locale}`;
const questionHelpId = `free-query-question-help-${locale}`;
const secureId = `free-query-receipt-reference-${locale}`;
const secureHelpId = `free-query-secure-help-${locale}`;
const copy = locale === "zh" ? {
  eyebrow: "自由查询",
  title: "直接查询 SAP 业务数据",
  body: "说明你想核对的业务问题，Agent Runtime 会使用已注册的只读能力准备查询并整理结果。",
  questionLabel: "你希望查询什么？",
  questionHelp: "请尽量提供业务对象编号、日期范围和需要核对的状态或关系。",
  placeholder: "例如：查询供应商 1000123 上个月到期但尚未付款的采购订单",
  submit: "开始只读查询",
  safety: "仅允许 SAP Provider GET 和已批准的只读 Skill",
  error: "无法连接本地运行服务，请先启动 127.0.0.1:8765。",
  gapContext: "正在为工作流补齐缺口 Agent。完成查询后，请点击“保存为 Agent 草稿”。",
  secureSummary: "安全参数（可选）",
  secureLabel: "银行来款参考号",
  secureHelp: "请勿把银行参考号写入问题正文；需要时在这里填写，平台会加密并在运行结束后销毁原值。",
} : {
  eyebrow: "Free query",
  title: "Query SAP business data directly",
  body: "Describe the business question you want to check. The Agent Runtime will prepare a query from registered read-only capabilities and organize the result.",
  questionLabel: "What do you want to query?",
  questionHelp: "Include business object IDs, date ranges, and the statuses or relationships you want to verify when possible.",
  placeholder: "Example: find purchase orders for supplier 1000123 that were due last month but remain unpaid",
  submit: "Start read-only query",
  safety: "Only SAP Provider GET and approved read-only Skills are allowed",
  error: "Cannot reach the local runtime. Start 127.0.0.1:8765 first.",
  gapContext: "This query is closing a workflow Agent gap. When it finishes, select Save as Agent draft.",
  secureSummary: "Secure parameters (optional)",
  secureLabel: "Bank receipt reference",
  secureHelp: "Do not put a bank reference in the question text. Enter it here when needed; the platform encrypts it and destroys the original value after the run.",
};
---

<section class="free-query-panel" data-free-query data-api-base={apiBase} data-run-path={destination} data-locale={locale}>
  <header class="free-query-heading">
    <p class="runtime-eyebrow"><MessageSquareText size={16} aria-hidden="true" />{copy.eyebrow}</p>
    <h2>{copy.title}</h2>
    <p>{copy.body}</p>
    <p class="runtime-safety"><ShieldCheck size={16} aria-hidden="true" />{copy.safety}</p>
  </header>
  <form class="free-query-form">
    <p class="free-query-gap-context" data-gap-context hidden>{copy.gapContext}</p>
    <label class="free-query-question" for={questionId}>
      <strong>{copy.questionLabel}</strong>
      <small id={questionHelpId}>{copy.questionHelp}</small>
    </label>
    <textarea id={questionId} name="query" required rows="6" placeholder={copy.placeholder} aria-describedby={questionHelpId}></textarea>
    <details class="free-query-secure">
      <summary><span>{copy.secureSummary}</span><ChevronDown size={17} aria-hidden="true" /></summary>
      <div>
        <label for={secureId}>{copy.secureLabel}</label>
        <small id={secureHelpId}>{copy.secureHelp}</small>
        <input id={secureId} name="receipt_reference" type="password" autocomplete="off" maxlength="35" aria-describedby={secureHelpId} />
      </div>
    </details>
    <div class="runtime-form-actions">
      <span class="runtime-form-error" role="alert" hidden>{copy.error}</span>
      <button type="submit">{copy.submit}<ArrowRight size={17} aria-hidden="true" /></button>
    </div>
  </form>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-free-query]").forEach((panel) => {
    const form = panel.querySelector<HTMLFormElement>("form");
    const error = panel.querySelector<HTMLElement>(".runtime-form-error");
    const textarea = form?.querySelector<HTMLTextAreaElement>("textarea[name=query]");
    const context = panel.querySelector<HTMLElement>("[data-gap-context]");
    const params = new URLSearchParams(window.location.search);
    const workflowDraft = params.get("workflowDraft");
    const gap = params.get("gap");
    if (workflowDraft && gap) {
      void fetch(`${panel.dataset.apiBase}/api/authoring/workflows/${encodeURIComponent(workflowDraft)}/gaps/${encodeURIComponent(gap)}?locale=${encodeURIComponent(panel.dataset.locale || "zh")}`)
        .then(async (response) => {
          if (!response.ok) throw new Error(await response.text());
          const payload = await response.json();
          if (textarea) textarea.value = String(payload.prompt || "");
          if (context) context.hidden = false;
        })
        .catch(() => { if (error) error.hidden = false; });
    }
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (submit) submit.disabled = true;
      if (error) error.hidden = true;
      const query = String(new FormData(form).get("query") || "").trim();
      const receiptReference = String(new FormData(form).get("receipt_reference") || "").trim();
      try {
        const response = await fetch(`${panel.dataset.apiBase}/api/runs`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            mode: "free_query",
            query,
            ...(receiptReference ? { sensitiveInputs: { receipt_reference: receiptReference } } : {}),
          }),
        });
        if (!response.ok) throw new Error(await response.text());
        const payload = await response.json();
        const destinationParams = new URLSearchParams({ run: String(payload.run_id) });
        if (payload.session_id) destinationParams.set("session", String(payload.session_id));
        if (workflowDraft && gap) {
          destinationParams.set("workflowDraft", workflowDraft);
          destinationParams.set("gap", gap);
        }
        window.location.href = `${panel.dataset.runPath}?${destinationParams.toString()}`;
      } catch {
        if (error) error.hidden = false;
        if (submit) submit.disabled = false;
      }
    });
  });
</script>
