    root.querySelector("[data-session-new]").hidden = !["reviewing", "satisfied"].includes(session.status);
    root.querySelector("[data-session-reopen]").hidden = session.status !== "satisfied";
    root.querySelector("[data-session-draft]").hidden = session.status !== "satisfied";
    const feedbackForm = root.querySelector("[data-session-feedback]");
    if (session.status === "waiting_input" && session.pending_feedback) {
      feedbackForm.hidden = false;
      feedbackForm.dataset.mode = "clarification";
      root.querySelector("[data-session-feedback-question]").textContent = session.pending_feedback?.decision?.clarification_question || labels.freeQuerySession.waiting;
    } else if (feedbackForm.dataset.mode === "clarification") {
      feedbackForm.hidden = true;
      feedbackForm.dataset.mode = "";
    }
  };

  const loadSession = async () => {
    if (!sessionId || !apiBase) return;
    const response = await fetch(`${apiBase}/api/free-query-sessions/${encodeURIComponent(sessionId)}`);
    if (!response.ok) throw new Error(await response.text());
    const session = await response.json();
    renderFreeQuerySession(session);
    if (session.active_feedback_request?.feedback_request_id) {
      connectFeedback(String(session.active_feedback_request.feedback_request_id));
    } else if (feedbackSource) {
      feedbackSource.close(); feedbackSource = undefined; activeFeedbackRequestId = "";
    }
    return session;
  };

  const loadFeedbackRequest = async (requestId) => {
    if (!sessionId || !requestId) return null;
    const response = await fetch(`${apiBase}/api/free-query-sessions/${encodeURIComponent(sessionId)}/feedback-requests/${encodeURIComponent(requestId)}`);
    if (!response.ok) throw new Error(await response.text());
    const request = await response.json();
    renderFeedbackProgress(request);
    if (request.run_id && request.status === "iteration_created") {
      runId = String(request.run_id);
      const params = new URLSearchParams(window.location.search);
      params.set("session", String(sessionId)); params.set("run", runId);
      history.replaceState(null, "", `${window.location.pathname}?${params.toString()}`);
      await loadSession(); await loadRun(); connect();
    } else if (["new_session_required", "failed", "cancelled"].includes(String(request.status))) {
      await loadSession();
    }
    return request;
  };

  const connectFeedback = (requestId) => {
    if (!sessionId || !requestId || !window.EventSource) return;
    if (feedbackSource && activeFeedbackRequestId === requestId && feedbackSource.readyState !== EventSource.CLOSED) return;
    if (feedbackSource) feedbackSource.close();
    activeFeedbackRequestId = requestId;
    feedbackSource = new EventSource(`${apiBase}/api/free-query-sessions/${encodeURIComponent(sessionId)}/feedback-requests/${encodeURIComponent(requestId)}/events`);
    const names = ["feedback_received", "feedback_review_started", "feedback_decision_created", "feedback_waiting_input", "feedback_iteration_queued", "feedback_review_failed", "feedback_cancelled"];
    names.forEach((name) => feedbackSource.addEventListener(name, async () => {
      try {
        const request = await loadFeedbackRequest(requestId);
        if (request && ["iteration_created", "new_session_required", "failed", "cancelled"].includes(String(request.status))) {
          feedbackSource?.close(); feedbackSource = undefined;
        }
      } catch (error) { showAlert(String(error?.message || error)); }
    }));
    feedbackSource.onerror = () => {
      if (feedbackSource?.readyState === EventSource.CLOSED) feedbackSource = undefined;
    };
  };

  const renderRun = (run) => {
    const incomingSequence = Number(run.progress?.event_sequence || 0);
    const currentSequence = Number(currentRun?.progress?.event_sequence || 0);
    if (currentRun && incomingSequence < currentSequence) run.progress = currentRun.progress;
    currentRun = run;
    if (run.free_query_session?.session_id && !sessionId) {
      sessionId = String(run.free_query_session.session_id);
      const params = new URLSearchParams(window.location.search);
      params.set("session", sessionId);
      history.replaceState(null, "", `${window.location.pathname}?${params.toString()}`);
      loadSession().catch(() => {});
    }
    const modeLabel = run.mode === "free_query" && run.agent_id ? labels.mode.guided : (labels.mode[run.mode] || run.mode);
    const subject = run.agent_id || run.workflow_id;
    const runtimeIdentity = run.mode === "free_query" && run.runtime?.provider_id
      ? ` · ${labels.runtimeLabel}: ${run.runtime.provider_id}${run.runtime.version ? ` ${run.runtime.version}` : ""}`
      : "";
    root.querySelector("[data-run-identity]").textContent = `${modeLabel}${subject ? ` · ${subject}` : ""}${runtimeIdentity} · ${run.run_id}`;
    const progressState = run.progress?.state || (terminal.has(run.status) ? run.status : "active");
    root.querySelector("[data-run-status]").textContent = labels.progressState[progressState] || labels.phaseLabels[progressIndex(run)] || labels.connecting;
    root.querySelector("[data-plan]").textContent = format(run.plan || run.result?.plan);
    root.querySelector("[data-rules]").textContent = format(run.result?.rule_results);
    root.querySelector("[data-tool-calls]").textContent = format(run.result?.tool_calls);
    root.querySelector("[data-evidence]").textContent = format(run.result?.evidence);
    renderProgress(run); renderLimits(run); renderBusinessReport(run); renderRestrictedArtifact(run); renderPlanTable(run); renderEvidenceTable(run); renderCompleteness(run);
    const inputForm = root.querySelector("[data-input-form]");
    const disclosure = root.querySelector("[data-input-disclosure]");
    const waitingForInput = run.status === "waiting_input";
    const secureReference = waitingForInput && run.error?.detail?.input_kind === "secure_business_reference" && run.error?.detail?.field === "receipt_reference";
    const steerable = run.mode === "free_query" && Boolean(run.thread_id) && ["planning", "validating", "running"].includes(run.status);
    const displayMode = waitingForInput ? "clarification" : (steerable ? "steer" : "");
    disclosure.hidden = !displayMode;
    disclosure.dataset.mode = displayMode;
    if (displayMode !== inputDisplayMode) {
      disclosure.open = waitingForInput;
      root.querySelector("[data-input-feedback]").hidden = true;
      inputDisplayMode = displayMode;
    }
    const clarificationQuestion = localized(run.error?.message) || labels.input;
    root.querySelector("[data-input-summary]").textContent = waitingForInput ? labels.input : labels.steerTitle;
    root.querySelector("[data-input-question]").textContent = waitingForInput ? clarificationQuestion : labels.steerTitle;
    root.querySelector("[data-input-help]").textContent = waitingForInput ? labels.inputHelp : labels.steerHelp;
    root.querySelector("[data-input-submit]").textContent = waitingForInput ? labels.clarificationSend : labels.steerSend;
    const ordinaryInput = inputForm.querySelector("textarea");
    const secureInput = inputForm.querySelector('input[name="receipt_reference"]');
    ordinaryInput.hidden = secureReference; ordinaryInput.required = !secureReference;
    secureInput.hidden = !secureReference; secureInput.required = secureReference;
    ordinaryInput.placeholder = waitingForInput ? labels.clarificationPlaceholder : (steerable ? labels.steerPlaceholder : labels.inputPlaceholder);
    root.querySelector("[data-draft]").hidden = Boolean(sessionId) || run.mode !== "free_query" || !terminal.has(run.status) || !run.plan;
    root.querySelector("[data-start-session]").hidden = Boolean(sessionId) || run.mode !== "free_query" || !["completed", "inconclusive"].includes(run.status);
    const downloads = root.querySelector("[data-downloads]");
    downloads.querySelectorAll("a").forEach((node) => node.remove());
    if (run.mode === "workflow" && run.result?.workflow_presentation) {
      ["workflow-report.md", "workflow-orders.csv", "workflow-ap-scopes.csv"].forEach((name) => {
        const link = document.createElement("a");
        link.href = `${apiBase}/api/runs/${encodeURIComponent(run.run_id)}/${encodeURIComponent(name)}`;
        link.textContent = labels.artifact[name] || name; link.download = name; downloads.append(link);
      });
    }
    (run.result?.artifacts || []).forEach((artifact) => {
      if (run.mode === "workflow" && ["report.md", "business-stages.csv", "workflow-report.md", "workflow-orders.csv", "workflow-ap-scopes.csv"].includes(artifact.name)) return;
      const link = document.createElement("a");
      link.href = `${apiBase}/api/runs/${encodeURIComponent(run.run_id)}/artifacts/${encodeURIComponent(artifact.name)}`;
      link.textContent = labels.artifact[artifact.name] || artifact.name; link.download = artifact.name; downloads.append(link);
    });
    downloads.hidden = downloads.querySelectorAll("a").length === 0;
    root.querySelector("[data-cancel]").disabled = terminal.has(run.status);
  };

  const loadRun = async () => {
    if (!runId && sessionId) {
      const session = await loadSession();
      const latest = (session?.iterations || []).find((item) => Number(item.iteration) === Number(session.current_iteration));
      if (latest) runId = String(latest.run_id);
    }
    if (!runId || !apiBase) return;
    const response = await fetch(`${apiBase}/api/runs/${encodeURIComponent(runId)}`);
    if (!response.ok) throw new Error(await response.text());
    const run = await response.json(); renderRun(run); return run;
  };
  const eventNames = [
    "run_queued", "run_started", "progress_changed", "planning_started", "plan_created", "validation_started", "schema_received",
    "plan_grounded", "plan_canonicalized", "plan_repaired", "waiting_input", "input_received", "step_started",
    "workflow_started", "node_started", "node_input_resolved", "node_completed", "node_inconclusive", "node_skipped", "node_skipped_empty_input",
    "mapping_failed", "candidate_discovery_completed", "codex_repair_applied",
    "tool_started", "tool_completed", "evidence_received", "rule_completed", "summary_started", "run_completed",
    "run_inconclusive", "run_failed", "cancellation_requested", "run_cancelled",
    "harness_started", "harness_resumed", "codex_turn_started", "codex_turn_failed", "assistant_message", "web_search_started", "web_search_completed",
    "tool_discovery_started", "tool_discovery_completed", "tool_admission_passed", "tool_admission_rejected",
    "external_tool_started", "external_tool_completed", "external_tool_failed", "tool_requested", "tool_failed",
    "agent_runtime_tool_started", "agent_runtime_tool_completed", "harness_time_extended", "harness_finalization_started",
    "evidence_gap_assessed", "codex_turn_completed", "harness_completed", "harness_interrupted",
    "feedback_reinterpretation_started",
  ];
  const connect = () => {
    source?.close();
    if (!runId || !apiBase) { showAlert(labels.noRun); return; }
    source = new EventSource(`${apiBase}/api/runs/${encodeURIComponent(runId)}/events`);
    eventNames.forEach((name) => source.addEventListener(name, (event) => {
      if (name !== "progress_changed") {
        try { appendEvent(name, JSON.parse(event.data)); } catch { appendEvent(name, {}); }
      }
      loadRun().catch(() => showAlert(labels.unavailable));
      if (sessionId) loadSession().catch(() => {});
      if (["run_completed", "run_inconclusive", "run_failed", "run_cancelled"].includes(name)) source.close();
    }));
    source.onerror = () => loadRun().catch(() => showAlert(labels.unavailable));
  };

  root?.querySelector("[data-reconnect]")?.addEventListener("click", connect);
  root?.querySelector("[data-restricted-reveal]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget; const panel = root.querySelector("[data-restricted-artifact]"); const status = panel.querySelector("[data-restricted-status]");
    button.disabled = true; status.textContent = "";
    try {
      const token = await revealToken("rows");
      const response = await fetch(`${apiBase}/api/runs/${encodeURIComponent(runId)}/structured-artifacts/${encodeURIComponent(panel.dataset.artifactId)}/rows?offset=0&limit=200`, { headers: { "X-SAPBA-Reveal-Token": token } });
      if (!response.ok) throw new Error(await response.text());
      const payload = await response.json(); const rows = Array.isArray(payload.rows) ? payload.rows : []; const wrap = panel.querySelector("[data-restricted-table]"); wrap.replaceChildren();
      if (!rows.length) { const empty = document.createElement("p"); empty.textContent = labels.restricted.empty; wrap.append(empty); }
      else {
        const columns = [...new Set(rows.flatMap((row) => Object.keys(row || {})))]; const table = document.createElement("table"); table.className = "run-business-table";
        const head = document.createElement("thead"); const header = document.createElement("tr"); columns.forEach((name) => { const cell = document.createElement("th"); cell.textContent = friendlyId(name); header.append(cell); }); head.append(header);
        const body = document.createElement("tbody"); rows.forEach((row) => { const tr = document.createElement("tr"); columns.forEach((name) => { const td = document.createElement("td"); td.textContent = row?.[name] == null ? labels.empty : String(row[name]); tr.append(td); }); body.append(tr); }); table.append(head, body); wrap.append(table);
      }
      wrap.hidden = false;
    } catch (_) { status.textContent = labels.restricted.error; }
    finally { button.disabled = false; }
  });
  root?.querySelector("[data-restricted-download]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget; const panel = root.querySelector("[data-restricted-artifact]"); const status = panel.querySelector("[data-restricted-status]"); button.disabled = true; status.textContent = "";
    try {
      const token = await revealToken("download");
      const response = await fetch(`${apiBase}/api/runs/${encodeURIComponent(runId)}/structured-artifacts/${encodeURIComponent(panel.dataset.artifactId)}/download`, { headers: { "X-SAPBA-Reveal-Token": token } });
      if (!response.ok) throw new Error(await response.text());
      const blob = await response.blob(); const url = URL.createObjectURL(blob); const link = document.createElement("a"); link.href = url; link.download = `${panel.dataset.artifactId}.csv`; link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000);
    } catch (_) { status.textContent = labels.restricted.error; }
    finally { button.disabled = false; }
  });
  root?.querySelector("[data-restricted-delete]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget; const panel = root.querySelector("[data-restricted-artifact]"); const status = panel.querySelector("[data-restricted-status]");
    if (!window.confirm(labels.restricted.delete)) return;
    button.disabled = true;
    try {
      const csrf = await csrfToken();
      const response = await fetch(`${apiBase}/api/runs/${encodeURIComponent(runId)}/structured-artifacts/${encodeURIComponent(panel.dataset.artifactId)}`, { method: "DELETE", headers: { "Content-Type": "application/json", "X-SAPBA-CSRF": csrf }, body: JSON.stringify({ reason: "user_deleted" }) });
      if (!response.ok) throw new Error(await response.text());
      status.textContent = labels.restricted.deleted; panel.querySelector("[data-restricted-table]").hidden = true; panel.querySelectorAll("button").forEach((item) => { item.disabled = true; });
    } catch (_) { status.textContent = labels.restricted.error; button.disabled = false; }
  });
  root?.querySelector("[data-cancel]")?.addEventListener("click", async () => {
    await fetch(`${apiBase}/api/runs/${encodeURIComponent(runId)}/cancel`, { method: "POST" }); await loadRun();
  });
  root?.querySelector("[data-input-form]")?.addEventListener("submit", async (event) => {
    event.preventDefault(); const form = event.currentTarget; const formData = new FormData(form); const input = String(formData.get("input") || "").trim(); const receiptReference = String(formData.get("receipt_reference") || "").trim();
    const button = form.querySelector("button[type=submit]"); if (button) button.disabled = true;
    const feedback = root.querySelector("[data-input-feedback]"); feedback.hidden = true;
    try {
      const body = receiptReference ? { sensitiveInputs: { receipt_reference: receiptReference } } : { input };
      const response = await fetch(`${apiBase}/api/runs/${encodeURIComponent(runId)}/input`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
      if (!response.ok) throw new Error(await response.text());
      const payload = await response.json();
      form.reset(); feedback.textContent = payload.mode === "steer" ? labels.steerReceived : labels.clarificationReceived;
      feedback.dataset.state = "success"; feedback.hidden = false; await loadRun(); connect();
    } catch (error) {
      feedback.textContent = labels.inputFailed + (error?.message ? " " + error.message : "");
      feedback.dataset.state = "error"; feedback.hidden = false;
    } finally {
      if (button) button.disabled = false;
    }
  });
  root?.querySelector("[data-draft]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget; button.disabled = true;
    const body = { correction: "" };
    if (workflowDraft && gap) { body.workflowDraftId = workflowDraft; body.gapId = gap; }
    const response = await fetch(`${apiBase}/api/runs/${encodeURIComponent(runId)}/create-agent-draft`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    const payload = await response.json();
    button.textContent = response.ok ? `${payload.draft_id} · ${payload.status}` : String(payload.detail?.message || payload.detail || "Draft failed");
    if (response.ok && workflowDraft && gap) {
      const returnLink = root.querySelector("[data-gap-return]");
      returnLink.href = `${root.dataset.workflowsPath}?draft=${encodeURIComponent(workflowDraft)}`;
      returnLink.hidden = false;
    } else if (!response.ok) button.disabled = false;
  });
  root?.querySelector("[data-start-session]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget; button.disabled = true;
    try {
      const response = await fetch(`${apiBase}/api/free-query-sessions`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ sourceRunId: runId }),
      });
      const payload = await response.json();
      if (!response.ok) throw new Error(String(payload.detail?.message || payload.detail || "Session creation failed"));
      sessionId = String(payload.session_id);
      const params = new URLSearchParams(window.location.search);
      params.set("session", sessionId); params.set("run", runId);
      history.replaceState(null, "", `${window.location.pathname}?${params.toString()}`);
      renderFreeQuerySession(payload); renderRun(currentRun);
    } catch (error) { showAlert(String(error?.message || error)); button.disabled = false; }
  });

  root?.querySelector("[data-session-correct]")?.addEventListener("click", () => {
    const form = root.querySelector("[data-session-feedback]");
    form.hidden = false; form.dataset.mode = "feedback";
    root.querySelector("[data-session-feedback-question]").textContent = labels.freeQuerySession.feedbackPrompt;
    form.querySelector("textarea")?.focus();
  });
  root?.querySelectorAll("[data-feedback-type]").forEach((button) => button.addEventListener("click", () => {
    selectedFeedbackType = String(button.dataset.feedbackType || "");
    root.querySelectorAll("[data-feedback-type]").forEach((item) => item.classList.toggle("is-selected", item === button));
  }));
  root?.querySelector("[data-session-feedback]")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const feedback = String(new FormData(form).get("feedback") || "").trim();
    const status = root.querySelector("[data-session-feedback-status]");
    const button = form.querySelector("button[type=submit]");
    if (!feedback || !currentSession) return;
    if (button) button.disabled = true;
    status.hidden = true;
    try {
      const clarification = form.dataset.mode === "clarification";
      const endpoint = clarification ? "feedback-input" : "feedback";
      const body = clarification
        ? { baseIteration: currentSession.current_iteration, input: feedback }
        : { baseIteration: currentSession.current_iteration, feedback, locale, feedbackTypeHint: selectedFeedbackType || null };
      const response = await fetch(`${apiBase}/api/free-query-sessions/${encodeURIComponent(sessionId)}/${endpoint}`, {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body),
      });
      const payload = await response.json();
      if (!response.ok) throw new Error(String(payload.detail?.message || payload.detail || "Feedback failed"));
      status.textContent = labels.freeQuerySession.feedbackSteps[0]; status.dataset.state = "success"; status.hidden = false;
      form.reset(); selectedFeedbackType = ""; form.hidden = true;
      root.querySelectorAll("[data-feedback-type]").forEach((item) => item.classList.remove("is-selected"));
      renderFeedbackProgress(payload);
      connectFeedback(String(payload.feedback_request_id || ""));
      await loadSession();
    } catch (error) {
      status.textContent = String(error?.message || error); status.dataset.state = "error"; status.hidden = false;
    } finally { if (button) button.disabled = false; }
  });
  root?.querySelector("[data-feedback-cancel]")?.addEventListener("click", async (event) => {
    if (!sessionId || !activeFeedbackRequestId) return;
    const button = event.currentTarget; button.disabled = true;
    try {
      const response = await fetch(`${apiBase}/api/free-query-sessions/${encodeURIComponent(sessionId)}/feedback-requests/${encodeURIComponent(activeFeedbackRequestId)}/cancel`, {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ reason: "user_cancelled" }),
      });
      if (!response.ok) throw new Error(await response.text());
      renderFeedbackProgress(await response.json());
      feedbackSource?.close(); feedbackSource = undefined;
      await loadSession();
    } catch (error) { showAlert(String(error?.message || error)); }
    finally { button.disabled = false; }
  });
  root?.querySelector("[data-session-accept]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget; button.disabled = true;
    try {
      const latest = (currentSession?.iterations || []).find((item) => Number(item.iteration) === Number(currentSession.current_iteration));
      const response = await fetch(`${apiBase}/api/free-query-sessions/${encodeURIComponent(sessionId)}/accept`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ iteration: currentSession.current_iteration, expectedResultDigest: latest?.result_digest }),
      });
      if (!response.ok) throw new Error(await response.text());
      renderFreeQuerySession(await response.json());
    } catch (error) { showAlert(String(error?.message || error)); }
    finally { button.disabled = false; }
  });
  root?.querySelector("[data-session-reopen]")?.addEventListener("click", async () => {
    const response = await fetch(`${apiBase}/api/free-query-sessions/${encodeURIComponent(sessionId)}/reopen`, { method: "POST" });
    if (response.ok) renderFreeQuerySession(await response.json()); else showAlert(await response.text());
  });
  root?.querySelector("[data-session-draft]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget; button.disabled = true;
    const response = await fetch(`${apiBase}/api/free-query-sessions/${encodeURIComponent(sessionId)}/agent-draft`, { method: "POST" });
    const payload = await response.json();
    button.textContent = response.ok ? `${labels.freeQuerySession.draftCreated} · ${payload.draft_id}` : String(payload.detail || "Draft failed");
    if (response.ok) await loadSession(); else button.disabled = false;
  });
  root?.querySelector("[data-session-new]")?.addEventListener("click", () => {
    window.location.href = window.location.pathname.replace(/\/run\/?$/, "/ask/");
  });

  if (runId || sessionId) {
    Promise.all([loadRun(), sessionId ? loadSession() : Promise.resolve()]).then(connect).catch(() => showAlert(labels.unavailable));
  } else showAlert(labels.noRun);
</script>
