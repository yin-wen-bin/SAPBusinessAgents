---

<section class="run-console" data-run-console data-api-base={apiBase} data-workflows-path={workflowDestination}>
  <header class="run-console-header">
    <div>
      <p class="runtime-eyebrow">SAPBusinessAgents</p>
      <h1>{labels.title}</h1>
      <p class="run-identity" data-run-identity></p>
    </div>
    <span class="run-status" data-run-status aria-live="polite">{labels.connecting}</span>
  </header>

  <div class="run-alert" data-run-alert hidden>{labels.noRun}</div>

  <div class="run-actions">
    <button type="button" class="secondary-button" data-cancel><Ban size={16} aria-hidden="true" />{labels.cancel}</button>
    <button type="button" class="secondary-button" data-reconnect><RefreshCw size={16} aria-hidden="true" />{labels.reconnect}</button>
    <button type="button" data-draft hidden><FilePlus size={16} aria-hidden="true" />{labels.draft}</button>
    <a class="secondary-button" data-gap-return hidden>{labels.returnWorkflow}</a>
    <span class="run-downloads" data-downloads hidden><Download size={16} aria-hidden="true" /><span>{labels.downloads}</span></span>
  </div>

  <details class="run-input-disclosure" data-input-disclosure hidden>
    <summary data-input-summary>{labels.steerTitle}</summary>
    <form class="run-input-form" data-input-form>
      <label>
        <span class="run-input-question" data-input-question aria-live="polite">{labels.input}</span>
        <small data-input-help>{labels.inputHelp}</small>
        <textarea name="input" required rows="3" placeholder={labels.inputPlaceholder}></textarea>
      </label>
      <p class="run-input-feedback" data-input-feedback aria-live="polite" hidden></p>
      <button type="submit"><Send size={16} aria-hidden="true" /><span data-input-submit>{labels.send}</span></button>
    </form>
  </details>

  <section class="run-progress-card" aria-labelledby="run-progress-title">
    <div class="run-progress-summary">
      <span class="run-progress-indicator" data-progress-indicator aria-hidden="true"></span>
      <div>
        <h2 id="run-progress-title">{labels.progress}</h2>
        <p data-progress-message>{labels.connecting}</p>
        <small>{labels.progressHint}</small>
        <small class="run-limit-summary" data-limit-summary hidden></small>
      </div>
    </div>
    <div class="run-progress-track" aria-hidden="true"><span data-progress-bar></span></div>
    <ol class="run-progress-steps">
      {labels.phaseLabels.map((phase, index) => <li data-progress-step={index}><span>{index + 1}</span><b>{phase}</b></li>)}
    </ol>
  </section>

  <section class="business-result-card" data-business-result hidden aria-labelledby="business-result-title">
    <div class="business-result-heading">
      <div>
        <p class="runtime-eyebrow">{labels.conclusion}</p>
        <h2 id="business-result-title" data-business-headline></h2>
      </div>
      <span class="business-result-state" data-business-state></span>
    </div>
    <p class="business-result-overview" data-business-overview></p>
    <div class="presentation-blocks" data-presentation-blocks hidden></div>
    <div class="run-table-wrap" data-business-stages-wrap hidden>
      <h3>{labels.stages}</h3>
      <table class="run-business-table">
        <thead><tr><th>{labels.table.stage}</th><th>{labels.table.state}</th><th>{labels.table.detail}</th></tr></thead>
        <tbody data-business-stages></tbody>
      </table>
    </div>
    <div class="run-table-wrap" data-business-metrics-wrap hidden>
      <h3>{labels.metrics}</h3>
      <table class="run-business-table">
        <thead><tr><th>{labels.table.metric}</th><th>{labels.table.value}</th></tr></thead>
        <tbody data-business-metrics></tbody>
      </table>
    </div>
    <div class="business-next-actions" data-business-findings-wrap hidden>
      <h3>{labels.findings}</h3>
      <ul data-business-findings></ul>
    </div>
    <div class="business-next-actions" data-missing-evidence-wrap hidden>
      <h3>{labels.missingEvidence}</h3>
      <ul data-missing-evidence></ul>
    </div>
    <div class="business-next-actions" data-next-actions-wrap hidden>
      <h3>{labels.nextActions}</h3>
      <ol data-next-actions></ol>
    </div>
  </section>

  <div class="run-grid run-business-grid">
    <section class="run-panel run-timeline-panel">
      <h2>{labels.timeline}</h2>
      <ol class="run-timeline" data-timeline aria-live="polite"></ol>
    </section>
    <section class="run-panel">
      <h2>{labels.completeness}</h2>
      <div class="completeness-card" data-completeness>—</div>
    </section>
    <section class="run-panel run-wide-panel">
      <h2>{labels.scope}</h2>
      <div class="run-table-wrap">
        <table class="run-business-table">
          <thead><tr><th>{labels.table.stage}</th><th>{labels.table.object}</th><th>{labels.table.purpose}</th></tr></thead>
          <tbody data-plan-table></tbody>
        </table>
      </div>
    </section>
    <section class="run-panel run-wide-panel">
      <h2>{labels.evidence}</h2>
      <div class="run-table-wrap">
        <table class="run-business-table">
          <thead><tr><th>{labels.table.stage}</th><th>{labels.table.object}</th><th>{labels.table.result}</th><th>{labels.table.count}</th></tr></thead>
          <tbody data-evidence-table></tbody>
        </table>
      </div>
    </section>
  </div>

  <details class="run-technical-details">
    <summary>{labels.technical}</summary>
    <div class="run-technical-grid">
      <section><h3>{labels.rawPlan}</h3><pre data-plan>—</pre></section>
      <section><h3>{labels.rawRules}</h3><pre data-rules>—</pre></section>
      <section><h3>{labels.rawCalls}</h3><pre data-tool-calls>—</pre></section>
      <section><h3>{labels.rawEvidence}</h3><pre data-evidence>—</pre></section>
    </div>
  </details>
</section>

<script is:inline define:vars={{ labels, locale }}>
  const root = document.querySelector("[data-run-console]");
  const queryParams = new URLSearchParams(window.location.search);
  const runId = queryParams.get("run");
  const workflowDraft = queryParams.get("workflowDraft");
  const gap = queryParams.get("gap");
  const apiBase = root?.dataset.apiBase;
  const terminal = new Set(["completed", "inconclusive", "failed", "cancelled"]);
  const seenEvents = new Set();
  let source;
  let currentRun;
  let inputDisplayMode = "";

  const showAlert = (message) => {
    const alert = root?.querySelector("[data-run-alert]");
    if (alert) { alert.textContent = message; alert.hidden = false; }
  };
  const localized = (value) => {
