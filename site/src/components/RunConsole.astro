    const rows = []; const seen = new Set();
    const visit = (node) => {
      if (Array.isArray(node)) { node.forEach(visit); return; }
      if (!node || typeof node !== "object") return;
      const isContainerPlan = Array.isArray(node.steps) && !node.step_id && !node.id;
      if ((node.entity_set || node.entity || node.skill_id) && !isContainerPlan) {
        const signature = `${node.step_id || node.id || ""}|${node.service_name || node.api || node.skill_id || ""}|${node.entity_set || node.entity || ""}`;
        if (!seen.has(signature)) { seen.add(signature); rows.push(node); }
      }
      Object.values(node).forEach(visit);
    };
    visit(value); return rows;
  };
  const renderPlanTable = (run) => {
    const body = root.querySelector("[data-plan-table]"); body.replaceChildren();
    const steps = collectPlanSteps(run.plan || run.result?.plan);
    if (!steps.length) {
      const row = document.createElement("tr"); const cell = document.createElement("td"); cell.colSpan = 3; cell.textContent = labels.empty; row.append(cell); body.append(row); return;
    }
    steps.forEach((step, index) => {
      const row = document.createElement("tr");
      const stage = document.createElement("th"); stage.scope = "row"; stage.textContent = friendlyId(step.step_id || step.id) || `${index + 1}`;
      const object = document.createElement("td"); object.textContent = sourceName(step);
      const purpose = document.createElement("td"); purpose.textContent = businessPurpose(step);
      row.append(stage, object, purpose); body.append(row);
    });
  };

  const evidenceRows = (run) => {
    const rows = [];
    (run.result?.evidence || []).forEach((evidence) => {
      const data = evidence?.payload?.data;
      if (data?.step_results && typeof data.step_results === "object") {
        Object.entries(data.step_results).forEach(([id, item]) => rows.push({ id, ...item }));
      } else if (data) {
        rows.push({ id: evidence.step_id || evidence.operation, entity_set: evidence.operation, result_count: data.result_count ?? data.returned_count, source_complete: data.source_complete, source_truncated: data.source_truncated, ok: evidence.payload?.ok });
      }
    });
    return rows;
  };
  const renderEvidenceTable = (run) => {
    const body = root.querySelector("[data-evidence-table]"); body.replaceChildren();
    const rows = evidenceRows(run);
    if (!rows.length) {
      const row = document.createElement("tr"); const cell = document.createElement("td"); cell.colSpan = 4; cell.textContent = terminal.has(run.status) ? labels.empty : labels.status[run.status]; row.append(cell); body.append(row); return;
    }
    rows.forEach((item) => {
      const count = Number(item.result_count ?? item.returned_count ?? 0);
      const resultState = item.ok === false ? "failed" : (item.source_truncated || item.source_complete === false ? "limited" : (count > 0 ? "found" : "not_found"));
      const row = document.createElement("tr");
      const stage = document.createElement("th"); stage.scope = "row"; stage.textContent = friendlyId(item.id || item.step_id);
      const object = document.createElement("td"); object.textContent = sourceName(item);
      const result = document.createElement("td"); const pill = document.createElement("span"); pill.className = `evidence-state evidence-state-${resultState}`; pill.textContent = labels.evidenceState[resultState]; result.append(pill);
      const amount = document.createElement("td"); amount.textContent = Number.isFinite(count) ? String(count) : labels.empty;
      row.append(stage, object, result, amount); body.append(row);
    });
  };

  const businessCompletenessReason = (completeness) => {
    const reason = String(completeness.reason || "");
    if (locale !== "zh") return reason || labels.empty;
    if (completeness.source_complete) return "本次 Agent 设定的查询均已完成，并且没有检测到分页截断。";
    const topMatch = reason.match(/(\d+)\s+explicit top bound/i);
    if (topMatch) return `查询计划中有 ${topMatch[1]} 个步骤设置了记录数上限，因此当前结果不能代表全部源数据。`;
    return "至少一个数据来源存在数量上限、分页未完成或其他范围限制，因此当前结果不能代表全部源数据。";
  };

  const renderCompleteness = (run) => {
    const node = root.querySelector("[data-completeness]"); node.replaceChildren();
    if (run.status === "failed") {
      node.dataset.complete = "unknown";
      const heading = document.createElement("strong"); heading.textContent = labels.notEvaluated;
      const reason = document.createElement("p"); reason.textContent = labels.notEvaluatedReason;
      const help = document.createElement("small"); help.textContent = labels.notEvaluatedHelp;
      node.append(heading, reason, help);
      return;
    }
    const completeness = run.result?.completeness;
    if (!completeness) { node.textContent = terminal.has(run.status) ? labels.empty : labels.status[run.status]; return; }
    node.dataset.complete = String(Boolean(completeness.source_complete));
    const heading = document.createElement("strong"); heading.textContent = completeness.source_complete ? labels.complete : labels.incomplete;
    const reason = document.createElement("p"); reason.textContent = businessCompletenessReason(completeness);
    const help = document.createElement("small"); help.textContent = labels.completeHelp;
    node.append(heading, reason, help);
  };

  const eventDetail = (name, payload) => {
    const data = payload?.data || {};
    if (name === "step_started") return friendlyId(data.step_id || data.id);
    if (name.startsWith("node_") || name === "mapping_failed") return friendlyId(data.node_id || data.agent_id);
    if (name === "tool_started" || name === "tool_completed") return friendlyId(data.step_id || data.operation || data.plugin_id);
    if (name === "waiting_input") return localized(data.prompt || data.question || data.message);
    if (name === "input_received") return data.mode === "steer" ? labels.steerReceived : labels.clarificationReceived;
    if (name === "run_phase_changed") return labels.status[data.status] || data.status;
    if (name === "run_failed") return localized(data.message || currentRun?.error?.message);
    return localized(data.reason || data.purpose || data.message);
  };
  const appendEvent = (name, payload) => {
    const key = payload?.sequence ?? `${name}|${payload?.created_at || ""}|${JSON.stringify(payload?.data || {})}`;
    if (seenEvents.has(key)) return;
    seenEvents.add(key);
    const item = document.createElement("li");
    const marker = document.createElement("span"); marker.className = "run-timeline-marker";
    const content = document.createElement("div");
    const heading = document.createElement("strong"); heading.textContent = labels.events[name] || titleCase(name);
    const detail = eventDetail(name, payload); if (detail) { const paragraph = document.createElement("p"); paragraph.textContent = detail; content.append(heading, paragraph); } else content.append(heading);
    const time = document.createElement("time"); time.textContent = payload?.created_at ? new Date(payload.created_at).toLocaleTimeString(locale === "zh" ? "zh-CN" : "en-US") : "";
    item.append(marker, content, time); root.querySelector("[data-timeline]").append(item);
  };
  const progressPhases = ["received", "preparing", "reading_sap", "validating_evidence", "preparing_result"];
  const progressIndex = (run) => Math.max(0, progressPhases.indexOf(run.progress?.phase || "received"));
  const renderProgress = (run) => {
    const index = progressIndex(run);
    const progress = run.progress || {};
    const state = progress.state || (terminal.has(run.status) ? run.status : "active");
    const finished = state === "completed" || state === "inconclusive";
    const failed = state === "failed" || state === "cancelled";
    const waiting = state === "waiting_input";
    const showUnits = run.mode !== "free_query" && progress.determinate && Number(progress.total_units) > 0;
    const unitText = showUnits
      ? labels.stepProgress.replace("{current}", String(Math.min(Number(progress.completed_units || 0) + (finished ? 0 : 1), Number(progress.total_units)))).replace("{total}", String(progress.total_units))
      : "";
    const activityId = progress.current_step_id || progress.current_node_id || "";
    const activity = activityId ? friendlyId(activityId) : "";
    const phaseText = labels.phaseLabels[index] || labels.phaseLabels[0];
    root.querySelector("[data-progress-message]").textContent = [labels.progressState[state] || phaseText, activity, unitText].filter(Boolean).join(" · ");
    const indicator = root.querySelector("[data-progress-indicator]");
    indicator.className = `run-progress-indicator ${finished ? "is-complete" : failed ? "is-stopped" : waiting ? "is-paused" : "is-active"}`;
    let percent;
    if (finished) percent = 100;
    else if (showUnits) percent = Math.max(4, Number(progress.completed_units || 0) / Number(progress.total_units) * 92);
    else percent = Math.max(4, (index + 0.35) / labels.phaseLabels.length * 100);
    root.querySelector("[data-progress-bar]").style.width = `${Math.min(100, percent)}%`;
    root.querySelectorAll("[data-progress-step]").forEach((step, stepIndex) => {
      step.classList.toggle("is-complete", finished || (stepIndex < index && !failed));
      step.classList.toggle("is-active", stepIndex === index && !finished && !failed && !waiting);
      step.classList.toggle("is-paused", stepIndex === index && waiting);
      step.classList.toggle("is-stopped", failed && stepIndex === Math.min(index, labels.phaseLabels.length - 1));
    });
  };

  const renderLimits = (run) => {
    const node = root.querySelector("[data-limit-summary]");
    const harness = run.result?.harness; const limits = harness?.limits;
    if (!harness || !limits) { node.hidden = true; node.textContent = ""; return; }
    const toolLimit = limits.tool_calls?.limit == null ? labels.presentation.unlimited : limits.tool_calls.limit;
    const totalCalls = harness.tool_call_count ?? limits.tool_calls?.used ?? 0;
    const budgetedCalls = limits.tool_calls?.used ?? harness.budgeted_tool_call_count ?? totalCalls;
    const parts = [
      labels.presentation.calls + ": " + totalCalls + " (" + labels.presentation.budgeted + " " + budgetedCalls + "/" + toolLimit + ")",
      labels.presentation.turns + ": " + (limits.turns?.used ?? harness.turn_count ?? 0) + "/" + (limits.turns?.limit ?? labels.presentation.unlimited),
      labels.presentation.runtime + ": " + (limits.runtime_seconds?.used ?? 0) + "/" + (limits.runtime_seconds?.limit ?? labels.presentation.unlimited) + labels.presentation.seconds,
    ];
    node.textContent = parts.join(" · "); node.hidden = false;
  };

  const renderRun = (run) => {
    const incomingSequence = Number(run.progress?.event_sequence || 0);
    const currentSequence = Number(currentRun?.progress?.event_sequence || 0);
    if (currentRun && incomingSequence < currentSequence) run.progress = currentRun.progress;
    currentRun = run;
    const modeLabel = run.mode === "free_query" && run.agent_id ? labels.mode.guided : (labels.mode[run.mode] || run.mode);
    const subject = run.agent_id || run.workflow_id;
    const runtimeIdentity = run.mode === "free_query" && run.runtime?.provider_id
      ? ` · ${labels.runtimeLabel}: ${run.runtime.provider_id}${run.runtime.version ? ` ${run.runtime.version}` : ""}`
      : "";
    root.querySelector("[data-run-identity]").textContent = `${modeLabel}${subject ? ` · ${subject}` : ""}${runtimeIdentity} · ${run.run_id}`;
    const progressState = run.progress?.state || (terminal.has(run.status) ? run.status : "active");
    root.querySelector("[data-run-status]").textContent = labels.progressState[progressState] || labels.phaseLabels[progressIndex(run)] || labels.connecting;
    root.querySelector("[data-plan]").textContent = format(run.plan || run.result?.plan);
    root.querySelector("[data-rules]").textContent = format(run.result?.rule_results);
    root.querySelector("[data-tool-calls]").textContent = format(run.result?.tool_calls);
    root.querySelector("[data-evidence]").textContent = format(run.result?.evidence);
    renderProgress(run); renderLimits(run); renderBusinessReport(run); renderPlanTable(run); renderEvidenceTable(run); renderCompleteness(run);
    const inputForm = root.querySelector("[data-input-form]");
    const disclosure = root.querySelector("[data-input-disclosure]");
    const waitingForInput = run.status === "waiting_input";
    const steerable = run.mode === "free_query" && Boolean(run.thread_id) && ["planning", "validating", "running"].includes(run.status);
    const displayMode = waitingForInput ? "clarification" : (steerable ? "steer" : "");
    disclosure.hidden = !displayMode;
    disclosure.dataset.mode = displayMode;
    if (displayMode !== inputDisplayMode) {
      disclosure.open = waitingForInput;
      root.querySelector("[data-input-feedback]").hidden = true;
      inputDisplayMode = displayMode;
    }
    const clarificationQuestion = localized(run.error?.message) || labels.input;
    root.querySelector("[data-input-summary]").textContent = waitingForInput ? labels.input : labels.steerTitle;
    root.querySelector("[data-input-question]").textContent = waitingForInput ? clarificationQuestion : labels.steerTitle;
    root.querySelector("[data-input-help]").textContent = waitingForInput ? labels.inputHelp : labels.steerHelp;
    root.querySelector("[data-input-submit]").textContent = waitingForInput ? labels.clarificationSend : labels.steerSend;
    inputForm.querySelector("textarea").placeholder = waitingForInput ? labels.clarificationPlaceholder : (steerable ? labels.steerPlaceholder : labels.inputPlaceholder);
    root.querySelector("[data-draft]").hidden = run.mode !== "free_query" || !terminal.has(run.status) || !run.plan;
    const downloads = root.querySelector("[data-downloads]");
    downloads.querySelectorAll("a").forEach((node) => node.remove());
    (run.result?.artifacts || []).forEach((artifact) => {
      const link = document.createElement("a");
      link.href = `${apiBase}/api/runs/${encodeURIComponent(run.run_id)}/artifacts/${encodeURIComponent(artifact.name)}`;
      link.textContent = labels.artifact[artifact.name] || artifact.name; link.download = artifact.name; downloads.append(link);
    });
    downloads.hidden = !run.result?.artifacts?.length;
    root.querySelector("[data-cancel]").disabled = terminal.has(run.status);
  };

  const loadRun = async () => {
    if (!runId || !apiBase) return;
    const response = await fetch(`${apiBase}/api/runs/${encodeURIComponent(runId)}`);
    if (!response.ok) throw new Error(await response.text());
    const run = await response.json(); renderRun(run); return run;
  };
  const eventNames = [
    "run_queued", "run_started", "progress_changed", "planning_started", "plan_created", "validation_started", "schema_received",
    "plan_grounded", "plan_canonicalized", "plan_repaired", "waiting_input", "input_received", "step_started",
    "workflow_started", "node_started", "node_input_resolved", "node_completed", "node_inconclusive", "node_skipped", "node_skipped_empty_input",
    "mapping_failed", "candidate_discovery_completed", "codex_repair_applied",
    "tool_started", "tool_completed", "evidence_received", "rule_completed", "summary_started", "run_completed",
    "run_inconclusive", "run_failed", "cancellation_requested", "run_cancelled",
    "harness_started", "harness_resumed", "codex_turn_started", "codex_turn_failed", "assistant_message", "web_search_started", "web_search_completed",
    "tool_discovery_started", "tool_discovery_completed", "tool_admission_passed", "tool_admission_rejected",
    "external_tool_started", "external_tool_completed", "external_tool_failed", "tool_requested", "tool_failed",
    "evidence_gap_assessed", "codex_turn_completed", "harness_completed", "harness_interrupted",
  ];
  const connect = () => {
    source?.close();
    if (!runId || !apiBase) { showAlert(labels.noRun); return; }
    source = new EventSource(`${apiBase}/api/runs/${encodeURIComponent(runId)}/events`);
    eventNames.forEach((name) => source.addEventListener(name, (event) => {
      if (name !== "progress_changed") {
        try { appendEvent(name, JSON.parse(event.data)); } catch { appendEvent(name, {}); }
      }
      loadRun().catch(() => showAlert(labels.unavailable));
      if (["run_completed", "run_inconclusive", "run_failed", "run_cancelled"].includes(name)) source.close();
    }));
    source.onerror = () => loadRun().catch(() => showAlert(labels.unavailable));
  };

  root?.querySelector("[data-reconnect]")?.addEventListener("click", connect);
  root?.querySelector("[data-cancel]")?.addEventListener("click", async () => {
    await fetch(`${apiBase}/api/runs/${encodeURIComponent(runId)}/cancel`, { method: "POST" }); await loadRun();
  });
  root?.querySelector("[data-input-form]")?.addEventListener("submit", async (event) => {
    event.preventDefault(); const form = event.currentTarget; const input = String(new FormData(form).get("input") || "").trim();
    const button = form.querySelector("button[type=submit]"); if (button) button.disabled = true;
    const feedback = root.querySelector("[data-input-feedback]"); feedback.hidden = true;
    try {
      const response = await fetch(`${apiBase}/api/runs/${encodeURIComponent(runId)}/input`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ input }) });
      if (!response.ok) throw new Error(await response.text());
      const payload = await response.json();
      form.reset(); feedback.textContent = payload.mode === "steer" ? labels.steerReceived : labels.clarificationReceived;
      feedback.dataset.state = "success"; feedback.hidden = false; await loadRun(); connect();
    } catch (error) {
      feedback.textContent = labels.inputFailed + (error?.message ? " " + error.message : "");
      feedback.dataset.state = "error"; feedback.hidden = false;
    } finally {
      if (button) button.disabled = false;
    }
  });
  root?.querySelector("[data-draft]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget; button.disabled = true;
    const body = { correction: "" };
    if (workflowDraft && gap) { body.workflowDraftId = workflowDraft; body.gapId = gap; }
    const response = await fetch(`${apiBase}/api/runs/${encodeURIComponent(runId)}/create-agent-draft`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    const payload = await response.json();
    button.textContent = response.ok ? `${payload.draft_id} · ${payload.status}` : String(payload.detail?.message || payload.detail || "Draft failed");
    if (response.ok && workflowDraft && gap) {
      const returnLink = root.querySelector("[data-gap-return]");
      returnLink.href = `${root.dataset.workflowsPath}?draft=${encodeURIComponent(workflowDraft)}`;
      returnLink.hidden = false;
    } else if (!response.ok) button.disabled = false;
  });

  if (runId) loadRun().then(connect).catch(() => showAlert(labels.unavailable)); else showAlert(labels.noRun);
</script>
