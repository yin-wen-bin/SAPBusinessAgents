---

<section class="run-console" data-run-console data-api-base={apiBase} data-workflows-path={workflowDestination}>
  <header class="run-console-header">
    <div>
      <p class="runtime-eyebrow">SAPBusinessAgents</p>
      <h1>{labels.title}</h1>
      <p class="run-identity" data-run-identity></p>
    </div>
    <span class="run-status" data-run-status aria-live="polite">{labels.connecting}</span>
  </header>

  <div class="run-alert" data-run-alert hidden>{labels.noRun}</div>

  <div class="run-actions">
    <button type="button" class="secondary-button" data-cancel><Ban size={16} aria-hidden="true" />{labels.cancel}</button>
    <button type="button" class="secondary-button" data-reconnect><RefreshCw size={16} aria-hidden="true" />{labels.reconnect}</button>
    <button type="button" class="secondary-button" data-start-session hidden>{labels.continueCorrection}</button>
    <button type="button" data-draft hidden><FilePlus size={16} aria-hidden="true" />{labels.draft}</button>
    <a class="secondary-button" data-gap-return hidden>{labels.returnWorkflow}</a>
    <span class="run-downloads" data-downloads hidden><Download size={16} aria-hidden="true" /><span>{labels.downloads}</span></span>
  </div>

  <section class="free-query-session-card" data-free-query-session hidden>
    <header>
      <div><p class="runtime-eyebrow">{labels.freeQuerySession.title}</p><h2 data-session-original></h2></div>
      <span class="run-status" data-session-status></span>
    </header>
    <div class="free-query-iteration-list" data-session-iterations></div>
    <section class="free-query-feedback-progress" data-feedback-progress aria-live="polite" hidden>
      <div class="free-query-feedback-progress-heading">
        <strong>{labels.freeQuerySession.feedbackProgress}</strong>
        <button type="button" class="secondary-button" data-feedback-cancel>{labels.freeQuerySession.cancelFeedback}</button>
      </div>
      <ol>
        {labels.freeQuerySession.feedbackSteps.map((step, index) => <li data-feedback-step={index}><span>{index + 1}</span><b>{step}</b></li>)}
      </ol>
      <p data-feedback-progress-detail></p>
    </section>
    <div class="free-query-session-actions" data-session-actions hidden>
      <button type="button" data-session-correct>{labels.freeQuerySession.correct}</button>
      <button type="button" class="secondary-button" data-session-accept>{labels.freeQuerySession.satisfied}</button>
      <button type="button" class="secondary-button" data-session-new>{labels.freeQuerySession.newQuestion}</button>
      <button type="button" class="secondary-button" data-session-reopen hidden>{labels.freeQuerySession.reopen}</button>
      <button type="button" data-session-draft hidden>{labels.freeQuerySession.createDraft}</button>
    </div>
    <form class="free-query-feedback-form" data-session-feedback hidden>
      <p data-session-feedback-question>{labels.freeQuerySession.feedbackPrompt}</p>
      <div class="free-query-feedback-chips" data-session-chips>
        {Object.entries(labels.freeQuerySession.chips).map(([value, text]) => <button type="button" data-feedback-type={value}>{text}</button>)}
      </div>
      <textarea name="feedback" rows="4" required placeholder={labels.freeQuerySession.feedbackPlaceholder}></textarea>
      <p class="run-input-feedback" data-session-feedback-status aria-live="polite" hidden></p>
      <div class="runtime-form-actions">
        <button type="submit"><Send size={16} aria-hidden="true" />{labels.freeQuerySession.submitFeedback}</button>
      </div>
    </form>
  </section>

  <details class="run-input-disclosure" data-input-disclosure hidden>
    <summary data-input-summary>{labels.steerTitle}</summary>
    <form class="run-input-form" data-input-form>
      <label>
        <span class="run-input-question" data-input-question aria-live="polite">{labels.input}</span>
        <small data-input-help>{labels.inputHelp}</small>
        <textarea name="input" required rows="3" placeholder={labels.inputPlaceholder}></textarea>
        <input name="receipt_reference" type="password" autocomplete="off" hidden placeholder={labels.secureReferencePlaceholder} />
      </label>
      <p class="run-input-feedback" data-input-feedback aria-live="polite" hidden></p>
      <button type="submit"><Send size={16} aria-hidden="true" /><span data-input-submit>{labels.send}</span></button>
    </form>
  </details>

  <section class="run-progress-card" aria-labelledby="run-progress-title">
    <div class="run-progress-summary">
      <span class="run-progress-indicator" data-progress-indicator aria-hidden="true"></span>
      <div>
        <h2 id="run-progress-title">{labels.progress}</h2>
        <p data-progress-message>{labels.connecting}</p>
        <small>{labels.progressHint}</small>
        <small class="run-limit-summary" data-limit-summary hidden></small>
      </div>
    </div>
    <div class="run-progress-track" aria-hidden="true"><span data-progress-bar></span></div>
    <ol class="run-progress-steps">
      {labels.phaseLabels.map((phase, index) => <li data-progress-step={index}><span>{index + 1}</span><b>{phase}</b></li>)}
    </ol>
  </section>

  <section class="business-result-card" data-business-result hidden aria-labelledby="business-result-title">
    <div class="business-result-heading">
      <div>
        <p class="runtime-eyebrow">{labels.conclusion}</p>
        <h2 id="business-result-title" data-business-headline></h2>
      </div>
      <span class="business-result-state" data-business-state></span>
    </div>
    <p class="business-result-overview" data-business-overview></p>
    <div class="presentation-blocks" data-presentation-blocks hidden></div>
    <section class="restricted-artifact-panel" data-restricted-artifact hidden>
      <h3>{labels.restricted.title}</h3>
      <p>{labels.restricted.help}</p>
      <div class="runtime-form-actions">
        <button type="button" data-restricted-reveal>{labels.restricted.reveal}</button>
        <button type="button" data-restricted-download>{labels.restricted.download}</button>
        <button type="button" class="danger-button" data-restricted-delete>{labels.restricted.delete}</button>
      </div>
      <p data-restricted-status aria-live="polite"></p>
      <div class="run-table-wrap" data-restricted-table hidden></div>
    </section>
    <div class="run-table-wrap" data-business-stages-wrap hidden>
      <h3>{labels.stages}</h3>
      <table class="run-business-table">
        <thead><tr><th>{labels.table.stage}</th><th>{labels.table.state}</th><th>{labels.table.detail}</th></tr></thead>
        <tbody data-business-stages></tbody>
      </table>
    </div>
    <div class="run-table-wrap" data-business-metrics-wrap hidden>
      <h3>{labels.metrics}</h3>
      <table class="run-business-table">
        <thead><tr><th>{labels.table.metric}</th><th>{labels.table.value}</th></tr></thead>
        <tbody data-business-metrics></tbody>
      </table>
    </div>
    <div class="business-next-actions" data-business-findings-wrap hidden>
      <h3>{labels.findings}</h3>
      <ul data-business-findings></ul>
    </div>
    <div class="business-next-actions" data-missing-evidence-wrap hidden>
      <h3>{labels.missingEvidence}</h3>
      <ul data-missing-evidence></ul>
    </div>
    <div class="business-next-actions" data-next-actions-wrap hidden>
      <h3>{labels.nextActions}</h3>
      <ol data-next-actions></ol>
    </div>
  </section>

  <div class="run-grid run-business-grid">
    <section class="run-panel run-timeline-panel">
      <h2>{labels.timeline}</h2>
      <ol class="run-timeline" data-timeline aria-live="polite"></ol>
    </section>
    <section class="run-panel">
      <h2>{labels.completeness}</h2>
      <div class="completeness-card" data-completeness>—</div>
    </section>
    <section class="run-panel run-wide-panel">
      <h2>{labels.scope}</h2>
      <div class="run-table-wrap">
        <table class="run-business-table">
          <thead><tr><th>{labels.table.stage}</th><th>{labels.table.object}</th><th>{labels.table.purpose}</th></tr></thead>
          <tbody data-plan-table></tbody>
        </table>
      </div>
    </section>
    <section class="run-panel run-wide-panel">
      <h2>{labels.evidence}</h2>
      <div class="run-table-wrap">
        <table class="run-business-table">
          <thead><tr><th>{labels.table.stage}</th><th>{labels.table.object}</th><th>{labels.table.result}</th><th>{labels.table.count}</th></tr></thead>
          <tbody data-evidence-table></tbody>
        </table>
      </div>
    </section>
  </div>

  <details class="run-technical-details">
    <summary>{labels.technical}</summary>
    <div class="run-technical-grid">
      <section><h3>{labels.rawPlan}</h3><pre data-plan>—</pre></section>
      <section><h3>{labels.rawRules}</h3><pre data-rules>—</pre></section>
      <section><h3>{labels.rawCalls}</h3><pre data-tool-calls>—</pre></section>
      <section><h3>{labels.rawEvidence}</h3><pre data-evidence>—</pre></section>
    </div>
  </details>
</section>

<script is:inline define:vars={{ labels, locale }}>
  const root = document.querySelector("[data-run-console]");
  const queryParams = new URLSearchParams(window.location.search);
  let runId = queryParams.get("run");
  let sessionId = queryParams.get("session");
  const workflowDraft = queryParams.get("workflowDraft");
  const gap = queryParams.get("gap");
  const apiBase = root?.dataset.apiBase;
  const terminal = new Set(["completed", "inconclusive", "failed", "cancelled"]);
  const seenEvents = new Set();
  let source;
  let feedbackSource;
  let activeFeedbackRequestId = "";
  let currentRun;
  let currentSession;
  let selectedFeedbackType = "";
  let inputDisplayMode = "";

  const showAlert = (message) => {
    const alert = root?.querySelector("[data-run-alert]");
    if (alert) { alert.textContent = message; alert.hidden = false; }
  };
  const localized = (value) => {
    if (value && typeof value === "object" && !Array.isArray(value)) return String(value[locale] || value.zh || value.en || "");
    return String(value ?? "");
  };
  const findingText = (finding) => {
    if (!finding || typeof finding !== "object" || Array.isArray(finding)) return localized(finding);
    const explicit = localized(finding.detail || finding.text || finding.label);
    if (explicit) return explicit;
    const code = String(finding.code || "Finding");
    const raw = String(finding.value || "").trim();
    const valueText = localized(finding.value_text);
    const objectId = String(finding.object || "").trim();
    let text = [code, raw].filter(Boolean).join(" — ");
    if (valueText) text += ` — ${valueText}`;
    if (objectId) text += ` (${objectId})`;
    return text;
  };
  const format = (value) => value == null ? "—" : JSON.stringify(value, null, 2);
  const titleCase = (value) => String(value || "").replace(/^A_/, "").replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
  const friendlyId = (value) => {
    const id = String(value || "");
    const names = locale === "zh" ? {
      purchase_order: "采购订单", purchase_order_items: "采购订单项目", material_documents: "收货与冲销记录",
      supplier_invoice_items: "供应商发票", accounting_items: "PO关联财务行", full_accounting_documents: "完整财务凭证", clearing_documents: "清账与付款凭证",
      sales_order: "销售订单", sales_order_items: "销售订单项目", delivery_items: "交货单项目",
      delivery_headers: "交货与发货过账", billing_items: "开票凭证项目", billing_headers: "开票凭证",
      accounting_by_billing: "应收财务凭证", ar_clearing: "应收清账", bank_receipt: "银行到账",
      items: "订单项目", goods_receipt: "收货", supplier_invoice: "供应商发票", gr_ir_match: "GR/IR匹配",
      ap_clearing: "应付账款清账", payment_document: "SAP付款凭证", bank_settlement: "银行实际扣款",
      fi_clearing: "财务清账", payment: "付款", delivery: "交货", pgi: "发货过账", billing: "开票",
    } : {
      purchase_order: "Purchase order", purchase_order_items: "Purchase-order items", material_documents: "Receipts and reversals",
      supplier_invoice_items: "Supplier invoices", accounting_items: "PO-linked accounting items", full_accounting_documents: "Full accounting documents", clearing_documents: "Clearing and payment documents",
      sales_order: "Sales order", sales_order_items: "Sales-order items", delivery_items: "Delivery items",
      delivery_headers: "Delivery and PGI", billing_items: "Billing items", billing_headers: "Billing documents",
      accounting_by_billing: "AR accounting documents", ar_clearing: "AR clearing", bank_receipt: "Bank receipt",
      items: "Order items", goods_receipt: "Goods receipt", supplier_invoice: "Supplier invoice", gr_ir_match: "GR/IR matching",
      ap_clearing: "AP clearing", payment_document: "SAP payment document", bank_settlement: "Actual bank debit",
      fi_clearing: "FI clearing", payment: "Payment", delivery: "Delivery", pgi: "Post goods issue", billing: "Billing",
    };
    return names[id] || titleCase(id) || labels.empty;
  };
  const sourceName = (step) => {
    const refs = Array.isArray(step.odata_refs) ? step.odata_refs : [];
    const service = step.service_name || step.api || refs[0]?.service_name || "";
    const entity = step.entity_set || step.entity || refs[0]?.entity_set || "";
    const versions = step.odata_version
      ? [String(step.odata_version)]
      : Array.isArray(step.odata_versions) ? step.odata_versions.map(String) : [];
    const protocol = [...new Set(versions)].map((version) => `V${version.split(".")[0]}`).join(" / ");
    const friendly = friendlyId(step.step_id || step.id || entity);
    const technical = [service, entity].filter(Boolean).join(" / ");
    return [friendly, technical, protocol].filter(Boolean).join(" · ") || labels.empty;
  };
  const businessPurpose = (step) => {
    const id = String(step.step_id || step.id || "");
    const purposes = locale === "zh" ? {
      purchase_order: "读取指定采购订单的基本信息。",
      purchase_order_items: "读取订单中的全部采购项目。",
      material_documents: "核对收货、退货和冲销记录。",
      supplier_invoice_items: "核对引用该采购订单的供应商发票。",
      accounting_items: "仅发现直接带采购订单号的财务行及其凭证键。",
      full_accounting_documents: "按公司代码、年度和凭证号展开读取每张完整财务凭证。",
      clearing_documents: "读取清账凭证本身，避免把清账号误当成付款。",
      sales_order: "读取指定销售订单的基本信息。",
      sales_order_items: "读取订单中的全部销售项目。",
      delivery_items: "核对销售订单对应的交货记录。",
      delivery_headers: "核对交货和发货过账状态。",
      billing_items_by_delivery: "核对交货单对应的开票凭证。",
      billing_headers_by_delivery: "读取开票凭证的整体状态。",
      accounting_by_delivery_billing: "核对开票对应的应收财务凭证。",
      clearing_documents_by_delivery_billing: "核对应收清账和客户收款凭证。",
    } : {
      purchase_order: "Read the requested purchase-order header.",
      purchase_order_items: "Read all purchase-order items.",
      material_documents: "Check receipts, returns, and reversals.",
      supplier_invoice_items: "Check supplier invoices referencing the purchase order.",
      accounting_items: "Discover accounting rows that directly carry the purchase-order reference.",
      full_accounting_documents: "Expand each discovered document by company code, fiscal year and document number.",
      clearing_documents: "Read the clearing document so a clearing reference is not mistaken for payment.",
      sales_order: "Read the requested sales-order header.",
      sales_order_items: "Read all sales-order items.",
