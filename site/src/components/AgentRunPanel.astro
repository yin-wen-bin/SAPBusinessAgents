---
import { Play, ShieldCheck } from "@lucide/astro";
import type { AgentDefinition, Locale } from "../lib/types";
import { runPath } from "../lib/urls";

interface Props { locale: Locale; agent: AgentDefinition }
const { locale, agent } = Astro.props;
const execution = agent.execution;
const deterministicRuntimeAccepted = agent.validation?.acceptanceMode === "deterministic_runtime"
  && agent.validation?.freeQueryComparison === "NOT_TESTED";
const executable = Boolean(
  agent.validation?.verdict === "PASS"
  && agent.validation?.executable === true
  && (agent.validation?.freeQueryComparison === "MATCH" || deterministicRuntimeAccepted)
  && agent.validation?.fixedAgentComparison === "MATCH"
);
const base = import.meta.env.BASE_URL;
const apiBase = import.meta.env.PUBLIC_SAPBA_API_URL || "http://127.0.0.1:8765";
const destination = runPath(base, locale);
const dateRangePairs = execution?.inputSchema.dateRangePairs ?? [];
const labels = locale === "zh" ? {
  title: "执行这个 Agent",
  deterministicLead: "执行引擎严格按照已定义步骤运行，Agent Runtime 不参与 API 或 Skill 选择。",
  guidedLead: "该 Agent 的确定性工作流尚未接入。你仍可带着此 Agent 的业务范围发起只读查询；当前默认 Agent Runtime 负责规划，SAP Provider 会再次验证字段和 GET-only 边界。",
  deterministicSubmit: "执行只读工作流",
  guidedSubmit: "使用此 Agent 发起只读查询",
  deterministicSafety: "确定性计划 · SAP Provider GET-only · 完整证据检查",
  guidedSafety: "Agent 业务上下文 · Agent Runtime 只读规划 · SAP Provider GET-only",
  question: "业务问题",
  questionHelp: "请提供业务对象编号、日期范围以及希望确认的状态。",
  questionPlaceholder: `例如：${agent.summary.zh}`,
  networkError: "无法连接本地运行服务，请确认服务已启动且 API 地址可访问。",
  requestError: "运行服务拒绝了本次请求。",
  invalidInput: "请修正标出的输入后重试。",
  required: "{field}为必填项。",
  minLength: "{field}至少需要 {limit} 个字符。",
  maxLength: "{field}最多允许 {limit} 个字符。",
  invalidFormat: "{field}的格式无效。",
  invalidDate: "{field}必须是有效日期。",
  minimum: "{field}不能小于 {limit}。",
  maximum: "{field}不能大于 {limit}。",
  dateOrder: "结束日期不能早于开始日期。",
  maxDays: "日期范围不能超过 {limit} 天。",
  invalidNumber: "{field}必须是有效数字。",
  minItems: "{field}至少需要 {limit} 项。",
  maxItems: "{field}最多允许 {limit} 项。",
  normalizationConflict: "该输入映射到相互冲突的 SAP 格式规则，请联系平台管理员。",
  validationRequired: "该 Agent 尚未通过真机三级验收，当前不可执行。",
} : {
  title: "Run this Agent",
  deterministicLead: "The deterministic engine follows the declared steps exactly. The Agent Runtime does not choose or replace APIs or Skills.",
  guidedLead: "This Agent does not yet have a deterministic workflow. You can still start a read-only query with its business scope; the current default Agent Runtime plans the query and the SAP Provider revalidates fields and the GET-only boundary.",
  deterministicSubmit: "Run read-only workflow",
  guidedSubmit: "Start a read-only query with this Agent",
  deterministicSafety: "Deterministic plan · SAP Provider GET-only · evidence completeness checks",
  guidedSafety: "Agent business context · Agent Runtime read-only planning · SAP Provider GET-only",
  question: "Business question",
  questionHelp: "Include the business object ID, date range, and the status you want to confirm.",
  questionPlaceholder: `Example: ${agent.summary.en}`,
  networkError: "Could not reach the local runtime. Confirm that it is running and the API address is accessible.",
  requestError: "The runtime rejected this request.",
  invalidInput: "Correct the highlighted input and try again.",
  required: "{field} is required.",
  minLength: "{field} must contain at least {limit} character(s).",
  maxLength: "{field} must contain at most {limit} character(s).",
  invalidFormat: "{field} has an invalid format.",
  invalidDate: "{field} must be a valid date.",
  minimum: "{field} must not be less than {limit}.",
  maximum: "{field} must not be greater than {limit}.",
  dateOrder: "The end date must not be earlier than the start date.",
  maxDays: "The date range must not exceed {limit} days.",
  invalidNumber: "{field} must be a valid number.",
  minItems: "{field} must contain at least {limit} item(s).",
  maxItems: "{field} must contain no more than {limit} item(s).",
  normalizationConflict: "This input maps to conflicting SAP formatting rules. Contact the platform administrator.",
  validationRequired: "This Agent has not passed three-stage live acceptance and cannot run yet.",
};
const runtimeMessages = {
  networkError: labels.networkError,
  requestError: labels.requestError,
  invalidInput: labels.invalidInput,
  required: labels.required,
  minLength: labels.minLength,
  maxLength: labels.maxLength,
  invalidFormat: labels.invalidFormat,
  invalidDate: labels.invalidDate,
  minimum: labels.minimum,
  maximum: labels.maximum,
  dateOrder: labels.dateOrder,
  maxDays: labels.maxDays,
  invalidNumber: labels.invalidNumber,
  minItems: labels.minItems,
  maxItems: labels.maxItems,
  normalizationConflict: labels.normalizationConflict,
  validationRequired: labels.validationRequired,
};
---

<section
  class="agent-run-panel"
  data-agent-run
  data-api-base={apiBase}
  data-run-path={destination}
  data-agent-id={agent.slug}
  data-run-mode={execution ? "agent" : "free_query"}
  data-locale={locale}
  data-messages={JSON.stringify(runtimeMessages)}
  data-date-range-pairs={JSON.stringify(dateRangePairs)}
>
    <div class="agent-run-heading">
      <div>
        <h2>{labels.title}</h2>
        <p>{execution ? labels.deterministicLead : labels.guidedLead}</p>
      </div>
      <span><ShieldCheck size={16} aria-hidden="true" />{execution ? labels.deterministicSafety : labels.guidedSafety}</span>
    </div>
    <form class="agent-run-form" novalidate>
      {execution ? (
        <div class="runtime-field-grid">
          {Object.entries(execution.inputSchema.properties).filter(([, property]) => property["x-sapba-workflow-only"] !== true).map(([name, property]) => (
            <label>
              <span>{property.title?.[locale] || name}</span>
              {property.description && <small class="runtime-field-help">{property.description[locale]}</small>}
              {property.type === "array" ? (
                <textarea
                  name={name}
                  rows={5}
                  placeholder={property.placeholder?.[locale]}
                  data-value-type="array"
                  data-item-pattern={property.items?.pattern}
                  data-min-items={property.minItems}
                  data-max-items={property.maxItems}
                  required={execution.inputSchema.required?.includes(name)}
                >{Array.isArray(property.default) ? property.default.join("\n") : ""}</textarea>
              ) : (
                <input
                  name={name}
                  type={property.format === "date" ? "date" : property.type === "integer" || property.type === "number" ? "number" : "text"}
                  value={property.default === undefined ? "" : String(property.default)}
                  placeholder={property.placeholder?.[locale]}
                  minlength={property.minLength}
                  maxlength={property.maxLength}
                  min={property.minimum}
                  max={property.maximum}
                  step={property.type === "integer" ? 1 : undefined}
                  data-value-type={property.type}
                  pattern={property.pattern}
                  inputmode={property.pattern === "^[0-9]+$" ? "numeric" : undefined}
                  title={property.description?.[locale]}
                  required={execution.inputSchema.required?.includes(name)}
                />
              )}
              <small class="runtime-field-error" data-field-error={name} role="alert" hidden></small>
            </label>
          ))}
        </div>
      ) : (
        <label class="guided-agent-question">
          <span>{labels.question}</span>
          <small>{labels.questionHelp}</small>
          <textarea name="query" rows="3" required placeholder={labels.questionPlaceholder}></textarea>
        </label>
      )}
      <div class="runtime-form-actions">
        <span class="runtime-form-error" role="alert" hidden></span>
        {execution && !executable && <span class="runtime-validation-required" role="status">{labels.validationRequired}</span>}
        <button type="submit" disabled={Boolean(execution && !executable)}><Play size={17} aria-hidden="true" />{execution ? labels.deterministicSubmit : labels.guidedSubmit}</button>
      </div>
    </form>
</section>

<script>
  type LocalizedMessages = Record<string, string>;
  type ApiErrorPayload = {
    detail?: {
      code?: string;
      message?: string;
      detail?: {
        field?: string;
        fields?: string[];
        constraint?: string;
        minimum?: string | number;
        maximum?: string | number;
      } | null;
    } | Array<unknown> | string;
  };

  class RunCreateHttpError extends Error {
    status: number;
    payload: ApiErrorPayload;

    constructor(status: number, payload: ApiErrorPayload) {
      super(`Run creation failed with HTTP ${status}`);
      this.status = status;
      this.payload = payload;
    }
  }

  const formatMessage = (template: string, values: Record<string, string | number>) =>
    Object.entries(values).reduce(
      (message, [key, value]) => message.replace(`{${key}}`, String(value)),
      template,
    );

  const fieldLabel = (form: HTMLFormElement, name: string) => {
    const field = form.querySelector<HTMLInputElement>(`input[name="${CSS.escape(name)}"]`);
    return field?.closest("label")?.querySelector<HTMLElement>(":scope > span")?.textContent?.trim() || name;
  };

  const clearErrors = (form: HTMLFormElement, summary: HTMLElement | null) => {
    if (summary) {
      summary.hidden = true;
      summary.textContent = "";
    }
    form.querySelectorAll<HTMLElement>("[data-field-error]").forEach((item) => {
      item.hidden = true;
      item.textContent = "";
    });
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[aria-invalid], textarea[aria-invalid]").forEach((field) => {
      field.removeAttribute("aria-invalid");
    });
  };

  const showSummary = (summary: HTMLElement | null, message: string) => {
    if (!summary) return;
    summary.textContent = message;
    summary.hidden = false;
  };

  const showFieldError = (form: HTMLFormElement, name: string, message: string) => {
    const field = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${CSS.escape(name)}"]`);
    const target = form.querySelector<HTMLElement>(`[data-field-error="${CSS.escape(name)}"]`);
    field?.setAttribute("aria-invalid", "true");
    if (target) {
      target.textContent = message;
      target.hidden = false;
    }
  };

  const validateClientInput = (
    form: HTMLFormElement,
    messages: LocalizedMessages,
    dateRangePairs: Array<{ from?: string; to?: string; maxDays?: number }>,
  ) => {
    let valid = true;
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[name], textarea[name]").forEach((field) => {
      const value = field.value.trim();
      const label = fieldLabel(form, field.name);
      let message = "";
      const arrayValues = field.dataset.valueType === "array" ? parseArrayInput(value) : [];
      const itemPattern = field.dataset.itemPattern ? new RegExp(field.dataset.itemPattern) : null;
      if (field.required && !value) {
        message = formatMessage(messages.required, { field: label });
      } else if (field.dataset.valueType === "array" && Number(field.dataset.minItems || 0) > arrayValues.length) {
        message = formatMessage(messages.minItems, { field: label, limit: field.dataset.minItems || "" });
      } else if (field.dataset.valueType === "array" && Number(field.dataset.maxItems || 0) > 0 && arrayValues.length > Number(field.dataset.maxItems)) {
        message = formatMessage(messages.maxItems, { field: label, limit: field.dataset.maxItems || "" });
      } else if (field.dataset.valueType === "array" && itemPattern && arrayValues.some((item) => !itemPattern.test(item))) {
        message = formatMessage(messages.invalidFormat, { field: label });
      } else if (field instanceof HTMLInputElement && value && field.minLength > 0 && value.length < field.minLength) {
        message = formatMessage(messages.minLength, { field: label, limit: field.minLength });
      } else if (field instanceof HTMLInputElement && value && field.maxLength > 0 && value.length > field.maxLength) {
        message = formatMessage(messages.maxLength, { field: label, limit: field.maxLength });
      } else if (field instanceof HTMLInputElement && value && field.validity.patternMismatch) {
        message = formatMessage(messages.invalidFormat, { field: label });
      } else if (field instanceof HTMLInputElement && value && field.type === "date" && Number.isNaN(Date.parse(`${value}T00:00:00Z`))) {
        message = formatMessage(messages.invalidDate, { field: label });
      } else if (field instanceof HTMLInputElement && value && field.type === "number" && !Number.isFinite(field.valueAsNumber)) {
        message = formatMessage(messages.invalidNumber, { field: label });
      } else if (field instanceof HTMLInputElement && value && field.validity.rangeUnderflow) {
        message = formatMessage(messages.minimum, { field: label, limit: field.min || "" });
      } else if (field instanceof HTMLInputElement && value && field.validity.rangeOverflow) {
        message = formatMessage(messages.maximum, { field: label, limit: field.max || "" });
      }
      if (message) {
        valid = false;
        showFieldError(form, field.name, message);
      }
    });

    dateRangePairs.forEach((pair) => {
      const startField = pair.from ? form.elements.namedItem(pair.from) : null;
      const endField = pair.to ? form.elements.namedItem(pair.to) : null;
      if (!(startField instanceof HTMLInputElement) || !(endField instanceof HTMLInputElement)) return;
      if (!startField.value || !endField.value) return;
      const start = Date.parse(`${startField.value}T00:00:00Z`);
      const end = Date.parse(`${endField.value}T00:00:00Z`);
      if (!Number.isFinite(start) || !Number.isFinite(end)) return;
      if (end < start) {
        valid = false;
        showFieldError(form, endField.name, messages.dateOrder);
      } else if (typeof pair.maxDays === "number" && (end - start) / 86_400_000 > pair.maxDays) {
        valid = false;
        const message = formatMessage(messages.maxDays, { limit: pair.maxDays });
        showFieldError(form, startField.name, message);
        showFieldError(form, endField.name, message);
      }
    });
    return valid;
  };

  const parseArrayInput = (value: string): string[] => Array.from(new Set(
    value.split(/[\n,;，；]+/u).map((item) => item.trim()).filter(Boolean),
  ));

  const constraintMessage = (
    form: HTMLFormElement,
    messages: LocalizedMessages,
    field: string,
    detail: NonNullable<Exclude<ApiErrorPayload["detail"], string | Array<unknown>>>["detail"],
  ) => {
    const label = fieldLabel(form, field);
    const constraint = detail?.constraint || "";
    const limit = detail?.maximum ?? detail?.minimum ?? "";
    if (constraint === "required") return formatMessage(messages.required, { field: label });
    if (constraint === "min_length") return formatMessage(messages.minLength, { field: label, limit });
    if (constraint === "max_length") return formatMessage(messages.maxLength, { field: label, limit });
    if (constraint === "min_items") return formatMessage(messages.minItems, { field: label, limit });
    if (constraint === "max_items") return formatMessage(messages.maxItems, { field: label, limit });
    if (constraint === "date") return formatMessage(messages.invalidDate, { field: label });
    if (constraint === "minimum") return formatMessage(messages.minimum, { field: label, limit });
    if (constraint === "maximum") return formatMessage(messages.maximum, { field: label, limit });
    if (constraint === "date_range_order") return messages.dateOrder;
    if (constraint === "max_days") return formatMessage(messages.maxDays, { limit });
    if (constraint === "integer") return formatMessage(messages.invalidNumber, { field: label });
    return formatMessage(messages.invalidFormat, { field: label });
  };

  const showHttpError = (
    form: HTMLFormElement,
    summary: HTMLElement | null,
    messages: LocalizedMessages,
    error: RunCreateHttpError,
  ) => {
    const envelope = error.payload.detail;
    if (Array.isArray(envelope)) {
      showSummary(summary, `${messages.requestError} (HTTP ${error.status})`);
      return;
    }
    if (!envelope || typeof envelope === "string") {
      showSummary(summary, `${messages.requestError} (HTTP ${error.status})`);
      return;
    }
    if (envelope.code === "agent_live_validation_required") {
      showSummary(summary, messages.validationRequired);
      return;
    }
    if (envelope.code === "sap_input_normalization_conflict") {
      showSummary(summary, messages.normalizationConflict);
      return;
    }
    if (envelope.code === "agent_input_invalid" || envelope.code === "agent_validation_failed") {
      const detail = envelope.detail;
      const fields = detail?.fields?.length
        ? detail.fields
        : detail?.field
          ? [detail.field]
          : [];
      fields.forEach((field) => showFieldError(form, field, constraintMessage(form, messages, field, detail)));
      showSummary(summary, fields.length ? messages.invalidInput : messages.requestError);
      return;
    }
    const safeMessage = envelope.message ? ` ${envelope.message}` : "";
    showSummary(summary, `${messages.requestError} (HTTP ${error.status}).${safeMessage}`);
  };

  document.querySelectorAll<HTMLElement>("[data-agent-run]").forEach((panel) => {
    const form = panel.querySelector<HTMLFormElement>("form");
    const error = panel.querySelector<HTMLElement>(".runtime-form-error");
    const messages = JSON.parse(panel.dataset.messages || "{}") as LocalizedMessages;
    const dateRangePairs = JSON.parse(panel.dataset.dateRangePairs || "[]") as Array<{ from?: string; to?: string; maxDays?: number }>;
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (button) button.disabled = true;
      clearErrors(form, error);
      if (!validateClientInput(form, messages, dateRangePairs)) {
        showSummary(error, messages.invalidInput);
        if (button) button.disabled = false;
        form.querySelector<HTMLInputElement | HTMLTextAreaElement>('[aria-invalid="true"]')?.focus();
        return;
      }
      const mode = panel.dataset.runMode === "agent" ? "agent" : "free_query";
      const formData = new FormData(form);
      const input: Record<string, unknown> = {};
      if (mode === "agent") {
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[name], textarea[name]").forEach((field) => {
          const value = field.value.trim();
          if (!value) return;
          input[field.name] = field.dataset.valueType === "array"
            ? parseArrayInput(value)
            : field.dataset.valueType === "integer"
            ? Number(value)
            : field.dataset.valueType === "number"
              ? Number(value)
              : value;
        });
      }
      const body = mode === "agent"
        ? { mode, agentId: panel.dataset.agentId, input }
        : { mode, agentId: panel.dataset.agentId, query: String(formData.get("query") || "").trim() };
      try {
        const response = await fetch(`${panel.dataset.apiBase}/api/runs`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        if (!response.ok) {
          const text = await response.text();
          let payload: ApiErrorPayload = {};
          try {
            payload = JSON.parse(text) as ApiErrorPayload;
          } catch {
            payload = {};
          }
          throw new RunCreateHttpError(response.status, payload);
        }
        const payload = await response.json();
        window.location.href = `${panel.dataset.runPath}?run=${encodeURIComponent(payload.run_id)}`;
      } catch (caught) {
        if (caught instanceof RunCreateHttpError) {
          showHttpError(form, error, messages, caught);
        } else {
          showSummary(error, messages.networkError);
        }
        if (button) button.disabled = false;
      }
    });
  });
</script>
