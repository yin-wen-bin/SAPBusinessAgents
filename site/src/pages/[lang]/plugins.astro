---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import PluginManagerPanel from "../../components/PluginManagerPanel.astro";
import { moduleCounts } from "../../lib/catalog";
import { pluginsPath } from "../../lib/urls";
import type { Locale } from "../../lib/types";

export function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}
const locale = Astro.params.lang as Locale;
const other: Locale = locale === "zh" ? "en" : "zh";
const base = import.meta.env.BASE_URL;
---

<SiteLayout
  title={locale === "zh" ? "插件与能力 — SAP Business Agents" : "Plugins and capabilities — SAP Business Agents"}
  description={locale === "zh" ? "查看本机插件状态、能力与只读安全边界。" : "Inspect local plugin status, capabilities, and read-only boundaries."}
  locale={locale}
  alternateHref={pluginsPath(base, other)}
>
  <div class="app-shell">
    <Sidebar locale={locale} counts={moduleCounts()} />
    <main id="main-content" class="main-content runtime-main"><PluginManagerPanel locale={locale} /></main>
  </div>
</SiteLayout>
