---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import PluginManagerPanel from "../../components/PluginManagerPanel.astro";
import { moduleCounts } from "../../lib/catalog";
import { pluginsPath } from "../../lib/urls";
import type { Locale } from "../../lib/types";

export function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}
const locale = Astro.params.lang as Locale;
const other: Locale = locale === "zh" ? "en" : "zh";
const base = import.meta.env.BASE_URL;
---

<SiteLayout
  title={locale === "zh" ? "插件与连接 — SAP Business Agents" : "Plugins and connections — SAP Business Agents"}
  description={locale === "zh" ? "统一管理本地插件、Runtime App、MCP 连接、权限和诊断。" : "Manage local plugins, Runtime Apps, MCP connections, permissions, and diagnostics."}
  locale={locale}
  alternateHref={pluginsPath(base, other)}
>
  <div class="app-shell">
    <Sidebar locale={locale} counts={moduleCounts()} />
    <main id="main-content" class="main-content runtime-main"><PluginManagerPanel locale={locale} /></main>
  </div>
</SiteLayout>
