---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import FreeQueryPanel from "../../components/FreeQueryPanel.astro";
import { moduleCounts } from "../../lib/catalog";
import { askPath } from "../../lib/urls";
import type { Locale } from "../../lib/types";

export function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}
const locale = Astro.params.lang as Locale;
const other: Locale = locale === "zh" ? "en" : "zh";
const base = import.meta.env.BASE_URL;
---

<SiteLayout
  title={locale === "zh" ? "直接询问 SAP — SAP Business Agents" : "Ask SAP — SAP Business Agents"}
  description={locale === "zh" ? "通过 Codex 和内嵌 SAP 只读 Provider 执行受控的自由查询。" : "Run a guarded free SAP query through Codex and the embedded SAP read Provider."}
  locale={locale}
  alternateHref={askPath(base, other)}
>
  <div class="app-shell">
    <Sidebar locale={locale} counts={moduleCounts()} />
    <main id="main-content" class="main-content runtime-main"><FreeQueryPanel locale={locale} /></main>
  </div>
</SiteLayout>
