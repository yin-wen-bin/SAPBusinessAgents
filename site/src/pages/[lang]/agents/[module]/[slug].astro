---
import { Database, ExternalLink, FolderGit2, ListChecks, ShieldCheck, Wrench } from "@lucide/astro";
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import Sidebar from "../../../../components/Sidebar.astro";
import AgentRunPanel from "../../../../components/AgentRunPanel.astro";
import RoleMatchingAssistant from "../../../../components/RoleMatchingAssistant";
import { getAgents, moduleCounts } from "../../../../lib/catalog";
import { statusLabel } from "../../../../lib/display";
import type { AgentDefinition, Locale } from "../../../../lib/types";
import { agentPath, homePath, sourceUrl } from "../../../../lib/urls";

export function getStaticPaths() {
  return getAgents().flatMap((agent) => (["zh", "en"] as const).map((locale) => ({
    params: { lang: locale, module: agent.module, slug: agent.slug },
    props: { locale, agent },
  })));
}

interface Props { locale: Locale; agent: AgentDefinition }
const { locale, agent } = Astro.props as Props;
const counts = moduleCounts();
const base = import.meta.env.BASE_URL;
const apiBase = import.meta.env.PUBLIC_SAPBA_API_URL || "http://127.0.0.1:8765";
const alternateLocale: Locale = locale === "zh" ? "en" : "zh";
const alternateHref = agentPath(base, alternateLocale, agent.module, agent.slug);
const githubUrl = sourceUrl(agent.module, agent.slug);
const validationReportUrl = agent.validation
  ? `${githubUrl}/${agent.validation.reportPath}`
  : undefined;
const hasStepSapScope = agent.workflow.some((step) => step.sapScope !== undefined);
const collectODataRefs = (value: unknown, refs = new Map<string, { service: string; version: string; entity: string }>()) => {
  if (Array.isArray(value)) {
    value.forEach((item) => collectODataRefs(item, refs));
    return refs;
  }
  if (!value || typeof value !== "object") return refs;
  const record = value as Record<string, unknown>;
  if (typeof record.service_name === "string" && typeof record.entity_set === "string" && typeof record.odata_version === "string") {
    const key = `${record.service_name}|${record.odata_version}|${record.entity_set}`;
    refs.set(key, { service: record.service_name, version: record.odata_version, entity: record.entity_set });
  }
  Object.values(record).forEach((item) => collectODataRefs(item, refs));
  return refs;
};
const odataRefs = [...collectODataRefs(agent.execution).values()];
const inputProperties = Object.entries(agent.execution?.inputSchema.properties ?? {});
const outputProperties = Object.entries(agent.execution?.outputSchema?.properties ?? {});
const labels = locale === "zh" ? {
  all: "全部 Agents",
  profile: "Agent 信息",
  owner: "业务域",
  status: "状态",
  version: "版本",
  systems: "适用系统",
  inputsOutputs: "输入与输出",
  inputs: "输入",
  outputs: "输出",
  sapScope: "SAP 范围",
  modules: "业务模块",
  transactions: "事务码",
  tables: "核心对象 / 表",
  odataServices: "OData API 与协议版本",
  workflow: "工作流与 Tools",
  workflowLead: "从业务输入到安全输出的完整执行路径。每一步均列出对应 SAP 范围与实际使用的 Tool。",
  step: "步骤",
  operations: "详细操作",
  tools: "本步骤 API / SAPSkill / Tools",
  guardrails: "安全边界",
  source: "在 GitHub 查看源码",
  validation: "真机验收",
  verdict: "判定",
  evidenceScope: "证据范围",
  testedAt: "测试时间",
  providers: "证据 Provider",
  report: "查看独立测试报告",
  executable: "可执行",
  freeQueryComparison: "自由查询对照",
  fixedAgentComparison: "固定 Agent 对照",
} : {
  all: "All agents",
  profile: "Agent profile",
  owner: "Business owner",
  status: "Status",
  version: "Version",
  systems: "Systems",
  inputsOutputs: "Inputs and outputs",
  inputs: "Inputs",
  outputs: "Outputs",
  sapScope: "SAP scope",
  modules: "Business modules",
  transactions: "Transactions",
  tables: "Core objects / tables",
  odataServices: "OData APIs and protocol versions",
  workflow: "Workflow & Tools",
  workflowLead: "The complete execution path from business input to safe output. Every step identifies its SAP scope and the Tools it uses.",
  step: "Step",
  operations: "Detailed operations",
  tools: "APIs, SAPSkills & tools used at this step",
  guardrails: "Guardrails",
  source: "View source on GitHub",
  validation: "Live SAP validation",
  verdict: "Verdict",
  evidenceScope: "Evidence scope",
  testedAt: "Tested at",
  providers: "Evidence providers",
  report: "View independent test report",
  executable: "Executable",
  freeQueryComparison: "Free-query comparison",
  fixedAgentComparison: "Fixed-Agent comparison",
};
---

<SiteLayout
  title={`${agent.title[locale]} — SAP Business Agents`}
  description={agent.summary[locale]}
  locale={locale}
  alternateHref={alternateHref}
>
  <div class="app-shell">
    <Sidebar locale={locale} counts={counts} activeModule={agent.module} />
    <main id="main-content" class="detail-main">
      <nav class="breadcrumbs" aria-label={locale === "zh" ? "面包屑" : "Breadcrumb"}>
        <a href={homePath(base, locale)}>{labels.all}</a>
        <span>/</span>
        <a href={`${homePath(base, locale)}?module=${agent.module}`}>{agent.module}</a>
        <span>/</span>
        <span aria-current="page">{agent.title[locale]}</span>
      </nav>

      <div class="detail-layout">
        <article class="skill-document">
          <header class="detail-header">
            <span class="detail-module-badge">{agent.module}</span>
            <div>
              <h1>{agent.title[locale]}</h1>
              <p>{agent.summary[locale]}</p>
            </div>
          </header>

          <a class="source-button detail-source-button" href={githubUrl} target="_blank" rel="noreferrer">
            <FolderGit2 size={18} stroke-width={1.8} aria-hidden="true" />
            <span>{labels.source}</span>
            <ExternalLink size={15} stroke-width={1.8} aria-hidden="true" />
          </a>

          <div class="markdown-body agent-document-body">
            {agent.kind === "platform_assistant" && agent.assistant?.type === "role_matching"
              ? <RoleMatchingAssistant apiBase={apiBase} locale={locale} workflowsPath={`${base}${locale}/workflows/`} client:load />
              : <AgentRunPanel locale={locale} agent={agent} />}
            <section id="agent-profile">
              <h2>{labels.profile}</h2>
              <dl class="profile-grid">
                <div><dt>{labels.owner}</dt><dd>{agent.owner}</dd></div>
                <div><dt>{labels.status}</dt><dd>{statusLabel(agent.status, locale)}</dd></div>
                <div><dt>{labels.version}</dt><dd>{agent.version}</dd></div>
                <div><dt>{labels.systems}</dt><dd>{agent.systems.join(" · ")}</dd></div>
              </dl>
            </section>

            {agent.validation && (
              <section id="live-validation">
                <h2>{labels.validation}</h2>
                <p>{agent.validation.summary[locale]}</p>
                <dl class="profile-grid">
                  <div><dt>{labels.verdict}</dt><dd><code>{agent.validation.verdict}</code></dd></div>
                  <div><dt>{labels.evidenceScope}</dt><dd>{agent.validation.evidenceScope}</dd></div>
                  <div><dt>{labels.testedAt}</dt><dd>{agent.validation.testedAt}</dd></div>
                  <div><dt>{labels.providers}</dt><dd>{agent.validation.providers.join(" · ")}</dd></div>
                  <div><dt>{labels.executable}</dt><dd><code>{String(agent.validation.executable === true)}</code></dd></div>
                  <div><dt>{labels.freeQueryComparison}</dt><dd><code>{agent.validation.freeQueryComparison || "NOT_TESTED"}</code></dd></div>
                  <div><dt>{labels.fixedAgentComparison}</dt><dd><code>{agent.validation.fixedAgentComparison || "NOT_TESTED"}</code></dd></div>
                </dl>
                {validationReportUrl && (
                  <p><a href={validationReportUrl} target="_blank" rel="noreferrer">{labels.report} <ExternalLink size={14} aria-hidden="true" /></a></p>
                )}
              </section>
            )}

            <section id="inputs-outputs">
              <h2>{labels.inputsOutputs}</h2>
              <div class="io-grid">
                <div class="document-panel">
                  <h3>{labels.inputs}</h3>
                  <ul>{agent.kind === "platform_assistant" ? agent.inputs[locale].map((item) => <li><strong>{item}</strong></li>) : inputProperties.map(([name, property]) => (
                    <li>
                      <strong>{property.title?.[locale] || name}</strong>
                      {property.description?.[locale] && <span> — {property.description[locale]}</span>}
                      {agent.execution?.inputSchema.required?.includes(name) && <code>{locale === "zh" ? "必填" : "required"}</code>}
                    </li>
                  ))}</ul>
                </div>
                <div class="document-panel">
                  <h3>{labels.outputs}</h3>
                  <ul>{agent.kind === "platform_assistant" ? agent.outputs[locale].map((item) => <li><strong>{item}</strong></li>) : outputProperties.map(([name, property]) => (
                    <li><strong>{property.title?.[locale] || name}</strong></li>
                  ))}</ul>
                </div>
              </div>
            </section>

            {!hasStepSapScope && (
              <section id="sap-scope">
                <h2>{labels.sapScope}</h2>
                <div class="scope-grid">
                  <div>
                    <h3><Database size={18} stroke-width={1.8} aria-hidden="true" />{labels.modules}</h3>
                    <ul class="tag-list scope-tags">{agent.sapModules.map((item) => <li>{item}</li>)}</ul>
                  </div>
                  {agent.transactions.length > 0 && (
                    <div>
                      <h3>{labels.transactions}</h3>
                      <ul class="tag-list scope-tags">{agent.transactions.map((item) => <li><code>{item}</code></li>)}</ul>
                    </div>
                  )}
                  {agent.tables.length > 0 && (
                    <div>
                      <h3>{labels.tables}</h3>
                      <ul class="tag-list scope-tags">{agent.tables.map((item) => <li><code>{item}</code></li>)}</ul>
                    </div>
                  )}
                </div>
              </section>
            )}

            {odataRefs.length > 0 && (
              <section id="odata-api-scope">
                <h2>{labels.odataServices}</h2>
                <ul class="tag-list scope-tags odata-api-tags">
                  {odataRefs.map((item) => (
                    <li>
                      <code>{item.service} / {item.entity}</code>
                      <span class="odata-version-badge">V{item.version.split(".")[0]}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            <section id="workflow-tools">
              <h2>{labels.workflow}</h2>
              <p>{labels.workflowLead}</p>
              <ol class="agent-workflow">
                {agent.workflow.map((step, index) => (
                  <li class="workflow-step">
                    <div class="workflow-step-heading">
                      <span class="workflow-index">{String(index + 1).padStart(2, "0")}</span>
                      <div>
                        <small>{labels.step} {index + 1}</small>
                        <h3>{step.title[locale]}</h3>
                      </div>
                      <code>{step.id}</code>
                    </div>
                    <p>{step.description[locale]}</p>
                    {step.operations && (
                      <div class="step-operations">
                        <h4><ListChecks size={16} stroke-width={1.8} aria-hidden="true" />{labels.operations}</h4>
                        <ol>
                          {step.operations[locale].map((operation) => <li>{operation}</li>)}
                        </ol>
                      </div>
                    )}
                    {step.sapScope && (
                      <div class="step-sap-scope">
                        {step.sapScope.modules.length > 0 && (
                          <div>
                            <h4><Database size={15} stroke-width={1.8} aria-hidden="true" />{labels.modules}</h4>
                            <ul class="tag-list scope-tags">{step.sapScope.modules.map((item) => <li>{item}</li>)}</ul>
                          </div>
                        )}
                        {step.sapScope.transactions.length > 0 && (
                          <div>
                            <h4>{labels.transactions}</h4>
                            <ul class="tag-list scope-tags">{step.sapScope.transactions.map((item) => <li><code>{item}</code></li>)}</ul>
                          </div>
                        )}
                        {step.sapScope.tables.length > 0 && (
                          <div>
                            <h4>{labels.tables}</h4>
                            <ul class="tag-list scope-tags">{step.sapScope.tables.map((item) => <li><code>{item}</code></li>)}</ul>
                          </div>
                        )}
                      </div>
                    )}
                    <div class="step-tools">
                      <h4><Wrench size={16} stroke-width={1.8} aria-hidden="true" />{labels.tools}</h4>
                      <ul>
                        {step.tools.map((tool) => (
                          <li>
                            <div class="tool-heading"><code>{tool.name}</code><span>{tool.kind}</span></div>
                            <p>{tool.purpose[locale]}</p>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </li>
                ))}
              </ol>
            </section>

            <section id="guardrails">
              <h2>{labels.guardrails}</h2>
              <ul class="guardrail-list">
                {agent.guardrails[locale].map((guardrail) => (
                  <li><ShieldCheck size={18} stroke-width={1.8} aria-hidden="true" /><span>{guardrail}</span></li>
                ))}
              </ul>
            </section>
          </div>
        </article>

      </div>
    </main>
  </div>
</SiteLayout>
