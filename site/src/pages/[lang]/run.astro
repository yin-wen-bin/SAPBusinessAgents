---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import RunConsole from "../../components/RunConsole.astro";
import { moduleCounts } from "../../lib/catalog";
import { runPath } from "../../lib/urls";
import type { Locale } from "../../lib/types";

export function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}
const locale = Astro.params.lang as Locale;
const other: Locale = locale === "zh" ? "en" : "zh";
const base = import.meta.env.BASE_URL;
---

<SiteLayout
  title={locale === "zh" ? "运行详情 — SAP Business Agents" : "Run details — SAP Business Agents"}
  description={locale === "zh" ? "查看本地 Agent 或自由 SAP 查询的实时过程和结果。" : "Inspect local Agent or free-query progress and results."}
  locale={locale}
  alternateHref={runPath(base, other)}
>
  <div class="app-shell">
    <Sidebar locale={locale} counts={moduleCounts()} />
    <main id="main-content" class="main-content runtime-main"><RunConsole locale={locale} /></main>
  </div>
</SiteLayout>
