---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import SystemSettingsPanel from "../../components/SystemSettingsPanel.astro";
import { moduleCounts } from "../../lib/catalog";
import { settingsPath } from "../../lib/urls";
import type { Locale } from "../../lib/types";

export function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}
const locale = Astro.params.lang as Locale;
const other: Locale = locale === "zh" ? "en" : "zh";
const base = import.meta.env.BASE_URL;
---

<SiteLayout
  title={locale === "zh" ? "系统配置 — SAP Business Agents" : "System settings — SAP Business Agents"}
  description={locale === "zh" ? "启用或停用 Agent Runtime，并管理本机 SDK、绑定 CLI 与系统默认模型。" : "Enable or disable Agent Runtimes and manage local SDKs, bundled CLIs, and system-default models."}
  locale={locale}
  alternateHref={settingsPath(base, other)}
>
  <div class="app-shell">
    <Sidebar locale={locale} counts={moduleCounts()} />
    <main id="main-content" class="main-content runtime-main"><SystemSettingsPanel locale={locale} /></main>
  </div>
</SiteLayout>
