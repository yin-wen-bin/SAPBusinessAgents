---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { Settings, Bot, History } from "@lucide/astro";
import SystemSettingsPanel from "../../components/SystemSettingsPanel.astro";
import QueryHistorySettings from "../../components/QueryHistorySettings.astro";
import "../../styles/settings-layout.css";
import { settingsPath } from "../../lib/urls";
import type { Locale } from "../../lib/types";

export function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}
const locale = Astro.params.lang as Locale;
const other: Locale = locale === "zh" ? "en" : "zh";
const base = import.meta.env.BASE_URL;
---

<SiteLayout
  title={locale === "zh" ? "系统配置 — SAP Business Agents" : "System settings — SAP Business Agents"}
  description={locale === "zh" ? "启用或停用 Agent Runtime，并管理本机 SDK、绑定 CLI 与系统默认模型。" : "Enable or disable Agent Runtimes and manage local SDKs, bundled CLIs, and system-default models."}
  locale={locale}
  alternateHref={settingsPath(base, other)}
>
  <div class="app-shell settings-shell" data-settings-shell data-locale={locale}>
    <nav class="settings-navigation" aria-label={locale === "zh" ? "系统配置导航" : "Settings navigation"}>
      <h2><Settings size={18} />{locale === "zh" ? "系统配置" : "Settings"}</h2>
      <a href="?section=runtime" data-settings-section="runtime"><Bot size={20} />AI Runtime</a>
      <a href="?section=history" data-settings-section="history"><History size={20} />{locale === "zh" ? "查询历史" : "Query history"}</a>
    </nav>
    <main id="main-content" class="main-content runtime-main">
      <div data-settings-pane="runtime"><SystemSettingsPanel locale={locale} /></div>
      <div data-settings-pane="history" hidden><QueryHistorySettings locale={locale} /></div>
    </main>
  </div>
</SiteLayout>
<script>
  import { initializeSettingsNavigation } from "../../lib/settingsNavigation";
  initializeSettingsNavigation();
</script>
