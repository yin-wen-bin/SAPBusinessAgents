---
import SiteLayout from "../../layouts/SiteLayout.astro";
import AgentManagementCenter from "../../components/AgentManagementCenter";
import { agentManagementPath, askPath, runPath } from "../../lib/urls";
import type { Locale } from "../../lib/types";

export function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}
const locale = Astro.params.lang as Locale;
const other: Locale = locale === "zh" ? "en" : "zh";
const base = import.meta.env.BASE_URL;
const apiBase = import.meta.env.PUBLIC_SAPBA_API_URL || "http://127.0.0.1:8765";
---

<SiteLayout
  title={locale === "zh" ? "Agent 管理中心 — SAP Business Agents" : "Agent management — SAP Business Agents"}
  description={locale === "zh" ? "管理确定性固定 Agent 的完整生命周期。" : "Manage the complete lifecycle of deterministic fixed Agents."}
  locale={locale}
  alternateHref={agentManagementPath(base, other)}
>
  <AgentManagementCenter apiBase={apiBase} locale={locale} runPath={runPath(base, locale)} askPath={askPath(base, locale)} client:load />
</SiteLayout>
