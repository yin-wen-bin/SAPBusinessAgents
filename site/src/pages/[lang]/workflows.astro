---
import SiteLayout from "../../layouts/SiteLayout.astro";
import WorkflowBuilder from "../../components/WorkflowBuilder";
import { runPath, workflowsPath } from "../../lib/urls";
import type { Locale } from "../../lib/types";

export function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}
const locale = Astro.params.lang as Locale;
const other: Locale = locale === "zh" ? "en" : "zh";
const base = import.meta.env.BASE_URL;
const apiBase = import.meta.env.PUBLIC_SAPBA_API_URL || "http://127.0.0.1:8765";
---

<SiteLayout
  title={locale === "zh" ? "工作流编排 — SAP Business Agents" : "Workflow builder — SAP Business Agents"}
  description={locale === "zh" ? "连接固定 Agent，真机验证并发布确定性只读工作流。" : "Connect fixed Agents, validate live, and publish deterministic read-only workflows."}
  locale={locale}
  alternateHref={workflowsPath(base, other)}
>
  <div id="main-content">
    <WorkflowBuilder apiBase={apiBase} locale={locale} runPath={runPath(base, locale)} client:load />
  </div>
</SiteLayout>
