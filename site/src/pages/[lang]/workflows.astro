---
import SiteLayout from "../../layouts/SiteLayout.astro";
import WorkflowCenter from "../../components/WorkflowCenter";
import { askPath, runPath, workflowsPath } from "../../lib/urls";
import type { Locale } from "../../lib/types";

export function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}
const locale = Astro.params.lang as Locale;
const other: Locale = locale === "zh" ? "en" : "zh";
const base = import.meta.env.BASE_URL;
const apiBase = import.meta.env.PUBLIC_SAPBA_API_URL || "http://127.0.0.1:8765";
---

<SiteLayout
  title={locale === "zh" ? "我的工作流 — SAP Business Agents" : "My workflows — SAP Business Agents"}
  description={locale === "zh" ? "查看、运行或创建确定性只读工作流。" : "View, run, or create deterministic read-only workflows."}
  locale={locale}
  alternateHref={workflowsPath(base, other)}
>
  <div id="main-content">
    <WorkflowCenter apiBase={apiBase} locale={locale} runPath={runPath(base, locale)} askPath={askPath(base, locale)} client:load />
  </div>
</SiteLayout>
