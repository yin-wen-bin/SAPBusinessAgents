---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import AgentCatalog from "../../components/AgentCatalog.astro";
import FreeQueryPanel from "../../components/FreeQueryPanel.astro";
import { getAgents, moduleCounts } from "../../lib/catalog";
import { homePath } from "../../lib/urls";
import type { Locale } from "../../lib/types";

export function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}

const locale = Astro.params.lang as Locale;
const agents = getAgents();
const counts = moduleCounts(agents);
const base = import.meta.env.BASE_URL;
const alternateLocale: Locale = locale === "zh" ? "en" : "zh";
const title = locale === "zh" ? "SAP Business Agents — SAP 业务 Agent 目录" : "SAP Business Agents — SAP business agent catalog";
const description = locale === "zh"
  ? "搜索和浏览 Common、FI、CO、SD、MM、PP 模块的 SAP 业务 Agent。"
  : "Search and browse SAP business agents for Common, FI, CO, SD, MM, and PP.";
---

<SiteLayout title={title} description={description} locale={locale} alternateHref={homePath(base, alternateLocale)}>
  <div class="app-shell">
    <Sidebar locale={locale} counts={counts} />
    <main id="main-content" class="main-content">
      <FreeQueryPanel locale={locale} />
      <AgentCatalog locale={locale} agents={agents} counts={counts} />
    </main>
  </div>
</SiteLayout>
