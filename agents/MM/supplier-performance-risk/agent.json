{
  "schemaVersion":2,"slug":"supplier-performance-risk","module":"MM",
  "title":{"zh":"供应商绩效与交付风险助手","en":"Supplier Performance and Delivery Risk Assistant"},
  "summary":{"zh":"按采购订单计划行和累计净收货计算有证据约束的 OTIF，并识别迟交、退货、冲销与供应商状态风险。","en":"Calculates evidence-constrained OTIF by PO schedule line and cumulative net receipts while flagging delays, returns, reversals, and supplier-status risks."},
  "status":"Deterministic prototype pending live validation","version":"0.1.0","owner":"MM-PUR / Supplier Management",
  "tags":["Supplier Performance","OTIF","Delivery Risk","Purchase Order"],"sapModules":["MM-PUR","MM-IM"],"transactions":["ME23N","ME2L","MB51","MK03"],"tables":["EKKO","EKPO","EKET","EKBE","MATDOC","MKPF","MSEG"],"systems":["SAP ECC","SAP S/4HANA"],
  "inputs":{"zh":["供应商","采购组织","可选工厂","起止日期（最长 365 天）"],"en":["Supplier","Purchasing organization","Optional plant","Date range up to 365 days"]},
  "outputs":{"zh":["正式或受抑制的 OTIF","到期计划行","迟交与不完整交付","退货/冲销风险","样本可信度"],"en":["Formal or suppressed OTIF","Due schedule lines","Late and incomplete deliveries","Return/reversal risk","Sample confidence"]},
  "guardrails":{"zh":["OTIF 按 schedule line 和累计净收货计算","少于 5 条到期计划行标记低样本","缺少完整交期或收货日期时不计算正式 OTIF","最长查询期间 365 天且只读"],"en":["Calculate OTIF by schedule line and cumulative net receipts","Flag fewer than five due schedule lines as low sample","Suppress formal OTIF without complete schedule or receipt dates","Limit queries to 365 days and keep them read-only"]},
  "workflow":[
    {"id":"parse-input","title":{"zh":"1. 解析输入","en":"1. Parse input"},"description":{"zh":"验证供应商、采购组织、可选工厂和最长 365 天期间。","en":"Validate supplier, purchasing organization, optional plant, and a maximum 365-day horizon."},"operations":{"zh":["要求供应商与采购组织精确值。"],"en":["Require exact supplier and purchasing-organization values."]},"tools":[{"name":"Input schema","kind":"Control","purpose":{"zh":"建立有界样本。","en":"Establishes a bounded sample."}}]},
    {"id":"check-embedded","title":{"zh":"2. 检查 Embedded Provider/schema","en":"2. Check Embedded Provider/schema"},"description":{"zh":"确认 embedded、read_only 及 PO、收货、供应商实时 schema。","en":"Confirm embedded selection, read-only state, and live PO, receipt, and supplier schemas."},"operations":{"zh":["验证计划行和收货日期字段。"],"en":["Validate schedule-line and receipt-date fields."]},"tools":[{"name":"embedded-sap-odata","kind":"SAP read Provider","purpose":{"zh":"提供 GET-only schema。","en":"Provides GET-only schemas."}}]},
    {"id":"read-api","title":{"zh":"3. 读取标准 API","en":"3. Read standard APIs"},"description":{"zh":"读取 PO、计划行、物料凭证和供应商状态。","en":"Read POs, schedule lines, material documents, and supplier status."},"operations":{"zh":["按供应商、采购组织、工厂和期间精确过滤。"],"en":["Filter exactly by supplier, purchasing organization, plant, and horizon."]},"tools":[{"name":"Released SAP OData APIs","kind":"SAP API","purpose":{"zh":"提供首选绩效证据。","en":"Provides preferred performance evidence."}}]},
    {"id":"assess-gap","title":{"zh":"4. 评估 API 证据缺口","en":"4. Assess API evidence gaps"},"description":{"zh":"检查 po_schedule、receipt 和 supplier 证据的字段、关联与分页。","en":"Check fields, relationships, and paging for po_schedule, receipt, and supplier evidence."},"operations":{"zh":["不把空结果解释为 100% OTIF。"],"en":["Do not interpret empty results as 100% OTIF."]},"tools":[{"name":"assess_api_evidence","kind":"Deterministic rule","purpose":{"zh":"识别需要 ADT 的范围。","en":"Identifies the ADT scope needed."}}]},
    {"id":"adt-fallback","title":{"zh":"5. 条件调用 sap-adt-table-export","en":"5. Conditionally call sap-adt-table-export"},"description":{"zh":"按缺口读取 EKET、EKBE、EKKO 或目标系统适用的 MATDOC/MKPF/MSEG；不限制对象、读取字段或过滤字段，由实时 DDIC 校验。","en":"Read EKET, EKBE, EKKO, or target-applicable MATDOC/MKPF/MSEG for gaps; do not restrict objects, selected fields, or filter fields, and validate them against live DDIC metadata."},"operations":{"zh":["所有查询保持供应商/采购组织/期间边界。"],"en":["Keep supplier/purchasing-organization/horizon bounds on every query."]},"tools":[{"name":"sap-adt-table-export","kind":"SAPSkillhub Skill","purpose":{"zh":"补充计划行和收货历史。","en":"Supplements schedule-line and receipt history."}}]},
    {"id":"merge-evidence","title":{"zh":"6. 合并并验证证据","en":"6. Merge and validate evidence"},"description":{"zh":"按 PO/item/schedule line 汇总净收货并检查完整性、分页和 manifest。","en":"Aggregate net receipts by PO/item/schedule line and validate completeness, paging, and manifest."},"operations":{"zh":["退货和冲销按负向证据处理。"],"en":["Treat returns and reversals as negative evidence."]},"tools":[{"name":"Evidence gate","kind":"Control","purpose":{"zh":"防止错误 OTIF。","en":"Prevents incorrect OTIF."}}]},
    {"id":"analyze","title":{"zh":"7. 执行确定性分析","en":"7. Run deterministic analysis"},"description":{"zh":"按承诺交期比较累计净收货数量与计划数量。","en":"Compare cumulative net receipts with scheduled quantity at the committed date."},"operations":{"zh":["样本不少于 5 且证据完整时才计算正式 OTIF。"],"en":["Calculate formal OTIF only with at least five samples and complete evidence."]},"tools":[{"name":"Supplier OTIF analyzer","kind":"Rule engine","purpose":{"zh":"计算受控绩效指标。","en":"Calculates controlled performance metrics."}}]},
    {"id":"present","title":{"zh":"8. 输出结论和限制","en":"8. Present conclusions and limits"},"description":{"zh":"输出 OTIF、样本量、风险、缺口和改善建议。","en":"Present OTIF, sample size, risks, gaps, and improvement actions."},"operations":{"zh":["证据不完整时输出 INCONCLUSIVE。"],"en":["Return INCONCLUSIVE when evidence is incomplete."]},"tools":[{"name":"Business report","kind":"Output","purpose":{"zh":"生成双语绩效报告。","en":"Creates a bilingual performance report."}}]}
  ],
  "execution":{"mode":"deterministic","timeoutSeconds":600,
    "inputSchema":{"type":"object","properties":{"supplier":{"type":"string","minLength":1,"maxLength":10,"pattern":"^[0-9A-Za-z]+$"},"purchasing_organization":{"type":"string","minLength":1,"maxLength":4,"pattern":"^[0-9A-Za-z_-]+$"},"plant":{"type":"string","minLength":1,"maxLength":4,"pattern":"^[0-9A-Za-z_-]+$"},"date_from":{"type":"string","format":"date"},"date_to":{"type":"string","format":"date"}},"required":["supplier","purchasing_organization","date_from","date_to"],"additionalProperties":false,"dateRangePairs":[{"from":"date_from","to":"date_to","maxDays":365}]},
    "outputSchema":{"type":"object","properties":{"supplier":{"type":"string"},"purchasing_organization":{"type":"string"},"business_status":{"type":"string"},"source_complete":{"type":"boolean"},"business_report":{"type":"object"}},"required":["supplier","purchasing_organization","business_status","source_complete","business_report"],"additionalProperties":false},
    "outputMapping":{"supplier":"{{steps.evaluate.output.workflow_output.supplier}}","purchasing_organization":"{{steps.evaluate.output.workflow_output.purchasing_organization}}","business_status":"{{steps.evaluate.output.workflow_output.business_status}}","source_complete":"{{steps.evaluate.output.workflow_output.source_complete}}","business_report":"{{steps.evaluate.output.workflow_output.business_report}}"},
    "steps":[
      {"id":"read_po","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_PURCHASEORDER_PROCESS_SRV","odata_version": "2.0","entity_set":"A_PurchaseOrder","http_method":"GET","plan_kind":"multi_step","steps":[{"step_id":"po_headers","service_name":"API_PURCHASEORDER_PROCESS_SRV","odata_version": "2.0","entity_set":"A_PurchaseOrder","http_method":"GET","select_fields":["PurchaseOrder","Supplier","PurchasingOrganization","PurchaseOrderDate"],"filters":[{"field":"Supplier","operator":"eq","value":"{{input.supplier}}","value_type":"string"},{"field":"PurchasingOrganization","operator":"eq","value":"{{input.purchasing_organization}}","value_type":"string"},{"field":"PurchaseOrderDate","operator":"ge","value":"{{input.date_from}}","value_type":"date"},{"field":"PurchaseOrderDate","operator":"le","value":"{{input.date_to}}","value_type":"date"}]},{"step_id":"receipts","service_name":"API_MATERIAL_DOCUMENT_SRV","odata_version": "2.0","entity_set":"A_MaterialDocumentItem","http_method":"GET","select_fields":["MaterialDocument","MaterialDocumentYear","MaterialDocumentItem","PurchaseOrder","PurchaseOrderItem","Supplier","Plant","GoodsMovementType","QuantityInEntryUnit","EntryUnit","DebitCreditCode","GoodsMovementIsCancelled"],"filter_from_previous":[{"field":"PurchaseOrder","source_step_id":"po_headers","source_field":"PurchaseOrder","fanout":true,"fetch_all_for_binding":true}]}],"rationale":"Collect supplier PO and receipt core evidence within the 365-day PO horizon; schedule and posting dates require fallback."}}},
      {"id":"read_po_schedule","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_PURCHASEORDER_PROCESS_SRV","odata_version": "2.0","entity_set":"A_PurchaseOrderScheduleLine","http_method":"GET","plan_kind":"direct","select_fields":["PurchaseOrder","PurchaseOrderItem","ScheduleLine","Supplier","PurchasingOrganization","Plant","ScheduleLineDeliveryDate","ScheduleLineOrderQuantity","OrderQuantityUnit"],"filters":[{"field":"Supplier","operator":"eq","value":"{{input.supplier}}","value_type":"string"},{"field":"PurchasingOrganization","operator":"eq","value":"{{input.purchasing_organization}}","value_type":"string"},{"field":"ScheduleLineDeliveryDate","operator":"ge","value":"{{input.date_from}}","value_type":"date"},{"field":"ScheduleLineDeliveryDate","operator":"le","value":"{{input.date_to}}","value_type":"date"}],"rationale":"Collect schedule-line evidence within the bounded horizon when the live API exposes supplier-scoped fields."}}},
      {"id":"read_receipt_dates","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_PURCHASEORDER_PROCESS_SRV","odata_version": "2.0","entity_set":"A_PurchaseOrder","http_method":"GET","plan_kind":"multi_step","steps":[{"step_id":"date_scope_po","service_name":"API_PURCHASEORDER_PROCESS_SRV","odata_version": "2.0","entity_set":"A_PurchaseOrder","http_method":"GET","select_fields":["PurchaseOrder"],"filters":[{"field":"Supplier","operator":"eq","value":"{{input.supplier}}","value_type":"string"},{"field":"PurchasingOrganization","operator":"eq","value":"{{input.purchasing_organization}}","value_type":"string"},{"field":"PurchaseOrderDate","operator":"ge","value":"{{input.date_from}}","value_type":"date"},{"field":"PurchaseOrderDate","operator":"le","value":"{{input.date_to}}","value_type":"date"}]},{"step_id":"receipt_dates","service_name":"API_MATERIAL_DOCUMENT_SRV","odata_version": "2.0","entity_set":"A_MaterialDocumentItem","http_method":"GET","select_fields":["MaterialDocument","MaterialDocumentYear","MaterialDocumentItem","PurchaseOrder","PurchaseOrderItem","PostingDate"],"filter_from_previous":[{"field":"PurchaseOrder","source_step_id":"date_scope_po","source_field":"PurchaseOrder","fanout":true,"fetch_all_for_binding":true}]}],"rationale":"Collect receipt posting dates for exact POs in the bounded horizon when exposed."}}},
      {"id":"read_supplier","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_BUSINESS_PARTNER","odata_version": "2.0","entity_set":"A_SupplierPurchasingOrg","http_method":"GET","plan_kind":"direct","select_fields":["Supplier","PurchasingOrganization","PurchasingIsBlockedForSupplier","DeletionIndicator"],"filters":[{"field":"Supplier","operator":"eq","value":"{{input.supplier}}","value_type":"string"},{"field":"PurchasingOrganization","operator":"eq","value":"{{input.purchasing_organization}}","value_type":"string"}],"rationale":"Collect bounded supplier status evidence."}}},
      {"id":"assess","executor":"rule","operation":"assess_api_evidence","inputMapping":{"checks":{"po_schedule":{"core":"{{steps.read_po.output}}","schedule":"{{steps.read_po_schedule.output}}"},"receipt":{"core":"{{steps.read_po.output}}","dates":"{{steps.read_receipt_dates.output}}"},"supplier":"{{steps.read_supplier.output}}"}}},
      {"id":"adt_po_scope","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.po_schedule}}","equals":true},"inputMapping":{"schema_version":1,"source_type":"table","object":"EKKO","fields":["EBELN","LIFNR","EKORG"],"filters":[{"field":"LIFNR","operator":"eq","value":"{{input.supplier}}"},{"field":"EKORG","operator":"eq","value":"{{input.purchasing_organization}}"}],"max_rows":100}},
      {"id":"po_numbers","executor":"rule","operation":"extract_bounded_values","inputMapping":{"payload":"{{steps.adt_po_scope.output}}","field":"EBELN","max_values":100}},
