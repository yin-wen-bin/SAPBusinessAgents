      {"id":"adt_receipt","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.receipt_po_numbers.output.has_values}}","equals":true},"inputMapping":{"schema_version":1,"source_type":"table","object":"EKBE","fields":["EBELN","EBELP","ZEKKN","VGABE","GJAHR","BELNR","BUZEI","BUDAT","MENGE","SHKZG","BWART"],"filters":[{"field":"EBELN","operator":"in","values":"{{steps.receipt_po_numbers.output.values}}"},{"field":"BUDAT","operator":"bt","low":"{{input.date_from}}","high":"{{input.date_to}}"}],"max_rows":30000}},
      {"id":"adt_supplier","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.supplier}}","equals":true},"inputMapping":{"schema_version":1,"source_type":"table","object":"EKKO","fields":["EBELN","LIFNR","EKORG","LOEKZ"],"filters":[{"field":"LIFNR","operator":"eq","value":"{{input.supplier}}"},{"field":"EKORG","operator":"eq","value":"{{input.purchasing_organization}}"}],"max_rows":30000}},
      {"id":"evaluate","executor":"rule","operation":"evaluate_business_agent","inputMapping":{"agent_id":"supplier-performance-risk","run_input":"{{input}}","assessment":"{{steps.assess.output}}","evidence":{"po":"{{steps.read_po.output}}","po_schedule":"{{steps.read_po_schedule.output}}","receipt":"{{steps.read_po.output}}","receipt_dates":"{{steps.read_receipt_dates.output}}","supplier":"{{steps.read_supplier.output}}"},"fallbacks":{"po_schedule":{"scope":"{{steps.adt_po_scope.output}}","detail":"{{steps.adt_po.output}}"},"receipt":{"scope":"{{steps.adt_receipt_scope.output}}","detail":"{{steps.adt_receipt.output}}"},"supplier":"{{steps.adt_supplier.output}}"},"known_gaps":[]}}
    ]},
