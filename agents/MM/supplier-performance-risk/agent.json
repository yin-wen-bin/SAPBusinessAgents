      {"id":"adt_receipt_scope","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.receipt}}","equals":true},"inputMapping":{"schema_version":1,"source_type":"table","object":"EKKO","fields":["EBELN","LIFNR","EKORG"],"filters":[{"field":"LIFNR","operator":"eq","value":"{{input.supplier}}"},{"field":"EKORG","operator":"eq","value":"{{input.purchasing_organization}}"}],"max_rows":100}},
