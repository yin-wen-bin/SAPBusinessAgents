{
  "schemaVersion": 2,
  "slug": "supplier-performance-risk",
  "module": "MM",
  "title": {
    "zh": "供应商绩效与交付风险助手",
    "en": "Supplier Performance and Delivery Risk Assistant"
  },
  "summary": {
    "zh": "按采购订单计划行和累计净收货计算有证据约束的准时足量交付率(OTIF)，并识别迟交、退货、冲销与供应商状态风险。",
    "en": "Calculates evidence-constrained On Time In Full (OTIF) by PO schedule line and cumulative net receipts while flagging delays, returns, reversals, and supplier-status risks."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.2.2",
  "owner": "MM-PUR / Supplier Management",
  "tags": [
    "Supplier Performance",
    "OTIF",
    "Delivery Risk",
    "Purchase Order"
  ],
