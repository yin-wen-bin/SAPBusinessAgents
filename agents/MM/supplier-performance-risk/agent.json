  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {
      "type": "object",
      "properties": {
        "supplier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "x-sapba-sap-identifier": true,
          "title": {
            "zh": "供应商",
            "en": "Supplier"
          },
          "description": {
            "zh": "输入 SAP 中的完整供应商代码；允许企业供应商编码中的连字符等非控制字符。",
            "en": "Enter the complete SAP supplier ID; enterprise supplier IDs may contain non-control characters such as hyphens."
          }
        },
        "purchasing_organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "采购组织",
            "en": "Purchasing organization"
          }
        },
        "plant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "工厂",
            "en": "Plant"
          }
        },
        "date_from": {
          "type": "string",
          "format": "date",
          "title": {
            "zh": "开始日期",
            "en": "Date From"
          }
        },
        "date_to": {
          "type": "string",
          "format": "date",
          "title": {
            "zh": "结束日期",
            "en": "Date To"
          }
        }
      },
      "required": [
        "supplier",
        "purchasing_organization",
        "date_from",
        "date_to"
      ],
      "additionalProperties": false,
      "dateRangePairs": [
        {
          "from": "date_from",
          "to": "date_to",
          "maxDays": 365
        }
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "supplier": {
          "type": "string",
          "title": {
            "zh": "供应商",
            "en": "Supplier"
          }
        },
        "purchasing_organization": {
          "type": "string",
          "title": {
            "zh": "采购组织",
            "en": "Purchasing organization"
          }
        },
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "supplier",
        "purchasing_organization",
        "business_status",
        "source_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "supplier": "{{steps.evaluate.output.workflow_output.supplier}}",
      "purchasing_organization": "{{steps.evaluate.output.workflow_output.purchasing_organization}}",
      "business_status": "{{steps.evaluate.output.workflow_output.business_status}}",
      "source_complete": "{{steps.evaluate.output.workflow_output.source_complete}}",
      "business_report": "{{steps.evaluate.output.workflow_output.business_report}}"
    },
    "steps": [
      {
        "id": "read_po",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_PURCHASEORDER_PROCESS_SRV",
            "odata_version": "2.0",
            "entity_set": "A_PurchaseOrder",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "po_headers",
                "service_name": "API_PURCHASEORDER_PROCESS_SRV",
                "odata_version": "2.0",
                "entity_set": "A_PurchaseOrder",
                "http_method": "GET",
                "select_fields": [
                  "PurchaseOrder",
                  "Supplier",
                  "PurchasingOrganization",
                  "PurchaseOrderDate"
                ],
                "filters": [
                  {
                    "field": "Supplier",
                    "operator": "eq",
                    "value": "{{input.supplier}}",
                    "value_type": "string"
                  },
                  {
                    "field": "PurchasingOrganization",
                    "operator": "eq",
                    "value": "{{input.purchasing_organization}}",
                    "value_type": "string"
                  },
                  {
                    "field": "PurchaseOrderDate",
                    "operator": "ge",
                    "value": "{{input.date_from}}",
                    "value_type": "date"
                  },
                  {
                    "field": "PurchaseOrderDate",
                    "operator": "le",
                    "value": "{{input.date_to}}",
                    "value_type": "date"
                  }
                ]
              },
              {
                "step_id": "receipts",
                "service_name": "API_MATERIAL_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_MaterialDocumentItem",
                "http_method": "GET",
                "select_fields": [
                  "MaterialDocument",
                  "MaterialDocumentYear",
                  "MaterialDocumentItem",
                  "PurchaseOrder",
                  "PurchaseOrderItem",
                  "Supplier",
                  "Plant",
                  "GoodsMovementType",
                  "QuantityInEntryUnit",
                  "EntryUnit",
                  "DebitCreditCode",
                  "GoodsMovementIsCancelled"
                ],
                "filter_from_previous": [
                  {
                    "field": "PurchaseOrder",
                    "source_step_id": "po_headers",
                    "source_field": "PurchaseOrder",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              }
            ],
            "rationale": "Collect supplier PO and receipt core evidence within the 365-day PO horizon; schedule and posting dates require fallback."
          }
        }
      },
      {
        "id": "read_po_schedule",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_PURCHASEORDER_PROCESS_SRV",
            "odata_version": "2.0",
            "entity_set": "A_PurchaseOrder",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "schedule_po_headers",
                "service_name": "API_PURCHASEORDER_PROCESS_SRV",
                "odata_version": "2.0",
                "entity_set": "A_PurchaseOrder",
                "http_method": "GET",
                "select_fields": [
                  "PurchaseOrder",
                  "Supplier",
                  "PurchasingOrganization",
                  "PurchaseOrderDate"
                ],
                "filters": [
                  {
                    "field": "Supplier",
                    "operator": "eq",
                    "value": "{{input.supplier}}",
                    "value_type": "string"
                  },
                  {
                    "field": "PurchasingOrganization",
