{
  "schemaVersion": 2,
  "slug": "procure-to-pay-status",
  "module": "MM",
  "title": {
    "zh": "采购到付款状态助手",
    "en": "Procure-to-Pay Status Assistant"
  },
  "summary": {
    "zh": "一次接收最多 50 张采购订单，分块查询 PO、收货、发票、FI 与付款凭证，并逐单解释端到端状态、阻塞原因和 AP 交接证据。",
    "en": "Accepts up to 50 purchase orders, queries PO, receipt, invoice, FI, and payment evidence in bounded chunks, and explains per-PO status, blockers, and typed AP handoff evidence."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.3.1",
  "owner": "MM / FI-AP",
  "tags": [
    "Procure-to-Pay",
    "Purchase Order",
    "Document Flow",
    "Status"
  ],
  "sapModules": [
    "MM-PUR",
    "MM-IM",
    "MM-IV",
    "FI-AP"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "采购订单号列表"
    ],
    "en": [
      "Purchase orders"
    ]
  },
  "outputs": {
    "zh": [
      "采购订单列表",
      "公司代码列表",
      "供应商列表",
      "逐采购订单结果",
      "应付账款证据分组",
      "业务状态",
      "查询源完整性",
      "业务证据完整性",
      "结构化业务报告"
    ],
    "en": [
      "Purchase orders",
      "Company codes",
      "Suppliers",
      "Per-PO results",
      "AP evidence scopes",
      "Business status",
      "Query-source completeness",
      "Business-evidence completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "只读追踪，不创建后续凭证",
      "冲销与贷项按净额处理",
      "仅有清账号不自动等同于付款"
    ],
    "en": [
      "Read-only trace; never creates follow-on documents",
      "Reversals and credits are netted",
      "A clearing number alone is not assumed to be payment"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_p2p_evidence",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "校验 1–50 个唯一数字 PO，按每组最多 10 张拆分 GET 请求；每块和每个分页都成功后才把查询源标记为完整。",
        "en": "Validate 1–50 unique numeric POs and split GET requests into chunks of at most 10; query-source completeness is true only when every chunk and page succeeds."
      },
      "operations": {
        "zh": [
          "校验 purchase_orders 数组；拒绝空值、重复值、字符串冒充数组和超过 50 张的批次，不自动补零。",
          "把采购订单号按 10 张一组拆分；同一步只允许一个可分块的直接 in 过滤，最多并发 4 组。",
          "GET API_PURCHASEORDER_PROCESS_SRV@2.0/A_PurchaseOrder",
          "GET API_PURCHASEORDER_PROCESS_SRV@2.0/A_PurchaseOrderItem",
          "GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentItem",
          "按物料凭证号和年度关联 GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentHeader",
          "GET API_SUPPLIERINVOICE_PROCESS_SRV@2.0/A_SuplrInvcItemPurOrdRef",
          "按发票号和年度关联 GET API_SUPPLIERINVOICE_PROCESS_SRV@2.0/A_SupplierInvoice",
          "从 PO 引用的发票 FI 凭证扩展 GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube，再按清账凭证键读取付款凭证类型。",
          "所有块读取至 has_next=false；任一块失败、截断或超过结果上限时 source_complete=false。"
        ],
        "en": [
          "Validate the purchase_orders array; reject empty, duplicate, scalar-string, or over-50 input without zero-padding identifiers.",
          "Split PO numbers into groups of 10; allow one directly chunked in-filter per step and run at most four chunks concurrently.",
          "GET API_PURCHASEORDER_PROCESS_SRV@2.0/A_PurchaseOrder",
          "GET API_PURCHASEORDER_PROCESS_SRV@2.0/A_PurchaseOrderItem",
          "GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentItem",
          "Join material-document number and year to GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentHeader",
          "GET API_SUPPLIERINVOICE_PROCESS_SRV@2.0/A_SuplrInvcItemPurOrdRef",
          "Join supplier-invoice number and year to GET API_SUPPLIERINVOICE_PROCESS_SRV@2.0/A_SupplierInvoice",
          "Expand invoice FI documents referenced by each PO through GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube, then read payment-document types by clearing key.",
          "Read every chunk until has_next=false; any failed, truncated, or over-limit chunk makes source_complete=false."
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_p2p_evidence` / `execute_plan`",
            "en": "Execute `collect_p2p_evidence` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_p2p_evidence"
      ]
    },
    {
      "id": "execute-validate_p2p_evidence",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "按输入顺序隔离每张 PO 的技术键和证据，计算净收货、净发票、GR/IR、清账与付款凭证，并生成按公司代码和供应商分组的最小化 AP 证据。",
        "en": "Isolate technical keys and evidence per PO in input order, calculate net receipt, invoice, GR/IR, clearing, and payment-document status, then produce minimal AP evidence grouped by company code and supplier."
      },
      "operations": {
        "zh": [
          "按 PO 技术键隔离收货、发票、FI 和清账记录，防止批次内串数据。",
          "净额处理多次收货、退货、冲销、多发票和贷项；单位或币种不可比较时只将对应结论标记为 inconclusive。",
          "只有清账凭证类型属于 KZ/ZP/PY 时确认 SAP 付款凭证；该结论不代表银行实际扣款。",
          "逐 PO 输出 po_results[]，批次业务状态按 inconclusive > not_found > blocked > in_progress > complete 汇总。",
          "按公司代码 + 供应商生成 ap_payment_scopes[]，只携带发票/FI/清账键、到期日、冻结、金额币种、证据引用和完整性。",
          "顶层 source_complete 与 evidence_complete 分别取所有 PO 的逻辑 AND。"
        ],
        "en": [
          "Partition receipt, invoice, FI, and clearing rows by PO technical keys so evidence cannot leak across the batch.",
          "Net multiple receipts, returns, reversals, invoices, and credits; make only the affected conclusion inconclusive when units or currencies cannot be compared.",
          "Confirm an SAP payment document only when the clearing document type is KZ, ZP, or PY; this does not prove an actual bank debit.",
          "Emit po_results[] in input order and aggregate batch status by inconclusive > not_found > blocked > in_progress > complete.",
          "Build ap_payment_scopes[] by company code and supplier with only invoice/FI/clearing keys, due date, block, amount/currency, evidence references, and completeness.",
          "Compute top-level source_complete and evidence_complete as separate logical AND values across all POs."
        ]
      },
      "tools": [
        {
          "name": "evaluate_p2p_status",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `validate_p2p_evidence` / `evaluate_p2p_status`",
            "en": "Execute `validate_p2p_evidence` / `evaluate_p2p_status`"
          }
        }
      ],
      "executionStepIds": [
        "validate_p2p_evidence"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "purchase_orders": {
          "type": "array",
          "title": {
            "zh": "采购订单号列表",
            "en": "Purchase orders"
          },
          "description": {
            "zh": "输入 1 至 50 个采购订单号，可使用换行、逗号或分号分隔。",
            "en": "Enter 1 to 50 purchase-order numbers separated by new lines, commas, or semicolons."
          },
          "placeholder": {
            "zh": "例如：4500000030\n4500000031",
            "en": "Example: 4500000030\n4500000031"
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10,
            "pattern": "^[0-9]+$"
          }
        }
      },
      "required": [
        "purchase_orders"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "purchase_orders": {
          "type": "array",
          "title": {
            "zh": "采购订单列表",
            "en": "Purchase orders"
          },
          "items": {"type": "string"}
        },
        "company_codes": {
          "type": "array",
          "title": {
            "zh": "公司代码列表",
            "en": "Company codes"
          },
          "items": {"type": "string"}
        },
        "suppliers": {
          "type": "array",
          "title": {
            "zh": "供应商列表",
            "en": "Suppliers"
          },
          "items": {"type": "string"}
        },
        "po_results": {
          "type": "array",
          "title": {
            "zh": "逐采购订单结果",
            "en": "Per-PO results"
          },
          "items": {
            "type": "object",
            "properties": {
              "purchase_order": {"type": "string"},
              "company_code": {"type": "string"},
              "supplier": {"type": "string"},
              "business_status": {"type": "string", "enum": ["inconclusive", "not_found", "blocked", "in_progress", "complete"]},
              "source_complete": {"type": "boolean"},
              "evidence_complete": {"type": "boolean"},
              "gr_ir_match_status": {"type": "string"},
              "ap_clearing_status": {"type": "string"},
              "payment_document_status": {"type": "string"},
              "bank_settlement_status": {"type": "string", "const": "not_assessed"},
              "business_report": {"type": "object"}
            },
            "required": ["purchase_order", "company_code", "supplier", "business_status", "source_complete", "evidence_complete", "gr_ir_match_status", "ap_clearing_status", "payment_document_status", "bank_settlement_status", "business_report"],
            "additionalProperties": false
          }
        },
        "ap_payment_scopes": {
          "type": "array",
          "maxItems": 50,
          "title": {
            "zh": "应付账款证据分组",
            "en": "AP evidence scopes"
          },
          "items": {
            "type": "object",
            "properties": {
              "scope_id": {"type": "string"},
              "company_code": {"type": "string"},
              "supplier": {"type": "string"},
              "purchase_orders": {"type": "array", "items": {"type": "string"}},
              "supplier_invoices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "supplier_invoice": {"type": "string"},
                    "fiscal_year": {"type": "string"},
                    "supplier_invoice_items": {"type": "array", "items": {"type": "string"}}
                  },
                  "required": ["supplier_invoice", "fiscal_year", "supplier_invoice_items"],
                  "additionalProperties": false
                }
              },
              "fi_supplier_items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "purchase_order": {"type": "string"},
                    "purchase_order_item": {"type": "string"},
                    "company_code": {"type": "string"},
                    "supplier": {"type": "string"},
                    "fiscal_year": {"type": "string"},
                    "accounting_document": {"type": "string"},
                    "accounting_document_item": {"type": "string"},
                    "original_reference_document": {"type": "string"},
                    "posting_date": {"type": "string"},
                    "net_due_date": {"type": "string"},
                    "cash_discount_due_date": {"type": "string"},
                    "payment_blocking_reason": {"type": "string"},
                    "amount": {"type": "string"},
                    "currency": {"type": "string"},
                    "amount_allocation_ratio": {"type": "string"},
                    "amount_attribution_status": {"type": "string"},
                    "is_cleared": {"type": "boolean"},
                    "clearing_document": {"type": "string"},
                    "clearing_fiscal_year": {"type": "string"},
                    "clearing_date": {"type": "string"},
                    "payment_method": {"type": "string"},
                    "clearing_document_type": {"type": "string"},
                    "payment_document_status": {"type": "string"}
                  },
                  "required": ["purchase_order", "company_code", "supplier", "is_cleared"],
                  "additionalProperties": false
                }
              },
              "source_complete": {"type": "boolean"},
              "evidence_complete": {"type": "boolean"},
              "payment_run_evidence_complete": {"type": "boolean"},
              "bank_master_evidence_complete": {"type": "boolean"},
              "bank_settlement_evidence_complete": {"type": "boolean"},
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["scope_id", "company_code", "supplier", "purchase_orders", "supplier_invoices", "fi_supplier_items", "source_complete", "evidence_complete", "payment_run_evidence_complete", "bank_master_evidence_complete", "bank_settlement_evidence_complete", "evidence_refs"],
            "additionalProperties": false
          }
        },
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "evidence_complete": {
          "type": "boolean",
          "title": {
            "zh": "业务证据完整性",
            "en": "Business-evidence completeness"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "purchase_orders",
        "company_codes",
        "suppliers",
        "po_results",
        "ap_payment_scopes",
        "business_status",
        "source_complete",
        "evidence_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "purchase_orders": "{{steps.validate_p2p_evidence.output.workflow_output.purchase_orders}}",
      "company_codes": "{{steps.validate_p2p_evidence.output.workflow_output.company_codes}}",
      "suppliers": "{{steps.validate_p2p_evidence.output.workflow_output.suppliers}}",
      "po_results": "{{steps.validate_p2p_evidence.output.workflow_output.po_results}}",
      "ap_payment_scopes": "{{steps.validate_p2p_evidence.output.workflow_output.ap_payment_scopes}}",
      "business_status": "{{steps.validate_p2p_evidence.output.workflow_output.business_status}}",
      "source_complete": "{{steps.validate_p2p_evidence.output.workflow_output.source_complete}}",
      "evidence_complete": "{{steps.validate_p2p_evidence.output.workflow_output.evidence_complete}}",
      "business_report": "{{steps.validate_p2p_evidence.output.workflow_output.business_report}}"
    },
    "steps": [
      {
        "id": "collect_p2p_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_PURCHASEORDER_PROCESS_SRV",
            "odata_version": "2.0",
            "entity_set": "A_PurchaseOrder",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "target_entity_set": "A_OperationalAcctgDocItemCube",
            "steps": [
              {
                "step_id": "purchase_order",
                "service_name": "API_PURCHASEORDER_PROCESS_SRV",
                "odata_version": "2.0",
                "entity_set": "A_PurchaseOrder",
                "http_method": "GET",
                "select_fields": [
                  "PurchaseOrder",
                  "CompanyCode",
                  "Supplier",
                  "DocumentCurrency",
                  "PurchaseOrderDate",
                  "PurchasingDocumentDeletionCode"
                ],
                "order_by": [
                  "PurchaseOrder"
                ],
                "filters": [
                  {
                    "field": "PurchaseOrder",
                    "operator": "in",
                    "value": "{{input.purchase_orders}}",
                    "value_type": "string",
                    "chunk_size": 10
                  }
                ],
                "max_concurrent_chunks": 4,
                "rationale": "Load the requested PO header."
              },
              {
                "step_id": "purchase_order_items",
                "service_name": "API_PURCHASEORDER_PROCESS_SRV",
                "odata_version": "2.0",
                "entity_set": "A_PurchaseOrderItem",
                "http_method": "GET",
                "select_fields": [
                  "PurchaseOrder",
                  "PurchaseOrderItem",
                  "Material",
                  "Plant",
                  "OrderQuantity",
                  "PurchaseOrderQuantityUnit",
                  "DocumentCurrency",
                  "PurchasingDocumentDeletionCode",
                  "IsCompletelyDelivered",
                  "IsFinallyInvoiced"
                ],
                "order_by": [
                  "PurchaseOrder",
                  "PurchaseOrderItem"
                ],
                "filters": [
                  {
                    "field": "PurchaseOrder",
                    "operator": "in",
                    "value": "{{input.purchase_orders}}",
                    "value_type": "string",
                    "chunk_size": 10
                  }
                ],
                "max_concurrent_chunks": 4,
                "rationale": "Load every item for the requested PO."
              },
              {
                "step_id": "material_documents",
                "service_name": "API_MATERIAL_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_MaterialDocumentItem",
                "http_method": "GET",
                "select_fields": [
                  "MaterialDocumentYear",
                  "MaterialDocument",
                  "MaterialDocumentItem",
                  "PurchaseOrder",
                  "PurchaseOrderItem",
                  "GoodsMovementType",
                  "GoodsMovementIsCancelled",
                  "ReversedMaterialDocumentYear",
                  "ReversedMaterialDocument",
                  "ReversedMaterialDocumentItem",
                  "QuantityInEntryUnit",
                  "EntryUnit",
                  "QuantityInBaseUnit",
                  "MaterialBaseUnit",
                  "DebitCreditCode",
                  "Supplier"
                ],
                "order_by": [
                  "MaterialDocumentYear",
                  "MaterialDocument",
                  "MaterialDocumentItem"
                ],
                "filters": [
                  {
                    "field": "PurchaseOrder",
                    "operator": "in",
                    "value": "{{input.purchase_orders}}",
                    "value_type": "string",
                    "chunk_size": 10
                  }
                ],
                "max_concurrent_chunks": 4,
                "rationale": "Load receipt, return and reversal evidence."
              },
              {
                "step_id": "material_document_headers",
                "service_name": "API_MATERIAL_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_MaterialDocumentHeader",
                "http_method": "GET",
                "select_fields": [
                  "MaterialDocumentYear",
                  "MaterialDocument",
                  "PostingDate",
                  "DocumentDate"
                ],
                "order_by": [
                  "MaterialDocumentYear",
                  "MaterialDocument"
                ],
                "filter_from_previous": [
                  {
                    "field": "MaterialDocument",
                    "source_step_id": "material_documents",
                    "source_field": "MaterialDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "MaterialDocumentYear",
                    "source_step_id": "material_documents",
                    "source_field": "MaterialDocumentYear",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ],
                "rationale": "Load posting dates for every material-document key."
              },
              {
                "step_id": "supplier_invoice_items",
                "service_name": "API_SUPPLIERINVOICE_PROCESS_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SuplrInvcItemPurOrdRef",
                "http_method": "GET",
                "select_fields": [
                  "SupplierInvoice",
                  "FiscalYear",
                  "SupplierInvoiceItem",
                  "PurchaseOrder",
                  "PurchaseOrderItem",
                  "Plant",
                  "DocumentCurrency",
                  "SupplierInvoiceItemAmount",
                  "QuantityInPurchaseOrderUnit",
                  "PurchaseOrderQuantityUnit",
                  "IsSubsequentDebitCredit",
                  "IsFinallyInvoiced"
                ],
                "order_by": [
                  "FiscalYear",
                  "SupplierInvoice",
                  "SupplierInvoiceItem"
                ],
                "filters": [
                  {
                    "field": "PurchaseOrder",
                    "operator": "in",
                    "value": "{{input.purchase_orders}}",
                    "value_type": "string",
                    "chunk_size": 10
                  }
                ],
                "max_concurrent_chunks": 4,
                "rationale": "Load supplier-invoice references for the PO."
              },
              {
                "step_id": "supplier_invoice_headers",
                "service_name": "API_SUPPLIERINVOICE_PROCESS_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SupplierInvoice",
                "http_method": "GET",
                "select_fields": [
                  "SupplierInvoice",
                  "FiscalYear",
                  "CompanyCode",
                  "DocumentDate",
                  "PostingDate",
                  "DocumentCurrency",
                  "InvoiceGrossAmount",
                  "SupplierInvoiceStatus",
                  "SupplierInvoiceIsCreditMemo",
                  "IsReversal",
                  "IsReversed",
                  "ReverseDocument",
                  "ReverseDocumentFiscalYear"
                ],
                "order_by": [
                  "FiscalYear",
                  "SupplierInvoice"
                ],
                "filter_from_previous": [
                  {
                    "field": "SupplierInvoice",
                    "source_step_id": "supplier_invoice_items",
                    "source_field": "SupplierInvoice",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "FiscalYear",
                    "source_step_id": "supplier_invoice_items",
                    "source_field": "FiscalYear",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ],
                "rationale": "Confirm posting, credit-memo and reversal status for every supplier invoice."
              },
              {
                "step_id": "accounting_items",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "PurchasingDocument",
                  "PurchasingDocumentItem",
                  "Supplier",
                  "AccountingDocumentType",
                  "OriginalReferenceDocument",
                  "InvoiceReference",
                  "InvoiceReferenceFiscalYear",
                  "GLAccount",
                  "FinancialAccountType",
                  "DebitCreditCode",
                  "AmountInCompanyCodeCurrency",
                  "CompanyCodeCurrency",
                  "ClearingAccountingDocument",
                  "ClearingDocFiscalYear",
                  "ClearingDate",
                  "IsCleared",
                  "PostingDate",
                  "NetDueDate",
                  "CashDiscount1DueDate",
                  "PaymentBlockingReason",
                  "AmountInTransactionCurrency",
                  "TransactionCurrency",
                  "PaymentMethod",
                  "HouseBank",
                  "HouseBankAccount"
