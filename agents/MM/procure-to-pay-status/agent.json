{
  "schemaVersion": 2,
  "slug": "procure-to-pay-status",
  "module": "MM",
  "title": {
    "zh": "采购到付款状态助手",
    "en": "Procure-to-Pay Status Assistant"
  },
  "summary": {
    "zh": "从采购订单出发，跨 PO、收货、发票、FI 与付款凭证逐行项目判断端到端状态和阻塞原因。",
    "en": "Traces each PO item across receipt, invoice, FI and payment documents to explain end-to-end status and blockers."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.1.0",
  "owner": "MM / FI-AP",
  "tags": [
    "Procure-to-Pay",
    "Purchase Order",
    "Document Flow",
    "Status"
  ],
  "sapModules": [
    "MM-PUR",
    "MM-IM",
    "MM-IV",
    "FI-AP"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "采购订单号"
    ],
    "en": [
      "Purchase order"
    ]
  },
  "outputs": {
    "zh": [
      "采购订单",
      "公司代码",
      "供应商",
      "业务状态",
      "查询源完整性",
      "结构化业务报告"
    ],
    "en": [
      "Purchase order",
      "Company code",
      "Supplier",
      "Business status",
      "Query-source completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "只读追踪，不创建后续凭证",
      "冲销与贷项按净额处理",
      "仅有清账号不自动等同于付款"
    ],
    "en": [
      "Read-only trace; never creates follow-on documents",
      "Reversals and credits are netted",
      "A clearing number alone is not assumed to be payment"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_p2p_evidence",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_p2p_evidence`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_p2p_evidence` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_PURCHASEORDER_PROCESS_SRV@2.0/A_PurchaseOrder",
          "GET API_PURCHASEORDER_PROCESS_SRV@2.0/A_PurchaseOrderItem",
          "GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentItem",
          "GET API_SUPPLIERINVOICE_PROCESS_SRV@2.0/A_SuplrInvcItemPurOrdRef",
          "GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube"
        ],
        "en": [
          "GET API_PURCHASEORDER_PROCESS_SRV@2.0/A_PurchaseOrder",
          "GET API_PURCHASEORDER_PROCESS_SRV@2.0/A_PurchaseOrderItem",
          "GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentItem",
          "GET API_SUPPLIERINVOICE_PROCESS_SRV@2.0/A_SuplrInvcItemPurOrdRef",
          "GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_p2p_evidence` / `execute_plan`",
            "en": "Execute `collect_p2p_evidence` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_p2p_evidence"
      ]
    },
    {
      "id": "execute-validate_p2p_evidence",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `validate_p2p_evidence`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `validate_p2p_evidence` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_p2p_status"
        ],
        "en": [
          "rule.evaluate_p2p_status"
        ]
      },
      "tools": [
        {
          "name": "evaluate_p2p_status",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `validate_p2p_evidence` / `evaluate_p2p_status`",
            "en": "Execute `validate_p2p_evidence` / `evaluate_p2p_status`"
          }
        }
      ],
      "executionStepIds": [
        "validate_p2p_evidence"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "purchase_order": {
          "type": "string",
          "title": {
            "zh": "采购订单号",
            "en": "Purchase order"
          },
          "description": {
            "zh": "只输入采购订单号，例如 4500000030；不要输入完整句子。",
            "en": "Enter only the purchase-order number, for example 4500000030; do not enter a sentence."
          },
          "placeholder": {
            "zh": "例如：4500000030",
            "en": "Example: 4500000030"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "purchase_order"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "purchase_order": {
          "type": "string",
          "title": {
            "zh": "采购订单",
            "en": "Purchase order"
          }
        },
        "company_code": {
          "type": "string",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          }
        },
        "supplier": {
          "type": "string",
          "title": {
            "zh": "供应商",
            "en": "Supplier"
          }
        },
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "purchase_order",
        "business_status",
        "source_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "purchase_order": "{{steps.validate_p2p_evidence.output.workflow_output.purchase_order}}",
      "company_code": "{{steps.validate_p2p_evidence.output.workflow_output.company_code}}",
      "supplier": "{{steps.validate_p2p_evidence.output.workflow_output.supplier}}",
      "business_status": "{{steps.validate_p2p_evidence.output.workflow_output.business_status}}",
      "source_complete": "{{steps.validate_p2p_evidence.output.workflow_output.source_complete}}",
      "business_report": "{{steps.validate_p2p_evidence.output.workflow_output.business_report}}"
    },
    "steps": [
      {
        "id": "collect_p2p_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_PURCHASEORDER_PROCESS_SRV",
            "odata_version": "2.0",
            "entity_set": "A_PurchaseOrder",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "target_entity_set": "A_OperationalAcctgDocItemCube",
            "steps": [
              {
                "step_id": "purchase_order",
                "service_name": "API_PURCHASEORDER_PROCESS_SRV",
                "odata_version": "2.0",
                "entity_set": "A_PurchaseOrder",
                "http_method": "GET",
                "filters": [
                  {
                    "field": "PurchaseOrder",
                    "operator": "eq",
                    "value": "{{input.purchase_order}}",
                    "value_type": "string"
                  }
                ],
                "rationale": "Load the requested PO header."
              },
              {
                "step_id": "purchase_order_items",
                "service_name": "API_PURCHASEORDER_PROCESS_SRV",
                "odata_version": "2.0",
                "entity_set": "A_PurchaseOrderItem",
                "http_method": "GET",
                "filters": [
                  {
                    "field": "PurchaseOrder",
                    "operator": "eq",
                    "value": "{{input.purchase_order}}",
                    "value_type": "string"
                  }
                ],
                "rationale": "Load every item for the requested PO."
              },
              {
                "step_id": "material_documents",
                "service_name": "API_MATERIAL_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_MaterialDocumentItem",
                "http_method": "GET",
                "filters": [
                  {
                    "field": "PurchaseOrder",
                    "operator": "eq",
                    "value": "{{input.purchase_order}}",
                    "value_type": "string"
                  }
                ],
                "rationale": "Load receipt, return and reversal evidence."
              },
              {
                "step_id": "supplier_invoice_items",
                "service_name": "API_SUPPLIERINVOICE_PROCESS_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SuplrInvcItemPurOrdRef",
                "http_method": "GET",
                "filters": [
                  {
                    "field": "PurchaseOrder",
                    "operator": "eq",
                    "value": "{{input.purchase_order}}",
                    "value_type": "string"
                  }
                ],
                "rationale": "Load supplier-invoice references for the PO."
              },
              {
                "step_id": "accounting_items",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "PurchasingDocument",
                  "Supplier",
                  "AccountingDocumentType",
                  "ClearingAccountingDocument",
                  "ClearingDocFiscalYear",
                  "IsCleared",
                  "PaymentMethod",
                  "HouseBank",
                  "HouseBankAccount"
                ],
                "filters": [
                  {
                    "field": "PurchasingDocument",
                    "operator": "eq",
                    "value": "{{input.purchase_order}}",
                    "value_type": "string"
                  }
                ],
                "rationale": "Load FI clearing and payment evidence linked to the PO."
              },
              {
                "step_id": "clearing_documents",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "AccountingDocumentType",
                  "ClearingAccountingDocument",
                  "IsCleared",
                  "PaymentMethod",
                  "HouseBank",
                  "HouseBankAccount",
                  "Supplier"
                ],
                "filter_from_previous": [
                  {
                    "field": "AccountingDocument",
                    "source_step_id": "accounting_items",
                    "source_field": "ClearingAccountingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "CompanyCode",
                    "source_step_id": "accounting_items",
                    "source_field": "CompanyCode",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "FiscalYear",
                    "source_step_id": "accounting_items",
                    "source_field": "ClearingDocFiscalYear",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ],
                "rationale": "Load the clearing document itself so payment is never inferred from a clearing reference alone."
              }
            ],
            "rationale": "Follow the PO through goods receipt, supplier invoice and FI evidence using GET-only SAP APIs."
          }
        }
      },
      {
        "id": "validate_p2p_evidence",
        "executor": "rule",
        "operation": "evaluate_p2p_status",
        "inputMapping": {
          "run_input": "{{input}}",
          "sap_read": "{{steps.collect_p2p_evidence.output}}"
        }
      }
    ],
    "acceptance": {
      "schemaVersion": "2.0",
      "comparisonMode": "business_semantic",
      "businessKeys": [
        "purchase_order",
        "purchase_order_item"
      ],
      "facts": [
        "material",
        "plant",
        "business_status"
      ],
      "metrics": [
        "purchase_orders",
        "purchase_order_items",
        "material_document_items",
        "supplier_invoice_items",
        "accounting_items",
        "active_receipts",
        "cleared_items",
        "payment_evidence"
      ],
      "decimalFields": [
        "order_quantity"
      ],
      "decimalMetricIds": [],
      "currencyFields": [],
      "unitFields": [
        "unit"
      ],
      "dateFields": [],
      "codeSetFields": [],
      "zeroPadFields": {},
      "booleanFields": [],
      "inputDefaults": {
        "purchase_order": "purchase_order"
      },
      "constantDefaults": {},
      "fieldAliases": {
        "unit": [
          "order_unit"
        ]
      },
      "fieldExtractors": {
        "business_status": {
          "source": "business_status",
          "contains": {
            "partially received": "partial",
            "receipt recorded": "partial"
          },
          "default": "partial",
          "always": true
        }
      },
      "currencyFromDecimal": {},
      "valueMappings": {
        "business_status": {
          "receipt_recorded_invoice_branch_empty_no_clearing_or_payment_evidence": "partial"
        }
      },
      "limitationKeywords": {
        "source_incomplete": [
          "source incomplete",
          "paging incomplete",
          "range limited",
          "范围限制",
          "分页未完成"
        ],
        "bank_settlement_not_proven": [
          "bank settlement",
          "bank receipt",
          "银行结算",
          "银行到账"
        ],
        "capability_gap": [
          "capability gap",
          "evidence unavailable",
          "inconclusive",
          "能力缺口",
          "证据不足",
          "无法确认"
        ],
        "p2p_supplier_invoice_evidence": [
          "supplier invoice evidence",
          "no supplier invoice",
          "supplier invoice branch is empty",
          "invoice not found",
          "供应商发票证据",
          "未找到供应商发票",
          "发票分支为空"
        ]
      },
      "summaryRecord": false,
      "currencyAndUnitPolicy": "compare_only_when_same_or_conversion_validated",
      "requiredLimitations": [],
      "businessStatusFromMetric": {},
      "limitationsFromMetrics": {
        "supplier_invoice_items": {
          "zero": "p2p_supplier_invoice_evidence"
        }
      },
      "blankValueKeywords": {},
      "blockingLimitations": [],
      "ignoredNoticeKeywords": [],
      "zeroFactWhenMetricZero": {},
      "recordScope": "",
      "metricDefinitions": {},
      "businessStatusDefinition": "",
      "businessStatusFromAnyPositiveMetric": {}
    }
  },
