    ]
  },
  "guardrails": {
    "zh": [
      "严格只读；发布前必须由业务与SAP负责人复核。"
    ],
    "en": [
      "Strictly read-only; requires business and SAP review before publication."
    ]
  },
  "workflow": [
    {
      "id": "read-procurement-scope",
      "title": {
        "zh": "读取采购订单范围",
        "en": "Read purchase-order scope"
      },
      "description": {
        "zh": "使用一个或多个采购订单执行三项 GET-only 采购证据查询。",
        "en": "Run three GET-only procurement evidence queries for one or more purchase orders."
      },
      "operations": {
        "zh": [
          "以必填采购订单集合读取科目分配、采购订单项目和计划行，每批最多使用 20 个筛选值。",
          "可选物料仅用于收窄采购订单项目；A_PurchaseOrderScheduleLine.PurchasingDocument 复用同一采购订单集合。",
          "保留空结果、失败、截断和 source_complete 状态供后续判断。"
        ],
        "en": [
          "Read account assignments, purchase-order items, and schedule lines for the required purchase-order set, using at most 20 filter values per chunk.",
          "Use the optional material only to narrow purchase-order items; A_PurchaseOrderScheduleLine.PurchasingDocument reuses the same purchase-order set.",
          "Preserve empty results, failures, truncation, and source_complete for downstream decisions."
        ]
      },
      "tools": [
        {
          "name": "sap_read_execute_plan",
          "kind": "SAP Read Provider",
          "purpose": {
            "zh": "执行采购订单范围 GET 查询。",
            "en": "Execute purchase-order scope GET queries."
          }
        }
      ],
      "executionStepIds": [
        "sap_query_1",
        "sap_query_2",
        "sap_query_3"
      ]
    },
    {
      "id": "analyze-demand-exposure",
      "title": {
        "zh": "派生物料与工厂并分析需求暴露",
        "en": "Derive material and plant and analyze demand exposure"
      },
      "description": {
        "zh": "从采购订单项目证据派生物料与工厂，再执行有界 MRP 和销售订单 GET-only 查询。",
        "en": "Derive material and plant from purchase-order item evidence, then run bounded GET-only MRP and sales-order queries."
      },
      "operations": {
        "zh": [
          "本地规则仅从完整 sap_query_3 结构化结果提取 Material 与 Plant，各最多 100 个值；可选物料只收窄该证据范围。",
          "按派生物料集合、派生 MRPPlant 与 MRPElementCategory=VC 读取 MRP 供需和候选需求；可选销售订单以 MRPElement 精确收窄候选需求。",
          "从完整候选需求派生销售订单集合，按派生销售订单、物料和 ProductionPlant 复核订单项目，再按已复核销售订单读取计划行。",
          "不得发送空值或无界派生筛选；物料/工厂来源不完整时跳过依赖查询，完整空候选不会触发无界销售订单查询。"
        ],
        "en": [
          "Local rules extract at most 100 Material and 100 Plant values only from complete structured sap_query_3 evidence; the optional material only narrows that evidence scope.",
          "Read MRP supply/demand and candidate demand by the derived material set, derived MRPPlant, and MRPElementCategory=VC; an optional sales order narrows candidate demand by exact MRPElement.",
          "Derive the sales-order set from complete candidate demand, verify order items by derived sales orders, material, and ProductionPlant, then read schedule lines for verified sales orders.",
          "Never send empty or unbounded derived filters; skip dependent queries when material or plant evidence is unavailable, and never issue an unbounded sales-order query for a complete empty candidate set."
        ]
      },
      "tools": [
        {
          "name": "managed_agent_rule",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "从结构化证据派生有界物料、工厂和销售订单集合。",
            "en": "Derive bounded material, plant, and sales-order sets from structured evidence."
          }
        },
        {
          "name": "sap_read_execute_plan",
          "kind": "SAP Read Provider",
          "purpose": {
            "zh": "执行 MRP 与销售订单 GET 查询。",
            "en": "Execute MRP and sales-order GET queries."
          }
        }
      ],
      "executionStepIds": [
        "derive_plant_scope",
        "derive_material_scope",
        "sap_query_4",
        "sap_query_5",
        "derive_sales_order_scope",
        "sap_query_6",
        "extract_candidate_sales_orders",
        "sap_query_7"
      ]
    },
    {
      "id": "summarize-business-evidence",
      "title": {
        "zh": "汇总候选订单与完整性",
        "en": "Summarize candidates and completeness"
      },
      "description": {
        "zh": "汇总已复核候选销售订单及七个 SAP 来源的完整性。",
        "en": "Summarize verified candidate sales orders and completeness across seven SAP sources."
      },
      "operations": {
        "zh": [
          "核对采购订单物料与工厂的实际配对；按订单、物料、工厂对应MRP需求核实销售订单项目，不交叉拼接独立集合。",
          "按销售订单去重形成规范记录；项目和计划行按组合键去重计数，报告由同一份记录生成。",
          "完整零结果、候选待复核和证据不足分别显示；仅输出潜在关联，不证明实际延期影响。"
        ],
        "en": [
          "Verify actual material/plant pairs from the purchase order, then verify sales-order items against matching order/material/plant MRP demand without crossing independent sets.",
          "Build one canonical record per sales order; deduplicate items and schedule lines by their stable composite keys, and derive the report from those same records.",
          "Separate complete zero, candidates for review, and incomplete evidence. Report potential association only and do not claim actual delay impact."
        ]
      },
      "tools": [
        {
          "name": "evidence_summary",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "汇总查询源完整性。",
            "en": "Summarize query-source completeness."
          }
        },
        {
          "name": "managed_agent_rule",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "生成候选订单业务报告。",
            "en": "Build the candidate-order business report."
          }
        }
      ],
      "executionStepIds": [
        "validate_evidence",
        "build_business_report"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "inputSchema": {
      "type": "object",
      "properties": {
        "purchase_order": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "zh": "采购订单",
            "en": "Purchase Order"
          }
        },
        "material": {
          "type": "string",
          "minLength": 1,
          "title": {
            "zh": "物料",
            "en": "Material"
          }
        },
        "sales_order": {
          "type": "string",
          "minLength": 1,
          "title": {
            "zh": "销售订单",
            "en": "Sales Order"
          }
        }
      },
      "required": [
        "purchase_order"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "id": "sap_query_1",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_PURCHASEORDER_PROCESS_SRV",
            "odata_version": "2.0",
            "entity_set": "A_PurOrdAccountAssignment",
            "http_method": "GET",
            "filters": [
              {
                "field": "PurchaseOrder",
                "operator": "in",
                "value": "{{input.purchase_order}}",
                "chunk_size": 20
              }
            ],
            "select_fields": [
              "PurchaseOrder",
              "PurchaseOrderItem",
              "AccountAssignmentNumber",
              "IsDeleted",
              "Quantity",
              "PurchaseOrderQuantityUnit",
              "SalesOrder",
              "SalesOrderItem",
              "SalesOrderScheduleLine"
            ],
            "order_by": [
              "PurchaseOrder",
              "PurchaseOrderItem",
              "AccountAssignmentNumber"
            ],
            "response_summary_fields": [
              "PurchaseOrder",
              "PurchaseOrderItem",
              "AccountAssignmentNumber",
              "IsDeleted",
              "Quantity",
              "PurchaseOrderQuantityUnit",
              "SalesOrder",
              "SalesOrderItem",
              "SalesOrderScheduleLine"
            ]
          }
        }
      },
      {
        "id": "sap_query_2",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_PURCHASEORDER_PROCESS_SRV",
            "odata_version": "2.0",
            "entity_set": "A_PurchaseOrderScheduleLine",
            "http_method": "GET",
            "filters": [
              {
                "field": "PurchasingDocument",
                "operator": "in",
                "value": "{{input.purchase_order}}",
                "chunk_size": 20
              }
            ],
            "select_fields": [
              "PurchasingDocument",
              "PurchasingDocumentItem",
              "ScheduleLine",
              "ScheduleLineDeliveryDate",
              "ScheduleLineOrderQuantity",
              "PurchaseOrderQuantityUnit",
              "ScheduleLineCommittedQuantity",
              "PurchaseRequisition",
              "PurchaseRequisitionItem"
            ],
            "order_by": [
