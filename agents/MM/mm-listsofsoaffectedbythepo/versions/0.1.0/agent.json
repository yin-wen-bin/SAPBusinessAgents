            "select_fields": [
              "Material",
              "MRPPlant",
              "MRPArea",
              "MaterialBaseUnit",
              "MRPElement",
              "MRPElementItem",
              "MRPElementScheduleLine",
              "MRPElementAvailyOrRqmtDate",
