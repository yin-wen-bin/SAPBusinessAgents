{
  "schemaVersion": 2,
  "slug": "mm-listsofsoaffectedbythepo",
  "module": "MM",
  "title": {
    "zh": "采购订单延期的销售订单潜在影响分析",
    "en": "Potential Sales Order Impact Analysis for Delayed Purchase Orders"
  },
  "summary": {
    "zh": "沿“采购订单 → 物料/工厂 → MRP 供需 → 销售订单项目与计划行”的只读 SAP 证据链，生成待复核的潜在暴露销售订单清单，并报告查询源完整性。",
    "en": "Follows a read-only SAP evidence chain from purchase orders through material/plant and MRP supply and demand to sales-order items and schedule lines, producing potentially exposed sales orders for review and reporting query-source completeness."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.1.0",
  "owner": "采购与订单履约 / Procurement and Order Fulfillment",
  "tags": [
    "Generated draft",
    "Read-only"
  ],
  "sapModules": [
    "MM-PUR",
    "PP-MRP",
    "SD-SLS"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "采购订单",
      "物料",
      "销售订单"
    ],
    "en": [
      "Purchase Order",
      "Material",
      "Sales Order"
    ]
  },
  "outputs": {
    "zh": [
      "执行状态",
      "查询源完整性",
