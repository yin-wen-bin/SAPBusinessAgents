      "待复核候选销售订单",
      "待复核候选销售订单数量",
      "业务报告",
      "候选销售订单明细",
      "已核实项目数",
      "已核实计划行数",
      "业务状态",
      "业务证据完整性",
      "业务检查完整性",
      "证据缺口"
    ],
    "en": [
      "Execution status",
      "Query-source completeness",
      "Successful source count",
      "Candidate sales orders for review",
      "Candidate sales order count",
      "Business report",
      "Candidate sales-order records",
      "Verified items",
      "Verified schedule lines",
      "Business status",
