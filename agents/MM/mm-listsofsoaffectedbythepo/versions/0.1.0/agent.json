        "executor": "rule",
        "operation": "managed_agent_rule",
        "inputMapping": {
          "payload": {
            "purchase_order_items": "{{steps.sap_query_3.output}}",
            "plant_scope": {
              "source_complete": "{{steps.derive_plant_scope.output.can_query}}"
            }
