            "evidence_gap_codes": [
              "derived_material_or_plant_scope_unavailable"
            ]
          }
        }
      },
      {
        "id": "sap_query_5",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_MRP_MATERIALS_SRV_01",
            "odata_version": "2.0",
            "entity_set": "SupplyDemandItems",
            "http_method": "GET",
            "filters": [
              {
                "field": "Material",
                "operator": "in",
                "value": "{{steps.derive_material_scope.output.values}}",
                "chunk_size": 20
              },
              {
                "field": "MRPPlant",
                "operator": "in",
                "value": "{{steps.derive_plant_scope.output.values}}"
              },
              {
                "field": "MRPElementCategory",
                "operator": "eq",
                "value": "VC"
              },
              {
                "field": "MRPElement",
                "operator": "eq",
                "value": "{{input.sales_order}}",
