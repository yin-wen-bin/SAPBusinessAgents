        }
      },
      {
        "id": "derive_plant_scope",
        "executor": "rule",
        "operation": "managed_agent_rule",
        "inputMapping": {
          "payload": "{{steps.sap_query_3.output}}",
          "field": "Plant",
          "max_values": 100
