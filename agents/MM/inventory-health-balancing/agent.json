      "结构化业务报告"
    ],
    "en": [
      "Material",
      "Plant",
      "Business status",
      "Query-source completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "只使用 unrestricted/available 库存",
      "缺少安全库存、单位或批次数量时不输出确定调拨量",
      "MB5B 仅作额外余额核对",
      "全部 SAP 访问为 GET-only"
    ],
    "en": [
      "Use unrestricted/available stock only",
      "Suppress confirmed transfer quantity without safety stock, units, or batch quantities",
      "Use MB5B only as an additional balance check",
      "All SAP access is GET-only"
    ]
  },
