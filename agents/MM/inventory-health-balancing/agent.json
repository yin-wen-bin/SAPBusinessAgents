{
  "schemaVersion": 2,
  "slug": "inventory-health-balancing",
  "module": "MM",
  "title": {
    "zh": "库存健康与库存平衡助手",
    "en": "Inventory Health and Balancing Assistant"
  },
  "summary": {
    "zh": "结合库存余额、移动历史、批次效期和补货参数识别慢动、呆滞、临期与平衡候选。",
    "en": "Combines stock balances, movement history, batch expiry, and replenishment parameters to identify slow-moving, obsolete, expiring, and balancing candidates."
  },
  "status": "Three-stage live acceptance blocked",
  "version": "0.1.0",
  "owner": "MM-IM / Inventory Planning",
  "tags": [
    "Inventory",
    "Slow Moving",
    "Shelf Life",
    "Balancing"
  ],
  "sapModules": [
    "MM-IM",
    "MM-BD"
  ],
  "transactions": [],
  "tables": [
    "MARD",
    "MATDOC",
    "MCHA",
    "MARC"
  ],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "物料",
      "工厂",
      "storage location",
      "date from",
      "查询基准日",
      "slow moving days",
      "obsolete days",
      "expiry days"
    ],
    "en": [
      "Material",
      "Plant",
      "Storage Location",
      "Date From",
      "As-of date",
