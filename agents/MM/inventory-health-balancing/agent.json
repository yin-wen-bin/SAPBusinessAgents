{
  "schemaVersion": 2,
  "slug": "inventory-health-balancing",
  "module": "MM",
  "title": {"zh": "库存健康检查", "en": "Inventory Health Check"},
  "summary": {
    "zh": "查询当前非限制使用库存，并按用户选择的天数检查慢动、呆滞和临期风险。",
    "en": "Reads current unrestricted-use stock and checks slow-moving, obsolete, and expiry risks using optional user-selected thresholds."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.2.0",
  "owner": "MM-IM / Inventory Planning",
  "tags": ["Inventory", "Slow Moving", "Shelf Life"],
  "sapModules": ["MM-IM", "MM-BD"],
  "transactions": [],
  "tables": ["MARD", "MATDOC", "MCHA"],
  "systems": ["SAP S/4HANA"],
  "inputs": {
    "zh": ["物料", "工厂", "库存地点", "慢动天数（可选）", "呆滞天数（可选）", "临期天数（可选）"],
    "en": ["Material", "Plant", "Storage Location", "Slow-moving days (optional)", "Obsolete days (optional)", "Expiry days (optional)"]
  },
  "outputs": {
    "zh": ["快照日期", "物料", "工厂", "库存地点", "当前非限制使用库存", "单位", "本次检查项目", "最后移动日期", "库存账龄（天）", "库存账龄下限（天）", "慢动状态", "呆滞状态", "临期状态", "临期批次数", "业务状态", "查询源完整性", "证据完整性", "结构化业务报告"],
    "en": ["Snapshot date", "Material", "Plant", "Storage Location", "Current unrestricted-use stock", "Unit", "Selected checks", "Last movement date", "Stock age (days)", "Stock age lower bound (days)", "Slow-moving status", "Obsolete status", "Expiry status", "Expiry candidate count", "Business status", "Query-source completeness", "Evidence completeness", "Structured business report"]
  },
  "guardrails": {
    "zh": ["只统计库存类型 01 且非特殊库存的当前库存", "用户留空的检查不执行，也不计为证据缺失", "不同单位的库存不得合计", "不计算历史库存余额或调拨数量", "全部 SAP 访问为 GET-only"],
    "en": ["Count only current stock type 01 with no special-stock indicator", "A blank optional check is not executed and is not treated as missing evidence", "Never aggregate stock across different units", "Do not calculate historical stock balances or transfer quantities", "All SAP access is GET-only"]
  },
  "workflow": [
    {
      "id": "derive-check-window",
      "title": {"zh": "确定本次检查范围", "en": "Resolve this check's scope"},
      "description": {"zh": "自动使用运行当天作为快照日，并根据已填写的天数启用对应检查。", "en": "Uses the run date as the snapshot and enables only checks with supplied thresholds."},
      "operations": {"zh": ["本地规则 resolve_inventory_health_window"], "en": ["Local rule resolve_inventory_health_window"]},
      "tools": [{"name": "resolve_inventory_health_window", "kind": "Local deterministic rule", "purpose": {"zh": "生成检查开关和移动日期窗口", "en": "Generate check switches and the movement date window"}}],
      "executionStepIds": ["resolve_window"]
    },
    {
      "id": "read-current-stock",
      "title": {"zh": "读取当前库存", "en": "Read current stock"},
      "description": {"zh": "始终查询指定物料、工厂和库存地点的当前非限制使用、非特殊库存。", "en": "Always reads current unrestricted-use, non-special stock for the exact material, plant, and storage location."},
      "operations": {"zh": ["GET API_MATERIAL_STOCK_SRV@2.0/A_MatlStkInAcctMod"], "en": ["GET API_MATERIAL_STOCK_SRV@2.0/A_MatlStkInAcctMod"]},
      "tools": [{"name": "Embedded SAP OData Provider", "kind": "GET-only SAP Provider", "purpose": {"zh": "读取当前库存快照", "en": "Read the current stock snapshot"}}],
      "executionStepIds": ["read_stock"]
    },
    {
      "id": "read-optional-movement",
      "title": {"zh": "按需读取移动历史", "en": "Read movement history when requested"},
      "description": {"zh": "仅当填写慢动或呆滞天数时，按最大阈值读取物料凭证及其过账日期。", "en": "Reads material-document items and header posting dates only when a slow-moving or obsolete threshold is supplied."},
      "operations": {"zh": ["GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentItem", "GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentHeader"], "en": ["GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentItem", "GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentHeader"]},
      "tools": [{"name": "Embedded SAP OData Provider", "kind": "GET-only SAP Provider", "purpose": {"zh": "读取所选日期窗口内的移动证据", "en": "Read movement evidence inside the selected date window"}}],
      "executionStepIds": ["read_movement_dates"]
    },
    {
      "id": "read-optional-expiry",
      "title": {"zh": "按需读取批次效期", "en": "Read batch expiry when requested"},
      "description": {"zh": "仅当填写临期天数时读取批次效期，并只关联当前正库存批次。", "en": "Reads batch expiry only when requested and relates it only to batches with positive current stock."},
      "operations": {"zh": ["GET API_BATCH_SRV@2.0/Batch"], "en": ["GET API_BATCH_SRV@2.0/Batch"]},
      "tools": [{"name": "Embedded SAP OData Provider", "kind": "GET-only SAP Provider", "purpose": {"zh": "读取批次和效期证据", "en": "Read batch and expiry evidence"}}],
      "executionStepIds": ["read_batch_parameters"]
    },
    {
      "id": "assess-evidence",
      "title": {"zh": "检查证据完整性", "en": "Assess evidence completeness"},
      "description": {"zh": "只评估本次实际启用的证据主题，未启用检查不记缺口。", "en": "Assesses only requested evidence topics; disabled checks do not create gaps."},
      "operations": {"zh": ["本地规则 assess_api_evidence"], "en": ["Local rule assess_api_evidence"]},
      "tools": [{"name": "assess_api_evidence", "kind": "Local deterministic rule", "purpose": {"zh": "判定是否存在实时 Schema 能力缺口", "en": "Determine whether live schema proves a capability gap"}}],
      "executionStepIds": ["assess"]
    },
    {
      "id": "approved-adt-stock-fallback",
      "title": {"zh": "按需补充库存证据", "en": "Supplement stock evidence when needed"},
      "description": {"zh": "仅在实时 Schema 直接证明库存 API 能力缺口时调用只读 MARD。", "en": "Uses read-only MARD only when live schema directly proves a stock-API capability gap."},
      "operations": {"zh": ["只读 MARD"], "en": ["Read-only MARD"]},
      "tools": [{"name": "sap-adt-table-export", "kind": "Approved read-only Skill", "purpose": {"zh": "补充当前库存证据", "en": "Supplement current-stock evidence"}}],
      "executionStepIds": ["adt_stock"]
    },
    {
      "id": "approved-adt-movement-fallback",
      "title": {"zh": "按需补充移动证据", "en": "Supplement movement evidence when needed"},
      "description": {"zh": "仅在已启用移动检查且实时 Schema 直接证明 API 能力缺口时调用只读 MATDOC。", "en": "Uses read-only MATDOC only for an enabled movement check with a live-schema-proven API capability gap."},
      "operations": {"zh": ["只读 MATDOC"], "en": ["Read-only MATDOC"]},
      "tools": [{"name": "sap-adt-table-export", "kind": "Approved read-only Skill", "purpose": {"zh": "补充移动历史证据", "en": "Supplement movement-history evidence"}}],
      "executionStepIds": ["adt_movement"]
    },
    {
      "id": "approved-adt-batch-fallback",
      "title": {"zh": "按需补充批次证据", "en": "Supplement batch evidence when needed"},
      "description": {"zh": "仅在已启用临期检查且实时 Schema 直接证明 API 能力缺口时调用只读 MCHA。", "en": "Uses read-only MCHA only for an enabled expiry check with a live-schema-proven API capability gap."},
      "operations": {"zh": ["只读 MCHA"], "en": ["Read-only MCHA"]},
      "tools": [{"name": "sap-adt-table-export", "kind": "Approved read-only Skill", "purpose": {"zh": "补充批次效期证据", "en": "Supplement batch-expiry evidence"}}],
      "executionStepIds": ["adt_batch"]
    },
    {
      "id": "evaluate-health",
      "title": {"zh": "形成库存健康结论", "en": "Evaluate inventory health"},
      "description": {"zh": "按用户选择的检查项目计算账龄、风险和完整性，不生成调拨建议。", "en": "Calculates age, risk, and completeness for selected checks without producing transfer advice."},
      "operations": {"zh": ["本地规则 inventory_health_check_deterministic_v2"], "en": ["Local rule inventory_health_check_deterministic_v2"]},
      "tools": [{"name": "evaluate_business_agent", "kind": "Local deterministic rule", "purpose": {"zh": "生成双语业务报告", "en": "Generate the bilingual business report"}}],
      "executionStepIds": ["evaluate"]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {
      "type": "object",
      "properties": {
        "material": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[0-9A-Za-z_-]+$", "title": {"zh": "物料", "en": "Material"}},
        "plant": {"type": "string", "minLength": 1, "maxLength": 4, "pattern": "^[0-9A-Za-z_-]+$", "title": {"zh": "工厂", "en": "Plant"}},
        "storage_location": {"type": "string", "minLength": 1, "maxLength": 4, "pattern": "^[0-9A-Za-z_-]+$", "title": {"zh": "库存地点", "en": "Storage Location"}},
        "slow_moving_days": {"type": "integer", "minimum": 1, "maximum": 365, "title": {"zh": "慢动天数（可选）", "en": "Slow-moving days (optional)"}, "description": {"zh": "留空则不执行慢动检查。", "en": "Leave blank to skip the slow-moving check."}},
        "obsolete_days": {"type": "integer", "minimum": 1, "maximum": 365, "title": {"zh": "呆滞天数（可选）", "en": "Obsolete days (optional)"}, "description": {"zh": "留空则不执行呆滞检查。", "en": "Leave blank to skip the obsolete-stock check."}},
        "expiry_days": {"type": "integer", "minimum": 1, "maximum": 365, "title": {"zh": "临期天数（可选）", "en": "Expiry days (optional)"}, "description": {"zh": "留空则不执行临期检查。", "en": "Leave blank to skip the expiry check."}}
      },
      "required": ["material", "plant", "storage_location"],
      "additionalProperties": false,
      "numericOrderPairs": [{"lower": "slow_moving_days", "upper": "obsolete_days"}]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "snapshot_date": {"type": "string", "title": {"zh": "快照日期", "en": "Snapshot date"}},
        "material": {"type": "string", "title": {"zh": "物料", "en": "Material"}},
        "plant": {"type": "string", "title": {"zh": "工厂", "en": "Plant"}},
        "storage_location": {"type": "string", "title": {"zh": "库存地点", "en": "Storage Location"}},
        "current_unrestricted_stock": {"type": ["string", "null"], "title": {"zh": "当前非限制使用库存", "en": "Current unrestricted-use stock"}},
        "unit": {"type": ["string", "null"], "title": {"zh": "单位", "en": "Unit"}},
        "selected_checks": {"type": "array", "title": {"zh": "本次检查项目", "en": "Selected checks"}},
        "last_movement_date": {"type": ["string", "null"], "title": {"zh": "最后移动日期", "en": "Last movement date"}},
        "stock_age_days": {"type": ["integer", "null"], "title": {"zh": "库存账龄（天）", "en": "Stock age (days)"}},
        "stock_age_lower_bound_days": {"type": ["integer", "null"], "title": {"zh": "库存账龄下限（天）", "en": "Stock age lower bound (days)"}},
        "slow_moving_status": {"type": "string", "title": {"zh": "慢动状态", "en": "Slow-moving status"}},
        "obsolete_status": {"type": "string", "title": {"zh": "呆滞状态", "en": "Obsolete status"}},
        "expiry_status": {"type": "string", "title": {"zh": "临期状态", "en": "Expiry status"}},
        "expiry_candidate_count": {"type": "integer", "title": {"zh": "临期批次数", "en": "Expiry candidate count"}},
        "business_status": {"type": "string", "title": {"zh": "业务状态", "en": "Business status"}},
        "source_complete": {"type": "boolean", "title": {"zh": "查询源完整性", "en": "Query-source completeness"}},
        "evidence_complete": {"type": "boolean", "title": {"zh": "证据完整性", "en": "Evidence completeness"}},
        "business_report": {"type": "object", "title": {"zh": "结构化业务报告", "en": "Structured business report"}}
      },
      "required": ["snapshot_date", "material", "plant", "storage_location", "current_unrestricted_stock", "unit", "selected_checks", "last_movement_date", "stock_age_days", "stock_age_lower_bound_days", "slow_moving_status", "obsolete_status", "expiry_status", "expiry_candidate_count", "business_status", "source_complete", "evidence_complete", "business_report"],
      "additionalProperties": false
    },
    "outputMapping": {
      "snapshot_date": "{{steps.evaluate.output.workflow_output.snapshot_date}}",
      "material": "{{steps.evaluate.output.workflow_output.material}}",
      "plant": "{{steps.evaluate.output.workflow_output.plant}}",
      "storage_location": "{{steps.evaluate.output.workflow_output.storage_location}}",
      "current_unrestricted_stock": "{{steps.evaluate.output.workflow_output.current_unrestricted_stock}}",
      "unit": "{{steps.evaluate.output.workflow_output.unit}}",
      "selected_checks": "{{steps.evaluate.output.workflow_output.selected_checks}}",
      "last_movement_date": "{{steps.evaluate.output.workflow_output.last_movement_date}}",
      "stock_age_days": "{{steps.evaluate.output.workflow_output.stock_age_days}}",
      "stock_age_lower_bound_days": "{{steps.evaluate.output.workflow_output.stock_age_lower_bound_days}}",
      "slow_moving_status": "{{steps.evaluate.output.workflow_output.slow_moving_status}}",
      "obsolete_status": "{{steps.evaluate.output.workflow_output.obsolete_status}}",
      "expiry_status": "{{steps.evaluate.output.workflow_output.expiry_status}}",
      "expiry_candidate_count": "{{steps.evaluate.output.workflow_output.expiry_candidate_count}}",
      "business_status": "{{steps.evaluate.output.workflow_output.business_status}}",
      "source_complete": "{{steps.evaluate.output.workflow_output.source_complete}}",
      "evidence_complete": "{{steps.evaluate.output.workflow_output.evidence_complete}}",
      "business_report": "{{steps.evaluate.output.workflow_output.business_report}}"
    },
    "steps": [
      {"id": "resolve_window", "executor": "rule", "operation": "resolve_inventory_health_window", "inputMapping": {"run_input": "{{input}}"}},
      {
        "id": "read_stock", "executor": "sap_read", "operation": "execute_plan", "readOnly": true, "failurePolicy": "record_gap",
        "request": {"plan": {
          "service_name": "API_MATERIAL_STOCK_SRV", "odata_version": "2.0", "entity_set": "A_MatlStkInAcctMod", "http_method": "GET", "plan_kind": "direct",
          "select_fields": ["Material", "Plant", "StorageLocation", "Batch", "InventoryStockType", "InventorySpecialStockType", "MatlWrhsStkQtyInMatlBaseUnit", "MaterialBaseUnit"],
          "filters": [
            {"field": "Material", "operator": "eq", "value": "{{input.material}}", "value_type": "string"},
            {"field": "Plant", "operator": "eq", "value": "{{input.plant}}", "value_type": "string"},
            {"field": "StorageLocation", "operator": "eq", "value": "{{input.storage_location}}", "value_type": "string"},
            {"field": "InventoryStockType", "operator": "eq", "value": "01", "value_type": "string"},
            {"field": "InventorySpecialStockType", "operator": "eq", "value": "", "value_type": "string"}
          ],
          "rationale": "Read the exact current unrestricted-use, non-special stock snapshot."
        }}
      },
      {
        "id": "read_movement_dates", "executor": "sap_read", "operation": "execute_plan", "readOnly": true, "failurePolicy": "record_gap",
        "when": {"source": "{{steps.resolve_window.output.movement_check_requested}}", "equals": true},
        "request": {"plan": {
          "service_name": "API_MATERIAL_DOCUMENT_SRV", "odata_version": "2.0", "entity_set": "A_MaterialDocumentItem", "http_method": "GET", "plan_kind": "multi_step",
          "steps": [
            {
              "step_id": "movement_date_items", "service_name": "API_MATERIAL_DOCUMENT_SRV", "odata_version": "2.0", "entity_set": "A_MaterialDocumentItem", "http_method": "GET",
              "select_fields": ["MaterialDocumentYear", "MaterialDocument", "MaterialDocumentItem", "Material", "Plant", "StorageLocation"],
              "filters": [
                {"field": "Material", "operator": "eq", "value": "{{input.material}}", "value_type": "string"},
                {"field": "Plant", "operator": "eq", "value": "{{input.plant}}", "value_type": "string"},
                {"field": "StorageLocation", "operator": "eq", "value": "{{input.storage_location}}", "value_type": "string"},
                {"field": "MaterialDocumentYear", "operator": "in", "value": "{{steps.resolve_window.output.movement_years}}"}
              ]
            },
            {
              "step_id": "movement_date_headers", "service_name": "API_MATERIAL_DOCUMENT_SRV", "odata_version": "2.0", "entity_set": "A_MaterialDocumentHeader", "http_method": "GET",
              "select_fields": ["MaterialDocumentYear", "MaterialDocument", "PostingDate"],
              "filters": [
                {"field": "PostingDate", "operator": "ge", "value": "{{steps.resolve_window.output.movement_date_from}}", "value_type": "date_start"},
                {"field": "PostingDate", "operator": "le", "value": "{{steps.resolve_window.output.snapshot_date}}", "value_type": "date_end"}
              ],
              "filter_from_previous": [
                {"field": "MaterialDocumentYear", "source_step_id": "movement_date_items", "source_field": "MaterialDocumentYear"},
                {"field": "MaterialDocument", "source_step_id": "movement_date_items", "source_field": "MaterialDocument"}
              ]
            }
          ],
          "rationale": "Read movement posting dates inside the maximum requested health-check window."
        }}
      },
      {
        "id": "read_batch_parameters", "executor": "sap_read", "operation": "execute_plan", "readOnly": true, "failurePolicy": "record_gap",
        "when": {"source": "{{steps.resolve_window.output.check_expiry}}", "equals": true},
        "request": {"plan": {
          "service_name": "API_BATCH_SRV", "odata_version": "2.0", "entity_set": "Batch", "http_method": "GET", "plan_kind": "direct",
          "select_fields": ["Material", "BatchIdentifyingPlant", "Batch", "ShelfLifeExpirationDate", "ManufactureDate", "BatchIsMarkedForDeletion"],
          "filters": [
            {"field": "Material", "operator": "eq", "value": "{{input.material}}", "value_type": "string"},
            {"field": "BatchIdentifyingPlant", "operator": "eq", "value": "{{input.plant}}", "value_type": "string"}
          ],
          "rationale": "Read expiry evidence only when the user requests an expiry check."
        }}
      },
      {
        "id": "assess", "executor": "rule", "operation": "assess_api_evidence",
        "inputMapping": {
          "checks": {"stock": "{{steps.read_stock.output}}", "movement": "{{steps.read_movement_dates.output}}", "batch_expiry": "{{steps.read_batch_parameters.output}}"},
          "requested": {"stock": true, "movement": "{{steps.resolve_window.output.movement_check_requested}}", "batch_expiry": "{{steps.resolve_window.output.check_expiry}}"}
        }
      },
      {
        "id": "adt_stock", "executor": "skill", "operation": "execute", "skillId": "sap-adt-table-export", "readOnly": true, "failurePolicy": "record_gap",
        "when": {"source": "{{steps.assess.output.needs_adt.stock}}", "equals": true},
        "inputMapping": {
          "schema_version": 1, "source_type": "table", "object": "MARD", "fields": ["MATNR", "WERKS", "LGORT", "LABST", "MEINS"],
          "filters": [
            {"field": "MATNR", "operator": "eq", "value": "{{input.material}}"},
            {"field": "WERKS", "operator": "eq", "value": "{{input.plant}}"},
            {"field": "LGORT", "operator": "eq", "value": "{{input.storage_location}}"}
          ],
          "max_rows": 30000
        }
      },
      {
        "id": "adt_movement", "executor": "skill", "operation": "execute", "skillId": "sap-adt-table-export", "readOnly": true, "failurePolicy": "record_gap",
        "when": {"source": "{{steps.assess.output.needs_adt.movement}}", "equals": true},
        "inputMapping": {
          "schema_version": 1, "source_type": "table", "object": "MATDOC", "fields": ["MBLNR", "MJAHR", "ZEILE", "MATNR", "WERKS", "LGORT", "BUDAT", "BWART", "MENGE", "MEINS"],
          "filters": [
            {"field": "MATNR", "operator": "eq", "value": "{{input.material}}"},
            {"field": "WERKS", "operator": "eq", "value": "{{input.plant}}"},
            {"field": "LGORT", "operator": "eq", "value": "{{input.storage_location}}"},
            {"field": "BUDAT", "operator": "bt", "low": "{{steps.resolve_window.output.movement_date_from}}", "high": "{{steps.resolve_window.output.snapshot_date}}"}
          ],
          "max_rows": 30000
        }
      },
      {
        "id": "adt_batch", "executor": "skill", "operation": "execute", "skillId": "sap-adt-table-export", "readOnly": true, "failurePolicy": "record_gap",
        "when": {"source": "{{steps.assess.output.needs_adt.batch_expiry}}", "equals": true},
        "inputMapping": {
          "schema_version": 1, "source_type": "table", "object": "MCHA", "fields": ["MATNR", "WERKS", "CHARG", "VFDAT"],
          "filters": [
            {"field": "MATNR", "operator": "eq", "value": "{{input.material}}"},
            {"field": "WERKS", "operator": "eq", "value": "{{input.plant}}"}
          ],
          "max_rows": 30000
        }
      },
      {
        "id": "evaluate", "executor": "rule", "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "inventory-health-balancing", "run_input": "{{input}}", "window": "{{steps.resolve_window.output}}", "assessment": "{{steps.assess.output}}",
          "evidence": {"stock": "{{steps.read_stock.output}}", "movement": "{{steps.read_movement_dates.output}}", "batch_expiry": "{{steps.read_batch_parameters.output}}"},
          "fallbacks": {"stock": "{{steps.adt_stock.output}}", "movement": "{{steps.adt_movement.output}}", "batch_expiry": "{{steps.adt_batch.output}}"},
          "known_gaps": []
        }
      }
    ],
    "acceptance": {
      "schemaVersion": "2.0",
      "comparisonMode": "business_semantic",
      "businessKeys": ["material", "plant", "storage_location"],
      "facts": ["snapshot_date", "last_movement_date", "slow_moving_status", "obsolete_status", "expiry_status", "business_status", "source_complete", "evidence_complete"],
      "metrics": ["current_unrestricted_stock", "stock_age_days", "stock_age_lower_bound_days", "expiry_candidate_count"],
      "decimalFields": ["current_unrestricted_stock"],
      "decimalMetricIds": ["current_unrestricted_stock"],
      "currencyFields": [],
      "unitFields": ["unit"],
      "dateFields": ["snapshot_date", "last_movement_date"],
      "codeSetFields": [],
      "zeroPadFields": {},
      "booleanFields": ["source_complete", "evidence_complete"],
      "inputDefaults": {}, "constantDefaults": {}, "fieldAliases": {}, "fieldExtractors": {}, "currencyFromDecimal": {},
