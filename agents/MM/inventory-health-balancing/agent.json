  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {
      "type": "object",
      "properties": {
        "material": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "物料",
            "en": "Material"
          }
        },
        "plant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "工厂",
            "en": "Plant"
          }
        },
        "storage_location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "storage location",
            "en": "Storage Location"
          }
        },
        "date_from": {
          "type": "string",
          "format": "date",
          "title": {
            "zh": "date from",
            "en": "Date From"
          }
        },
        "as_of": {
          "type": "string",
          "format": "date",
          "title": {
            "zh": "查询基准日",
            "en": "As-of date"
          }
        },
        "slow_moving_days": {
          "type": "integer",
          "title": {
            "zh": "slow moving days",
            "en": "Slow Moving Days"
          }
        },
        "obsolete_days": {
          "type": "integer",
          "title": {
            "zh": "obsolete days",
            "en": "Obsolete Days"
          }
        },
        "expiry_days": {
          "type": "integer",
          "title": {
            "zh": "expiry days",
            "en": "Expiry Days"
          }
        }
      },
      "required": [
        "material",
        "plant",
        "storage_location",
        "date_from",
        "as_of"
      ],
      "additionalProperties": false,
      "dateRangePairs": [
        {
          "from": "date_from",
          "to": "as_of",
          "maxDays": 365
        }
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "material": {
          "type": "string",
          "title": {
            "zh": "物料",
            "en": "Material"
          }
        },
        "plant": {
          "type": "string",
          "title": {
            "zh": "工厂",
            "en": "Plant"
          }
        },
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "material",
        "plant",
        "business_status",
        "source_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "material": "{{steps.evaluate.output.workflow_output.material}}",
      "plant": "{{steps.evaluate.output.workflow_output.plant}}",
      "business_status": "{{steps.evaluate.output.workflow_output.business_status}}",
      "source_complete": "{{steps.evaluate.output.workflow_output.source_complete}}",
      "business_report": "{{steps.evaluate.output.workflow_output.business_report}}"
    },
    "steps": [
      {
        "id": "read_stock",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_MATERIAL_STOCK_SRV",
            "odata_version": "2.0",
            "entity_set": "A_MatlStkInAcctMod",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "Material",
              "Plant",
              "StorageLocation",
              "InventoryStockType",
              "MatlWrhsStkQtyInMatlBaseUnit",
              "MaterialBaseUnit"
            ],
            "filters": [
              {
                "field": "Material",
                "operator": "eq",
                "value": "{{input.material}}",
                "value_type": "string"
              },
              {
                "field": "Plant",
                "operator": "eq",
                "value": "{{input.plant}}",
                "value_type": "string"
              },
              {
                "field": "StorageLocation",
                "operator": "eq",
                "value": "{{input.storage_location}}",
                "value_type": "string"
              }
            ],
            "rationale": "Collect bounded unrestricted stock evidence."
          }
        }
      },
      {
        "id": "read_movement",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_MATERIAL_DOCUMENT_SRV",
            "odata_version": "2.0",
            "entity_set": "A_MaterialDocumentItem",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "MaterialDocumentYear",
              "MaterialDocument",
              "MaterialDocumentItem",
              "Material",
              "Plant",
              "StorageLocation",
              "GoodsMovementType",
              "QuantityInEntryUnit",
              "EntryUnit",
              "DebitCreditCode",
              "ReversedMaterialDocument"
            ],
            "filters": [
              {
                "field": "Material",
                "operator": "eq",
                "value": "{{input.material}}",
                "value_type": "string"
              },
              {
                "field": "Plant",
                "operator": "eq",
                "value": "{{input.plant}}",
                "value_type": "string"
              },
              {
                "field": "StorageLocation",
                "operator": "eq",
                "value": "{{input.storage_location}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read exact material-document items; posting dates are joined from headers in the next GET-only step."
          }
        }
      },
      {
        "id": "read_movement_dates",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_MATERIAL_DOCUMENT_SRV",
            "odata_version": "2.0",
            "entity_set": "A_MaterialDocumentItem",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "movement_date_items",
                "service_name": "API_MATERIAL_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_MaterialDocumentItem",
                "http_method": "GET",
                "select_fields": [
                  "MaterialDocumentYear",
                  "MaterialDocument",
                  "MaterialDocumentItem",
                  "Material",
                  "Plant",
                  "StorageLocation"
                ],
                "filters": [
                  {
                    "field": "Material",
                    "operator": "eq",
                    "value": "{{input.material}}",
                    "value_type": "string"
                  },
                  {
                    "field": "Plant",
                    "operator": "eq",
                    "value": "{{input.plant}}",
                    "value_type": "string"
                  },
                  {
                    "field": "StorageLocation",
                    "operator": "eq",
                    "value": "{{input.storage_location}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "movement_date_headers",
                "service_name": "API_MATERIAL_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_MaterialDocumentHeader",
                "http_method": "GET",
                "select_fields": [
                  "MaterialDocumentYear",
                  "MaterialDocument",
                  "PostingDate"
                ],
                "filters": [
                  {
                    "field": "PostingDate",
                    "operator": "ge",
                    "value": "{{input.date_from}}",
                    "value_type": "date_start"
                  },
                  {
                    "field": "PostingDate",
                    "operator": "le",
                    "value": "{{input.as_of}}",
                    "value_type": "date_end"
                  }
                ],
                "filter_from_previous": [
                  {
                    "field": "MaterialDocumentYear",
                    "source_step_id": "movement_date_items",
                    "source_field": "MaterialDocumentYear",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "MaterialDocument",
                    "source_step_id": "movement_date_items",
                    "source_field": "MaterialDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              }
            ],
            "rationale": "Join material-document header posting dates to exact movement keys and apply the requested date window."
          }
        }
      },
      {
        "id": "read_batch_parameters",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_BATCH_SRV",
            "odata_version": "2.0",
            "entity_set": "Batch",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "Material",
              "BatchIdentifyingPlant",
              "Batch",
              "ShelfLifeExpirationDate",
              "ManufactureDate",
              "BatchIsMarkedForDeletion"
            ],
            "filters": [
              {
                "field": "Material",
                "operator": "eq",
                "value": "{{input.material}}",
                "value_type": "string"
              },
              {
                "field": "BatchIdentifyingPlant",
                "operator": "eq",
                "value": "{{input.plant}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read target-system Batch entities and expiry dates for the exact material and identifying plant."
          }
        }
      },
      {
        "id": "read_parameters",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
