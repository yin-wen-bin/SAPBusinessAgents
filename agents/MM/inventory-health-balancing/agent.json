{
  "schemaVersion":2,"slug":"inventory-health-balancing","module":"MM",
  "title":{"zh":"库存健康与库存平衡助手","en":"Inventory Health and Balancing Assistant"},
  "summary":{"zh":"结合库存余额、移动历史、批次效期和补货参数识别慢动、呆滞、临期与平衡候选。","en":"Combines stock balances, movement history, batch expiry, and replenishment parameters to identify slow-moving, obsolete, expiring, and balancing candidates."},
  "status":"Deterministic prototype pending live validation","version":"0.1.0","owner":"MM-IM / Inventory Planning",
  "tags":["Inventory","Slow Moving","Shelf Life","Balancing"],"sapModules":["MM-IM","MM-BD"],
  "transactions":["MMBE","MB5B","MB51","MSC3N"],"tables":["MARD","MCHB","MCHA","MCH1","MATDOC","MKPF","MSEG","MARC"],"systems":["SAP ECC","SAP S/4HANA"],
  "inputs":{"zh":["物料","工厂","库存地点","评估基准日","慢动/呆滞/临期阈值"],"en":["Material","Plant","Storage location","Evaluation date","Slow-moving/obsolete/expiry thresholds"]},
  "outputs":{"zh":["库存健康分类","慢动与呆滞候选","临期批次","平衡候选","受控调拨量"],"en":["Inventory health classification","Slow-moving and obsolete candidates","Expiring batches","Balancing candidates","Controlled transfer quantity"]},
  "guardrails":{"zh":["只使用 unrestricted/available 库存","缺少安全库存、单位或批次数量时不输出确定调拨量","MB5B 仅作额外余额核对","全部 SAP 访问为 GET-only"],"en":["Use unrestricted/available stock only","Suppress confirmed transfer quantity without safety stock, units, or batch quantities","Use MB5B only as an additional balance check","All SAP access is GET-only"]},
  "workflow":[
    {"id":"parse-input","title":{"zh":"1. 解析输入","en":"1. Parse input"},"description":{"zh":"验证物料、工厂、库存地点、日期和 180/365/90 天默认阈值。","en":"Validate material, plant, storage location, date, and default 180/365/90-day thresholds."},"operations":{"zh":["限制为单一库存范围。"],"en":["Limit execution to one inventory scope."]},"tools":[{"name":"Input schema","kind":"Control","purpose":{"zh":"阻止无界查询。","en":"Prevents unbounded queries."}}]},
    {"id":"check-embedded","title":{"zh":"2. 检查 Embedded Provider/schema","en":"2. Check Embedded Provider/schema"},"description":{"zh":"确认 embedded、read_only 与实时 metadata。","en":"Confirm embedded selection, read-only state, and live metadata."},"operations":{"zh":["验证库存、物料凭证和批次 API。"],"en":["Validate stock, material-document, and batch APIs."]},"tools":[{"name":"embedded-sap-odata","kind":"SAP read Provider","purpose":{"zh":"提供标准 API schema。","en":"Provides standard API schemas."}}]},
    {"id":"read-api","title":{"zh":"3. 读取标准 API","en":"3. Read standard APIs"},"description":{"zh":"读取当前库存、移动历史、批次效期和补货参数。","en":"Read current stock, movement history, batch expiry, and replenishment parameters."},"operations":{"zh":["按物料、工厂、库存地点和日期范围过滤。"],"en":["Filter by material, plant, storage location, and date range."]},"tools":[{"name":"Released SAP OData APIs","kind":"SAP API","purpose":{"zh":"提供首选库存证据。","en":"Provides preferred inventory evidence."}}]},
    {"id":"assess-gap","title":{"zh":"4. 评估 API 证据缺口","en":"4. Assess API evidence gaps"},"description":{"zh":"检查 stock、movement、batch_expiry、parameters 完整性。","en":"Check completeness for stock, movement, batch_expiry, and parameters."},"operations":{"zh":["空结果不会自动视为零库存。"],"en":["An empty result is not automatically treated as zero stock."]},"tools":[{"name":"assess_api_evidence","kind":"Deterministic rule","purpose":{"zh":"生成 ADT 条件。","en":"Produces ADT conditions."}}]},
    {"id":"adt-fallback","title":{"zh":"5. 条件调用 sap-adt-table-export","en":"5. Conditionally call sap-adt-table-export"},"description":{"zh":"按缺口读取 MARD、MATDOC、MCH1、MARC。","en":"Read MARD, MATDOC, MCH1, and MARC only for identified gaps."},"operations":{"zh":["使用静态对象、字段、过滤、稳定键和 max_rows。"],"en":["Use static objects, fields, filters, stable keys, and max_rows."]},"tools":[{"name":"sap-adt-table-export","kind":"SAPSkillhub Skill","purpose":{"zh":"提供表级补证。","en":"Provides table-level supplemental evidence."}}]},
    {"id":"merge-evidence","title":{"zh":"6. 合并并验证证据","en":"6. Merge and validate evidence"},"description":{"zh":"校验完整性、分页、单位、批次数量和 SHA-256 manifest。","en":"Validate completeness, paging, units, batch quantities, and the SHA-256 manifest."},"operations":{"zh":["达到行数上限即保持 partial。"],"en":["Keep the result partial when the row limit is reached."]},"tools":[{"name":"Evidence gate","kind":"Control","purpose":{"zh":"保护完整性语义。","en":"Protects completeness semantics."}}]},
    {"id":"analyze","title":{"zh":"7. 执行确定性分析","en":"7. Run deterministic analysis"},"description":{"zh":"按 180/365/90 天识别慢动、呆滞、临期并形成平衡候选。","en":"Apply 180/365/90-day rules for slow-moving, obsolete, expiring, and balancing candidates."},"operations":{"zh":["只在证据和单位完整时计算确定调拨量。"],"en":["Calculate a confirmed transfer quantity only with complete evidence and units."]},"tools":[{"name":"Inventory health analyzer","kind":"Rule engine","purpose":{"zh":"生成确定性分类。","en":"Produces deterministic classifications."}}]},
    {"id":"present","title":{"zh":"8. 输出结论和限制","en":"8. Present conclusions and limits"},"description":{"zh":"输出分类、候选、证据缺口和人工复核建议。","en":"Present classifications, candidates, evidence gaps, and human-review actions."},"operations":{"zh":["必需证据不完整时输出 INCONCLUSIVE。"],"en":["Return INCONCLUSIVE when required evidence is incomplete."]},"tools":[{"name":"Business report","kind":"Output","purpose":{"zh":"形成双语报告。","en":"Creates a bilingual report."}}]}
  ],
  "execution":{"mode":"deterministic","timeoutSeconds":600,
    "inputSchema":{"type":"object","properties":{"material":{"type":"string","minLength":1,"maxLength":40,"pattern":"^[0-9A-Za-z_-]+$"},"plant":{"type":"string","minLength":1,"maxLength":4,"pattern":"^[0-9A-Za-z_-]+$"},"storage_location":{"type":"string","minLength":1,"maxLength":4,"pattern":"^[0-9A-Za-z_-]+$"},"date_from":{"type":"string","format":"date"},"as_of":{"type":"string","format":"date"},"slow_moving_days":{"type":"integer"},"obsolete_days":{"type":"integer"},"expiry_days":{"type":"integer"}},"required":["material","plant","storage_location","date_from","as_of"],"additionalProperties":false,"dateRangePairs":[{"from":"date_from","to":"as_of","maxDays":365}]},
    "outputSchema":{"type":"object","properties":{"material":{"type":"string"},"plant":{"type":"string"},"business_status":{"type":"string"},"source_complete":{"type":"boolean"},"business_report":{"type":"object"}},"required":["material","plant","business_status","source_complete","business_report"],"additionalProperties":false},
    "outputMapping":{"material":"{{steps.evaluate.output.workflow_output.material}}","plant":"{{steps.evaluate.output.workflow_output.plant}}","business_status":"{{steps.evaluate.output.workflow_output.business_status}}","source_complete":"{{steps.evaluate.output.workflow_output.source_complete}}","business_report":"{{steps.evaluate.output.workflow_output.business_report}}"},
    "steps":[
      {"id":"read_stock","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_MATERIAL_STOCK_SRV","entity_set":"A_MatlStkInAcctMod","http_method":"GET","plan_kind":"direct","select_fields":["Material","Plant","StorageLocation","InventoryStockType","MatlWrhsStkQtyInMatlBaseUnit","MaterialBaseUnit"],"filters":[{"field":"Material","operator":"eq","value":"{{input.material}}","value_type":"string"},{"field":"Plant","operator":"eq","value":"{{input.plant}}","value_type":"string"},{"field":"StorageLocation","operator":"eq","value":"{{input.storage_location}}","value_type":"string"}],"rationale":"Collect bounded unrestricted stock evidence."}}},
      {"id":"read_movement","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_MATERIAL_DOCUMENT_SRV","entity_set":"A_MaterialDocumentItem","http_method":"GET","plan_kind":"direct","select_fields":["MaterialDocument","MaterialDocumentYear","MaterialDocumentItem","Material","Plant","StorageLocation","GoodsMovementType","QuantityInEntryUnit","EntryUnit"],"filters":[{"field":"Material","operator":"eq","value":"{{input.material}}","value_type":"string"},{"field":"Plant","operator":"eq","value":"{{input.plant}}","value_type":"string"},{"field":"StorageLocation","operator":"eq","value":"{{input.storage_location}}","value_type":"string"}],"rationale":"Collect bounded movement core evidence; posting date requires fallback."}}},
      {"id":"read_movement_dates","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_MATERIAL_DOCUMENT_SRV","entity_set":"A_MaterialDocumentItem","http_method":"GET","plan_kind":"direct","select_fields":["MaterialDocument","MaterialDocumentYear","MaterialDocumentItem","PostingDate"],"filters":[{"field":"Material","operator":"eq","value":"{{input.material}}","value_type":"string"},{"field":"Plant","operator":"eq","value":"{{input.plant}}","value_type":"string"},{"field":"StorageLocation","operator":"eq","value":"{{input.storage_location}}","value_type":"string"}],"rationale":"Collect posting dates when the live item API exposes them."}}},
      {"id":"read_batch_parameters","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_BATCH_SRV","entity_set":"A_BatchPlant","http_method":"GET","plan_kind":"direct","select_fields":["Material","Batch","Plant","ShelfLifeExpirationDate","LastGoodsReceiptDate"],"filters":[{"field":"Material","operator":"eq","value":"{{input.material}}","value_type":"string"},{"field":"Plant","operator":"eq","value":"{{input.plant}}","value_type":"string"}],"rationale":"Collect bounded batch and replenishment evidence."}}},
      {"id":"read_parameters","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_MRP_MATERIALS_SRV_01","entity_set":"A_MRPMaterial","http_method":"GET","plan_kind":"direct","select_fields":["Material","MRPPlant","MaterialBaseUnit","SafetyStockQuantity"],"filters":[{"field":"Material","operator":"eq","value":"{{input.material}}","value_type":"string"},{"field":"MRPPlant","operator":"eq","value":"{{input.plant}}","value_type":"string"}],"rationale":"Collect safety-stock and replenishment parameters."}}},
      {"id":"assess","executor":"rule","operation":"assess_api_evidence","inputMapping":{"checks":{"stock":"{{steps.read_stock.output}}","movement":{"core":"{{steps.read_movement.output}}","dates":"{{steps.read_movement_dates.output}}"},"batch_expiry":"{{steps.read_batch_parameters.output}}","parameters":"{{steps.read_parameters.output}}"}}},
      {"id":"adt_stock","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.stock}}","equals":true},"inputMapping":{"schema_version":1,"connection_profile":"mm-read-only","source_type":"table","object":"MARD","fields":["MATNR","WERKS","LGORT","LABST","INSME","SPEME"],"filters":[{"field":"MATNR","operator":"eq","value":"{{input.material}}"},{"field":"WERKS","operator":"eq","value":"{{input.plant}}"},{"field":"LGORT","operator":"eq","value":"{{input.storage_location}}"}],"order_by":["MATNR","WERKS","LGORT"],"max_rows":10000}},
      {"id":"adt_movement","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.movement}}","equals":true},"inputMapping":{"schema_version":1,"connection_profile":"mm-read-only","source_type":"table","object":"MATDOC","fields":["MBLNR","MJAHR","ZEILE","MATNR","WERKS","LGORT","BUDAT","BWART","MENGE","MEINS"],"filters":[{"field":"MATNR","operator":"eq","value":"{{input.material}}"},{"field":"WERKS","operator":"eq","value":"{{input.plant}}"},{"field":"LGORT","operator":"eq","value":"{{input.storage_location}}"},{"field":"BUDAT","operator":"bt","low":"{{input.date_from}}","high":"{{input.as_of}}"}],"order_by":["MJAHR","MBLNR","ZEILE"],"max_rows":10000}},
      {"id":"adt_batch","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.batch_expiry}}","equals":true},"inputMapping":{"schema_version":1,"connection_profile":"mm-read-only","source_type":"table","object":"MCHA","fields":["MATNR","WERKS","CHARG","VFDAT"],"filters":[{"field":"MATNR","operator":"eq","value":"{{input.material}}"},{"field":"WERKS","operator":"eq","value":"{{input.plant}}"}],"order_by":["MATNR","WERKS","CHARG"],"max_rows":10000}},
      {"id":"adt_parameters","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.parameters}}","equals":true},"inputMapping":{"schema_version":1,"connection_profile":"mm-read-only","source_type":"table","object":"MARC","fields":["MATNR","WERKS","EISBE","DISMM","DISPO"],"filters":[{"field":"MATNR","operator":"eq","value":"{{input.material}}"},{"field":"WERKS","operator":"eq","value":"{{input.plant}}"}],"order_by":["MATNR","WERKS"],"max_rows":10000}},
      {"id":"evaluate","executor":"rule","operation":"evaluate_business_agent","inputMapping":{"agent_id":"inventory-health-balancing","run_input":"{{input}}","assessment":"{{steps.assess.output}}","evidence":{"stock":"{{steps.read_stock.output}}","movement":"{{steps.read_movement.output}}","movement_dates":"{{steps.read_movement_dates.output}}","batch":"{{steps.read_batch_parameters.output}}","parameters":"{{steps.read_parameters.output}}"},"fallbacks":{"stock":"{{steps.adt_stock.output}}","movement":"{{steps.adt_movement.output}}","batch_expiry":"{{steps.adt_batch.output}}","parameters":"{{steps.adt_parameters.output}}"},"known_gaps":[]}}
    ]},
  "validation":{"verdict":"BLOCKED","testedAt":"2026-08-17T17:10:00+08:00","evidenceScope":"bounded","providers":["embedded-sap-odata","sap-adt-table-export"],"summary":{"zh":"库存和移动核心 GET 完整；效期/日期补证因 ADT profile 缺失而阻塞。","en":"Stock and movement core GETs completed; expiry/date evidence is blocked by the missing ADT profile."},"reportPath":"docs/live-sap-test-report.md"}
