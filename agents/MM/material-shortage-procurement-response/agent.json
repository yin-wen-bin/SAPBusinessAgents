  "title": {
    "zh": "外购件短缺采购响应助手",
    "en": "Material Shortage Procurement Response Assistant"
  },
  "summary": {
    "zh": "联结 MRP 短缺、采购申请、采购订单交期和有效货源，给出可审计的释放、转换与催交建议。",
    "en": "Links MRP shortages, requisitions, PO schedules, and valid sources into auditable release, conversion, and expediting recommendations."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.1.0",
