{
  "schemaVersion": 2,
  "slug": "material-shortage-procurement-response",
  "module": "MM",
  "title": {"zh": "外购件短缺采购响应助手", "en": "Material Shortage Procurement Response Assistant"},
  "summary": {"zh": "联结 MRP 短缺、采购申请、采购订单交期和有效货源，给出可审计的释放、转换与催交建议。", "en": "Links MRP shortages, requisitions, PO schedules, and valid sources into auditable release, conversion, and expediting recommendations."},
  "status": "Deterministic prototype pending live validation",
  "version": "0.1.0",
  "owner": "MM-PUR / PP-MRP",
  "tags": ["MRP", "Shortage", "Purchase Requisition", "Expediting"],
  "sapModules": ["MM-PUR", "PP-MRP"],
  "transactions": ["MD04", "MD05", "ME53N", "ME23N"],
  "tables": ["MDKP", "MDTB", "EBAN", "EKPO", "EKET", "EINA", "EINE"],
  "systems": ["SAP ECC", "SAP S/4HANA"],
  "inputs": {"zh": ["物料", "工厂", "MRP 范围", "采购组织", "评估基准日"], "en": ["Material", "Plant", "MRP area", "Purchasing organization", "Evaluation date"]},
  "outputs": {"zh": ["待释放与待转换 PR", "催交 PO", "交期风险", "有效货源", "确定或受抑制的短缺量"], "en": ["PRs to release or convert", "POs to expedite", "Delivery risk", "Valid sources", "Confirmed or suppressed shortage quantity"]},
  "guardrails": {"zh": ["只读，不创建或修改采购凭证", "单位不可比时不计算确定缺口", "ADT 仅在 API 证据不足时按白名单调用", "缺失、超时和截断不得解释为零记录"], "en": ["Read-only; never create or change purchasing documents", "Do not calculate a confirmed gap when units are incomparable", "Call allowlisted ADT only when API evidence is insufficient", "Never interpret missing, timed-out, or truncated evidence as zero records"]},
  "workflow": [
    {"id":"parse-input","title":{"zh":"1. 解析输入","en":"1. Parse input"},"description":{"zh":"验证物料、工厂、MRP 范围、采购组织和基准日。","en":"Validate material, plant, MRP area, purchasing organization, and evaluation date."},"operations":{"zh":["拒绝无界或格式无效的查询。"],"en":["Reject unbounded or malformed queries."]},"tools":[{"name":"Input schema","kind":"Control","purpose":{"zh":"建立有界范围。","en":"Establishes bounded scope."}}]},
    {"id":"check-embedded","title":{"zh":"2. 检查 Embedded Provider/schema","en":"2. Check Embedded Provider/schema"},"description":{"zh":"要求 selected_provider=embedded、read_only=true 并读取实时 metadata。","en":"Require selected_provider=embedded and read_only=true, then read live metadata."},"operations":{"zh":["验证 MRP 与采购 API 的实体和字段。"],"en":["Validate entities and fields for MRP and purchasing APIs."]},"tools":[{"name":"embedded-sap-odata","kind":"SAP read Provider","purpose":{"zh":"提供 GET-only schema。","en":"Provides GET-only schema."}}]},
    {"id":"read-api","title":{"zh":"3. 读取标准 API","en":"3. Read standard APIs"},"description":{"zh":"读取 MRP 覆盖、供需、PR、PO 交期、信息记录、合同和供应商状态。","en":"Read MRP coverage, supply-demand, PR, PO schedule, info record, contract, and supplier status evidence."},"operations":{"zh":["全部请求使用精确过滤和完整分页。"],"en":["Use exact filters and complete paging for every request."]},"tools":[{"name":"Released SAP OData APIs","kind":"SAP API","purpose":{"zh":"提供首选业务证据。","en":"Provides preferred business evidence."}}]},
    {"id":"assess-gap","title":{"zh":"4. 评估 API 证据缺口","en":"4. Assess API evidence gaps"},"description":{"zh":"确定性检查实体、字段、分页和业务关联。","en":"Deterministically check entities, fields, paging, and business relationships."},"operations":{"zh":["按 mrp、pr、po_schedule、source 生成布尔 needs_adt。"],"en":["Produce boolean needs_adt flags for mrp, pr, po_schedule, and source."]},"tools":[{"name":"assess_api_evidence","kind":"Deterministic rule","purpose":{"zh":"控制降级。","en":"Controls fallback."}}]},
    {"id":"adt-fallback","title":{"zh":"5. 条件调用 sap-adt-table-export","en":"5. Conditionally call sap-adt-table-export"},"description":{"zh":"仅对明确缺口执行受保护、静态、有界的 ADT 查询。","en":"Run protected, static, bounded ADT queries only for explicit gaps."},"operations":{"zh":["未触发步骤记录 skipped/condition_false。"],"en":["Record skipped/condition_false for untriggered steps."]},"tools":[{"name":"sap-adt-table-export","kind":"SAPSkillhub Skill","purpose":{"zh":"补充 MDKP、EBAN、EKET、EINE 证据。","en":"Supplements MDKP, EBAN, EKET, and EINE evidence."}}]},
    {"id":"merge-evidence","title":{"zh":"6. 合并并验证证据","en":"6. Merge and validate evidence"},"description":{"zh":"按业务键合并 API 与 ADT，并校验完整性和哈希。","en":"Merge API and ADT by business keys and validate completeness and hashes."},"operations":{"zh":["partial、failed 或哈希失败保持证据缺口。"],"en":["Keep an evidence gap for partial, failed, or hash-invalid results."]},"tools":[{"name":"Evidence gate","kind":"Control","purpose":{"zh":"抑制不完整结论。","en":"Suppresses incomplete conclusions."}}]},
    {"id":"analyze","title":{"zh":"7. 执行确定性分析","en":"7. Run deterministic analysis"},"description":{"zh":"识别待释放/转换 PR、催交 PO、交期风险与有效货源。","en":"Identify PRs to release/convert, POs to expedite, schedule risk, and valid sources."},"operations":{"zh":["只有供需完整且单位一致才计算确定缺口。"],"en":["Calculate a confirmed shortage only with complete supply-demand evidence and consistent units."]},"tools":[{"name":"Shortage procurement analyzer","kind":"Rule engine","purpose":{"zh":"生成可解释建议。","en":"Produces explainable recommendations."}}]},
    {"id":"present","title":{"zh":"8. 输出结论和限制","en":"8. Present conclusions and limits"},"description":{"zh":"输出双语状态、证据范围、缺口和建议动作。","en":"Present bilingual status, evidence scope, gaps, and recommended actions."},"operations":{"zh":["必需证据缺失时输出 INCONCLUSIVE。"],"en":["Return INCONCLUSIVE when required evidence is missing."]},"tools":[{"name":"Business report","kind":"Output","purpose":{"zh":"形成审计友好报告。","en":"Creates an audit-friendly report."}}]}
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {"type":"object","properties":{"material":{"type":"string","minLength":1,"maxLength":40,"pattern":"^[0-9A-Za-z_-]+$"},"plant":{"type":"string","minLength":1,"maxLength":4,"pattern":"^[0-9A-Za-z_-]+$"},"mrp_area":{"type":"string","minLength":1,"maxLength":10,"pattern":"^[0-9A-Za-z_-]+$"},"purchasing_organization":{"type":"string","minLength":1,"maxLength":4,"pattern":"^[0-9A-Za-z_-]+$"},"shortage_profile":{"type":"string","minLength":1,"maxLength":20,"pattern":"^[0-9A-Za-z_-]+$"},"shortage_counter":{"type":"string","minLength":1,"maxLength":3,"pattern":"^[0-9]+$"},"as_of":{"type":"string","format":"date"}},"required":["material","plant","mrp_area","purchasing_organization","shortage_profile","shortage_counter","as_of"],"additionalProperties":false},
    "outputSchema":{"type":"object","properties":{"material":{"type":"string"},"plant":{"type":"string"},"business_status":{"type":"string"},"source_complete":{"type":"boolean"},"business_report":{"type":"object"}},"required":["material","plant","business_status","source_complete","business_report"],"additionalProperties":false},
    "outputMapping":{"material":"{{steps.evaluate.output.workflow_output.material}}","plant":"{{steps.evaluate.output.workflow_output.plant}}","business_status":"{{steps.evaluate.output.workflow_output.business_status}}","source_complete":"{{steps.evaluate.output.workflow_output.source_complete}}","business_report":"{{steps.evaluate.output.workflow_output.business_report}}"},
    "steps": [
      {"id":"read_mrp","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_MRP_MATERIALS_SRV_01","entity_set":"MaterialCoverages","http_method":"GET","plan_kind":"direct","select_fields":["Material","MRPArea","MRPPlant","MaterialBaseUnit","MaterialShortageQuantity","MaterialShortageStartDate","MaterialShortageProfile","MaterialShortageProfileCount"],"filters":[{"field":"Material","operator":"eq","value":"{{input.material}}","value_type":"string"},{"field":"MRPArea","operator":"eq","value":"{{input.mrp_area}}","value_type":"string"},{"field":"MRPPlant","operator":"eq","value":"{{input.plant}}","value_type":"string"},{"field":"MaterialShortageProfile","operator":"eq","value":"{{input.shortage_profile}}","value_type":"string"},{"field":"MaterialShortageProfileCount","operator":"eq","value":"{{input.shortage_counter}}","value_type":"string"}],"rationale":"Collect bounded MRP shortage evidence."}}},
      {"id":"read_pr","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_PURCHASEREQ_PROCESS_SRV","entity_set":"A_PurchaseRequisitionItem","http_method":"GET","plan_kind":"direct","select_fields":["PurchaseRequisition","PurchaseRequisitionItem","Material","Plant","RequestedQuantity","BaseUnit","ProcessingStatus"],"filters":[{"field":"Material","operator":"eq","value":"{{input.material}}","value_type":"string"},{"field":"Plant","operator":"eq","value":"{{input.plant}}","value_type":"string"}],"rationale":"Collect bounded purchase requisition core evidence."}}},
      {"id":"read_pr_release","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_PURCHASEREQ_PROCESS_SRV","entity_set":"A_PurchaseRequisitionItem","http_method":"GET","plan_kind":"direct","select_fields":["PurchaseRequisition","PurchaseRequisitionItem","ReleaseStatus"],"filters":[{"field":"Material","operator":"eq","value":"{{input.material}}","value_type":"string"},{"field":"Plant","operator":"eq","value":"{{input.plant}}","value_type":"string"}],"rationale":"Collect release status when the live API exposes it."}}},
      {"id":"read_po_source","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_PURCHASEORDER_PROCESS_SRV","entity_set":"A_PurchaseOrderItem","http_method":"GET","plan_kind":"direct","select_fields":["PurchaseOrder","PurchaseOrderItem","Material","Plant","OrderQuantity","PurchaseOrderQuantityUnit"],"filters":[{"field":"Material","operator":"eq","value":"{{input.material}}","value_type":"string"},{"field":"Plant","operator":"eq","value":"{{input.plant}}","value_type":"string"}],"rationale":"Collect bounded PO item core evidence before schedule fallback."}}},
      {"id":"read_po_schedule","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_PURCHASEORDER_PROCESS_SRV","entity_set":"A_PurchaseOrderScheduleLine","http_method":"GET","plan_kind":"direct","select_fields":["PurchaseOrder","PurchaseOrderItem","ScheduleLine","ScheduleLineDeliveryDate","ScheduleLineOrderQuantity","OpenPurchaseOrderQuantity"],"filters":[{"field":"PurchasingOrganization","operator":"eq","value":"{{input.purchasing_organization}}","value_type":"string"},{"field":"Material","operator":"eq","value":"{{input.material}}","value_type":"string"},{"field":"Plant","operator":"eq","value":"{{input.plant}}","value_type":"string"}],"rationale":"Collect schedule lines when the live API exposes the required fields."}}},
      {"id":"read_source","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_INFORECORD_PROCESS_SRV","entity_set":"A_PurchasingInfoRecord","http_method":"GET","plan_kind":"direct","select_fields":["PurchasingInfoRecord","Supplier","Material","PurchasingOrganization","IsDeleted"],"filters":[{"field":"Material","operator":"eq","value":"{{input.material}}","value_type":"string"},{"field":"PurchasingOrganization","operator":"eq","value":"{{input.purchasing_organization}}","value_type":"string"}],"rationale":"Collect approved source evidence when the live API exposes purchasing-organization scope."}}},
      {"id":"assess","executor":"rule","operation":"assess_api_evidence","inputMapping":{"checks":{"mrp":"{{steps.read_mrp.output}}","pr":{"core":"{{steps.read_pr.output}}","release":"{{steps.read_pr_release.output}}"},"po_schedule":{"core":"{{steps.read_po_source.output}}","schedule":"{{steps.read_po_schedule.output}}"},"source":"{{steps.read_source.output}}"}}},
      {"id":"adt_mrp","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.mrp}}","equals":true},"inputMapping":{"schema_version":1,"connection_profile":"mm-read-only","source_type":"table","object":"MDKP","fields":["DTNUM","MATNR","PLWRK"],"filters":[{"field":"MATNR","operator":"eq","value":"{{input.material}}"},{"field":"PLWRK","operator":"eq","value":"{{input.plant}}"}],"order_by":["DTNUM"],"max_rows":10000}},
      {"id":"adt_pr","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.pr}}","equals":true},"inputMapping":{"schema_version":1,"connection_profile":"mm-read-only","source_type":"table","object":"EBAN","fields":["BANFN","BNFPO","MATNR","WERKS","MENGE","MEINS","FRGKZ"],"filters":[{"field":"MATNR","operator":"eq","value":"{{input.material}}"},{"field":"WERKS","operator":"eq","value":"{{input.plant}}"}],"order_by":["BANFN","BNFPO"],"max_rows":10000}},
      {"id":"adt_po_scope","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.po_schedule}}","equals":true},"inputMapping":{"schema_version":1,"connection_profile":"mm-read-only","source_type":"table","object":"EKPO","fields":["EBELN","EBELP","MATNR","WERKS"],"filters":[{"field":"MATNR","operator":"eq","value":"{{input.material}}"},{"field":"WERKS","operator":"eq","value":"{{input.plant}}"}],"order_by":["EBELN","EBELP"],"max_rows":100}},
      {"id":"po_numbers","executor":"rule","operation":"extract_bounded_values","inputMapping":{"payload":"{{steps.adt_po_scope.output}}","field":"EBELN","max_values":100}},
      {"id":"adt_po","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.po_numbers.output.has_values}}","equals":true},"inputMapping":{"schema_version":1,"connection_profile":"mm-read-only","source_type":"table","object":"EKET","fields":["EBELN","EBELP","ETENR","EINDT","MENGE","WEMNG"],"filters":[{"field":"EBELN","operator":"in","values":"{{steps.po_numbers.output.values}}"},{"field":"EINDT","operator":"le","value":"{{input.as_of}}"}],"order_by":["EBELN","EBELP","ETENR"],"max_rows":10000}},
      {"id":"adt_source_scope","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.source}}","equals":true},"inputMapping":{"schema_version":1,"connection_profile":"mm-read-only","source_type":"table","object":"EINA","fields":["INFNR","MATNR","LIFNR"],"filters":[{"field":"MATNR","operator":"eq","value":"{{input.material}}"}],"order_by":["INFNR"],"max_rows":100}},
      {"id":"info_numbers","executor":"rule","operation":"extract_bounded_values","inputMapping":{"payload":"{{steps.adt_source_scope.output}}","field":"INFNR","max_values":100}},
      {"id":"adt_source","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.info_numbers.output.has_values}}","equals":true},"inputMapping":{"schema_version":1,"connection_profile":"mm-read-only","source_type":"table","object":"EINE","fields":["INFNR","EKORG","ESOKZ","WERKS"],"filters":[{"field":"INFNR","operator":"in","values":"{{steps.info_numbers.output.values}}"},{"field":"EKORG","operator":"eq","value":"{{input.purchasing_organization}}"},{"field":"WERKS","operator":"eq","value":"{{input.plant}}"}],"order_by":["INFNR","EKORG","ESOKZ","WERKS"],"max_rows":10000}},
      {"id":"evaluate","executor":"rule","operation":"evaluate_business_agent","inputMapping":{"agent_id":"material-shortage-procurement-response","run_input":"{{input}}","assessment":"{{steps.assess.output}}","evidence":{"mrp":"{{steps.read_mrp.output}}","pr":"{{steps.read_pr.output}}","pr_release":"{{steps.read_pr_release.output}}","po":"{{steps.read_po_source.output}}","po_schedule":"{{steps.read_po_schedule.output}}","source":"{{steps.read_source.output}}"},"fallbacks":{"mrp":"{{steps.adt_mrp.output}}","pr":"{{steps.adt_pr.output}}","po_schedule":{"scope":"{{steps.adt_po_scope.output}}","detail":"{{steps.adt_po.output}}"},"source":{"scope":"{{steps.adt_source_scope.output}}","detail":"{{steps.adt_source.output}}"}},"known_gaps":[]}}
    ]
  },
  "validation":{"verdict":"BLOCKED","testedAt":"2026-08-17T17:10:00+08:00","evidenceScope":"bounded","providers":["embedded-sap-odata","sap-adt-table-export"],"summary":{"zh":"PR 和 PO 核心 GET 完整；MRP 超时且 ADT profile 未配置，结论保持 INCONCLUSIVE。","en":"PR and PO core GETs completed; MRP timed out and the ADT profile is missing, so conclusions remain inconclusive."},"reportPath":"docs/live-sap-test-report.md"}
}
