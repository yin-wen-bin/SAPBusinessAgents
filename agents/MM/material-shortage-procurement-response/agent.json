  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {
      "type": "object",
      "properties": {
        "material": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "物料",
            "en": "Material"
          }
        },
        "plant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "工厂",
            "en": "Plant"
          }
        },
        "mrp_area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "MRP 区域",
            "en": "MRP Area"
          }
        },
        "purchasing_organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "采购组织",
            "en": "Purchasing organization"
          }
        },
        "shortage_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[0-9A-Za-z_-]+$",
          "default": "SAP000000001",
          "x-sapba-server-default": true,
          "title": {
            "zh": "短缺参数文件",
            "en": "Shortage Profile"
          },
          "description": {
            "zh": "通常使用默认值 SAP000000001，无需修改；企业配置了自定义物料短缺参数文件时，请填写企业配置的参数文件 ID。",
            "en": "The default SAP000000001 normally requires no change. Enter the configured profile ID only when your organization uses a custom material shortage profile."
          }
        },
        "shortage_counter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[0-9]+$",
          "default": "001",
          "x-sapba-server-default": true,
          "title": {
            "zh": "短缺定义序号",
            "en": "Shortage Definition Counter"
          },
          "description": {
            "zh": "通常使用默认值 001，无需修改；使用自定义短缺参数文件时，请填写其中对应的短缺定义序号，并保留前导零。",
            "en": "The default 001 normally requires no change. For a custom shortage profile, enter its corresponding shortage-definition counter and preserve leading zeros."
          }
        },
        "as_of": {
          "type": "string",
          "format": "date",
          "title": {
            "zh": "查询基准日",
            "en": "As-of date"
          }
        }
      },
      "required": [
        "material",
        "plant",
        "mrp_area",
        "purchasing_organization",
        "shortage_profile",
        "shortage_counter",
        "as_of"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "material": {
          "type": "string",
          "title": {
            "zh": "物料",
            "en": "Material"
          }
        },
        "plant": {
          "type": "string",
          "title": {
            "zh": "工厂",
            "en": "Plant"
          }
        },
        "business_status": {
          "type": "string",
