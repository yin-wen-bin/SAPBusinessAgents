  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {
      "type": "object",
      "properties": {
        "rfq": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9A-Za-z]+$",
          "title": {
            "zh": "询价单",
            "en": "RFQ"
          }
        },
        "purchasing_organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "采购组织",
            "en": "Purchasing organization"
          }
        },
        "as_of": {
          "type": "string",
          "format": "date",
          "title": {
            "zh": "查询基准日",
            "en": "As-of date"
          }
        }
      },
      "required": [
        "rfq",
        "purchasing_organization",
        "as_of"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "rfq": {
          "type": "string",
          "title": {
            "zh": "询价单",
            "en": "RFQ"
          }
        },
        "purchasing_organization": {
          "type": "string",
          "title": {
            "zh": "采购组织",
            "en": "Purchasing organization"
          }
        },
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "rfq",
        "purchasing_organization",
        "business_status",
        "source_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "rfq": "{{steps.evaluate.output.workflow_output.rfq}}",
      "purchasing_organization": "{{steps.evaluate.output.workflow_output.purchasing_organization}}",
      "business_status": "{{steps.evaluate.output.workflow_output.business_status}}",
      "source_complete": "{{steps.evaluate.output.workflow_output.source_complete}}",
      "business_report": "{{steps.evaluate.output.workflow_output.business_report}}"
    },
    "steps": [
      {
        "id": "read_rfq",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_RFQ_PROCESS_SRV",
            "odata_version": "2.0",
            "entity_set": "A_RequestForQuotation",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "RequestForQuotation",
              "PurchasingOrganization",
              "DocumentCurrency"
            ],
            "filters": [
              {
                "field": "RequestForQuotation",
                "operator": "eq",
                "value": "{{input.rfq}}",
                "value_type": "string"
              },
              {
                "field": "PurchasingOrganization",
                "operator": "eq",
                "value": "{{input.purchasing_organization}}",
                "value_type": "string"
              }
            ],
            "rationale": "Collect bounded RFQ core evidence; submission and status require fallback."
          }
        }
      },
      {
        "id": "read_rfq_status",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_RFQ_PROCESS_SRV",
            "odata_version": "2.0",
            "entity_set": "A_RequestForQuotation",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "RequestForQuotation",
              "PurchasingOrganization",
              "DocumentCurrency"
            ],
            "filters": [
              {
                "field": "RequestForQuotation",
                "operator": "eq",
                "value": "{{input.rfq}}",
                "value_type": "string"
              }
            ],
            "rationale": "Re-read the exact RFQ using only fields exposed by live metadata; quotation lifecycle is read from quotation headers."
          }
        }
      },
      {
        "id": "read_quotation",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_QTN_PROCESS_SRV",
            "odata_version": "2.0",
            "entity_set": "A_SupplierQuotationItem",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "quotation_items",
                "service_name": "API_QTN_PROCESS_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SupplierQuotationItem",
                "http_method": "GET",
                "select_fields": [
                  "SupplierQuotation",
                  "SupplierQuotationItem",
                  "RequestForQuotation",
                  "RequestForQuotationItem",
                  "Material",
                  "Plant",
                  "ScheduleLineDeliveryDate",
                  "ScheduleLineOrderQuantity",
                  "OrderQuantityUnit",
                  "NetPriceAmount",
                  "NetPriceQuantity",
                  "DocumentCurrency"
                ],
                "filters": [
                  {
                    "field": "RequestForQuotation",
                    "operator": "eq",
                    "value": "{{input.rfq}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "quotation_headers",
                "service_name": "API_QTN_PROCESS_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SupplierQuotation",
                "http_method": "GET",
                "select_fields": [
                  "SupplierQuotation",
                  "Supplier",
                  "PurchasingOrganization",
                  "DocumentCurrency",
                  "RequestForQuotation",
                  "QuotationSubmissionDate",
                  "BindingPeriodValidityEndDate",
                  "QTNLifecycleStatus"
                ],
                "filter_from_previous": [
                  {
                    "field": "SupplierQuotation",
                    "source_step_id": "quotation_items",
                    "source_field": "SupplierQuotation",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "supplier_status",
                "service_name": "API_BUSINESS_PARTNER",
                "odata_version": "2.0",
                "entity_set": "A_SupplierPurchasingOrg",
                "http_method": "GET",
                "select_fields": [
                  "Supplier",
                  "PurchasingOrganization",
                  "PurchasingIsBlockedForSupplier",
                  "DeletionIndicator"
                ],
                "filters": [
                  {
                    "field": "PurchasingOrganization",
                    "operator": "eq",
                    "value": "{{input.purchasing_organization}}",
                    "value_type": "string"
                  }
                ],
                "filter_from_previous": [
                  {
                    "field": "Supplier",
                    "source_step_id": "quotation_headers",
                    "source_field": "Supplier",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              }
            ],
            "rationale": "Read quotation items, join quotation headers for supplier/lifecycle data, and read purchasing-organization supplier status."
          }
        }
      },
      {
        "id": "read_quotation_comparison",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_QTN_PROCESS_SRV",
            "odata_version": "2.0",
            "entity_set": "A_SupplierQuotation",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "SupplierQuotation",
              "Supplier",
              "PurchasingOrganization",
              "DocumentCurrency",
              "RequestForQuotation",
              "QuotationSubmissionDate",
              "BindingPeriodValidityEndDate",
              "QTNLifecycleStatus"
            ],
            "filters": [
              {
                "field": "RequestForQuotation",
                "operator": "eq",
                "value": "{{input.rfq}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read complete quotation-header comparison fields for the exact RFQ."
          }
        }
      },
      {
        "id": "read_supplier_source",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_INFORECORD_PROCESS_SRV",
            "odata_version": "2.0",
            "entity_set": "A_PurgInfoRecdOrgPlantData",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "PurchasingInfoRecord",
              "PurchasingInfoRecordCategory",
              "PurchasingOrganization",
              "Plant",
              "Supplier",
              "Material",
              "PurgDocOrderQuantityUnit",
              "NetPriceQuantityUnit",
              "NetPriceAmount",
              "MaterialPriceUnitQty",
              "IsMarkedForDeletion",
              "IsRelevantForAutomSrcg"
            ],
            "filters": [
              {
                "field": "PurchasingOrganization",
