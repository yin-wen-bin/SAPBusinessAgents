{
  "schemaVersion": 2,
  "slug": "intelligent-sourcing-rfq",
  "module": "MM",
  "title": {
    "zh": "智能寻源与 RFQ 评估助手",
    "en": "Intelligent Sourcing and RFQ Evaluation Assistant"
  },
  "summary": {
    "zh": "在询价评审时对照RFQ、供应商报价、报价比较与货源证据，查看固定权重形成的候选排序。",
    "en": "During sourcing review, compare RFQs, quotations, quotation comparisons and source evidence, then inspect fixed-weight rankings."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.1.1",
  "owner": "MM-PUR / Strategic Sourcing",
  "tags": [
    "RFQ",
    "Supplier Quotation",
    "Sourcing",
    "Supplier"
  ],
  "sapModules": [
    "MM-PUR"
  ],
  "transactions": [],
  "tables": [
    "EKKO",
    "EKPO",
    "EINE"
  ],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "询价单",
      "采购组织",
      "查询基准日"
    ],
    "en": [
      "RFQ",
      "Purchasing organization",
      "As-of date"
    ]
  },
  "outputs": {
    "zh": [
      "询价单",
      "采购组织",
      "业务状态",
      "查询源完整性",
      "结构化业务报告"
    ],
    "en": [
      "RFQ",
      "Purchasing organization",
      "Business status",
      "Query-source completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "价格 60、交期 25、完整性 15",
      "币种、单位或价格单位不可比时禁止统一排名",
      "冻结、撤回或失效报价不参与推荐",
      "只读评估，不创建或接受报价"
    ],
    "en": [
      "Price 60, delivery 25, completeness 15",
      "Do not rank when currency, unit, or price unit is incomparable",
      "Exclude blocked, withdrawn, or expired quotations",
      "Read-only evaluation; never create or accept quotations"
    ]
  },
  "workflow": [
    {
      "id": "execute-read_rfq",
      "title": {
        "zh": "读取询价单",
        "en": "Read requests for quotation"
      },
      "description": {
        "zh": "读取询价单，按本次输入范围取得只读证据并保留来源和缺口。",
        "en": "Read requests for quotation within the requested scope, preserving read-only evidence references and gaps."
      },
      "operations": {
        "zh": [
          "GET API_RFQ_PROCESS_SRV@2.0/A_RequestForQuotation"
        ],
        "en": [
          "GET API_RFQ_PROCESS_SRV@2.0/A_RequestForQuotation"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `read_rfq` / `execute_plan`",
            "en": "Execute `read_rfq` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "read_rfq"
      ]
    },
