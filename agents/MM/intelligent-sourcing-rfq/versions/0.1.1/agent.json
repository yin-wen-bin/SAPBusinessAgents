    {
      "id": "execute-assess",
      "title": {
        "zh": "检查本次分析的必需证据",
        "en": "Check evidence required for this analysis"
      },
      "description": {
        "zh": "检查本次分析的必需证据；只解释已取得的证据，不新增SAP查询或执行业务写入。",
        "en": "Check evidence required for this analysis using acquired evidence only; this step adds no SAP query or business write."
      },
      "operations": {
        "zh": [
          "rule.assess_api_evidence"
        ],
        "en": [
          "rule.assess_api_evidence"
        ]
      },
      "tools": [
