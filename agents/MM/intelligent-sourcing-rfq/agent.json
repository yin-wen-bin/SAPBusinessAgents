{
  "schemaVersion":2,"slug":"intelligent-sourcing-rfq","module":"MM",
  "title":{"zh":"智能寻源与 RFQ 评估助手","en":"Intelligent Sourcing and RFQ Evaluation Assistant"},
  "summary":{"zh":"整合 RFQ、报价、投标方状态、信息记录和合同，以固定权重形成可比较、可解释的推荐。","en":"Combines RFQs, quotations, bidder status, info records, and contracts into comparable, explainable recommendations with fixed weights."},
  "status":"Deterministic prototype pending live validation","version":"0.1.0","owner":"MM-PUR / Strategic Sourcing",
  "tags":["RFQ","Supplier Quotation","Sourcing","Supplier"],"sapModules":["MM-PUR"],"transactions":["ME43","ME47","ME49","ME13"],"tables":["EKKO","EKPO","EINA","EINE"],"systems":["SAP ECC","SAP S/4HANA"],
  "inputs":{"zh":["RFQ 编号","采购组织","评估基准日"],"en":["RFQ number","Purchasing organization","Evaluation date"]},
  "outputs":{"zh":["有效报价集合","价格/交期/完整性得分","不可比原因","推荐候选与限制"],"en":["Valid quotation set","Price/delivery/completeness scores","Incomparability reasons","Recommended candidates and limits"]},
  "guardrails":{"zh":["价格 60、交期 25、完整性 15","币种、单位或价格单位不可比时禁止统一排名","冻结、撤回或失效报价不参与推荐","只读评估，不创建或接受报价"],"en":["Price 60, delivery 25, completeness 15","Do not rank when currency, unit, or price unit is incomparable","Exclude blocked, withdrawn, or expired quotations","Read-only evaluation; never create or accept quotations"]},
  "workflow":[
    {"id":"parse-input","title":{"zh":"1. 解析输入","en":"1. Parse input"},"description":{"zh":"验证精确 RFQ、采购组织和基准日。","en":"Validate an exact RFQ, purchasing organization, and evaluation date."},"operations":{"zh":["禁止无 RFQ 的广域报价查询。"],"en":["Forbid broad quotation queries without an RFQ."]},"tools":[{"name":"Input schema","kind":"Control","purpose":{"zh":"建立精确范围。","en":"Establishes exact scope."}}]},
    {"id":"check-embedded","title":{"zh":"2. 检查 Embedded Provider/schema","en":"2. Check Embedded Provider/schema"},"description":{"zh":"确认 embedded、read_only 和 RFQ/报价实时 schema。","en":"Confirm embedded selection, read-only state, and live RFQ/quotation schemas."},"operations":{"zh":["验证 bidder、supplier、info record、contract 字段。"],"en":["Validate bidder, supplier, info-record, and contract fields."]},"tools":[{"name":"embedded-sap-odata","kind":"SAP read Provider","purpose":{"zh":"提供 GET-only schema。","en":"Provides GET-only schemas."}}]},
    {"id":"read-api","title":{"zh":"3. 读取标准 API","en":"3. Read standard APIs"},"description":{"zh":"读取 RFQ 抬头/项目/投标方、供应商报价、冻结状态和历史货源。","en":"Read RFQ header/item/bidder, supplier quotations, block status, and existing sources."},"operations":{"zh":["按 RFQ 和采购组织精确过滤。"],"en":["Filter exactly by RFQ and purchasing organization."]},"tools":[{"name":"Released SAP OData APIs","kind":"SAP API","purpose":{"zh":"提供首选寻源证据。","en":"Provides preferred sourcing evidence."}}]},
    {"id":"assess-gap","title":{"zh":"4. 评估 API 证据缺口","en":"4. Assess API evidence gaps"},"description":{"zh":"分别检查 rfq、quotation、supplier、source。","en":"Check rfq, quotation, supplier, and source evidence separately."},"operations":{"zh":["任何必需字段或分页缺失均触发对应缺口。"],"en":["Any required field or paging gap triggers its evidence gap."]},"tools":[{"name":"assess_api_evidence","kind":"Deterministic rule","purpose":{"zh":"控制 ADT 条件。","en":"Controls ADT conditions."}}]},
    {"id":"adt-fallback","title":{"zh":"5. 条件调用 sap-adt-table-export","en":"5. Conditionally call sap-adt-table-export"},"description":{"zh":"仅按精确 RFQ、报价、采购组织或供应商补充 EKKO/EKPO/EINE。","en":"Supplement EKKO/EKPO/EINE only with exact RFQ, quotation, purchasing-organization, or supplier filters."},"operations":{"zh":["伙伴来源未获实时确认前不猜测对象。"],"en":["Do not guess a partner object before live confirmation."]},"tools":[{"name":"sap-adt-table-export","kind":"SAPSkillhub Skill","purpose":{"zh":"提供受控表级证据。","en":"Provides controlled table-level evidence."}}]},
    {"id":"merge-evidence","title":{"zh":"6. 合并并验证证据","en":"6. Merge and validate evidence"},"description":{"zh":"校验 RFQ/报价关联、币种、单位、价格单位、完整性和 manifest。","en":"Validate RFQ/quotation relationships, currency, unit, price unit, completeness, and manifest."},"operations":{"zh":["partial 证据不得支撑统一排名。"],"en":["Partial evidence cannot support a unified ranking."]},"tools":[{"name":"Evidence gate","kind":"Control","purpose":{"zh":"确保可比性。","en":"Ensures comparability."}}]},
    {"id":"analyze","title":{"zh":"7. 执行确定性分析","en":"7. Run deterministic analysis"},"description":{"zh":"按价格 60、交期 25、完整性 15 评分并排除不合格报价。","en":"Score price 60, delivery 25, completeness 15 and exclude ineligible quotations."},"operations":{"zh":["得分相同时使用稳定业务键排序。"],"en":["Use stable business keys to break score ties."]},"tools":[{"name":"RFQ scoring engine","kind":"Rule engine","purpose":{"zh":"形成可重复评分。","en":"Produces reproducible scoring."}}]},
    {"id":"present","title":{"zh":"8. 输出结论和限制","en":"8. Present conclusions and limits"},"description":{"zh":"输出排名、排除原因、证据范围和采购员复核建议。","en":"Present ranking, exclusion reasons, evidence scope, and buyer-review actions."},"operations":{"zh":["不可比或缺证时输出 INCONCLUSIVE。"],"en":["Return INCONCLUSIVE for incomparable or missing evidence."]},"tools":[{"name":"Business report","kind":"Output","purpose":{"zh":"生成双语评估报告。","en":"Creates a bilingual evaluation report."}}]}
  ],
  "execution":{"mode":"deterministic","timeoutSeconds":600,
    "inputSchema":{"type":"object","properties":{"rfq":{"type":"string","minLength":1,"maxLength":10,"pattern":"^[0-9A-Za-z]+$"},"purchasing_organization":{"type":"string","minLength":1,"maxLength":4,"pattern":"^[0-9A-Za-z_-]+$"},"as_of":{"type":"string","format":"date"}},"required":["rfq","purchasing_organization","as_of"],"additionalProperties":false},
    "outputSchema":{"type":"object","properties":{"rfq":{"type":"string"},"purchasing_organization":{"type":"string"},"business_status":{"type":"string"},"source_complete":{"type":"boolean"},"business_report":{"type":"object"}},"required":["rfq","purchasing_organization","business_status","source_complete","business_report"],"additionalProperties":false},
    "outputMapping":{"rfq":"{{steps.evaluate.output.workflow_output.rfq}}","purchasing_organization":"{{steps.evaluate.output.workflow_output.purchasing_organization}}","business_status":"{{steps.evaluate.output.workflow_output.business_status}}","source_complete":"{{steps.evaluate.output.workflow_output.source_complete}}","business_report":"{{steps.evaluate.output.workflow_output.business_report}}"},
    "steps":[
      {"id":"read_rfq","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_RFQ_PROCESS_SRV","entity_set":"A_RequestForQuotation","http_method":"GET","plan_kind":"direct","select_fields":["RequestForQuotation","PurchasingOrganization","DocumentCurrency"],"filters":[{"field":"RequestForQuotation","operator":"eq","value":"{{input.rfq}}","value_type":"string"},{"field":"PurchasingOrganization","operator":"eq","value":"{{input.purchasing_organization}}","value_type":"string"}],"rationale":"Collect bounded RFQ core evidence; submission and status require fallback."}}},
      {"id":"read_rfq_status","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_RFQ_PROCESS_SRV","entity_set":"A_RequestForQuotation","http_method":"GET","plan_kind":"direct","select_fields":["RequestForQuotation","QuotationSubmissionDate","PurchasingDocumentStatus"],"filters":[{"field":"RequestForQuotation","operator":"eq","value":"{{input.rfq}}","value_type":"string"}],"rationale":"Collect RFQ submission and status fields when exposed."}}},
      {"id":"read_quotation","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_QTN_PROCESS_SRV","entity_set":"A_SupplierQuotationItem","http_method":"GET","plan_kind":"direct","select_fields":["SupplierQuotation","SupplierQuotationItem","RequestForQuotation","Material","OrderQuantityUnit","NetPriceAmount","DocumentCurrency"],"filters":[{"field":"RequestForQuotation","operator":"eq","value":"{{input.rfq}}","value_type":"string"}],"rationale":"Collect bounded quotation core evidence; supplier, price unit, delivery, and status require fallback."}}},
      {"id":"read_quotation_comparison","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_QTN_PROCESS_SRV","entity_set":"A_SupplierQuotationItem","http_method":"GET","plan_kind":"direct","select_fields":["SupplierQuotation","SupplierQuotationItem","Supplier","PriceUnitQty","DeliveryDate","PurchasingDocumentStatus"],"filters":[{"field":"RequestForQuotation","operator":"eq","value":"{{input.rfq}}","value_type":"string"}],"rationale":"Collect supplier, price-unit, delivery, and status fields when exposed."}}},
      {"id":"read_supplier_source","executor":"sap_read","operation":"execute_plan","readOnly":true,"failurePolicy":"record_gap","request":{"plan":{"service_name":"API_INFORECORD_PROCESS_SRV","entity_set":"A_PurchasingInfoRecord","http_method":"GET","plan_kind":"direct","select_fields":["PurchasingInfoRecord","Supplier","Material","PurchasingOrganization","IsDeleted"],"filters":[{"field":"PurchasingOrganization","operator":"eq","value":"{{input.purchasing_organization}}","value_type":"string"}],"rationale":"Collect bounded supplier and existing source evidence."}}},
      {"id":"assess","executor":"rule","operation":"assess_api_evidence","inputMapping":{"checks":{"rfq":{"core":"{{steps.read_rfq.output}}","status":"{{steps.read_rfq_status.output}}"},"quotation":{"core":"{{steps.read_quotation.output}}","comparison":"{{steps.read_quotation_comparison.output}}"},"supplier":"{{steps.read_supplier_source.output}}","source":"{{steps.read_supplier_source.output}}"}}},
      {"id":"adt_rfq","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.rfq}}","equals":true},"inputMapping":{"schema_version":1,"connection_profile":"mm-read-only","source_type":"table","object":"EKKO","fields":["EBELN","BSTYP","BSART","EKORG","LIFNR","WAERS","STATU","KDATB","KDATE"],"filters":[{"field":"EBELN","operator":"eq","value":"{{input.rfq}}"},{"field":"EKORG","operator":"eq","value":"{{input.purchasing_organization}}"}],"order_by":["EBELN"],"max_rows":10000}},
      {"id":"adt_quotation","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.quotation}}","equals":true},"inputMapping":{"schema_version":1,"connection_profile":"mm-read-only","source_type":"table","object":"EKPO","fields":["EBELN","EBELP","MATNR","MENGE","MEINS","NETPR","PEINH","BPRME"],"filters":[{"field":"EBELN","operator":"eq","value":"{{input.rfq}}"}],"order_by":["EBELN","EBELP"],"max_rows":10000}},
      {"id":"adt_supplier","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.supplier}}","equals":true},"inputMapping":{"schema_version":1,"connection_profile":"mm-read-only","source_type":"table","object":"EKKO","fields":["EBELN","EKORG","LIFNR","STATU"],"filters":[{"field":"EBELN","operator":"eq","value":"{{input.rfq}}"},{"field":"EKORG","operator":"eq","value":"{{input.purchasing_organization}}"}],"order_by":["EBELN"],"max_rows":10000}},
      {"id":"adt_source","executor":"skill","operation":"execute","skillId":"sap-adt-table-export","readOnly":true,"failurePolicy":"record_gap","when":{"source":"{{steps.assess.output.needs_adt.source}}","equals":true},"inputMapping":{"schema_version":1,"connection_profile":"mm-read-only","source_type":"table","object":"EINE","fields":["INFNR","EKORG","ESOKZ","WERKS","NETPR","PEINH","BPRME"],"filters":[{"field":"EKORG","operator":"eq","value":"{{input.purchasing_organization}}"}],"order_by":["INFNR","EKORG","ESOKZ","WERKS"],"max_rows":10000}},
      {"id":"evaluate","executor":"rule","operation":"evaluate_business_agent","inputMapping":{"agent_id":"intelligent-sourcing-rfq","run_input":"{{input}}","assessment":"{{steps.assess.output}}","evidence":{"rfq":"{{steps.read_rfq.output}}","rfq_status":"{{steps.read_rfq_status.output}}","quotation":"{{steps.read_quotation.output}}","quotation_comparison":"{{steps.read_quotation_comparison.output}}","source":"{{steps.read_supplier_source.output}}"},"fallbacks":{"rfq":"{{steps.adt_rfq.output}}","quotation":"{{steps.adt_quotation.output}}","supplier":"{{steps.adt_supplier.output}}","source":"{{steps.adt_source.output}}"},"known_gaps":[]}}
    ]},
  "validation":{"verdict":"BLOCKED","testedAt":"2026-08-17T17:10:00+08:00","evidenceScope":"bounded","providers":["embedded-sap-odata","sap-adt-table-export"],"summary":{"zh":"RFQ/报价核心 GET 范围完整但无测试数据；比较字段补证因 ADT profile 缺失而阻塞。","en":"The RFQ/quotation core GET scope was complete but empty; comparison evidence is blocked by the missing ADT profile."},"reportPath":"docs/live-sap-test-report.md"}
