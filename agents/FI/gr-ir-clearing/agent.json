{
  "schemaVersion": 2,
  "slug": "gr-ir-clearing",
  "module": "FI",
  "title": {
    "zh": "GR/IR 清账助手",
    "en": "GR/IR Clearing Assistant"
  },
  "summary": {
    "zh": "关联采购订单历史与 GR/IR 未清项，解释差异原因、账龄和责任方，并给出受控清理建议。",
    "en": "Links PO history to open GR/IR balances, explains causes, aging and ownership, and proposes controlled cleanup actions."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.2.0",
  "owner": "MM-IV / FI-GL",
  "tags": [
    "GR/IR",
    "Month End",
    "Reconciliation",
    "Exception Analysis"
  ],
  "sapModules": [
    "MM-IM",
    "MM-IV",
    "FI-GL",
    "FI-AP"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "公司代码",
      "GR/IR 总账科目",
      "开始日期",
      "截止日期"
    ],
    "en": [
      "Company code",
      "GR/IR G/L account",
      "Start date",
      "End date"
    ]
  },
  "outputs": {
    "zh": [
      "公司代码",
      "GR/IR 总账科目",
      "开始日期",
      "截止日期",
      "业务状态",
      "查询源完整性",
      "业务证据完整性",
      "分析基准日期",
      "已检查项目数",
      "已匹配项目数",
      "待处理项目数",
      "无法确认项目数",
      "待处理记录",
      "结构化业务报告"
    ],
    "en": [
      "Company code",
      "GR/IR G/L account",
      "Start date",
      "End date",
      "Business status",
      "Query-source completeness",
      "Business-evidence completeness",
      "Analysis date",
      "Items examined",
      "Items matched",
      "Items requiring follow-up",
      "Inconclusive items",
      "Follow-up records",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "分析与建议保持只读",
      "MR11 仅作为人工复核建议",
      "缺少范围或凭证证据时保留数据缺口"
    ],
    "en": [
      "Analysis remains read-only",
      "MR11 is only a human-review recommendation",
      "Missing scope or evidence remains a data gap"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_grir_evidence",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_grir_evidence`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_grir_evidence` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube",
          "GET API_PURCHASEORDER_PROCESS_SRV@2.0/A_PurchaseOrderItem",
          "GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentItem",
          "GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentHeader",
          "GET API_SUPPLIERINVOICE_PROCESS_SRV@2.0/A_SuplrInvcItemPurOrdRef",
          "GET API_SUPPLIERINVOICE_PROCESS_SRV@2.0/A_SupplierInvoice"
        ],
        "en": [
          "GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube",
          "GET API_PURCHASEORDER_PROCESS_SRV@2.0/A_PurchaseOrderItem",
          "GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentItem",
          "GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentHeader",
          "GET API_SUPPLIERINVOICE_PROCESS_SRV@2.0/A_SuplrInvcItemPurOrdRef",
          "GET API_SUPPLIERINVOICE_PROCESS_SRV@2.0/A_SupplierInvoice"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_grir_evidence` / `execute_plan`",
            "en": "Execute `collect_grir_evidence` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_grir_evidence"
      ]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate_business_result`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate_business_result` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 900,
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          },
          "description": {
            "zh": "请输入公司代码。",
            "en": "Enter the company code."
          },
          "placeholder": {
            "zh": "例如：1010",
            "en": "Example: 1010"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "gl_account": {
          "type": "string",
          "title": {
            "zh": "GR/IR 总账科目",
            "en": "GR/IR G/L account"
          },
          "description": {
            "zh": "请输入GR/IR 总账科目。",
            "en": "Enter the gr/ir g/l account."
          },
          "placeholder": {
            "zh": "例如：0021100000",
            "en": "Example: 0021100000"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]+$"
        },
        "date_from": {
          "type": "string",
          "title": {
            "zh": "开始日期",
            "en": "Start date"
          },
          "description": {
            "zh": "请输入开始日期。",
            "en": "Enter the start date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "date_to": {
          "type": "string",
          "title": {
            "zh": "截止日期",
            "en": "End date"
          },
          "description": {
            "zh": "请输入截止日期。",
            "en": "Enter the end date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "company_code",
        "gl_account",
        "date_from",
        "date_to"
      ],
      "additionalProperties": false,
      "dateRangePairs": [
        {
          "from": "date_from",
          "to": "date_to",
          "maxDays": 366
        }
      ]
    },
    "steps": [
      {
        "id": "collect_grir_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "gl_items",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "GLAccount",
                  "PurchasingDocument",
                  "PurchasingDocumentItem",
                  "PostingDate",
                  "AmountInCompanyCodeCurrency",
                  "CompanyCodeCurrency",
                  "DebitCreditCode"
                ],
                "rationale": "Load scoped GR/IR G/L line items from the operational accounting cube with executable live stable keys.",
                "filters": [
                  {
                    "field": "CompanyCode",
                    "operator": "eq",
                    "value": "{{input.company_code}}",
                    "value_type": "string"
                  },
                  {
                    "field": "GLAccount",
                    "operator": "eq",
                    "value": "{{input.gl_account}}",
                    "value_type": "string"
                  }
                ],
                "order_by": [
                  "CompanyCode",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem"
                ],
                "partition": {
                  "field": "PostingDate",
                  "strategy": "adaptive_date",
                  "from": "{{input.date_from}}",
                  "to": "{{input.date_to}}",
                  "maxPartitions": 366,
                  "maxTotalResults": 50000
                }
              },
              {
                "step_id": "grir_gl_history",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "GLAccount",
                  "PurchasingDocument",
                  "PurchasingDocumentItem",
                  "PostingDate",
                  "AmountInCompanyCodeCurrency",
                  "CompanyCodeCurrency",
                  "DebitCreditCode"
                ],
                "rationale": "Expand complete GR/IR history through the analysis date for candidate purchase-order items.",
                "max_concurrent_chunks": 8,
                "filters": [
                  {
                    "field": "CompanyCode",
                    "operator": "eq",
                    "value": "{{input.company_code}}",
                    "value_type": "string"
                  },
                  {
                    "field": "GLAccount",
                    "operator": "eq",
                    "value": "{{input.gl_account}}",
                    "value_type": "string"
                  }
                ],
                "filter_from_previous": [
                  {
                    "field": "PurchasingDocument",
                    "source_step_id": "gl_items",
                    "source_field": "PurchasingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "PurchasingDocumentItem",
                    "source_step_id": "gl_items",
                    "source_field": "PurchasingDocumentItem",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ],
                "order_by": [
                  "CompanyCode",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem"
                ],
                "partition": {
                  "field": "PostingDate",
                  "strategy": "adaptive_date",
                  "from": "1900-01-01",
                  "to": "{{input.date_to}}",
                  "maxPartitions": 366,
                  "maxTotalResults": 50000
                }
              },
              {
                "step_id": "purchase_order_items",
                "service_name": "API_PURCHASEORDER_PROCESS_SRV",
                "odata_version": "2.0",
                "entity_set": "A_PurchaseOrderItem",
                "http_method": "GET",
                "select_fields": [
                  "PurchaseOrder",
                  "PurchaseOrderItem",
                  "Material",
                  "Plant",
                  "OrderQuantity",
                  "PurchaseOrderQuantityUnit",
                  "OrderPriceUnit",
                  "DocumentCurrency"
                ],
                "rationale": "Load purchase-order items referenced by GR/IR lines.",
                "max_concurrent_chunks": 8,
                "filter_from_previous": [
                  {
                    "field": "PurchaseOrder",
                    "source_step_id": "gl_items",
                    "source_field": "PurchasingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "PurchaseOrderItem",
                    "source_step_id": "gl_items",
                    "source_field": "PurchasingDocumentItem",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "material_documents",
                "service_name": "API_MATERIAL_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_MaterialDocumentItem",
                "http_method": "GET",
                "select_fields": [
                  "MaterialDocumentYear",
                  "MaterialDocument",
                  "MaterialDocumentItem",
                  "PurchaseOrder",
                  "PurchaseOrderItem",
                  "Material",
                  "Plant",
                  "GoodsMovementType",
                  "QuantityInEntryUnit",
                  "EntryUnit",
                  "MaterialBaseUnit",
                  "DebitCreditCode",
                  "ReversedMaterialDocument",
                  "ReversedMaterialDocumentYear",
                  "ReversedMaterialDocumentItem"
                ],
                "rationale": "Load receipt and reversal evidence.",
                "max_concurrent_chunks": 8,
                "filter_from_previous": [
                  {
                    "field": "PurchaseOrder",
                    "source_step_id": "gl_items",
                    "source_field": "PurchasingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "PurchaseOrderItem",
                    "source_step_id": "gl_items",
                    "source_field": "PurchasingDocumentItem",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "material_document_headers",
                "service_name": "API_MATERIAL_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_MaterialDocumentHeader",
                "http_method": "GET",
                "select_fields": [
                  "MaterialDocumentYear",
                  "MaterialDocument",
                  "PostingDate"
                ],
                "rationale": "Resolve authoritative posting dates for receipt, return, and reversal documents.",
                "max_concurrent_chunks": 8,
                "filter_from_previous": [
                  {
                    "field": "MaterialDocumentYear",
                    "source_step_id": "material_documents",
                    "source_field": "MaterialDocumentYear",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "MaterialDocument",
                    "source_step_id": "material_documents",
                    "source_field": "MaterialDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "supplier_invoice_items",
                "service_name": "API_SUPPLIERINVOICE_PROCESS_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SuplrInvcItemPurOrdRef",
                "http_method": "GET",
                "select_fields": [
                  "SupplierInvoice",
                  "FiscalYear",
                  "SupplierInvoiceItem",
                  "PurchaseOrder",
                  "PurchaseOrderItem",
                  "QuantityInPurchaseOrderUnit",
                  "PurchaseOrderQuantityUnit",
                  "SupplierInvoiceItemAmount",
                  "DocumentCurrency"
                ],
                "rationale": "Load supplier invoice references.",
                "max_concurrent_chunks": 8,
                "filter_from_previous": [
                  {
                    "field": "PurchaseOrder",
                    "source_step_id": "gl_items",
                    "source_field": "PurchasingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "PurchaseOrderItem",
                    "source_step_id": "gl_items",
                    "source_field": "PurchasingDocumentItem",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "supplier_invoice_headers",
                "service_name": "API_SUPPLIERINVOICE_PROCESS_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SupplierInvoice",
                "http_method": "GET",
                "select_fields": [
                  "SupplierInvoice",
                  "FiscalYear",
                  "CompanyCode",
                  "PostingDate",
                  "SupplierInvoiceStatus",
                  "SupplierInvoiceIsCreditMemo",
                  "DocumentCurrency"
                ],
                "rationale": "Resolve invoice posting dates and credit-memo direction for signed quantity netting.",
                "max_concurrent_chunks": 8,
                "filter_from_previous": [
                  {
                    "field": "SupplierInvoice",
                    "source_step_id": "supplier_invoice_items",
                    "source_field": "SupplierInvoice",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "FiscalYear",
                    "source_step_id": "supplier_invoice_items",
                    "source_field": "FiscalYear",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              }
            ],
            "rationale": "Collect GR/IR evidence by G/L scope."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "gr-ir-clearing",
          "run_input": "{{input}}",
          "evidence": {
            "collect_grir_evidence": "{{steps.collect_grir_evidence.output}}"
          },
          "known_gaps": []
        }
      }
    ],
    "outputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          },
          "description": {
            "zh": "请输入公司代码。",
            "en": "Enter the company code."
          },
          "placeholder": {
            "zh": "例如：1010",
            "en": "Example: 1010"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "gl_account": {
          "type": "string",
          "title": {
            "zh": "GR/IR 总账科目",
            "en": "GR/IR G/L account"
          },
          "description": {
            "zh": "请输入GR/IR 总账科目。",
            "en": "Enter the gr/ir g/l account."
          },
          "placeholder": {
            "zh": "例如：0021100000",
            "en": "Example: 0021100000"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]+$"
        },
        "date_from": {
          "type": "string",
          "title": {
            "zh": "开始日期",
            "en": "Start date"
          },
          "description": {
            "zh": "请输入开始日期。",
            "en": "Enter the start date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "date_to": {
          "type": "string",
          "title": {
            "zh": "截止日期",
            "en": "End date"
          },
          "description": {
            "zh": "请输入截止日期。",
            "en": "Enter the end date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "evidence_complete": {
          "type": "boolean",
          "title": {
            "zh": "业务证据完整性",
            "en": "Business-evidence completeness"
          }
        },
        "analysis_date": {
          "type": "string",
          "format": "date",
          "title": {
            "zh": "分析基准日期",
            "en": "Analysis date"
          }
        },
        "examined_item_count": {
          "type": "integer",
          "minimum": 0,
          "title": {
            "zh": "已检查项目数",
            "en": "Items examined"
          }
        },
        "matched_item_count": {
          "type": "integer",
          "minimum": 0,
          "title": {
            "zh": "已匹配项目数",
            "en": "Items matched"
          }
        },
        "follow_up_item_count": {
          "type": "integer",
          "minimum": 0,
          "title": {
            "zh": "待处理项目数",
            "en": "Items requiring follow-up"
          }
        },
        "unknown_item_count": {
          "type": "integer",
          "minimum": 0,
          "title": {
            "zh": "无法确认项目数",
            "en": "Inconclusive items"
          }
        },
        "action_required_records": {
          "type": "array",
          "title": {
            "zh": "待处理记录",
            "en": "Follow-up records"
          },
          "items": {
            "type": "object"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "company_code",
        "gl_account",
        "date_from",
        "date_to",
        "business_status",
        "source_complete",
        "evidence_complete",
        "analysis_date",
        "examined_item_count",
        "matched_item_count",
        "follow_up_item_count",
        "unknown_item_count",
        "action_required_records",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "company_code": "{{steps.evaluate_business_result.output.workflow_output.company_code}}",
      "gl_account": "{{steps.evaluate_business_result.output.workflow_output.gl_account}}",
      "date_from": "{{steps.evaluate_business_result.output.workflow_output.date_from}}",
      "date_to": "{{steps.evaluate_business_result.output.workflow_output.date_to}}",
      "business_status": "{{steps.evaluate_business_result.output.workflow_output.business_status}}",
      "source_complete": "{{steps.evaluate_business_result.output.workflow_output.source_complete}}",
      "evidence_complete": "{{steps.evaluate_business_result.output.workflow_output.evidence_complete}}",
      "analysis_date": "{{steps.evaluate_business_result.output.workflow_output.analysis_date}}",
      "examined_item_count": "{{steps.evaluate_business_result.output.workflow_output.examined_item_count}}",
      "matched_item_count": "{{steps.evaluate_business_result.output.workflow_output.matched_item_count}}",
      "follow_up_item_count": "{{steps.evaluate_business_result.output.workflow_output.follow_up_item_count}}",
