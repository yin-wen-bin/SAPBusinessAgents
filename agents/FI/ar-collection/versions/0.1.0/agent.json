  "guardrails": {
    "zh": [
      "不自动清账或记账",
      "不自动发送催款信息",
      "争议或冻结客户进入人工复核"
    ],
    "en": [
      "Never clears or posts automatically",
      "Never sends collection messages automatically",
      "Disputed or blocked accounts route to review"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_ar_evidence",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_ar_evidence`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_ar_evidence` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube",
          "GET API_BUSINESS_PARTNER@2.0/A_CustomerDunning"
        ],
        "en": [
          "GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube",
          "GET API_BUSINESS_PARTNER@2.0/A_CustomerDunning"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_ar_evidence` / `execute_plan`",
            "en": "Execute `collect_ar_evidence` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_ar_evidence"
      ]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate_business_result`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate_business_result` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          },
          "description": {
            "zh": "请输入公司代码。",
            "en": "Enter the company code."
          },
          "placeholder": {
            "zh": "例如：1010",
            "en": "Example: 1010"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "customer": {
          "type": "string",
          "title": {
            "zh": "客户编号",
            "en": "Customer"
          },
          "description": {
            "zh": "请输入客户编号。",
            "en": "Enter the customer."
          },
          "placeholder": {
            "zh": "例如：17100001",
            "en": "Example: 17100001"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "as_of": {
          "type": "string",
          "title": {
            "zh": "查询基准日",
            "en": "As-of date"
          },
          "description": {
            "zh": "请输入查询基准日。",
            "en": "Enter the as-of date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "company_code",
        "customer",
        "as_of"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "id": "collect_ar_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "customer_items",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "FiscalYear",
                  "FiscalPeriod",
                  "Ledger",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "Supplier",
                  "Customer",
                  "FinancialAccountType",
                  "GLAccount",
                  "OperationalGLAccount",
                  "PurchasingDocument",
                  "PurchasingDocumentItem",
                  "PostingDate",
                  "NetDueDate",
                  "ClearingDate",
                  "ClearingIsReversed",
                  "IsOpenItemManaged",
                  "DebitCreditCode",
                  "IsCleared",
                  "ClearingAccountingDocument",
                  "ClearingDocFiscalYear",
                  "PaymentMethod",
                  "PaymentBlockingReason",
                  "HouseBank",
                  "HouseBankAccount",
                  "AccountingDocumentType",
                  "AmountInTransactionCurrency",
                  "TransactionCurrency",
                  "AmountInCompanyCodeCurrency",
                  "CompanyCodeCurrency",
                  "OrderID",
                  "DunningArea",
                  "DunningKey",
                  "DunningLevel",
                  "DunningBlockingReason",
                  "LastDunningDate",
                  "PaymentTerms"
                ],
                "rationale": "Load customer line-item and item-level dunning evidence through the cutoff.",
                "filters": [
                  {
                    "field": "CompanyCode",
                    "operator": "eq",
                    "value": "{{input.company_code}}",
                    "value_type": "string"
                  },
                  {
                    "field": "Customer",
                    "operator": "eq",
                    "value": "{{input.customer}}",
                    "value_type": "string"
                  },
                  {
                    "field": "FinancialAccountType",
                    "operator": "eq",
                    "value": "D",
                    "value_type": "string"
                  },
                  {
                    "field": "PostingDate",
                    "operator": "le",
                    "value": "{{input.as_of}}",
                    "value_type": "date_end"
                  }
                ],
                "order_by": [
                  "CompanyCode",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem"
                ]
              },
              {
                "step_id": "customer_dunning",
                "service_name": "API_BUSINESS_PARTNER",
                "odata_version": "2.0",
                "entity_set": "A_CustomerDunning",
                "http_method": "GET",
                "select_fields": [
                  "Customer",
                  "CompanyCode",
                  "DunningArea",
                  "DunningProcedure",
                  "DunningLevel",
                  "DunningBlock",
                  "DunningRecipient",
                  "LastDunnedOn",
                  "LegDunningProcedureOn",
                  "DunningClerk"
                ],
                "rationale": "Load the current customer dunning master as a separate, explicitly non-historical source.",
                "filters": [
                  {
                    "field": "CompanyCode",
                    "operator": "eq",
                    "value": "{{input.company_code}}",
                    "value_type": "string"
                  },
                  {
                    "field": "Customer",
                    "operator": "eq",
                    "value": "{{input.customer}}",
                    "value_type": "string"
                  }
                ],
                "order_by": [
                  "Customer",
                  "CompanyCode",
                  "DunningArea"
                ]
              }
            ],
            "rationale": "Collect customer receivable and dunning evidence."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "ar-collection",
          "run_input": "{{input}}",
          "evidence": {
            "collect_ar_evidence": "{{steps.collect_ar_evidence.output}}"
          },
          "known_gaps": []
        }
      }
    ],
    "outputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
