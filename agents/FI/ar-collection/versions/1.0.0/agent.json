{
  "schemaVersion": 2,
  "slug": "ar-collection",
  "module": "FI",
  "title": {
    "zh": "应收账款催收助手",
    "en": "AR Collection Assistant"
  },
  "summary": {
    "zh": "批量重建客户应收账龄、催收冻结及催收状态，生成异常优先的催收工作清单；不处理银行来款。",
    "en": "Reconstructs customer aging, dunning blocks, and dunning status in batches and produces an exception-first collection worklist; bank receipts are out of scope."
  },
  "status": "Three-stage live acceptance not_tested",
  "version": "1.0.0",
  "owner": "FI-AR",
  "tags": [
    "Accounts Receivable",
    "Collections",
    "Aging",
    "Dunning"
  ],
  "sapModules": [
    "FI-AR"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "公司代码",
      "客户编号",
      "查询基准日",
      "催收区域（可选）"
    ],
    "en": [
      "Company code",
      "Customers",
      "As-of date",
      "Dunning area (optional)"
    ]
  },
  "outputs": {
    "zh": [
      "请求客户数",
      "结果客户数",
      "正常客户数",
      "需处理客户数",
      "无法确认客户数",
      "逐客户结果",
      "催收工作清单",
      "查询源完整性",
      "业务证据完整性",
      "业务状态",
      "结构化业务报告"
    ],
    "en": [
      "Requested customers",
      "Result customers",
      "Normal customers",
      "Customers requiring attention",
      "Inconclusive customers",
      "Customer results",
      "Collection worklist",
      "Query-source completeness",
      "Evidence completeness",
      "Business status",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "不自动清账、过账或发送催款通知",
      "不同台账或币种不合计",
      "当前催收主数据不冒充历史催收快照"
    ],
    "en": [
      "Never clears, posts, or sends collection notices",
      "Never aggregates different ledgers or currencies",
      "Never treats current dunning master data as a historical snapshot"
    ]
  },
  "workflow": [
    {
      "id": "read-ledger",
      "title": {
        "zh": "解析FI台账",
        "en": "Resolve FI ledger"
      },
      "description": {
        "zh": "执行解析FI台账，仅使用已批准的只读数据源或本地确定性规则。",
        "en": "Execute Resolve FI ledger using only approved read-only sources or local deterministic rules."
      },
      "operations": {
        "zh": [
          "GET API_LEDGER_SRV/A_Ledger",
          "rule.prepare_fi_ledger_scope"
        ],
        "en": [
          "GET API_LEDGER_SRV/A_Ledger",
          "rule.prepare_fi_ledger_scope"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "读取唯一主导台账并交由本地规则校验",
            "en": "Read the unique leading ledger for local deterministic validation"
          }
        }
      ],
      "executionStepIds": [
        "read_leading_ledger",
        "resolve_fi_ledger"
      ]
    },
    {
      "id": "read-ar",
      "title": {
        "zh": "读取应收和催收证据",
        "en": "Read AR and dunning evidence"
      },
      "description": {
        "zh": "执行读取应收和催收证据，仅使用已批准的只读数据源或本地确定性规则。",
        "en": "Execute Read AR and dunning evidence using only approved read-only sources or local deterministic rules."
      },
      "operations": {
        "zh": [
          "GET API_OPLACCTGDOCITEMCUBE_SRV/A_OperationalAcctgDocItemCube",
          "GET API_BUSINESS_PARTNER/A_CustomerDunning"
        ],
        "en": [
          "GET API_OPLACCTGDOCITEMCUBE_SRV/A_OperationalAcctgDocItemCube",
          "GET API_BUSINESS_PARTNER/A_CustomerDunning"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "批量读取应收行项目和当前催收主数据",
            "en": "Read batched AR line items and current dunning master data"
          }
        }
      ],
      "executionStepIds": [
        "collect_ar_evidence"
      ]
    },
    {
      "id": "evaluate",
      "title": {
        "zh": "生成催收工作清单",
        "en": "Build collection worklist"
      },
      "description": {
        "zh": "执行生成催收工作清单，仅使用已批准的只读数据源或本地确定性规则。",
        "en": "Execute Build collection worklist using only approved read-only sources or local deterministic rules."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "重建账龄并生成异常优先的催收工作清单",
            "en": "Reconstruct aging and produce an exception-first collection worklist"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "x-sapba-sap-identifier": true
        },
        "customers": {
          "type": "array",
          "title": {
            "zh": "客户编号",
            "en": "Customers"
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10,
            "pattern": "^[0-9A-Za-z_-]+$",
            "x-sapba-input-normalization": "uppercase"
          }
        },
        "as_of": {
          "type": "string",
          "title": {
            "zh": "查询基准日",
            "en": "As-of date"
          },
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "x-sapba-server-default": "business_date",
          "x-sapba-not-after-business-date": true
        },
        "business_date": {
          "type": "string",
          "title": {
            "zh": "业务日期（系统）",
            "en": "Business date (system)"
          },
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "x-sapba-server-default": "business_date",
          "x-sapba-internal": true
        },
        "dunning_area": {
          "type": "string",
          "title": {
            "zh": "催收区域（可选）",
            "en": "Dunning area (optional)"
          },
          "minLength": 1,
          "maxLength": 4,
          "x-sapba-sap-identifier": true
        }
      },
      "required": [
        "company_code",
        "customers",
        "business_date"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "id": "read_leading_ledger",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_LEDGER_SRV",
            "odata_version": "2.0",
            "entity_set": "A_Ledger",
            "http_method": "GET",
            "plan_kind": "direct",
            "step_id": "leading_ledger",
            "select_fields": [
              "Ledger",
              "IsLeadingLedger",
              "LedgerApplication",
              "LedgerSubApplication"
            ],
            "filters": [
              {
                "field": "IsLeadingLedger",
                "operator": "eq",
                "value": true,
                "value_type": "boolean"
              }
            ],
            "order_by": [
              "Ledger"
            ],
            "rationale": "Resolve the unique leading ledger from complete live metadata."
          }
        }
      },
      {
        "id": "resolve_fi_ledger",
        "executor": "rule",
        "operation": "prepare_fi_ledger_scope",
        "inputMapping": {
          "ledger_evidence": "{{steps.read_leading_ledger.output}}"
        }
      },
      {
        "id": "collect_ar_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.resolve_fi_ledger.output.has_unique_ledger}}",
          "equals": true
        },
        "onSkip": {
          "output": {
            "ok": true,
            "status": "skipped",
            "reason": "fi_leading_ledger_unavailable",
            "evidence_status": "unavailable",
            "source_complete": false,
            "evidence_complete": false,
            "step_results": {}
          }
        },
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "customer_items",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "Ledger",
                  "FiscalYear",
                  "FiscalPeriod",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "Customer",
                  "FinancialAccountType",
                  "GLAccount",
                  "PostingDate",
                  "NetDueDate",
                  "DueCalculationBaseDate",
                  "ClearingDate",
                  "ClearingIsReversed",
                  "IsReversal",
                  "IsReversed",
                  "ReverseDocument",
                  "ReverseDocumentFiscalYear",
                  "IsOpenItemManaged",
                  "DebitCreditCode",
                  "IsCleared",
                  "ClearingAccountingDocument",
                  "ClearingDocFiscalYear",
                  "AccountingDocumentType",
                  "AmountInTransactionCurrency",
                  "TransactionCurrency",
                  "AmountInCompanyCodeCurrency",
                  "CompanyCodeCurrency",
                  "DunningArea",
                  "DunningKey",
                  "DunningLevel",
                  "DunningBlockingReason",
                  "LastDunningDate",
                  "PaymentTerms",
                  "SpecialGLCode",
                  "AssignmentReference"
                ],
                "rationale": "Read customer-managed AR items through the cutoff in bounded customer chunks.",
                "filters": [
                  {
                    "field": "CompanyCode",
                    "operator": "eq",
                    "value": "{{input.company_code}}",
                    "value_type": "string"
                  },
                  {
                    "field": "Ledger",
                    "operator": "eq",
                    "value": "{{steps.resolve_fi_ledger.output.ledger}}",
                    "value_type": "string"
                  },
                  {
                    "field": "Customer",
                    "operator": "in",
                    "value": "{{input.customers}}",
                    "value_type": "string",
                    "chunk_size": 10
                  },
                  {
                    "field": "FinancialAccountType",
                    "operator": "eq",
                    "value": "D",
                    "value_type": "string"
                  },
                  {
                    "field": "PostingDate",
                    "operator": "le",
                    "value": "{{input.as_of}}",
                    "value_type": "date_end"
                  }
                ],
                "order_by": [
                  "CompanyCode",
                  "Ledger",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem"
                ],
                "max_concurrent_chunks": 2,
                "retry_failed_chunks_individually": true,
                "chunk_error_policy": "record_gap"
              },
              {
                "step_id": "clearing_document_evidence",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "Ledger",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "PostingDate",
                  "IsReversal",
                  "IsReversed",
                  "ReverseDocument",
                  "ReverseDocumentFiscalYear"
                ],
                "filter_from_previous": [
                  {
                    "field": "CompanyCode",
                    "source_step_id": "customer_items",
                    "source_field": "CompanyCode",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "Ledger",
                    "source_step_id": "customer_items",
                    "source_field": "Ledger",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "FiscalYear",
                    "source_step_id": "customer_items",
                    "source_field": "ClearingDocFiscalYear",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "AccountingDocument",
                    "source_step_id": "customer_items",
                    "source_field": "ClearingAccountingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ],
                "order_by": [
                  "CompanyCode",
                  "Ledger",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem"
                ],
                "rationale": "Expand each exact clearing-document tuple so a reversed clearing can be dated rather than inferred from its current flag."
              },
              {
                "step_id": "clearing_reversal_documents",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "Ledger",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "PostingDate",
                  "IsReversal",
                  "IsReversed",
                  "ReverseDocument",
                  "ReverseDocumentFiscalYear"
                ],
                "filter_from_previous": [
                  {
                    "field": "CompanyCode",
                    "source_step_id": "clearing_document_evidence",
                    "source_field": "CompanyCode",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "Ledger",
                    "source_step_id": "clearing_document_evidence",
                    "source_field": "Ledger",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "FiscalYear",
                    "source_step_id": "clearing_document_evidence",
                    "source_field": "ReverseDocumentFiscalYear",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "AccountingDocument",
                    "source_step_id": "clearing_document_evidence",
                    "source_field": "ReverseDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ],
                "order_by": [
                  "CompanyCode",
                  "Ledger",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem"
                ],
                "rationale": "Read the exact reversal document to establish when a previously cleared AR item reopened."
              },
              {
                "step_id": "customer_dunning",
                "service_name": "API_BUSINESS_PARTNER",
                "odata_version": "2.0",
                "entity_set": "A_CustomerDunning",
                "http_method": "GET",
                "select_fields": [
                  "Customer",
                  "CompanyCode",
                  "DunningArea",
                  "DunningProcedure",
                  "DunningLevel",
                  "DunningBlock",
                  "DunningRecipient",
                  "LastDunnedOn",
                  "LegDunningProcedureOn",
                  "DunningClerk"
                ],
                "rationale": "Read current customer dunning master separately from historical AR evidence.",
                "filters": [
                  {
                    "field": "CompanyCode",
                    "operator": "eq",
                    "value": "{{input.company_code}}",
                    "value_type": "string"
                  },
                  {
                    "field": "Customer",
                    "operator": "in",
                    "value": "{{input.customers}}",
                    "value_type": "string",
                    "chunk_size": 10
                  }
                ],
                "order_by": [
                  "Customer",
                  "CompanyCode",
                  "DunningArea"
                ],
                "max_concurrent_chunks": 2,
                "retry_failed_chunks_individually": true,
                "chunk_error_policy": "record_gap"
              }
            ],
            "rationale": "Collect customer AR and current dunning evidence without bank-receipt matching."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "ar-collection",
          "run_input": "{{input}}",
          "evidence": {
            "leading_ledger": "{{steps.read_leading_ledger.output}}",
            "ledger_scope": "{{steps.resolve_fi_ledger.output}}",
            "collect_ar_evidence": "{{steps.collect_ar_evidence.output}}"
          },
          "known_gaps": []
        }
      }
    ],
    "outputSchema": {
      "type": "object",
      "properties": {
        "requested_customer_count": {
          "type": "integer",
          "title": {
            "zh": "请求客户数",
            "en": "Requested customers"
          }
        },
        "result_customer_count": {
          "type": "integer",
          "title": {
            "zh": "结果客户数",
            "en": "Result customers"
          }
        },
        "normal_customer_count": {
          "type": "integer",
          "title": {
            "zh": "正常客户数",
            "en": "Normal customers"
          }
        },
        "attention_customer_count": {
          "type": "integer",
          "title": {
            "zh": "需处理客户数",
            "en": "Customers requiring attention"
          }
        },
        "inconclusive_customer_count": {
          "type": "integer",
          "title": {
            "zh": "无法确认客户数",
            "en": "Inconclusive customers"
          }
        },
        "customer_results": {
          "type": "array",
          "title": {
            "zh": "逐客户结果",
            "en": "Customer results"
          },
          "items": {
            "type": "object"
          }
        },
        "worklist_artifact": {
          "type": "object",
          "title": {
            "zh": "催收工作清单",
            "en": "Collection worklist"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "evidence_complete": {
          "type": "boolean",
          "title": {
            "zh": "业务证据完整性",
            "en": "Evidence completeness"
          }
        },
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          },
          "enum": [
            "normal",
            "attention",
            "inconclusive"
          ],
          "x-sapba-display": {
            "format": "enum",
            "labels": {
              "normal": {
                "zh": "正常",
                "en": "Normal"
              },
              "attention": {
                "zh": "需处理",
                "en": "Attention"
              },
              "inconclusive": {
                "zh": "无法确认",
                "en": "Inconclusive"
              }
            }
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "requested_customer_count",
        "result_customer_count",
        "normal_customer_count",
        "attention_customer_count",
        "inconclusive_customer_count",
        "customer_results",
        "worklist_artifact",
        "source_complete",
        "evidence_complete",
        "business_status",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "requested_customer_count": "{{steps.evaluate_business_result.output.workflow_output.requested_customer_count}}",
      "result_customer_count": "{{steps.evaluate_business_result.output.workflow_output.result_customer_count}}",
      "normal_customer_count": "{{steps.evaluate_business_result.output.workflow_output.normal_customer_count}}",
      "attention_customer_count": "{{steps.evaluate_business_result.output.workflow_output.attention_customer_count}}",
      "inconclusive_customer_count": "{{steps.evaluate_business_result.output.workflow_output.inconclusive_customer_count}}",
      "customer_results": "{{steps.evaluate_business_result.output.workflow_output.customer_results}}",
      "worklist_artifact": "{{steps.evaluate_business_result.output.workflow_output.worklist_artifact}}",
      "source_complete": "{{steps.evaluate_business_result.output.workflow_output.source_complete}}",
      "evidence_complete": "{{steps.evaluate_business_result.output.workflow_output.evidence_complete}}",
      "business_status": "{{steps.evaluate_business_result.output.workflow_output.business_status}}",
      "business_report": "{{steps.evaluate_business_result.output.workflow_output.business_report}}"
    },
    "acceptance": {
      "schemaVersion": "2.0",
      "comparisonMode": "business_semantic",
      "businessKeys": [
        "company_code",
        "ledger",
        "fiscal_year",
        "accounting_document",
        "accounting_document_item"
      ],
      "facts": [
        "customer",
        "posting_date",
        "due_date",
        "aging_bucket",
        "clearing_date",
        "dunning_as_of_status",
        "business_status"
      ],
      "metrics": [
        "requested_customer_count",
        "result_customer_count",
        "normal_customer_count",
        "attention_customer_count",
        "inconclusive_customer_count"
      ],
      "requiredLimitations": [
        "historical_dunning_evidence"
      ],
      "decimalFields": ["amount"],
      "decimalMetricIds": [],
      "currencyFields": ["currency"],
      "unitFields": [],
      "dateFields": ["posting_date", "due_date", "clearing_date", "last_dunning_date"],
      "inputDefaults": {},
      "constantDefaults": {},
      "fieldAliases": {},
      "fieldExtractors": {},
      "currencyFromDecimal": {"amount": "currency"},
      "valueMappings": {},
      "limitationKeywords": {
        "historical_dunning_evidence": [
          "historical dunning evidence",
          "历史催收证据"
        ]
      },
      "summaryRecord": false,
      "zeroFactWhenMetricZero": {},
      "blockingLimitations": ["historical_dunning_evidence"],
      "ignoredNoticeKeywords": [],
      "recordScope": "customer_results.items",
      "metricDefinitions": {},
      "businessStatusDefinition": "Each requested customer is classified independently before conservative batch aggregation.",
      "businessStatusFromAnyPositiveMetric": {}
    }
  },
  "validation": {
    "verdict": "NOT_TESTED",
    "testedAt": "2026-09-04T00:00:00+08:00",
    "evidenceScope": "bounded",
    "providers": [
      "embedded-sap-odata"
    ],
    "summary": {
