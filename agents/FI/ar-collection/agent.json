{
  "schemaVersion": 2,
  "slug": "ar-collection",
  "module": "FI",
  "title": {
    "zh": "应收账款催收助手",
    "en": "AR Collection Assistant"
  },
  "summary": {
    "zh": "批量重建客户应收账龄、催收冻结及催收状态，逐凭证说明处理原因、建议动作和SAPBusinessAgents处理优先级；不处理银行来款。",
    "en": "Reconstructs customer aging, dunning blocks, and dunning status in batches, with document-level reasons, recommended actions, and SAPBusinessAgents processing priority; bank receipts are out of scope."
  },
  "status": "Live acceptance passed",
  "version": "1.2.0",
  "owner": "FI-AR",
  "tags": [
    "Accounts Receivable",
    "Collections",
    "Aging",
    "Dunning"
  ],
  "sapModules": [
    "FI-AR"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "managedRule": {
    "entrypoint": "evaluate",
    "sha256": "sha256:fcbee7caa4265a1631fbcb4a03ad6f51425d9dcf1a33814d26881a9178f979ad"
  },
  "inputs": {
    "zh": [
      "公司代码",
      "客户编号",
      "查询基准日",
      "催收区域（可选）"
    ],
    "en": [
      "Company code",
      "Customers",
      "As-of date",
      "Dunning area (optional)"
    ]
  },
  "outputs": {
    "zh": [
      "请求客户数",
      "结果客户数",
      "正常客户数",
      "需处理客户数",
      "无法确认客户数",
      "需要处理项目数",
      "仅监控项目数",
      "逐客户结果",
      "催收工作清单",
      "查询源完整性",
      "业务证据完整性",
      "业务状态",
      "结构化业务报告"
    ],
    "en": [
      "Requested customers",
      "Result customers",
      "Normal customers",
      "Customers requiring attention",
      "Inconclusive customers",
      "Items requiring action",
      "Monitor-only items",
      "Customer results",
      "Collection worklist",
      "Query-source completeness",
      "Evidence completeness",
      "Business status",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "不自动清账、过账或发送催款通知",
      "不同台账或币种不合计",
      "当前催收主数据不冒充历史催收快照"
    ],
    "en": [
      "Never clears, posts, or sends collection notices",
      "Never aggregates different ledgers or currencies",
      "Never treats current dunning master data as a historical snapshot"
    ]
  },
  "workflow": [
    {
      "id": "read-ledger",
      "title": {
        "zh": "解析FI台账",
        "en": "Resolve FI ledger"
      },
      "description": {
        "zh": "执行解析FI台账，仅使用已批准的只读数据源或本地确定性规则。",
        "en": "Execute Resolve FI ledger using only approved read-only sources or local deterministic rules."
      },
      "operations": {
        "zh": [
          "GET API_LEDGER_SRV/A_Ledger",
          "rule.prepare_fi_ledger_scope"
        ],
        "en": [
          "GET API_LEDGER_SRV/A_Ledger",
          "rule.prepare_fi_ledger_scope"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "读取唯一主导台账并交由本地规则校验",
            "en": "Read the unique leading ledger for local deterministic validation"
          }
        }
      ],
      "executionStepIds": [
        "read_leading_ledger",
        "resolve_fi_ledger"
      ]
    },
    {
      "id": "read-ar",
      "title": {
        "zh": "读取应收和催收证据",
        "en": "Read AR and dunning evidence"
      },
      "description": {
        "zh": "执行读取应收和催收证据，仅使用已批准的只读数据源或本地确定性规则。",
        "en": "Execute Read AR and dunning evidence using only approved read-only sources or local deterministic rules."
      },
      "operations": {
        "zh": [
          "GET API_OPLACCTGDOCITEMCUBE_SRV/A_OperationalAcctgDocItemCube",
          "GET API_BUSINESS_PARTNER/A_CustomerDunning",
          "sap-ar-dunning-history-evidence（仅历史基准日）"
        ],
        "en": [
          "GET API_OPLACCTGDOCITEMCUBE_SRV/A_OperationalAcctgDocItemCube",
          "GET API_BUSINESS_PARTNER/A_CustomerDunning",
          "sap-ar-dunning-history-evidence (historical as-of dates only)"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "批量读取应收行项目和当前催收主数据",
            "en": "Read batched AR line items and current dunning master data"
          }
        }
      ],
      "executionStepIds": [
        "prepare_ar_collection_context",
        "collect_ar_evidence",
        "read_historical_dunning"
      ]
    },
    {
      "id": "evaluate",
      "title": {
        "zh": "生成催收工作清单",
        "en": "Build collection worklist"
      },
      "description": {
        "zh": "执行生成催收工作清单，仅使用已批准的只读数据源或本地确定性规则。",
        "en": "Execute Build collection worklist using only approved read-only sources or local deterministic rules."
      },
      "operations": {
        "zh": [
          "rule.ar_collection_deterministic_v4"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "ar_collection_deterministic_v4",
          "kind": "Managed local deterministic rule",
          "purpose": {
            "zh": "重建账龄并生成逐凭证处理动作和异常优先工作清单",
            "en": "Reconstruct aging and produce document-level actions and an exception-first worklist"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "x-sapba-sap-identifier": true
        },
        "customers": {
          "type": "array",
          "title": {
            "zh": "客户编号",
            "en": "Customers"
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10,
            "pattern": "^[0-9A-Za-z_-]+$",
            "x-sapba-input-normalization": "uppercase"
          }
        },
        "as_of": {
          "type": "string",
          "title": {
            "zh": "查询基准日",
            "en": "As-of date"
          },
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "x-sapba-server-default": "business_date",
          "x-sapba-not-after-business-date": true
        },
        "business_date": {
          "type": "string",
          "title": {
            "zh": "业务日期（系统）",
            "en": "Business date (system)"
          },
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "x-sapba-server-default": "business_date",
          "x-sapba-internal": true
        },
        "dunning_area": {
          "type": "string",
          "title": {
            "zh": "催收区域（可选）",
            "en": "Dunning area (optional)"
          },
          "minLength": 1,
          "maxLength": 4,
          "x-sapba-sap-identifier": true
        }
      },
      "required": [
        "company_code",
        "customers",
        "business_date"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "id": "read_leading_ledger",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_LEDGER_SRV",
            "odata_version": "2.0",
            "entity_set": "A_Ledger",
            "http_method": "GET",
            "plan_kind": "direct",
            "step_id": "leading_ledger",
            "select_fields": [
              "Ledger",
              "IsLeadingLedger",
              "LedgerApplication",
              "LedgerSubApplication"
            ],
            "filters": [
              {
                "field": "IsLeadingLedger",
                "operator": "eq",
                "value": true,
                "value_type": "boolean"
              }
            ],
            "order_by": [
              "Ledger"
            ],
            "rationale": "Resolve the unique leading ledger from complete live metadata."
          }
        }
      },
      {
        "id": "resolve_fi_ledger",
        "executor": "rule",
        "operation": "prepare_fi_ledger_scope",
        "inputMapping": {
          "ledger_evidence": "{{steps.read_leading_ledger.output}}"
        }
      },
      {
        "id": "prepare_ar_collection_context",
        "executor": "rule",
        "operation": "prepare_ar_collection_context",
        "inputMapping": {
          "run_input": "{{input}}"
        }
      },
      {
        "id": "collect_ar_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.resolve_fi_ledger.output.has_unique_ledger}}",
          "equals": true
        },
        "onSkip": {
          "output": {
            "ok": true,
            "status": "skipped",
            "reason": "fi_leading_ledger_unavailable",
            "evidence_status": "unavailable",
            "source_complete": false,
            "evidence_complete": false,
            "step_results": {}
          }
        },
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "customer_items",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "Ledger",
                  "FiscalYear",
                  "FiscalPeriod",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "Customer",
                  "FinancialAccountType",
                  "GLAccount",
                  "PostingDate",
                  "NetDueDate",
                  "DueCalculationBaseDate",
                  "ClearingDate",
                  "ClearingIsReversed",
                  "IsReversal",
                  "IsReversed",
                  "ReverseDocument",
                  "ReverseDocumentFiscalYear",
                  "IsOpenItemManaged",
                  "DebitCreditCode",
                  "IsCleared",
                  "ClearingAccountingDocument",
                  "ClearingDocFiscalYear",
                  "AccountingDocumentType",
                  "AmountInTransactionCurrency",
                  "TransactionCurrency",
                  "AmountInCompanyCodeCurrency",
                  "CompanyCodeCurrency",
                  "DunningArea",
                  "DunningKey",
                  "DunningLevel",
                  "DunningBlockingReason",
                  "LastDunningDate",
                  "PaymentTerms",
                  "SpecialGLCode",
                  "AssignmentReference"
                ],
                "rationale": "Read customer-managed AR items through the cutoff in bounded customer chunks.",
                "filters": [
                  {
                    "field": "CompanyCode",
                    "operator": "eq",
                    "value": "{{input.company_code}}",
                    "value_type": "string"
                  },
                  {
                    "field": "Customer",
                    "operator": "in",
                    "value": "{{input.customers}}",
                    "value_type": "string",
                    "chunk_size": 10
                  },
                  {
                    "field": "FinancialAccountType",
                    "operator": "eq",
                    "value": "D",
                    "value_type": "string"
                  },
                  {
                    "field": "PostingDate",
                    "operator": "le",
                    "value": "{{input.as_of}}",
                    "value_type": "date_end"
                  }
                ],
                "order_by": [
                  "CompanyCode",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem"
                ],
                "max_concurrent_chunks": 2,
                "retry_failed_chunks_individually": true,
                "chunk_error_policy": "record_gap"
              },
              {
                "step_id": "clearing_document_evidence",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "Ledger",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "PostingDate",
                  "IsReversal",
                  "IsReversed",
                  "ReverseDocument",
                  "ReverseDocumentFiscalYear"
                ],
                "filter_from_previous": [
                  {
                    "field": "CompanyCode",
                    "source_step_id": "customer_items",
                    "source_field": "CompanyCode",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "FiscalYear",
                    "source_step_id": "customer_items",
                    "source_field": "ClearingDocFiscalYear",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "AccountingDocument",
                    "source_step_id": "customer_items",
                    "source_field": "ClearingAccountingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ],
                "order_by": [
                  "CompanyCode",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem"
                ],
                "rationale": "Expand each exact clearing-document tuple so a reversed clearing can be dated rather than inferred from its current flag."
              },
              {
                "step_id": "clearing_reversal_documents",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "Ledger",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "PostingDate",
                  "IsReversal",
                  "IsReversed",
                  "ReverseDocument",
                  "ReverseDocumentFiscalYear"
                ],
                "filter_from_previous": [
                  {
                    "field": "CompanyCode",
                    "source_step_id": "clearing_document_evidence",
                    "source_field": "CompanyCode",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "FiscalYear",
                    "source_step_id": "clearing_document_evidence",
                    "source_field": "ReverseDocumentFiscalYear",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "AccountingDocument",
                    "source_step_id": "clearing_document_evidence",
                    "source_field": "ReverseDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ],
                "order_by": [
                  "CompanyCode",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem"
                ],
                "rationale": "Read the exact reversal document to establish when a previously cleared AR item reopened."
              },
              {
                "step_id": "customer_dunning",
                "service_name": "API_BUSINESS_PARTNER",
                "odata_version": "2.0",
                "entity_set": "A_CustomerDunning",
                "http_method": "GET",
                "select_fields": [
                  "Customer",
                  "CompanyCode",
                  "DunningArea",
                  "DunningProcedure",
                  "DunningLevel",
                  "DunningBlock",
                  "DunningRecipient",
                  "LastDunnedOn",
                  "LegDunningProcedureOn",
                  "DunningClerk"
                ],
                "rationale": "Read current customer dunning master separately from historical AR evidence.",
                "filters": [
                  {
                    "field": "CompanyCode",
                    "operator": "eq",
                    "value": "{{input.company_code}}",
                    "value_type": "string"
                  },
                  {
                    "field": "Customer",
                    "operator": "in",
                    "value": "{{input.customers}}",
                    "value_type": "string",
                    "chunk_size": 10
                  }
                ],
                "order_by": [
                  "Customer",
                  "CompanyCode",
                  "DunningArea"
                ],
                "max_concurrent_chunks": 2,
                "retry_failed_chunks_individually": true,
                "chunk_error_policy": "record_gap"
              }
            ],
            "rationale": "Collect customer AR and current dunning evidence without bank-receipt matching."
          }
        }
      },
      {
        "id": "read_historical_dunning",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-ar-dunning-history-evidence",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.prepare_ar_collection_context.output.historical}}",
          "equals": true
        },
        "onSkip": {
          "output": {
            "status": "skipped",
            "evidence_status": "not_requested",
            "source_complete": true,
            "evidence_complete": true,
            "events": [],
            "limitations": [],
            "validation_issues": [],
            "restricted_artifact_ref": null
          }
        },
        "inputMapping": {
          "schema_version": 1,
          "company_code": "{{input.company_code}}",
          "customers": "{{input.customers}}",
          "as_of": "{{input.as_of}}",
          "dunning_area": "{{steps.prepare_ar_collection_context.output.dunning_area}}"
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "managed_agent_rule",
        "inputMapping": {
          "run_input": "{{input}}",
          "evidence": {
            "leading_ledger": "{{steps.read_leading_ledger.output}}",
            "ledger_scope": "{{steps.resolve_fi_ledger.output}}",
            "collection_context": "{{steps.prepare_ar_collection_context.output}}",
            "collect_ar_evidence": "{{steps.collect_ar_evidence.output}}",
            "historical_dunning": "{{steps.read_historical_dunning.output}}"
          },
          "known_gaps": []
        }
      }
    ],
    "outputSchema": {
      "type": "object",
      "properties": {
        "requested_customer_count": {
          "type": "integer",
          "title": {
            "zh": "请求客户数",
            "en": "Requested customers"
          }
        },
        "result_customer_count": {
          "type": "integer",
          "title": {
            "zh": "结果客户数",
            "en": "Result customers"
          }
        },
        "normal_customer_count": {
          "type": "integer",
          "title": {
            "zh": "正常客户数",
            "en": "Normal customers"
          }
        },
        "attention_customer_count": {
          "type": "integer",
          "title": {
            "zh": "需处理客户数",
            "en": "Customers requiring attention"
          }
        },
        "inconclusive_customer_count": {
          "type": "integer",
          "title": {
            "zh": "无法确认客户数",
            "en": "Inconclusive customers"
          }
        },
        "action_required_item_count": {
          "type": "integer",
          "minimum": 0,
          "title": {
            "zh": "需要处理项目数",
            "en": "Items requiring action"
          }
        },
        "monitor_item_count": {
          "type": "integer",
          "minimum": 0,
          "title": {
            "zh": "仅监控项目数",
            "en": "Monitor-only items"
          }
        },
        "customer_results": {
          "type": "array",
          "title": {
            "zh": "逐客户结果",
            "en": "Customer results"
          },
          "items": {
            "type": "object",
            "properties": {
              "action_required_item_count": {"type": "integer", "minimum": 0},
              "monitor_item_count": {"type": "integer", "minimum": 0},
              "dunning_procedure": {"type": ["string", "null"]},
              "dunning_clerk": {"type": ["string", "null"]},
              "dunning_recipient": {"type": ["string", "null"]},
              "assignment_status": {
                "type": "string",
                "enum": ["assigned", "unassigned", "not_assessed", "unknown"]
              },
              "action_summary": {"type": "array"},
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "action_required": {"type": "boolean"},
                    "action_code": {
                      "type": "string",
                      "enum": [
                        "resolve_evidence_gap",
                        "resolve_dunning_block",
                        "review_special_gl",
                        "review_credit_balance",
                        "initiate_first_dunning",
                        "continue_dunning_follow_up",
                        "monitor_until_due"
                      ]
                    },
                    "action_priority": {
                      "type": "string",
                      "enum": ["high", "medium", "low", "none", "unknown"]
                    },
                    "action_reason": {"type": "object"},
                    "recommended_action": {"type": "object"}
                  },
                  "required": [
                    "action_required",
                    "action_code",
                    "action_priority",
                    "action_reason",
                    "recommended_action"
                  ]
                }
              }
            },
            "required": [
              "action_required_item_count",
              "monitor_item_count",
              "dunning_procedure",
              "dunning_clerk",
              "dunning_recipient",
              "assignment_status",
              "action_summary",
              "items"
            ]
          }
        },
        "worklist_artifact": {
          "type": "object",
          "title": {
            "zh": "催收工作清单",
            "en": "Collection worklist"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "evidence_complete": {
          "type": "boolean",
          "title": {
            "zh": "业务证据完整性",
            "en": "Evidence completeness"
          }
        },
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          },
          "enum": [
            "normal",
            "attention",
            "inconclusive"
          ],
          "x-sapba-display": {
            "format": "enum",
            "labels": {
              "normal": {
                "zh": "正常",
                "en": "Normal"
              },
              "attention": {
                "zh": "需处理",
                "en": "Attention"
              },
              "inconclusive": {
                "zh": "无法确认",
                "en": "Inconclusive"
              }
            }
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "requested_customer_count",
        "result_customer_count",
        "normal_customer_count",
        "attention_customer_count",
        "inconclusive_customer_count",
