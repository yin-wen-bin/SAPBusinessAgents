{
  "schemaVersion": 2,
  "slug": "ap-payment",
  "module": "FI",
  "title": {
    "zh": "应付账款付款助手",
    "en": "AP Payment Assistant"
  },
  "summary": {
    "zh": "既可独立查询单一公司代码和供应商，也可消费 P2P 批量证据，在不重复查询主凭证链的前提下复核到期、逾期、折扣、冻结、重复候选和付款准备度。",
    "en": "Runs independently for one company code and supplier or consumes batched P2P evidence to review due, overdue, discount, block, duplicate-candidate, and payment-readiness status without re-querying the main document chain."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.2.0",
  "owner": "FI-AP",
  "tags": [
    "Accounts Payable",
    "Payment Risk",
    "Open Items",
    "Explainable Rules"
  ],
  "sapModules": [
    "FI-AP",
    "MM-IV",
    "Bank Accounting"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "公司代码",
      "供应商编号",
      "查询基准日"
    ],
    "en": [
      "Company code",
      "Supplier",
      "As-of date"
    ]
  },
  "outputs": {
    "zh": [
      "查询模式",
      "公司代码",
      "供应商编号",
      "查询基准日",
      "分组付款复核结果",
      "业务状态",
      "查询源完整性",
      "业务证据完整性",
      "付款运行证据完整性",
      "银行主数据证据完整性",
      "银行扣款证据完整性",
      "银行扣款核验状态",
      "结构化业务报告"
    ],
    "en": [
      "Query mode",
      "Company code",
      "Supplier",
      "As-of date",
      "Payment review scope results",
      "Business status",
      "Query-source completeness",
      "Business-evidence completeness",
      "Payment-run evidence completeness",
      "Bank-master evidence completeness",
      "Bank-settlement evidence completeness",
      "Bank-settlement verification status",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "只读查询，不执行付款或清账",
      "银行账户只显示掩码",
      "计划付款不等同于已清账"
    ],
    "en": [
      "Read-only; never pays or clears items",
      "Bank accounts remain masked",
      "Scheduled payment is not reported as cleared"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_ap_evidence",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "direct 模式按公司代码和供应商读取 FI 供应商行；p2p_evidence 模式直接消费类型化 ap_payment_scopes，不重复查询 PO→GR→Invoice→FI 主链。",
        "en": "In direct mode, read FI supplier items by company code and supplier; in p2p_evidence mode, consume typed ap_payment_scopes without re-querying the PO→GR→Invoice→FI chain."
      },
      "operations": {
        "zh": [
          "根据输入自动确定 direct 或 p2p_evidence 模式；显式模式与输入分支冲突时由 oneOf 契约拒绝。",
          "direct：GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube，并按公司代码、供应商、供应商科目类型和基准日精确过滤。",
          "p2p_evidence：读取 P2P 输出的 ap_payment_scopes[]，保留每组证据引用及 source_complete/evidence_complete，不再次访问主凭证链。",
          "付款运行、银行主数据和银行结算证据保持独立；缺失时标记 unknown/not_assessed。"
        ],
        "en": [
          "Infer direct or p2p_evidence mode from the input; reject an explicit mode that conflicts with its oneOf branch.",
          "direct: GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube with exact company-code, supplier, supplier-account-type, and as-of filters.",
          "p2p_evidence: read P2P ap_payment_scopes[] with per-scope evidence references and source/evidence completeness, without accessing the main document chain again.",
          "Keep payment-run, bank-master, and bank-settlement evidence independent and report unknown/not_assessed when absent."
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_ap_evidence` / `execute_plan`",
            "en": "Execute `collect_ap_evidence` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_ap_evidence"
      ]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "使用唯一的生产规则实现截止日重建、净到期日、现金折扣、付款冻结、付款准备度和重复付款候选；任何银行证据缺口都不会被解释为无风险。",
        "en": "Use the single production rule implementation for cutoff reconstruction, net due date, cash discount, payment blocks, payment readiness, and duplicate-payment candidates; missing bank evidence is never interpreted as no risk."
      },
      "operations": {
        "zh": [
          "只使用 SAP NetDueDate/FAEDT 作为到期日，不把基准日或付款条件基准日当作到期日。",
          "按基准日排除之后过账的行，并把基准日后才清账的行重建为当日未清。",
          "分别判定未到期、到期、逾期、付款冻结、折扣可用和付款准备度。",
          "只有供应商、金额、币种、日期和证据均完整时才确认重复付款候选。",
          "批量输出 scope_results[]；顶层状态按最差分组状态汇总，source_complete 与 evidence_complete 保持独立。",
          "SAP 清账或付款凭证不自动等同于银行实际扣款，bank_settlement_status 保持 not_assessed。"
        ],
        "en": [
          "Use only SAP NetDueDate/FAEDT as the due date; never substitute the query cutoff or payment-terms baseline date.",
          "Exclude postings after the cutoff and reconstruct items cleared after the cutoff as open on that date.",
          "Assess not-due, due, overdue, payment-blocked, discount-available, and payment-readiness states separately.",
          "Confirm a duplicate-payment candidate only when supplier, amount, currency, dates, and evidence are complete.",
          "Emit scope_results[] and aggregate the top-level status by the worst scope while keeping source_complete and evidence_complete separate.",
          "Never equate SAP clearing or a payment document with actual bank debit; bank_settlement_status remains not_assessed."
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "prepare_ap_input",
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "query_mode": {
          "type": "string",
          "enum": ["direct", "p2p_evidence"],
          "x-sapba-workflow-only": true,
          "title": {
            "zh": "查询模式",
            "en": "Query mode"
          }
        },
        "company_code": {
          "type": "string",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          },
          "description": {
            "zh": "请输入公司代码。",
            "en": "Enter the company code."
          },
          "placeholder": {
            "zh": "例如：1010",
            "en": "Example: 1010"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "supplier": {
          "type": "string",
          "title": {
            "zh": "供应商编号",
            "en": "Supplier"
          },
          "description": {
            "zh": "请输入供应商编号。",
            "en": "Enter the supplier."
          },
          "placeholder": {
            "zh": "例如：1000123",
            "en": "Example: 1000123"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "as_of": {
          "type": "string",
          "title": {
            "zh": "查询基准日",
            "en": "As-of date"
          },
          "description": {
            "zh": "请输入查询基准日。",
            "en": "Enter the as-of date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "ap_payment_scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "x-sapba-workflow-only": true,
          "title": {
            "zh": "P2P 应付证据分组",
            "en": "P2P AP evidence scopes"
          },
          "items": {
            "type": "object",
            "properties": {
              "scope_id": {"type": "string"},
              "company_code": {"type": "string"},
              "supplier": {"type": "string"},
              "purchase_orders": {"type": "array", "items": {"type": "string"}},
              "supplier_invoices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "supplier_invoice": {"type": "string"},
                    "fiscal_year": {"type": "string"},
                    "supplier_invoice_items": {"type": "array", "items": {"type": "string"}}
                  },
                  "required": ["supplier_invoice", "fiscal_year", "supplier_invoice_items"],
                  "additionalProperties": false
                }
              },
              "fi_supplier_items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "purchase_order": {"type": "string"},
                    "purchase_order_item": {"type": "string"},
                    "company_code": {"type": "string"},
                    "supplier": {"type": "string"},
                    "fiscal_year": {"type": "string"},
                    "accounting_document": {"type": "string"},
                    "accounting_document_item": {"type": "string"},
                    "original_reference_document": {"type": "string"},
                    "posting_date": {"type": "string"},
                    "net_due_date": {"type": "string"},
                    "cash_discount_due_date": {"type": "string"},
                    "payment_blocking_reason": {"type": "string"},
                    "amount": {"type": "string"},
                    "currency": {"type": "string"},
                    "amount_allocation_ratio": {"type": "string"},
                    "amount_attribution_status": {"type": "string"},
                    "is_cleared": {"type": "boolean"},
                    "clearing_document": {"type": "string"},
                    "clearing_fiscal_year": {"type": "string"},
                    "clearing_date": {"type": "string"},
                    "payment_method": {"type": "string"},
                    "clearing_document_type": {"type": "string"},
                    "payment_document_status": {"type": "string"}
                  },
                  "required": ["purchase_order", "company_code", "supplier", "is_cleared"],
                  "additionalProperties": false
                }
              },
              "source_complete": {"type": "boolean"},
              "evidence_complete": {"type": "boolean"},
              "payment_run_evidence_complete": {"type": "boolean"},
              "bank_master_evidence_complete": {"type": "boolean"},
              "bank_settlement_evidence_complete": {"type": "boolean"},
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["scope_id", "company_code", "supplier", "purchase_orders", "fi_supplier_items", "source_complete", "evidence_complete", "evidence_refs"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "as_of"
      ],
      "oneOf": [
        {
          "properties": {"query_mode": {"const": "direct"}},
          "required": ["company_code", "supplier"],
          "not": {"required": ["ap_payment_scopes"]}
        },
        {
          "properties": {"query_mode": {"const": "p2p_evidence"}},
          "required": ["ap_payment_scopes"]
        }
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "id": "prepare_ap_input",
        "executor": "rule",
        "operation": "prepare_ap_input",
        "inputMapping": {
          "run_input": "{{input}}"
        }
      },
      {
        "id": "collect_ap_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "when": {
          "source": "{{steps.prepare_ap_input.output.query_direct}}",
          "equals": true
        },
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "direct",
            "step_id": "supplier_items",
            "select_fields": [
              "CompanyCode",
              "FiscalYear",
              "FiscalPeriod",
              "Ledger",
              "AccountingDocument",
              "AccountingDocumentItem",
              "Supplier",
              "Customer",
              "FinancialAccountType",
              "GLAccount",
              "OperationalGLAccount",
              "PurchasingDocument",
              "PurchasingDocumentItem",
              "PostingDate",
              "NetDueDate",
              "CashDiscount1DueDate",
              "ClearingDate",
              "ClearingIsReversed",
              "IsOpenItemManaged",
              "DebitCreditCode",
              "IsCleared",
              "ClearingAccountingDocument",
              "ClearingDocFiscalYear",
              "PaymentMethod",
              "PaymentBlockingReason",
              "HouseBank",
              "HouseBankAccount",
              "AccountingDocumentType",
              "AmountInTransactionCurrency",
              "TransactionCurrency",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency",
              "OrderID"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "Supplier",
                "operator": "eq",
                "value": "{{input.supplier}}",
                "value_type": "string"
              },
              {
                "field": "FinancialAccountType",
                "operator": "eq",
                "value": "K",
                "value_type": "string"
              },
              {
                "field": "PostingDate",
                "operator": "le",
                "value": "{{input.as_of}}",
                "value_type": "date_end"
              }
            ],
            "order_by": [
              "FiscalYear",
              "AccountingDocument",
              "AccountingDocumentItem",
              "Ledger"
            ],
            "rationale": "Collect supplier payment evidence."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "ap-payment",
          "run_input": "{{input}}",
          "evidence": {
            "supplier_items": "{{steps.collect_ap_evidence.output}}"
          },
          "known_gaps": [
            "bank_settlement_not_proven",
            "payment_run_and_bank_master_evidence"
          ]
        }
      }
    ],
