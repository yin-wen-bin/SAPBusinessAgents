{
  "schemaVersion": 2,
  "slug": "ap-payment",
  "module": "FI",
  "title": {
    "zh": "应付账款付款助手",
    "en": "AP Payment Assistant"
  },
  "summary": {
    "zh": "查询供应商未清项目与付款状态，并用可解释规则识别重复、冻结、异常账户和逾期风险。",
    "en": "Checks vendor open items and payment status, then explains duplicate, block, bank-account and overdue risks."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.1.0",
  "owner": "FI-AP",
  "tags": [
    "Accounts Payable",
    "Payment Risk",
    "Open Items",
    "Explainable Rules"
  ],
  "sapModules": [
    "FI-AP",
    "MM-IV",
    "Bank Accounting"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "公司代码",
      "供应商编号",
      "查询基准日"
    ],
    "en": [
      "Company code",
      "Supplier",
      "As-of date"
    ]
  },
  "outputs": {
    "zh": [
      "公司代码",
      "供应商编号",
      "查询基准日",
      "业务状态",
      "查询源完整性",
      "结构化业务报告"
    ],
    "en": [
      "Company code",
      "Supplier",
      "As-of date",
      "Business status",
      "Query-source completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "只读查询，不执行付款或清账",
      "银行账户只显示掩码",
      "计划付款不等同于已清账"
    ],
    "en": [
      "Read-only; never pays or clears items",
      "Bank accounts remain masked",
      "Scheduled payment is not reported as cleared"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_ap_evidence",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_ap_evidence`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_ap_evidence` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube"
        ],
        "en": [
          "GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_ap_evidence` / `execute_plan`",
            "en": "Execute `collect_ap_evidence` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_ap_evidence"
      ]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate_business_result`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate_business_result` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          },
          "description": {
            "zh": "请输入公司代码。",
            "en": "Enter the company code."
          },
          "placeholder": {
            "zh": "例如：1010",
            "en": "Example: 1010"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "supplier": {
          "type": "string",
          "title": {
            "zh": "供应商编号",
            "en": "Supplier"
          },
          "description": {
            "zh": "请输入供应商编号。",
            "en": "Enter the supplier."
          },
          "placeholder": {
            "zh": "例如：1000123",
            "en": "Example: 1000123"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "as_of": {
          "type": "string",
          "title": {
            "zh": "查询基准日",
            "en": "As-of date"
          },
          "description": {
            "zh": "请输入查询基准日。",
            "en": "Enter the as-of date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "company_code",
        "supplier",
        "as_of"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "id": "collect_ap_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "direct",
            "step_id": "supplier_items",
            "select_fields": [
              "CompanyCode",
              "FiscalYear",
              "FiscalPeriod",
              "Ledger",
              "AccountingDocument",
              "AccountingDocumentItem",
              "Supplier",
              "Customer",
              "FinancialAccountType",
              "GLAccount",
              "OperationalGLAccount",
              "PurchasingDocument",
              "PurchasingDocumentItem",
              "PostingDate",
              "NetDueDate",
              "ClearingDate",
              "ClearingIsReversed",
              "IsOpenItemManaged",
              "DebitCreditCode",
              "IsCleared",
              "ClearingAccountingDocument",
              "ClearingDocFiscalYear",
              "PaymentMethod",
              "PaymentBlockingReason",
              "HouseBank",
              "HouseBankAccount",
              "AccountingDocumentType",
              "AmountInTransactionCurrency",
              "TransactionCurrency",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency",
              "OrderID"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "Supplier",
                "operator": "eq",
                "value": "{{input.supplier}}",
                "value_type": "string"
              },
              {
                "field": "FinancialAccountType",
                "operator": "eq",
                "value": "K",
                "value_type": "string"
              },
              {
                "field": "PostingDate",
                "operator": "le",
                "value": "{{input.as_of}}",
                "value_type": "date_end"
              }
            ],
            "order_by": [
              "FiscalYear",
              "AccountingDocument",
              "AccountingDocumentItem",
              "Ledger"
            ],
            "rationale": "Collect supplier payment evidence."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "ap-payment",
          "run_input": "{{input}}",
          "evidence": {
            "supplier_items": "{{steps.collect_ap_evidence.output}}"
          },
          "known_gaps": [
            "bank_settlement_not_proven",
            "payment_run_and_bank_master_evidence"
          ]
        }
      }
    ],
    "outputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          },
          "description": {
            "zh": "请输入公司代码。",
            "en": "Enter the company code."
          },
          "placeholder": {
            "zh": "例如：1010",
            "en": "Example: 1010"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "supplier": {
          "type": "string",
          "title": {
            "zh": "供应商编号",
            "en": "Supplier"
          },
          "description": {
            "zh": "请输入供应商编号。",
            "en": "Enter the supplier."
          },
          "placeholder": {
            "zh": "例如：1000123",
            "en": "Example: 1000123"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "as_of": {
          "type": "string",
          "title": {
            "zh": "查询基准日",
            "en": "As-of date"
          },
          "description": {
            "zh": "请输入查询基准日。",
            "en": "Enter the as-of date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "company_code",
        "supplier",
        "as_of",
        "business_status",
        "source_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "company_code": "{{steps.evaluate_business_result.output.workflow_output.company_code}}",
      "supplier": "{{steps.evaluate_business_result.output.workflow_output.supplier}}",
      "as_of": "{{steps.evaluate_business_result.output.workflow_output.as_of}}",
      "business_status": "{{steps.evaluate_business_result.output.workflow_output.business_status}}",
      "source_complete": "{{steps.evaluate_business_result.output.workflow_output.source_complete}}",
      "business_report": "{{steps.evaluate_business_result.output.workflow_output.business_report}}"
    },
    "acceptance": {
      "comparisonMode": "business_semantic",
      "businessKeys": [
        "company_code",
        "fiscal_year",
        "accounting_document",
        "accounting_document_item"
      ],
      "facts": [
        "posting_date",
        "debit_credit",
        "as_of_status",
        "clearing_document",
        "payment_evidence_status"
      ],
      "metrics": [
        "open_items"
      ],
      "currencyAndUnitPolicy": "compare_only_when_same_or_conversion_validated",
      "requiredLimitations": [
        "bank_settlement_not_proven"
      ],
      "decimalFields": [
        "amount"
      ],
      "currencyFields": [
        "currency"
      ]
    }
  },
