{
  "schemaVersion": 2,
  "slug": "month-end-closing",
  "module": "FI",
  "title": { "zh": "月结助手", "en": "Month-end Closing Assistant" },
  "summary": {
    "zh": "通过 Embedded OData 和条件只读 SAPSkillhub 证据执行 12 项跨模块月结准备度检查。",
    "en": "Runs twelve cross-module month-end readiness checks using Embedded OData and conditional read-only SAPSkillhub evidence."
  },
  "status": "Three-stage live acceptance not_tested",
  "version": "0.2.0",
  "owner": "Financial Closing",
  "tags": ["Month End", "Closing Readiness", "Cross Module", "Read Only", "Embedded OData"],
  "sapModules": ["FI-GL", "FI-AP", "FI-AR", "FI-AA", "CO", "MM", "SD"],
  "transactions": [],
  "tables": ["TABA", "T001", "T001B", "MARV"],
  "systems": ["SAP S/4HANA"],
  "inputs": {
    "zh": ["公司代码", "会计年度", "会计期间", "基准日", "分类账（可选）", "公司月结配置（可选）"],
    "en": ["Company code", "Fiscal year", "Fiscal period", "As-of date", "Ledger (optional)", "Company closing profile (optional)"]
  },
  "outputs": {
    "zh": ["月结范围", "准备度状态", "查询源完整性", "检查清单完整性", "业务证据完整性", "12 项检查结果", "异常", "责任待办", "缺失证据", "GR/IR 专项范围", "AP 专项范围", "不支持的专项复核", "专项范围完整性", "结构化业务报告"],
    "en": ["Closing scope", "Readiness status", "Query-source completeness", "Checklist completeness", "Business-evidence completeness", "Twelve check results", "Findings", "Owner actions", "Missing evidence", "GR/IR follow-up scopes", "AP follow-up scopes", "Unsupported follow-ups", "Follow-up scope completeness", "Structured business report"]
  },
  "guardrails": {
    "zh": ["Embedded OData 请求只允许 GET", "SAPSkillhub 只在确认的 API 能力缺口下有界补证", "缺数、空白、超时或截断不得解释为零异常", "不会执行 OB52、MMPV、AFAB、F.05、F.13、MR11、过账、清账或关账", "所有业务动作必须人工确认"],
    "en": ["Embedded OData requests are GET-only", "SAPSkillhub is bounded and conditional on a confirmed API capability gap", "Missing, blank, timed-out, or truncated evidence is never treated as zero exceptions", "Never executes OB52, MMPV, AFAB, F.05, F.13, MR11, posting, clearing, or closing", "Every business action requires human confirmation"]
  },
  "workflow": [
    {
      "id": "read-scope-metadata",
      "title": { "zh": "确认公司与分类账", "en": "Resolve company and ledger" },
      "description": { "zh": "读取公司币种、会计年度变式和 leading ledger。", "en": "Read company currency, fiscal-year variant, and the leading ledger." },
      "operations": { "zh": ["GET API_COMPANYCODE_SRV/A_CompanyCode", "GET API_LEDGER_SRV/A_Ledger"], "en": ["GET API_COMPANYCODE_SRV/A_CompanyCode", "GET API_LEDGER_SRV/A_Ledger"] },
      "tools": [{ "name": "Embedded OData / sap_read.v2", "kind": "GET-only SAP Provider", "purpose": { "zh": "实时 metadata 校验与有界读取。", "en": "Live metadata validation and bounded reads." } }],
      "executionStepIds": ["read_company", "read_ledgers"]
    },
    {
      "id": "prepare-closing-scope",
      "title": { "zh": "绑定月结范围与公司配置", "en": "Bind closing scope and company profile" },
      "description": { "zh": "校验基准日、期间边界、分类账及配置版本并记录配置哈希。", "en": "Validate the as-of date, period boundaries, ledger, and profile version, and record the profile hash." },
      "operations": { "zh": ["rule.prepare_month_end_scope"], "en": ["rule.prepare_month_end_scope"] },
      "tools": [{ "name": "MonthEndProfileRegistry", "kind": "Trusted local configuration", "purpose": { "zh": "加载公司专用科目、阈值、状态映射和责任人。", "en": "Load company-specific accounts, thresholds, status mappings, and owners." } }],
      "executionStepIds": ["prepare_scope"]
    },
    {
      "id": "read-shared-accounting-evidence",
      "title": { "zh": "读取共享 FI/AP/AR/CO 证据", "en": "Read shared FI/AP/AR/CO evidence" },
      "description": { "zh": "按公司、分类账、年度、期间和日期范围读取总账行项目，并从运营会计凭证 API 取得 SAP 净到期日。", "en": "Read G/L line items by company, ledger, year, period, and date range, and obtain SAP net due dates from the operational accounting-document API." },
      "operations": { "zh": ["GET API_GLACCOUNTLINEITEM/GLAccountLineItem", "GET API_OPLACCTGDOCITEMCUBE_SRV/A_OperationalAcctgDocItemCube"], "en": ["GET API_GLACCOUNTLINEITEM/GLAccountLineItem", "GET API_OPLACCTGDOCITEMCUBE_SRV/A_OperationalAcctgDocItemCube"] },
      "tools": [{ "name": "Embedded OData / sap_read.v2", "kind": "GET-only SAP Provider", "purpose": { "zh": "稳定排序、分页和自适应日期分块。", "en": "Stable ordering, paging, and adaptive date partitioning." } }],
      "executionStepIds": ["read_gl_line_items", "read_due_items"]
    },
    {
      "id": "read-grir-chain",
      "title": { "zh": "读取 GR/IR 跨 API 凭证链", "en": "Read the cross-API GR/IR chain" },
      "description": { "zh": "串联 GR/IR 总账行、采购订单、物料凭证和供应商发票。", "en": "Link GR/IR G/L lines, purchase orders, material documents, and supplier invoices." },
      "operations": { "zh": ["GET API_GLACCOUNTLINEITEM", "GET API_PURCHASEORDER_PROCESS_SRV", "GET API_MATERIAL_DOCUMENT_SRV", "GET API_SUPPLIERINVOICE_PROCESS_SRV"], "en": ["GET API_GLACCOUNTLINEITEM", "GET API_PURCHASEORDER_PROCESS_SRV", "GET API_MATERIAL_DOCUMENT_SRV", "GET API_SUPPLIERINVOICE_PROCESS_SRV"] },
      "tools": [{ "name": "Embedded OData / sap_read.v2", "kind": "GET-only SAP Provider", "purpose": { "zh": "按采购订单项目绑定多服务证据。", "en": "Bind multi-service evidence by purchase-order item." } }],
      "executionStepIds": ["read_grir_chain"]
    },
    {
      "id": "read-billing-status",
      "title": { "zh": "读取开票会计传输状态", "en": "Read billing accounting-transfer status" },
      "description": { "zh": "读取期间内开票取消、会计传输和过账状态。", "en": "Read cancellation, accounting-transfer, and posting statuses for the period." },
      "operations": { "zh": ["GET API_BILLING_DOCUMENT_SRV/A_BillingDocument"], "en": ["GET API_BILLING_DOCUMENT_SRV/A_BillingDocument"] },
      "tools": [{ "name": "Embedded OData / sap_read.v2", "kind": "GET-only SAP Provider", "purpose": { "zh": "读取 SD 到 FI 的状态证据。", "en": "Read SD-to-FI status evidence." } }],
      "executionStepIds": ["read_billing_documents"]
    },
    {
      "id": "assess-evidence-gaps",
      "title": { "zh": "评估 API 证据缺口", "en": "Assess API evidence gaps" },
      "description": { "zh": "区分 API 能力缺口与运行失败，禁止隐式 Provider 回退。", "en": "Separate API capability gaps from operational failures and prohibit implicit provider fallback." },
      "operations": { "zh": ["rule.assess_api_evidence"], "en": ["rule.assess_api_evidence"] },
      "tools": [{ "name": "assess_api_evidence", "kind": "Local deterministic rule", "purpose": { "zh": "只为确认的缺口开放 SAPSkillhub 补证。", "en": "Open SAPSkillhub supplementation only for confirmed gaps." } }],
      "executionStepIds": ["assess_evidence", "resolve_skill_requirements"]
    },
    {
      "id": "read-conditional-adt-evidence",
      "title": { "zh": "条件补充权威状态证据", "en": "Conditionally supplement authoritative status evidence" },
      "description": { "zh": "仅按审核过的公司配置有界读取折旧、FI 期间和 MM 期间状态。", "en": "Read bounded depreciation, FI-period, and MM-period status evidence only when approved by the company profile." },
      "operations": { "zh": ["skill.sap-adt-table-export: TABA", "skill.sap-adt-table-export: T001/T001B", "skill.sap-adt-table-export: MARV"], "en": ["skill.sap-adt-table-export: TABA", "skill.sap-adt-table-export: T001/T001B", "skill.sap-adt-table-export: MARV"] },
      "tools": [{ "name": "sap-adt-table-export", "kind": "Read-only SAPSkillhub Skill", "purpose": { "zh": "对 OData 未提供的状态执行有界、DDIC 校验的补证。", "en": "Provide bounded, DDIC-validated evidence for statuses not exposed by OData." } }],
      "executionStepIds": ["adt_asset_depreciation", "adt_company_period_variant", "extract_period_variants", "adt_fi_period_control", "adt_mm_period_status"]
    },
    {
      "id": "evaluate-month-end-readiness",
      "title": { "zh": "执行 12 项检查并生成准备度建议", "en": "Run twelve checks and produce a readiness recommendation" },
      "description": { "zh": "所有检查消费同一份共享证据，分别计算来源、清单和业务证据完整性。", "en": "All checks consume the same evidence bundle and calculate source, checklist, and business-evidence completeness separately." },
      "operations": { "zh": ["rule.evaluate_month_end_closing"], "en": ["rule.evaluate_month_end_closing"] },
      "tools": [{ "name": "MonthEndCheckRegistry", "kind": "Local deterministic rules", "purpose": { "zh": "生成检查矩阵、异常、责任待办和专项复核范围。", "en": "Generate the check matrix, findings, owner actions, and follow-up scopes." } }],
      "executionStepIds": ["evaluate_month_end"]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 900,
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_code": { "type": "string", "title": { "zh": "公司代码", "en": "Company code" }, "minLength": 1, "maxLength": 4, "pattern": "^[0-9A-Za-z]+$" },
        "fiscal_year": { "type": "string", "title": { "zh": "会计年度", "en": "Fiscal year" }, "pattern": "^[0-9]{4}$" },
        "period": { "type": "integer", "title": { "zh": "会计期间", "en": "Fiscal period" }, "minimum": 1, "maximum": 16 },
        "as_of": { "type": "string", "format": "date", "title": { "zh": "基准日", "en": "As-of date" } },
        "ledger": { "type": "string", "title": { "zh": "分类账（可选）", "en": "Ledger (optional)" }, "minLength": 1, "maxLength": 2 },
        "profile_id": { "type": "string", "title": { "zh": "公司月结配置（可选）", "en": "Company closing profile (optional)" }, "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" }
      },
      "required": ["company_code", "fiscal_year", "period", "as_of"],
      "additionalProperties": false
    },
    "steps": [
      { "id": "read_company", "executor": "sap_read", "operation": "execute_plan", "readOnly": true, "request": { "plan": { "service_name": "API_COMPANYCODE_SRV", "odata_version": "2.0", "entity_set": "A_CompanyCode", "http_method": "GET", "plan_kind": "direct", "step_id": "company_metadata", "select_fields": ["CompanyCode", "CompanyCodeName", "Currency", "FiscalYearVariant", "ControllingArea"], "filters": [{ "field": "CompanyCode", "operator": "eq", "value": "{{input.company_code}}", "value_type": "string" }], "order_by": ["CompanyCode"], "rationale": "Resolve the exact company-code metadata." } } },
      { "id": "read_ledgers", "executor": "sap_read", "operation": "execute_plan", "readOnly": true, "request": { "plan": { "service_name": "API_LEDGER_SRV", "odata_version": "2.0", "entity_set": "A_Ledger", "http_method": "GET", "plan_kind": "direct", "step_id": "ledger_metadata", "select_fields": ["Ledger", "IsLeadingLedger", "LedgerApplication", "LedgerSubApplication"], "order_by": ["Ledger"], "rationale": "Resolve the leading ledger from complete ledger metadata." } } },
      { "id": "prepare_scope", "executor": "rule", "operation": "prepare_month_end_scope", "inputMapping": { "run_input": "{{input}}", "company_evidence": "{{steps.read_company.output}}", "ledger_evidence": "{{steps.read_ledgers.output}}" } },
      {
        "id": "read_gl_line_items", "executor": "sap_read", "operation": "execute_plan", "readOnly": true, "failurePolicy": "record_gap",
        "when": { "source": "{{steps.prepare_scope.output.query_ready}}", "equals": true },
        "request": { "plan": { "service_name": "API_GLACCOUNTLINEITEM", "odata_version": "2.0", "entity_set": "GLAccountLineItem", "http_method": "GET", "plan_kind": "direct", "step_id": "gl_line_items", "select_fields": ["Ledger", "CompanyCode", "FiscalYear", "FiscalPeriod", "AccountingDocument", "AccountingDocumentItem", "LedgerGLLineItem", "AccountingDocumentType", "PostingDate", "ClearingDate", "ClearingAccountingDocument", "Supplier", "Customer", "FinancialAccountType", "GLAccount", "IsOpenItemManaged", "DebitCreditCode", "AssignmentReference", "PurchasingDocument", "PurchasingDocumentItem", "CostCenter", "OrderID", "PartnerCostCenter", "DepreciationFiscalPeriod", "JrnlPeriodEndClosingRunLogUUID", "AmountInCompanyCodeCurrency", "CompanyCodeCurrency"], "filters": [{ "field": "CompanyCode", "operator": "eq", "value": "{{input.company_code}}", "value_type": "string" }, { "field": "Ledger", "operator": "eq", "value": "{{steps.prepare_scope.output.ledger}}", "value_type": "string" }, { "field": "FiscalYear", "operator": "eq", "value": "{{input.fiscal_year}}", "value_type": "string" }, { "field": "FiscalPeriod", "operator": "eq", "value": "{{steps.prepare_scope.output.period_text}}", "value_type": "string" }], "order_by": ["Ledger", "CompanyCode", "FiscalYear", "AccountingDocument", "AccountingDocumentItem", "LedgerGLLineItem"], "partition": { "field": "PostingDate", "strategy": "adaptive_date", "from": "{{steps.prepare_scope.output.period_start}}", "to": "{{input.as_of}}", "maxPartitions": 366, "maxTotalResults": 50000 }, "rationale": "Read the shared FI/AR/GL/CO evidence once for all month-end checks." } }
      },
      {
        "id": "read_due_items", "executor": "sap_read", "operation": "execute_plan", "readOnly": true, "failurePolicy": "record_gap",
        "when": { "source": "{{steps.prepare_scope.output.query_ready}}", "equals": true },
        "request": { "plan": { "service_name": "API_OPLACCTGDOCITEMCUBE_SRV", "odata_version": "2.0", "entity_set": "A_OperationalAcctgDocItemCube", "http_method": "GET", "plan_kind": "direct", "step_id": "due_items", "select_fields": ["Ledger", "CompanyCode", "FiscalYear", "FiscalPeriod", "AccountingDocument", "AccountingDocumentItem", "AccountingDocumentType", "PostingDate", "NetDueDate", "ClearingDate", "IsCleared", "Supplier", "PaymentBlockingReason", "GLAccount", "DebitCreditCode", "AmountInCompanyCodeCurrency", "CompanyCodeCurrency"], "filters": [{ "field": "CompanyCode", "operator": "eq", "value": "{{input.company_code}}", "value_type": "string" }, { "field": "Ledger", "operator": "eq", "value": "{{steps.prepare_scope.output.ledger}}", "value_type": "string" }, { "field": "FinancialAccountType", "operator": "eq", "value": "K", "value_type": "string" }], "order_by": ["Ledger", "CompanyCode", "FiscalYear", "AccountingDocument", "AccountingDocumentItem"], "partition": { "field": "PostingDate", "strategy": "adaptive_date", "from": "1900-01-01", "to": "{{input.as_of}}", "maxPartitions": 366, "maxTotalResults": 50000 }, "rationale": "Read all supplier-account items posted through the assessment date, including prior-period carryforward items, and use SAP-computed net due dates without deriving due dates locally." } }
      },
      {
        "id": "read_billing_documents", "executor": "sap_read", "operation": "execute_plan", "readOnly": true, "failurePolicy": "record_gap",
        "when": { "source": "{{steps.prepare_scope.output.query_ready}}", "equals": true },
        "request": { "plan": { "service_name": "API_BILLING_DOCUMENT_SRV", "odata_version": "2.0", "entity_set": "A_BillingDocument", "http_method": "GET", "plan_kind": "direct", "step_id": "billing_documents", "select_fields": ["BillingDocument", "CompanyCode", "FiscalYear", "BillingDocumentDate", "BillingDocumentIsCancelled", "CancelledBillingDocument", "AccountingDocument", "AccountingPostingStatus", "AccountingTransferStatus", "TransactionCurrency", "TotalNetAmount"], "filters": [{ "field": "CompanyCode", "operator": "eq", "value": "{{input.company_code}}", "value_type": "string" }], "order_by": ["BillingDocument"], "partition": { "field": "BillingDocumentDate", "strategy": "adaptive_date", "from": "{{steps.prepare_scope.output.period_start}}", "to": "{{input.as_of}}", "maxPartitions": 366, "maxTotalResults": 50000 }, "rationale": "Read billing-to-accounting status for the closing period." } }
      },
      {
        "id": "read_grir_chain", "executor": "sap_read", "operation": "execute_plan", "readOnly": true, "failurePolicy": "record_gap",
        "when": { "source": "{{steps.prepare_scope.output.grir_enabled}}", "equals": true },
        "request": { "plan": { "service_name": "API_GLACCOUNTLINEITEM", "odata_version": "2.0", "entity_set": "GLAccountLineItem", "http_method": "GET", "plan_kind": "multi_step", "steps": [
          { "step_id": "gl_items", "service_name": "API_GLACCOUNTLINEITEM", "odata_version": "2.0", "entity_set": "GLAccountLineItem", "http_method": "GET", "select_fields": ["Ledger", "CompanyCode", "FiscalYear", "AccountingDocument", "AccountingDocumentItem", "LedgerGLLineItem", "GLAccount", "PurchasingDocument", "PurchasingDocumentItem", "PostingDate", "AmountInCompanyCodeCurrency", "CompanyCodeCurrency", "DebitCreditCode"], "filters": [{ "field": "CompanyCode", "operator": "eq", "value": "{{input.company_code}}", "value_type": "string" }, { "field": "Ledger", "operator": "eq", "value": "{{steps.prepare_scope.output.ledger}}", "value_type": "string" }, { "field": "GLAccount", "operator": "in", "value": "{{steps.prepare_scope.output.grir_accounts}}", "value_type": "string", "chunk_size": 10 }], "order_by": ["Ledger", "CompanyCode", "FiscalYear", "AccountingDocument", "AccountingDocumentItem", "LedgerGLLineItem"], "partition": { "field": "PostingDate", "strategy": "adaptive_date", "from": "{{steps.prepare_scope.output.period_start}}", "to": "{{input.as_of}}", "maxPartitions": 366, "maxTotalResults": 50000 } },
          { "step_id": "grir_gl_history", "service_name": "API_GLACCOUNTLINEITEM", "odata_version": "2.0", "entity_set": "GLAccountLineItem", "http_method": "GET", "select_fields": ["Ledger", "CompanyCode", "FiscalYear", "AccountingDocument", "AccountingDocumentItem", "LedgerGLLineItem", "GLAccount", "PurchasingDocument", "PurchasingDocumentItem", "PostingDate", "AmountInCompanyCodeCurrency", "CompanyCodeCurrency", "DebitCreditCode"], "filters": [{ "field": "CompanyCode", "operator": "eq", "value": "{{input.company_code}}", "value_type": "string" }, { "field": "Ledger", "operator": "eq", "value": "{{steps.prepare_scope.output.ledger}}", "value_type": "string" }, { "field": "GLAccount", "operator": "in", "value": "{{steps.prepare_scope.output.grir_accounts}}", "value_type": "string", "chunk_size": 10 }], "filter_from_previous": [{ "field": "PurchasingDocument", "source_step_id": "gl_items", "source_field": "PurchasingDocument", "fanout": true, "fetch_all_for_binding": true }, { "field": "PurchasingDocumentItem", "source_step_id": "gl_items", "source_field": "PurchasingDocumentItem", "fanout": true, "fetch_all_for_binding": true }], "order_by": ["Ledger", "CompanyCode", "FiscalYear", "AccountingDocument", "AccountingDocumentItem", "LedgerGLLineItem"], "partition": { "field": "PostingDate", "strategy": "adaptive_date", "from": "1900-01-01", "to": "{{input.as_of}}", "maxPartitions": 366, "maxTotalResults": 50000 } },
          { "step_id": "purchase_order_items", "service_name": "API_PURCHASEORDER_PROCESS_SRV", "odata_version": "2.0", "entity_set": "A_PurchaseOrderItem", "http_method": "GET", "select_fields": ["PurchaseOrder", "PurchaseOrderItem", "Material", "Plant", "OrderQuantity", "PurchaseOrderQuantityUnit", "OrderPriceUnit", "DocumentCurrency"], "filter_from_previous": [{ "field": "PurchaseOrder", "source_step_id": "gl_items", "source_field": "PurchasingDocument", "fanout": true, "fetch_all_for_binding": true }, { "field": "PurchaseOrderItem", "source_step_id": "gl_items", "source_field": "PurchasingDocumentItem", "fanout": true, "fetch_all_for_binding": true }] },
          { "step_id": "material_documents", "service_name": "API_MATERIAL_DOCUMENT_SRV", "odata_version": "2.0", "entity_set": "A_MaterialDocumentItem", "http_method": "GET", "select_fields": ["MaterialDocumentYear", "MaterialDocument", "MaterialDocumentItem", "PurchaseOrder", "PurchaseOrderItem", "Material", "Plant", "GoodsMovementType", "QuantityInEntryUnit", "EntryUnit", "MaterialBaseUnit", "DebitCreditCode", "ReversedMaterialDocument", "ReversedMaterialDocumentYear", "ReversedMaterialDocumentItem"], "filter_from_previous": [{ "field": "PurchaseOrder", "source_step_id": "gl_items", "source_field": "PurchasingDocument", "fanout": true, "fetch_all_for_binding": true }, { "field": "PurchaseOrderItem", "source_step_id": "gl_items", "source_field": "PurchasingDocumentItem", "fanout": true, "fetch_all_for_binding": true }] },
          { "step_id": "material_document_headers", "service_name": "API_MATERIAL_DOCUMENT_SRV", "odata_version": "2.0", "entity_set": "A_MaterialDocumentHeader", "http_method": "GET", "select_fields": ["MaterialDocumentYear", "MaterialDocument", "PostingDate"], "filter_from_previous": [{ "field": "MaterialDocumentYear", "source_step_id": "material_documents", "source_field": "MaterialDocumentYear", "fanout": true, "fetch_all_for_binding": true }, { "field": "MaterialDocument", "source_step_id": "material_documents", "source_field": "MaterialDocument", "fanout": true, "fetch_all_for_binding": true }] },
          { "step_id": "supplier_invoice_items", "service_name": "API_SUPPLIERINVOICE_PROCESS_SRV", "odata_version": "2.0", "entity_set": "A_SuplrInvcItemPurOrdRef", "http_method": "GET", "select_fields": ["SupplierInvoice", "FiscalYear", "SupplierInvoiceItem", "PurchaseOrder", "PurchaseOrderItem", "QuantityInPurchaseOrderUnit", "PurchaseOrderQuantityUnit", "SupplierInvoiceItemAmount", "DocumentCurrency"], "filter_from_previous": [{ "field": "PurchaseOrder", "source_step_id": "gl_items", "source_field": "PurchasingDocument", "fanout": true, "fetch_all_for_binding": true }, { "field": "PurchaseOrderItem", "source_step_id": "gl_items", "source_field": "PurchasingDocumentItem", "fanout": true, "fetch_all_for_binding": true }] },
          { "step_id": "supplier_invoice_headers", "service_name": "API_SUPPLIERINVOICE_PROCESS_SRV", "odata_version": "2.0", "entity_set": "A_SupplierInvoice", "http_method": "GET", "select_fields": ["SupplierInvoice", "FiscalYear", "CompanyCode", "PostingDate", "SupplierInvoiceStatus", "SupplierInvoiceIsCreditMemo", "DocumentCurrency"], "filter_from_previous": [{ "field": "SupplierInvoice", "source_step_id": "supplier_invoice_items", "source_field": "SupplierInvoice", "fanout": true, "fetch_all_for_binding": true }, { "field": "FiscalYear", "source_step_id": "supplier_invoice_items", "source_field": "FiscalYear", "fanout": true, "fetch_all_for_binding": true }] }
        ], "rationale": "Collect the complete GR/IR evidence chain once for the two month-end checks." } }
      },
