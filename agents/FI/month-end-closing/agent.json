          },
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[0-9]+$"
        },
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
