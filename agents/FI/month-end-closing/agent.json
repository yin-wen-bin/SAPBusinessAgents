  "guardrails": {
    "zh": [
      "所有 SAP 操作只读",
      "缺数不会解释成零异常",
      "不会执行 OB52、MMPV、AFAB、F.05、F.13、MR11 或任何关账动作",
      "最终动作必须人工确认"
    ],
    "en": [
      "All SAP operations are read-only",
      "Missing data is never treated as zero exceptions",
      "Never executes OB52, MMPV, AFAB, F.05, F.13, MR11 or closing actions",
      "Final actions require human confirmation"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_month_end_evidence",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_month_end_evidence`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_month_end_evidence` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube"
        ],
        "en": [
          "GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_month_end_evidence` / `execute_plan`",
            "en": "Execute `collect_month_end_evidence` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_month_end_evidence"
      ]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate_business_result`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate_business_result` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          },
          "description": {
            "zh": "请输入公司代码。",
            "en": "Enter the company code."
          },
          "placeholder": {
            "zh": "例如：1010",
            "en": "Example: 1010"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "fiscal_year": {
          "type": "string",
          "title": {
            "zh": "会计年度",
            "en": "Fiscal year"
          },
          "description": {
            "zh": "请输入会计年度。",
            "en": "Enter the fiscal year."
          },
          "placeholder": {
            "zh": "例如：2026",
            "en": "Example: 2026"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9]+$"
        },
        "period": {
          "type": "string",
          "title": {
            "zh": "会计期间",
            "en": "Fiscal period"
          },
          "description": {
            "zh": "请输入会计期间。",
            "en": "Enter the fiscal period."
          },
          "placeholder": {
            "zh": "例如：08",
            "en": "Example: 08"
          },
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "company_code",
        "fiscal_year",
        "period"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "id": "collect_month_end_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "direct",
            "step_id": "fi_period_items",
            "select_fields": [
              "CompanyCode",
              "FiscalYear",
              "FiscalPeriod",
              "Ledger",
              "AccountingDocument",
              "AccountingDocumentItem",
              "Supplier",
              "Customer",
              "FinancialAccountType",
              "GLAccount",
              "OperationalGLAccount",
              "PurchasingDocument",
              "PurchasingDocumentItem",
              "PostingDate",
              "NetDueDate",
              "ClearingDate",
              "ClearingIsReversed",
              "IsOpenItemManaged",
              "DebitCreditCode",
              "IsCleared",
              "ClearingAccountingDocument",
              "ClearingDocFiscalYear",
              "PaymentMethod",
              "PaymentBlockingReason",
              "HouseBank",
              "HouseBankAccount",
              "AccountingDocumentType",
              "AmountInTransactionCurrency",
              "TransactionCurrency",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency",
              "OrderID"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "FiscalYear",
                "operator": "eq",
                "value": "{{input.fiscal_year}}",
                "value_type": "string"
              },
              {
                "field": "FiscalPeriod",
                "operator": "eq",
                "value": "{{input.period}}",
                "value_type": "string"
              }
            ],
            "order_by": [
              "PostingDate",
              "CompanyCode",
              "FiscalYear",
              "AccountingDocument",
              "AccountingDocumentItem"
            ],
            "rationale": "Collect available month-end evidence."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "month-end-closing",
          "run_input": "{{input}}",
          "evidence": {
            "fi_period_items": "{{steps.collect_month_end_evidence.output}}"
          },
          "known_gaps": [
            "period_control_asset_depreciation_and_specialized_closing_checks"
          ]
        }
      }
    ],
    "outputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
