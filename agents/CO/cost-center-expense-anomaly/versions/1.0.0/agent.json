    "steps": [
      {
        "id": "read_master",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_COSTCENTER_SRV",
            "odata_version": "2.0",
            "entity_set": "A_CostCenter",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "ControllingArea",
              "CostCenter",
              "ValidityStartDate",
              "ValidityEndDate",
              "CompanyCode",
              "CostCenterCurrency",
              "ProfitCenter",
              "IsBlkdForPrimaryCostsPosting",
              "IsBlkdForSecondaryCostsPosting"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "ControllingArea",
                "operator": "eq",
                "value": "{{input.controlling_area}}",
                "value_type": "string"
              },
              {
                "field": "CostCenter",
                "operator": "eq",
                "value": "{{input.cost_center}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read bounded cost-center master evidence."
          }
        }
      },
      {
        "id": "read_actual",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "CompanyCode",
              "FiscalYear",
              "FiscalPeriod",
