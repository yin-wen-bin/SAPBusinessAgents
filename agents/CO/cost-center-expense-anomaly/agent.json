{
  "schemaVersion": 2,
  "slug": "cost-center-expense-anomaly",
  "module": "CO",
  "title": {
    "zh": "成本中心费用异常助手",
    "en": "Cost Center Expense Anomaly Assistant"
  },
  "summary": {
    "zh": "比较成本中心实际与计划费用，识别超阈值偏差和主数据冻结。",
    "en": "Compares cost-center actual and plan expense to identify threshold breaches and master-data blocks."
  },
  "status": "Three-stage live acceptance blocked",
  "version": "0.1.1",
  "owner": "CO-OM-CCA / Cost Center Accounting",
  "tags": [
    "Cost Center",
    "Expense",
    "Variance",
    "Anomaly"
  ],
  "sapModules": [
    "CO-OM-CCA",
    "FI-GL"
  ],
  "transactions": [],
  "tables": [
    "CSKS",
    "ACDOCA",
    "ACDOCP"
  ],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "公司代码",
      "会计年度",
      "控制范围",
      "成本中心",
      "起始期间",
      "结束期间",
      "计划类别",
      "差异阈值（%）"
    ],
    "en": [
      "Company code",
      "Fiscal Year",
      "Controlling Area",
      "Cost Center",
      "Period From",
      "Period To",
      "Planning Category",
      "Variance Threshold Pct"
    ]
  },
  "outputs": {
    "zh": [
      "业务状态",
      "查询源完整性",
      "结构化业务报告"
    ],
    "en": [
      "Business status",
      "Query-source completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "全部 SAP 访问严格只读",
      "Embedded OData 为唯一主 provider",
      "仅 schema 能力缺口触发 ADT",
      "不启用自动 Provider 回退或 SE16N",
      "不完整证据不得生成确定结论"
    ],
    "en": [
      "All SAP access is strictly read-only",
      "Embedded OData is the sole primary provider",
      "Only schema capability gaps trigger ADT",
      "Never use automatic Provider fallback or SE16N",
      "Incomplete evidence cannot produce a confirmed conclusion"
    ]
  },
  "workflow": [
    {
      "id": "execute-read_master",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `read_master`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `read_master` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_COSTCENTER_SRV@2.0/A_CostCenter"
        ],
        "en": [
          "GET API_COSTCENTER_SRV@2.0/A_CostCenter"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `read_master` / `execute_plan`",
            "en": "Execute `read_master` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "read_master"
      ]
    },
    {
      "id": "execute-read_actual",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `read_actual`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `read_actual` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube"
        ],
        "en": [
          "GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `read_actual` / `execute_plan`",
            "en": "Execute `read_actual` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "read_actual"
      ]
    },
    {
      "id": "execute-read_plan",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `read_plan`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `read_plan` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_FINPLANNINGENTRYITEM_SRV@2.0/A_FinPlanningEntryItem"
        ],
        "en": [
          "GET API_FINPLANNINGENTRYITEM_SRV@2.0/A_FinPlanningEntryItem"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `read_plan` / `execute_plan`",
            "en": "Execute `read_plan` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "read_plan"
      ]
    },
    {
      "id": "execute-assess",
      "title": {
        "zh": "评估证据完整性",
        "en": "Assess evidence completeness"
      },
      "description": {
        "zh": "执行清单步骤 `assess`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `assess` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.assess_api_evidence"
        ],
        "en": [
          "rule.assess_api_evidence"
        ]
      },
      "tools": [
        {
          "name": "assess_api_evidence",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `assess` / `assess_api_evidence`",
            "en": "Execute `assess` / `assess_api_evidence`"
          }
        }
      ],
      "executionStepIds": [
        "assess"
      ]
    },
    {
      "id": "execute-adt_master",
      "title": {
        "zh": "按条件补充表级证据",
        "en": "Conditionally supplement table evidence"
      },
      "description": {
        "zh": "仅在清单条件成立时执行 `adt_master`；条件为假时记录 skipped，不连接 Skill。",
        "en": "Run `adt_master` only when its manifest condition is true; otherwise record skipped without calling the Skill."
      },
      "operations": {
        "zh": [
          "sap-adt-table-export.execute"
        ],
        "en": [
          "sap-adt-table-export.execute"
        ]
      },
      "tools": [
        {
          "name": "sap-adt-table-export",
          "kind": "Read-only SAPSkillhub Skill",
          "purpose": {
            "zh": "执行 `adt_master` / `execute`",
            "en": "Execute `adt_master` / `execute`"
          }
        }
      ],
      "executionStepIds": [
        "adt_master"
      ]
    },
    {
      "id": "execute-adt_actual",
      "title": {
        "zh": "按条件补充表级证据",
        "en": "Conditionally supplement table evidence"
      },
      "description": {
        "zh": "仅在清单条件成立时执行 `adt_actual`；条件为假时记录 skipped，不连接 Skill。",
        "en": "Run `adt_actual` only when its manifest condition is true; otherwise record skipped without calling the Skill."
      },
      "operations": {
        "zh": [
          "sap-adt-table-export.execute"
        ],
        "en": [
          "sap-adt-table-export.execute"
        ]
      },
      "tools": [
        {
          "name": "sap-adt-table-export",
          "kind": "Read-only SAPSkillhub Skill",
          "purpose": {
            "zh": "执行 `adt_actual` / `execute`",
            "en": "Execute `adt_actual` / `execute`"
          }
        }
      ],
      "executionStepIds": [
        "adt_actual"
      ]
    },
    {
      "id": "execute-adt_plan",
      "title": {
        "zh": "按条件补充表级证据",
        "en": "Conditionally supplement table evidence"
      },
      "description": {
        "zh": "仅在清单条件成立时执行 `adt_plan`；条件为假时记录 skipped，不连接 Skill。",
        "en": "Run `adt_plan` only when its manifest condition is true; otherwise record skipped without calling the Skill."
      },
      "operations": {
        "zh": [
          "sap-adt-table-export.execute"
        ],
        "en": [
          "sap-adt-table-export.execute"
        ]
      },
      "tools": [
        {
          "name": "sap-adt-table-export",
          "kind": "Read-only SAPSkillhub Skill",
          "purpose": {
            "zh": "执行 `adt_plan` / `execute`",
            "en": "Execute `adt_plan` / `execute`"
          }
        }
      ],
      "executionStepIds": [
        "adt_plan"
      ]
    },
    {
      "id": "execute-evaluate",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate` / `evaluate_business_agent`",
            "en": "Execute `evaluate` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          }
        },
        "fiscal_year": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$",
          "title": {
            "zh": "会计年度",
            "en": "Fiscal Year"
          }
        },
        "controlling_area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "控制范围",
            "en": "Controlling Area"
          }
        },
        "cost_center": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "成本中心",
            "en": "Cost Center"
          }
        },
        "period_from": {
          "type": "string",
          "pattern": "^[0-9]{1,3}$",
          "title": {
            "zh": "起始期间",
            "en": "Period From"
          }
        },
        "period_to": {
          "type": "string",
          "pattern": "^[0-9]{1,3}$",
          "title": {
            "zh": "结束期间",
            "en": "Period To"
          }
        },
        "planning_category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "title": {
            "zh": "计划类别",
            "en": "Planning Category"
          }
        },
        "variance_threshold_pct": {
          "type": "number",
          "default": 20,
          "title": {
            "zh": "差异阈值（%）",
            "en": "Variance Threshold Pct"
          }
        }
      },
      "required": [
        "controlling_area",
        "company_code",
        "cost_center",
        "fiscal_year",
        "period_from",
        "period_to",
        "planning_category"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "business_status",
        "source_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "business_status": "{{steps.evaluate.output.workflow_output.business_status}}",
      "source_complete": "{{steps.evaluate.output.workflow_output.source_complete}}",
      "business_report": "{{steps.evaluate.output.workflow_output.business_report}}"
    },
    "steps": [
      {
        "id": "read_master",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_COSTCENTER_SRV",
            "odata_version": "2.0",
            "entity_set": "A_CostCenter",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "ControllingArea",
              "CostCenter",
              "ValidityStartDate",
              "ValidityEndDate",
              "CompanyCode",
              "CostCenterCurrency",
              "ProfitCenter",
              "IsBlkdForPrimaryCostsPosting",
              "IsBlkdForSecondaryCostsPosting"
            ],
            "filters": [
              {
                "field": "ControllingArea",
                "operator": "eq",
                "value": "{{input.controlling_area}}",
                "value_type": "string"
              },
              {
                "field": "CostCenter",
                "operator": "eq",
                "value": "{{input.cost_center}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read bounded cost-center master evidence."
          }
        }
      },
      {
        "id": "read_actual",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "CompanyCode",
              "FiscalYear",
              "FiscalPeriod",
              "AccountingDocument",
              "AccountingDocumentItem",
              "ControllingArea",
              "CostCenter",
              "OrderID",
              "WBSElementInternalID",
              "Material",
              "Plant",
              "GLAccount",
              "PostingDate",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "FiscalYear",
                "operator": "eq",
                "value": "{{input.fiscal_year}}",
                "value_type": "string"
              },
              {
                "field": "CostCenter",
                "operator": "eq",
                "value": "{{input.cost_center}}",
                "value_type": "string"
              },
              {
                "field": "FiscalPeriod",
                "operator": "ge",
                "value": "{{input.period_from}}",
                "value_type": "string"
              },
              {
                "field": "FiscalPeriod",
                "operator": "le",
                "value": "{{input.period_to}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read complete actual expense evidence for one cost center and period range."
          }
        }
      },
      {
        "id": "read_plan",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_FINPLANNINGENTRYITEM_SRV",
            "odata_version": "2.0",
            "entity_set": "A_FinPlanningEntryItem",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "ID",
              "Ledger",
              "PlanningCategory",
              "LedgerFiscalYear",
              "FiscalPeriod",
              "CompanyCode",
              "CostCenter",
              "OrderID",
              "WBSElementExternalID",
              "Plant",
              "GLAccount",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "LedgerFiscalYear",
                "operator": "eq",
                "value": "{{input.fiscal_year}}",
                "value_type": "string"
              },
              {
                "field": "CostCenter",
                "operator": "eq",
                "value": "{{input.cost_center}}",
                "value_type": "string"
              },
              {
                "field": "PlanningCategory",
                "operator": "eq",
                "value": "{{input.planning_category}}",
                "value_type": "string"
              },
              {
                "field": "FiscalPeriod",
                "operator": "ge",
                "value": "{{input.period_from}}",
                "value_type": "string"
              },
              {
                "field": "FiscalPeriod",
                "operator": "le",
                "value": "{{input.period_to}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read complete planned expense evidence for the same scope."
          }
        }
      },
      {
        "id": "assess",
        "executor": "rule",
        "operation": "assess_api_evidence",
        "inputMapping": {
          "checks": {
            "master": "{{steps.read_master.output}}",
            "actual": "{{steps.read_actual.output}}",
            "plan": "{{steps.read_plan.output}}"
          }
        }
      },
      {
        "id": "adt_master",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess.output.needs_adt.master}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "CSKS",
          "fields": [
            "KOKRS",
            "KOSTL",
            "DATAB",
            "DATBI",
            "BUKRS",
            "WAERS",
            "BKZKP"
          ],
          "filters": [
            {
              "field": "KOKRS",
              "operator": "eq",
              "value": "{{input.controlling_area}}"
            },
            {
              "field": "KOSTL",
              "operator": "eq",
              "value": "{{input.cost_center}}"
            }
          ],
          "order_by": [
            "KOKRS",
            "KOSTL",
            "DATBI"
          ],
          "max_rows": 100
        }
      },
      {
        "id": "adt_actual",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess.output.needs_adt.actual}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "ACDOCA",
          "fields": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN",
            "POPER",
            "KOSTL",
            "RACCT",
            "HSL",
            "RHCUR"
          ],
          "filters": [
            {
              "field": "RBUKRS",
              "operator": "eq",
              "value": "{{input.company_code}}"
            },
            {
              "field": "GJAHR",
              "operator": "eq",
              "value": "{{input.fiscal_year}}"
            },
            {
              "field": "KOSTL",
              "operator": "eq",
              "value": "{{input.cost_center}}"
            },
            {
              "field": "POPER",
              "operator": "bt",
              "low": "{{input.period_from}}",
              "high": "{{input.period_to}}"
            }
          ],
          "order_by": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN"
          ],
          "max_rows": 10000
        }
      },
      {
        "id": "adt_plan",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess.output.needs_adt.plan}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "ACDOCP",
          "fields": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN",
            "POPER",
            "KOSTL",
            "RACCT",
            "HSL",
            "RHCUR"
          ],
          "filters": [
            {
              "field": "RBUKRS",
              "operator": "eq",
              "value": "{{input.company_code}}"
            },
            {
              "field": "GJAHR",
              "operator": "eq",
              "value": "{{input.fiscal_year}}"
            },
            {
              "field": "KOSTL",
              "operator": "eq",
              "value": "{{input.cost_center}}"
            },
            {
              "field": "POPER",
              "operator": "bt",
              "low": "{{input.period_from}}",
              "high": "{{input.period_to}}"
            }
          ],
          "order_by": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN"
          ],
          "max_rows": 10000
        }
      },
      {
        "id": "evaluate",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "cost-center-expense-anomaly",
          "run_input": "{{input}}",
          "assessment": "{{steps.assess.output}}",
          "evidence": {
            "cost_centers": "{{steps.read_master.output}}",
            "actual_items": "{{steps.read_actual.output}}",
            "plan_items": "{{steps.read_plan.output}}"
          },
          "fallbacks": {
            "master": "{{steps.adt_master.output}}",
            "actual": "{{steps.adt_actual.output}}",
            "plan": "{{steps.adt_plan.output}}"
          },
          "known_gaps": []
        }
      }
