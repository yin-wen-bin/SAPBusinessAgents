  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          }
        },
        "fiscal_year": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$",
          "title": {
            "zh": "fiscal year",
            "en": "Fiscal Year"
          }
        },
        "cost_center": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "cost center",
            "en": "Cost Center"
          }
        },
        "current_period": {
          "type": "string",
          "pattern": "^[0-9]{3}$",
          "title": {
            "zh": "current period",
            "en": "Current Period"
          }
        },
        "planning_category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "title": {
            "zh": "planning category",
            "en": "Planning Category"
          }
        },
        "risk_threshold_pct": {
          "type": "number",
          "default": 10,
          "title": {
            "zh": "risk threshold pct",
            "en": "Risk Threshold Pct"
          }
        }
      },
      "required": [
        "company_code",
        "cost_center",
        "fiscal_year",
        "current_period",
        "planning_category"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "business_status",
        "source_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "business_status": "{{steps.evaluate.output.workflow_output.business_status}}",
      "source_complete": "{{steps.evaluate.output.workflow_output.source_complete}}",
      "business_report": "{{steps.evaluate.output.workflow_output.business_report}}"
    },
    "steps": [
      {
        "id": "read_actual",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "CompanyCode",
              "FiscalYear",
              "FiscalPeriod",
              "AccountingDocument",
              "AccountingDocumentItem",
              "ControllingArea",
              "CostCenter",
              "OrderID",
              "WBSElementInternalID",
              "Material",
              "Plant",
              "GLAccount",
              "PostingDate",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "FiscalYear",
                "operator": "eq",
                "value": "{{input.fiscal_year}}",
                "value_type": "string"
              },
              {
                "field": "CostCenter",
                "operator": "eq",
                "value": "{{input.cost_center}}",
                "value_type": "string"
              },
              {
                "field": "FiscalPeriod",
                "operator": "le",
                "value": "{{input.current_period}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read year-to-date actual cost."
          }
        }
      },
      {
        "id": "read_plan",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_FINPLANNINGENTRYITEM_SRV",
            "odata_version": "2.0",
            "entity_set": "A_FinPlanningEntryItem",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "ID",
              "Ledger",
              "PlanningCategory",
              "LedgerFiscalYear",
              "FiscalPeriod",
              "CompanyCode",
              "CostCenter",
              "OrderID",
              "WBSElementExternalID",
              "Plant",
              "GLAccount",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "LedgerFiscalYear",
                "operator": "eq",
                "value": "{{input.fiscal_year}}",
                "value_type": "string"
              },
              {
                "field": "CostCenter",
                "operator": "eq",
                "value": "{{input.cost_center}}",
                "value_type": "string"
              },
              {
                "field": "PlanningCategory",
                "operator": "eq",
                "value": "{{input.planning_category}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read the full-year plan for the same cost center."
          }
        }
      },
      {
        "id": "assess",
        "executor": "rule",
        "operation": "assess_api_evidence",
        "inputMapping": {
          "checks": {
            "actual": "{{steps.read_actual.output}}",
            "plan": "{{steps.read_plan.output}}"
          }
        }
      },
      {
        "id": "adt_actual",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess.output.needs_adt.actual}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "ACDOCA",
          "fields": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN",
            "POPER",
            "KOSTL",
            "RACCT",
            "HSL",
            "RHCUR"
          ],
          "filters": [
            {
              "field": "RBUKRS",
              "operator": "eq",
              "value": "{{input.company_code}}"
            },
            {
              "field": "GJAHR",
              "operator": "eq",
              "value": "{{input.fiscal_year}}"
            },
            {
              "field": "KOSTL",
              "operator": "eq",
              "value": "{{input.cost_center}}"
            },
            {
              "field": "POPER",
              "operator": "bt",
              "low": "1",
              "high": "{{input.current_period}}"
            }
          ],
          "order_by": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN"
          ],
          "max_rows": 10000
        }
      },
      {
        "id": "adt_plan",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess.output.needs_adt.plan}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "ACDOCP",
          "fields": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN",
            "POPER",
            "KOSTL",
            "RACCT",
            "HSL",
            "RHCUR"
          ],
          "filters": [
            {
              "field": "RBUKRS",
              "operator": "eq",
              "value": "{{input.company_code}}"
            },
            {
              "field": "GJAHR",
              "operator": "eq",
              "value": "{{input.fiscal_year}}"
            },
            {
              "field": "KOSTL",
              "operator": "eq",
              "value": "{{input.cost_center}}"
            }
          ],
          "order_by": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN"
          ],
          "max_rows": 10000
        }
      },
      {
        "id": "evaluate",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "budget-rolling-forecast",
          "run_input": "{{input}}",
          "assessment": "{{steps.assess.output}}",
          "evidence": {
            "actual_items": "{{steps.read_actual.output}}",
            "plan_items": "{{steps.read_plan.output}}"
          },
          "fallbacks": {
            "actual": "{{steps.adt_actual.output}}",
            "plan": "{{steps.adt_plan.output}}"
          },
          "known_gaps": []
        }
      }
    ],
