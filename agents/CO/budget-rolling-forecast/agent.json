{
  "schemaVersion": 2,
  "slug": "budget-rolling-forecast",
  "module": "CO",
  "title": {
    "zh": "预算滚动预测助手",
    "en": "Budget Rolling Forecast Assistant"
  },
  "summary": {
    "zh": "基于成本中心累计实际与全年计划形成透明的月均滚动预测。",
    "en": "Builds a transparent monthly-average rolling forecast from cost-center year-to-date actuals and full-year plan."
  },
  "status": "Deterministic prototype with bounded live validation",
  "version": "0.1.0",
  "owner": "CO Planning / FP&A",
  "tags": [
    "Budget",
    "Forecast",
    "Plan Actual",
    "Cost Center"
  ],
  "sapModules": [
    "CO-OM-CCA",
    "FI-GL"
  ],
  "transactions": [
    "KP06",
    "S_ALR_87013611"
  ],
  "tables": [
    "ACDOCA",
    "ACDOCP"
  ],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "公司代码",
      "成本中心",
      "会计年度",
      "当前期间",
      "计划类别",
      "风险阈值"
    ],
    "en": [
      "Company code",
      "Cost center",
      "Fiscal year",
      "Current period",
      "Planning category",
      "Risk threshold"
    ]
  },
  "outputs": {
    "zh": [
      "累计实际",
      "全年计划",
      "全年预测",
      "预测偏差"
    ],
    "en": [
      "Year-to-date actual",
      "Full-year plan",
      "Full-year forecast",
      "Forecast variance"
    ]
  },
  "guardrails": {
    "zh": [
      "全部 SAP 访问严格只读",
      "Embedded OData 为唯一主 provider",
      "仅 schema 能力缺口触发 ADT",
      "不启用自动 Provider 回退或 SE16N",
      "不完整证据不得生成确定结论"
    ],
    "en": [
      "All SAP access is strictly read-only",
      "Embedded OData is the sole primary provider",
      "Only schema capability gaps trigger ADT",
      "Never use automatic Provider fallback or SE16N",
      "Incomplete evidence cannot produce a confirmed conclusion"
    ]
  },
  "workflow": [
    {
      "id": "validate-scope",
      "title": {
        "zh": "1. 校验 CO 范围",
        "en": "1. Validate CO scope"
      },
      "description": {
        "zh": "校验公司代码、成本中心、年度、当前期间和计划类别。",
        "en": "Validate company code, cost center, year, current period, and planning category."
      },
      "operations": {
        "zh": [
          "拒绝无界或格式错误的范围。"
        ],
        "en": [
          "Reject unbounded or malformed scope."
        ]
      },
      "tools": [
        {
          "name": "Input schema",
          "kind": "Control",
          "purpose": {
            "zh": "限制真机读取范围。",
            "en": "Bounds live reads."
          }
        }
      ]
    },
    {
      "id": "check-schema",
      "title": {
        "zh": "2. 校验 Embedded API schema",
        "en": "2. Validate Embedded API schema"
      },
      "description": {
        "zh": "从目标系统实时 metadata 校验实体、字段、筛选和稳定键。",
        "en": "Validate entities, fields, filters, and stable keys against live target metadata."
      },
      "operations": {
        "zh": [
          "同名字段和静态目录不能替代实时 schema。"
        ],
        "en": [
          "Same-named fields and static catalogs do not replace live schema."
        ]
      },
      "tools": [
        {
          "name": "embedded-sap-odata",
          "kind": "SAP read Provider",
          "purpose": {
            "zh": "提供 GET-only schema 权威来源。",
            "en": "Provides the authoritative GET-only schema."
          }
        }
      ]
    },
    {
      "id": "read-api",
      "title": {
        "zh": "3. 分页读取标准 API",
        "en": "3. Read released APIs with paging"
      },
      "description": {
        "zh": "读取累计实际和全年财务计划行项目。",
        "en": "Read year-to-date actual and full-year financial planning entries."
      },
      "operations": {
        "zh": [
          "不使用显式 top 作为完整性证据。"
        ],
        "en": [
          "Do not use explicit top as completeness evidence."
        ]
      },
      "tools": [
        {
          "name": "Released SAP OData APIs",
          "kind": "SAP API",
          "purpose": {
            "zh": "提供首选业务证据。",
            "en": "Provides preferred business evidence."
          }
        }
      ]
    },
    {
      "id": "assess-gap",
      "title": {
        "zh": "4. 评估 API 能力缺口",
        "en": "4. Assess API capability gaps"
      },
      "description": {
        "zh": "仅实时 schema 的实体、字段或关系缺口可以触发 ADT。",
        "en": "Only live-schema entity, field, or relationship gaps can trigger ADT."
      },
      "operations": {
        "zh": [
          "超时、权限、截断和完整空结果不触发 ADT。"
        ],
        "en": [
          "Timeouts, authorization failures, truncation, and complete empty results do not trigger ADT."
        ]
      },
      "tools": [
        {
          "name": "assess_api_evidence",
          "kind": "Deterministic rule",
          "purpose": {
            "zh": "区分能力缺口和操作故障。",
            "en": "Separates capability gaps from operational failures."
          }
        }
      ]
    },
    {
      "id": "adt-fallback",
      "title": {
        "zh": "5. 条件调用 sap-adt-table-export",
        "en": "5. Conditionally call sap-adt-table-export"
      },
      "description": {
        "zh": "仅在 schema 缺口时读取 ACDOCA 或 ACDOCP。",
        "en": "Read ACDOCA or ACDOCP only for schema gaps."
      },
      "operations": {
        "zh": [
          "仅使用静态对象、白名单字段、有界过滤和升序稳定键。"
        ],
        "en": [
          "Use only static objects, allowlisted fields, bounded filters, and ascending stable keys."
        ]
      },
      "tools": [
        {
          "name": "sap-adt-table-export",
          "kind": "SAPSkillhub Skill",
          "purpose": {
            "zh": "提供受保护的表级补证。",
            "en": "Provides protected table-level supplemental evidence."
          }
        }
      ]
    },
    {
      "id": "merge-evidence",
      "title": {
        "zh": "6. 合并并验证证据",
        "en": "6. Merge and validate evidence"
      },
      "description": {
        "zh": "校验业务键、币种、单位、期间、分页和 SHA-256 manifest。",
        "en": "Validate business keys, currency, units, periods, paging, and the SHA-256 manifest."
      },
      "operations": {
        "zh": [
          "冲突不覆盖；达到行数上限保持 partial。"
        ],
        "en": [
          "Do not overwrite conflicts; retain partial at the row limit."
        ]
      },
      "tools": [
        {
          "name": "Evidence gate",
          "kind": "Control",
          "purpose": {
            "zh": "保护完整性语义。",
            "en": "Protects completeness semantics."
          }
        }
      ]
    },
    {
      "id": "analyze",
      "title": {
        "zh": "7. 执行确定性 CO 分析",
        "en": "7. Run deterministic CO analysis"
      },
      "description": {
        "zh": "以当前期间月均外推全年，并与全年计划比较。",
        "en": "Extrapolate the current-period monthly average to full year and compare it with plan."
      },
      "operations": {
        "zh": [
          "规则透明、可复现且不回写 SAP。"
        ],
        "en": [
          "Rules are transparent, reproducible, and never write to SAP."
        ]
      },
      "tools": [
        {
          "name": "Rolling forecast evaluator",
          "kind": "Rule engine",
          "purpose": {
            "zh": "生成确定性业务结论。",
            "en": "Produces deterministic business conclusions."
          }
        }
      ]
    },
    {
      "id": "present",
      "title": {
        "zh": "8. 输出结论和限制",
        "en": "8. Present conclusions and limits"
      },
      "description": {
        "zh": "输出状态、指标、证据范围、缺口和人工复核动作。",
        "en": "Present status, metrics, evidence scope, gaps, and human-review actions."
      },
      "operations": {
        "zh": [
          "必需证据不完整时输出 INCONCLUSIVE。"
        ],
        "en": [
          "Return INCONCLUSIVE when required evidence is incomplete."
        ]
      },
      "tools": [
        {
          "name": "Business report",
          "kind": "Output",
          "purpose": {
            "zh": "形成双语、可审计报告。",
            "en": "Creates a bilingual auditable report."
          }
        }
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "fiscal_year": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$"
        },
        "cost_center": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "current_period": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "planning_category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "risk_threshold_pct": {
          "type": "number",
          "default": 10
        }
      },
      "required": [
        "company_code",
        "cost_center",
        "fiscal_year",
        "current_period",
        "planning_category"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "business_status": {
          "type": "string"
        },
        "source_complete": {
          "type": "boolean"
        },
        "business_report": {
          "type": "object"
        }
      },
      "required": [
        "business_status",
        "source_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "business_status": "{{steps.evaluate.output.workflow_output.business_status}}",
      "source_complete": "{{steps.evaluate.output.workflow_output.source_complete}}",
      "business_report": "{{steps.evaluate.output.workflow_output.business_report}}"
    },
    "steps": [
      {
        "id": "read_actual",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "CompanyCode",
              "FiscalYear",
              "FiscalPeriod",
              "AccountingDocument",
              "AccountingDocumentItem",
              "ControllingArea",
              "CostCenter",
              "OrderID",
              "WBSElementInternalID",
              "Material",
              "Plant",
              "GLAccount",
              "PostingDate",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "FiscalYear",
                "operator": "eq",
                "value": "{{input.fiscal_year}}",
                "value_type": "string"
              },
              {
                "field": "CostCenter",
                "operator": "eq",
                "value": "{{input.cost_center}}",
                "value_type": "string"
              },
              {
                "field": "FiscalPeriod",
                "operator": "le",
                "value": "{{input.current_period}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read year-to-date actual cost."
          }
        }
      },
      {
        "id": "read_plan",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_FINPLANNINGENTRYITEM_SRV",
            "entity_set": "A_FinPlanningEntryItem",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "ID",
              "Ledger",
              "PlanningCategory",
              "LedgerFiscalYear",
              "FiscalPeriod",
              "CompanyCode",
              "CostCenter",
              "OrderID",
              "WBSElementExternalID",
              "Plant",
              "GLAccount",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "LedgerFiscalYear",
                "operator": "eq",
                "value": "{{input.fiscal_year}}",
                "value_type": "string"
              },
              {
                "field": "CostCenter",
                "operator": "eq",
                "value": "{{input.cost_center}}",
                "value_type": "string"
              },
              {
                "field": "PlanningCategory",
                "operator": "eq",
                "value": "{{input.planning_category}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read the full-year plan for the same cost center."
          }
        }
      },
      {
        "id": "assess",
        "executor": "rule",
        "operation": "assess_api_evidence",
        "inputMapping": {
          "checks": {
            "actual": "{{steps.read_actual.output}}",
            "plan": "{{steps.read_plan.output}}"
          }
        }
      },
      {
        "id": "adt_actual",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess.output.needs_adt.actual}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "ACDOCA",
          "fields": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN",
            "POPER",
            "KOSTL",
            "RACCT",
            "HSL",
            "RHCUR"
          ],
          "filters": [
            {
              "field": "RBUKRS",
              "operator": "eq",
              "value": "{{input.company_code}}"
            },
            {
              "field": "GJAHR",
              "operator": "eq",
              "value": "{{input.fiscal_year}}"
            },
            {
              "field": "KOSTL",
              "operator": "eq",
              "value": "{{input.cost_center}}"
            },
            {
              "field": "POPER",
              "operator": "bt",
              "low": "1",
              "high": "{{input.current_period}}"
            }
          ],
          "order_by": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN"
          ],
          "max_rows": 10000
        }
      },
      {
        "id": "adt_plan",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess.output.needs_adt.plan}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "ACDOCP",
          "fields": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN",
            "POPER",
            "KOSTL",
            "RACCT",
            "HSL",
            "RHCUR"
          ],
          "filters": [
            {
              "field": "RBUKRS",
              "operator": "eq",
              "value": "{{input.company_code}}"
            },
            {
              "field": "GJAHR",
              "operator": "eq",
              "value": "{{input.fiscal_year}}"
            },
            {
              "field": "KOSTL",
              "operator": "eq",
              "value": "{{input.cost_center}}"
            }
          ],
          "order_by": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN"
          ],
          "max_rows": 10000
        }
      },
      {
        "id": "evaluate",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "budget-rolling-forecast",
          "run_input": "{{input}}",
          "assessment": "{{steps.assess.output}}",
          "evidence": {
            "actual_items": "{{steps.read_actual.output}}",
            "plan_items": "{{steps.read_plan.output}}"
          },
          "fallbacks": {
            "actual": "{{steps.adt_actual.output}}",
            "plan": "{{steps.adt_plan.output}}"
          },
          "known_gaps": []
        }
      }
    ]
  },
  "validation": {
    "verdict": "PASS",
    "testedAt": "2026-08-17T11:41:06.839334+00:00",
    "evidenceScope": "complete",
    "providers": [
      "embedded-sap-odata",
      "sap-adt-table-export"
    ],
    "summary": {
      "zh": "真机查询源与必需证据完整。",
      "en": "Live query sources and required evidence are complete."
    },
    "reportPath": "docs/live-sap-test-report.md"
  }
}
