  "guardrails": {
    "zh": [
      "全部 SAP 访问严格只读",
      "Embedded OData 为唯一主 provider",
      "WBS 只通过已验证 resolver 解析；内部订单继续通过 AUFK 解析",
      "承诺只通过专用 Skill 读取，不再投影 COOI 金额字段",
      "ADT 仅读 Skill 只读取清单声明的 AUFK/BPJA 证据",
      "不启用自动 Provider 回退或 SE16N",
      "不完整证据不得生成确定结论"
    ],
    "en": [
      "All SAP access is strictly read-only",
      "Embedded OData is the sole primary provider",
      "WBS objects are resolved only by the validated resolver; internal orders remain AUFK-resolved",
      "Commitments are read only through the dedicated Skill; COOI amount projection is no longer used",
      "The read-only ADT Skill reads only manifest-declared AUFK/BPJA evidence",
      "Never use automatic Provider fallback or SE16N",
      "Incomplete evidence cannot produce a confirmed conclusion"
    ]
  },
