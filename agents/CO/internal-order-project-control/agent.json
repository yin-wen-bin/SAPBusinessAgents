  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          }
        },
        "fiscal_year": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$",
          "title": {
            "zh": "会计年度",
            "en": "Fiscal Year"
          }
        },
        "object_type": {
          "type": "string",
          "pattern": "^(INTERNAL_ORDER|WBS)$",
          "title": {
            "zh": "对象类型",
            "en": "Object Type"
          }
        },
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[0-9A-Za-z_./ -]+$",
          "title": {
            "zh": "对象编号",
            "en": "Object Id"
          }
        },
        "planning_category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "title": {
            "zh": "计划类别（可选）",
            "en": "Planning Category (optional)"
          }
        }
      },
      "required": [
        "object_type",
        "object_id",
        "company_code",
        "fiscal_year"
      ],
      "additionalProperties": false
    },
