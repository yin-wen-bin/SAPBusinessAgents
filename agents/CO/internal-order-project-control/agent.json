  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          }
        },
        "fiscal_year": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$",
          "title": {
            "zh": "fiscal year",
            "en": "Fiscal Year"
          }
        },
        "object_type": {
          "type": "string",
          "pattern": "^(INTERNAL_ORDER|WBS)$",
          "title": {
            "zh": "object type",
            "en": "Object Type"
          }
        },
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[0-9A-Za-z_.-]+$",
          "title": {
            "zh": "object id",
            "en": "Object Id"
          }
        },
        "planning_category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "title": {
            "zh": "planning category",
            "en": "Planning Category"
          }
        }
      },
      "required": [
        "object_type",
        "object_id",
        "company_code",
        "fiscal_year",
        "planning_category"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "business_status",
        "source_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "business_status": "{{steps.evaluate.output.workflow_output.business_status}}",
      "source_complete": "{{steps.evaluate.output.workflow_output.source_complete}}",
      "business_report": "{{steps.evaluate.output.workflow_output.business_report}}"
    },
    "steps": [
      {
        "id": "read_order_actual",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "CompanyCode",
              "FiscalYear",
              "FiscalPeriod",
              "AccountingDocument",
              "AccountingDocumentItem",
              "ControllingArea",
              "CostCenter",
              "OrderID",
              "WBSElementInternalID",
              "Material",
              "Plant",
              "GLAccount",
              "PostingDate",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "FiscalYear",
                "operator": "eq",
                "value": "{{input.fiscal_year}}",
                "value_type": "string"
              },
              {
                "field": "OrderID",
                "operator": "eq",
                "value": "{{input.object_id}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read internal-order actual cost."
          }
        }
      },
      {
        "id": "read_wbs_actual",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "CompanyCode",
              "FiscalYear",
              "FiscalPeriod",
              "AccountingDocument",
              "AccountingDocumentItem",
              "ControllingArea",
              "CostCenter",
              "OrderID",
              "WBSElementInternalID",
              "Material",
              "Plant",
              "GLAccount",
              "PostingDate",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "FiscalYear",
                "operator": "eq",
                "value": "{{input.fiscal_year}}",
                "value_type": "string"
              },
              {
                "field": "WBSElementInternalID",
                "operator": "eq",
                "value": "{{input.object_id}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read WBS actual cost when the identifier is internal."
          }
        }
      },
      {
        "id": "read_order_plan",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_FINPLANNINGENTRYITEM_SRV",
            "odata_version": "2.0",
            "entity_set": "A_FinPlanningEntryItem",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "ID",
              "Ledger",
              "PlanningCategory",
              "LedgerFiscalYear",
              "FiscalPeriod",
              "CompanyCode",
              "CostCenter",
              "OrderID",
              "WBSElementExternalID",
              "Plant",
              "GLAccount",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "LedgerFiscalYear",
                "operator": "eq",
                "value": "{{input.fiscal_year}}",
                "value_type": "string"
              },
              {
                "field": "PlanningCategory",
                "operator": "eq",
                "value": "{{input.planning_category}}",
                "value_type": "string"
              },
              {
                "field": "OrderID",
                "operator": "eq",
                "value": "{{input.object_id}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read internal-order plan cost."
          }
        }
      },
      {
        "id": "read_wbs_plan",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_FINPLANNINGENTRYITEM_SRV",
            "odata_version": "2.0",
            "entity_set": "A_FinPlanningEntryItem",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "ID",
              "Ledger",
              "PlanningCategory",
              "LedgerFiscalYear",
              "FiscalPeriod",
              "CompanyCode",
              "CostCenter",
              "OrderID",
              "WBSElementExternalID",
              "Plant",
              "GLAccount",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "LedgerFiscalYear",
                "operator": "eq",
                "value": "{{input.fiscal_year}}",
                "value_type": "string"
              },
              {
                "field": "PlanningCategory",
                "operator": "eq",
                "value": "{{input.planning_category}}",
                "value_type": "string"
              },
              {
                "field": "WBSElementExternalID",
                "operator": "eq",
                "value": "{{input.object_id}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read WBS plan cost when the identifier is external."
          }
        }
      },
      {
        "id": "assess",
        "executor": "rule",
        "operation": "assess_api_evidence",
        "inputMapping": {
          "checks": {
            "actual": {
              "order": "{{steps.read_order_actual.output}}",
              "wbs": "{{steps.read_wbs_actual.output}}"
            },
            "plan": {
              "order": "{{steps.read_order_plan.output}}",
              "wbs": "{{steps.read_wbs_plan.output}}"
            }
          },
          "capability_gaps": [
            "master",
            "budget",
