{
  "schemaVersion": 2,
  "slug": "product-cost-variance",
  "module": "CO",
  "title": {"zh": "生产订单成本差异分析助手", "en": "Production Order Cost Variance Analysis Assistant"},
  "summary": {
    "zh": "按生产订单、成本要素、期间、账本和币种比较计划、目标与实际成本；证据不完整时保持不确定。",
    "en": "Compares production-order plan, target, and actual costs by cost element, period, ledger, and currency and remains inconclusive when evidence is incomplete."
  },
  "status": "Three-stage live acceptance blocked",
  "version": "0.2.0",
  "owner": "CO-PC / Product Cost Controlling",
  "tags": ["Production Order", "Plan Cost", "Target Cost", "Actual Cost", "Cost Element"],
  "sapModules": ["CO-PC", "PP-SFC"],
  "transactions": [],
  "tables": ["AUFK", "ACDOCA", "I_MfgOrderActlPlanTgtLdgrCost"],
  "systems": ["SAP S/4HANA"],
  "inputs": {
    "zh": ["生产订单", "会计年度", "期间"],
    "en": ["Manufacturing order", "Fiscal year", "Period"]
  },
  "outputs": {
    "zh": ["生产订单", "公司代码", "控制范围", "物料", "工厂", "分析期间起始", "分析期间截止", "账本", "币种角色", "目标成本版本", "计划成本总额", "目标成本总额", "实际成本总额", "实际减目标差异", "实际减目标差异百分比", "成本状态", "成本要素明细", "订单与成本对象关系证据", "查询源完整性", "业务证据完整性", "业务状态", "结构化业务报告"],
    "en": ["Manufacturing order", "Company code", "Controlling area", "Material", "Plant", "Analysis period from", "Analysis period to", "Ledger", "Currency role", "Target cost variant", "Plan cost total", "Target cost total", "Actual cost total", "Actual minus target variance", "Actual minus target variance percent", "Cost status", "Cost element details", "Order-to-cost-object relationship evidence", "Query-source completeness", "Business evidence completeness", "Business status", "Structured business report"]
  },
  "guardrails": {
    "zh": ["全部SAP访问严格只读", "生产订单与成本对象关系必须由AUFK证明", "计划、目标和实际成本必须来自发布成本CDS或已对账的只读回退", "目标成本缺失不得当作零", "不同账本、币种或币种角色不得合计", "不得用物料标准单价乘数量伪造订单目标成本", "不得运行成本计算、差异计算、结算或重估"],
    "en": ["All SAP access is strictly read-only", "AUFK must prove the production-order-to-cost-object relationship", "Plan, target, and actual costs must come from the released cost CDS or a reconciled read-only fallback", "Missing target cost is never treated as zero", "Different ledgers, currencies, or currency roles are never combined", "Never fabricate order target cost from standard price multiplied by quantity", "Never run costing, variance calculation, settlement, or revaluation"]
  },
  "workflow": [
    {
      "id": "read-order",
      "title": {"zh": "读取生产订单", "en": "Read production order"},
      "description": {"zh": "读取订单公司代码、物料、工厂、成本变式和状态。", "en": "Read company code, material, plant, costing variants, and order status."},
      "operations": {"zh": ["GET API_PRODUCTION_ORDER_2_SRV/A_ProductionOrder_2"], "en": ["GET API_PRODUCTION_ORDER_2_SRV/A_ProductionOrder_2"]},
      "tools": [{"name": "Embedded SAP OData Provider", "kind": "GET-only SAP Provider", "purpose": {"zh": "读取订单主数据", "en": "Read order master evidence"}}],
      "executionStepIds": ["read_order"]
    },
    {
      "id": "read-actual-periods",
      "title": {"zh": "读取实际成本过账期间", "en": "Read actual-cost posting periods"},
      "description": {"zh": "读取订单实际成本行，用于确定存在实际过账的年度和期间。", "en": "Read actual order-cost rows to identify fiscal years and periods with postings."},
      "operations": {"zh": ["GET API_OPLACCTGDOCITEMCUBE_SRV/A_OperationalAcctgDocItemCube"], "en": ["GET API_OPLACCTGDOCITEMCUBE_SRV/A_OperationalAcctgDocItemCube"]},
      "tools": [
        {"name": "Embedded SAP OData Provider", "kind": "GET-only SAP Provider", "purpose": {"zh": "读取实际成本期间", "en": "Read actual cost periods"}}
      ],
      "executionStepIds": ["read_actual_periods"]
    },
    {
      "id": "resolve-period",
      "title": {"zh": "确定成本分析期间", "en": "Resolve cost analysis period"},
      "description": {"zh": "优先使用用户指定的年度和期间；未指定时按完整的实际成本过账期间确定范围。", "en": "Use the requested fiscal scope when supplied; otherwise derive it from complete actual-cost posting periods."},
      "operations": {"zh": ["rule.resolve_production_cost_scope"], "en": ["rule.resolve_production_cost_scope"]},
      "tools": [
        {"name": "resolve_production_cost_scope", "kind": "Local deterministic rule", "purpose": {"zh": "解析精确期间范围", "en": "Resolve the exact fiscal-period range"}}
      ],
      "executionStepIds": ["resolve_scope"]
    },
    {
      "id": "read-cost",
      "title": {"zh": "读取计划、目标与实际成本", "en": "Read plan, target, and actual costs"},
      "description": {"zh": "专用只读Skill验证AUFK关系并读取发布成本CDS。", "en": "A dedicated read-only Skill validates AUFK attribution and reads the released cost CDS."},
      "operations": {"zh": ["sap-production-order-cost-analysis.execute"], "en": ["sap-production-order-cost-analysis.execute"]},
      "tools": [{"name": "sap-production-order-cost-analysis", "kind": "Read-only SAPSkillhub Skill", "purpose": {"zh": "读取按成本要素的计划、目标和实际成本", "en": "Read plan, target, and actual costs by cost element"}}],
      "executionStepIds": ["read_production_cost"]
    },
    {
      "id": "evaluate-cost",
      "title": {"zh": "执行确定性成本差异规则", "en": "Run deterministic cost variance rules"},
      "description": {"zh": "按成本要素计算实际减目标差异，证据缺口优先返回不确定。", "en": "Calculate actual-minus-target variance by cost element and return inconclusive when evidence gaps remain."},
      "operations": {"zh": ["rule.evaluate_business_agent"], "en": ["rule.evaluate_business_agent"]},
      "tools": [{"name": "production_order_cost_variance_v2", "kind": "Local deterministic rule", "purpose": {"zh": "生成成本结论和业务报告", "en": "Produce the cost conclusion and business report"}}],
      "executionStepIds": ["evaluate"]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 900,
    "inputSchema": {
      "type": "object",
      "properties": {
        "manufacturing_order": {"type": "string", "minLength": 1, "maxLength": 12, "pattern": "^[0-9A-Za-z_-]+$", "x-sapba-sap-identifier": true, "title": {"zh": "生产订单", "en": "Manufacturing order"}},
        "fiscal_year": {"type": "string", "pattern": "^[0-9]{4}$", "title": {"zh": "会计年度", "en": "Fiscal year"}},
        "period": {"type": "integer", "minimum": 1, "maximum": 16, "title": {"zh": "期间", "en": "Period"}}
      },
      "required": ["manufacturing_order"],
      "dependentRequired": {"period": ["fiscal_year"]},
      "additionalProperties": false
    },
    "steps": [
      {
        "id": "read_order",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {"plan": {
          "service_name": "API_PRODUCTION_ORDER_2_SRV",
          "odata_version": "2.0",
          "entity_set": "A_ProductionOrder_2",
          "http_method": "GET",
          "plan_kind": "direct",
          "select_fields": ["ManufacturingOrder", "ManufacturingOrderType", "Material", "ProductionPlant", "CompanyCode", "ActualCostsCostingVariant", "PlannedCostsCostingVariant", "OrderIsReleased", "OrderIsDelivered", "OrderIsTechnicallyCompleted", "OrderIsClosed"],
          "filters": [{"field": "ManufacturingOrder", "operator": "eq", "value": "{{input.manufacturing_order}}", "value_type": "string"}],
          "rationale": "Read the exact production-order context without changing SAP."
        }}
      },
      {
        "id": "read_actual_periods",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {"plan": {
          "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
          "odata_version": "2.0",
          "entity_set": "A_OperationalAcctgDocItemCube",
          "http_method": "GET",
          "plan_kind": "direct",
          "select_fields": ["CompanyCode", "FiscalYear", "FiscalPeriod", "AccountingDocument", "AccountingDocumentItem", "ControllingArea", "OrderID", "GLAccount", "AmountInCompanyCodeCurrency", "CompanyCodeCurrency"],
          "filters": [{"field": "OrderID", "operator": "eq", "value": "{{input.manufacturing_order}}", "value_type": "string"}],
          "order_by": ["CompanyCode", "FiscalYear", "AccountingDocument", "AccountingDocumentItem"],
          "rationale": "Read exact-order actual cost postings and fiscal periods for scope derivation."
        }}
      },
      {
        "id": "resolve_scope",
        "executor": "rule",
        "operation": "resolve_production_cost_scope",
        "inputMapping": {"run_input": "{{input}}", "actual_cost": "{{steps.read_actual_periods.output}}"}
      },
      {
        "id": "read_production_cost",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-production-order-cost-analysis",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {"source": "{{steps.resolve_scope.output.scope_resolved}}", "equals": true},
        "inputMapping": {
          "schema_version": 1,
          "manufacturing_order": "{{input.manufacturing_order}}",
          "analysis_period_from": "{{steps.resolve_scope.output.analysis_period_from}}",
          "analysis_period_to": "{{steps.resolve_scope.output.analysis_period_to}}",
          "target_cost_variant": 1
        }
      },
      {
        "id": "evaluate",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "product-cost-variance",
          "run_input": "{{input}}",
          "scope": "{{steps.resolve_scope.output}}",
          "evidence": {"production_order": "{{steps.read_order.output}}", "actual_cost": "{{steps.read_actual_periods.output}}"},
          "fallbacks": {"production_cost": "{{steps.read_production_cost.output}}"},
          "known_gaps": []
        }
      }
    ],
    "outputSchema": {
      "type": "object",
      "properties": {
        "manufacturing_order": {"type": "string", "title": {"zh": "生产订单", "en": "Manufacturing order"}},
        "company_code": {"type": "string", "title": {"zh": "公司代码", "en": "Company code"}},
        "controlling_area": {"type": "string", "title": {"zh": "控制范围", "en": "Controlling area"}},
        "material": {"type": "string", "title": {"zh": "物料", "en": "Material"}},
        "plant": {"type": "string", "title": {"zh": "工厂", "en": "Plant"}},
        "analysis_period_from": {"type": "string", "title": {"zh": "分析期间起始", "en": "Analysis period from"}},
        "analysis_period_to": {"type": "string", "title": {"zh": "分析期间截止", "en": "Analysis period to"}},
        "ledger": {"type": "string", "title": {"zh": "账本", "en": "Ledger"}},
        "currency_role": {"type": "string", "title": {"zh": "币种角色", "en": "Currency role"}},
        "target_cost_variant": {"type": "integer", "title": {"zh": "目标成本版本", "en": "Target cost variant"}},
        "plan_cost_total": {"type": ["string", "null"], "title": {"zh": "计划成本总额", "en": "Plan cost total"}},
        "target_cost_total": {"type": ["string", "null"], "title": {"zh": "目标成本总额", "en": "Target cost total"}},
        "actual_cost_total": {"type": ["string", "null"], "title": {"zh": "实际成本总额", "en": "Actual cost total"}},
        "actual_target_variance": {"type": ["string", "null"], "title": {"zh": "实际减目标差异", "en": "Actual minus target variance"}},
        "actual_target_variance_percent": {"type": ["string", "null"], "title": {"zh": "实际减目标差异百分比", "en": "Actual minus target variance percent"}},
        "cost_status": {"type": "string", "title": {"zh": "成本状态", "en": "Cost status"}},
        "cost_element_details": {"type": "array", "items": {"type": "object"}, "title": {"zh": "成本要素明细", "en": "Cost element details"}},
        "relationship_evidence": {"type": "object", "title": {"zh": "订单与成本对象关系证据", "en": "Order-to-cost-object relationship evidence"}},
        "source_complete": {"type": "boolean", "title": {"zh": "查询源完整性", "en": "Query-source completeness"}},
        "evidence_complete": {"type": "boolean", "title": {"zh": "业务证据完整性", "en": "Business evidence completeness"}},
        "business_status": {"type": "string", "title": {"zh": "业务状态", "en": "Business status"}},
        "business_report": {"type": "object", "title": {"zh": "结构化业务报告", "en": "Structured business report"}}
      },
      "required": ["manufacturing_order", "company_code", "controlling_area", "material", "plant", "analysis_period_from", "analysis_period_to", "ledger", "currency_role", "target_cost_variant", "plan_cost_total", "target_cost_total", "actual_cost_total", "actual_target_variance", "actual_target_variance_percent", "cost_status", "cost_element_details", "relationship_evidence", "source_complete", "evidence_complete", "business_status", "business_report"],
      "additionalProperties": false
    },
    "outputMapping": {
      "manufacturing_order": "{{steps.evaluate.output.workflow_output.manufacturing_order}}",
      "company_code": "{{steps.evaluate.output.workflow_output.company_code}}",
      "controlling_area": "{{steps.evaluate.output.workflow_output.controlling_area}}",
      "material": "{{steps.evaluate.output.workflow_output.material}}",
      "plant": "{{steps.evaluate.output.workflow_output.plant}}",
      "analysis_period_from": "{{steps.evaluate.output.workflow_output.analysis_period_from}}",
      "analysis_period_to": "{{steps.evaluate.output.workflow_output.analysis_period_to}}",
      "ledger": "{{steps.evaluate.output.workflow_output.ledger}}",
      "currency_role": "{{steps.evaluate.output.workflow_output.currency_role}}",
      "target_cost_variant": "{{steps.evaluate.output.workflow_output.target_cost_variant}}",
      "plan_cost_total": "{{steps.evaluate.output.workflow_output.plan_cost_total}}",
      "target_cost_total": "{{steps.evaluate.output.workflow_output.target_cost_total}}",
      "actual_cost_total": "{{steps.evaluate.output.workflow_output.actual_cost_total}}",
      "actual_target_variance": "{{steps.evaluate.output.workflow_output.actual_target_variance}}",
      "actual_target_variance_percent": "{{steps.evaluate.output.workflow_output.actual_target_variance_percent}}",
      "cost_status": "{{steps.evaluate.output.workflow_output.cost_status}}",
      "cost_element_details": "{{steps.evaluate.output.workflow_output.cost_element_details}}",
      "relationship_evidence": "{{steps.evaluate.output.workflow_output.relationship_evidence}}",
      "source_complete": "{{steps.evaluate.output.workflow_output.source_complete}}",
      "evidence_complete": "{{steps.evaluate.output.workflow_output.evidence_complete}}",
      "business_status": "{{steps.evaluate.output.workflow_output.business_status}}",
      "business_report": "{{steps.evaluate.output.workflow_output.business_report}}"
    },
    "acceptance": {
      "schemaVersion": "2.0",
      "comparisonMode": "business_semantic",
      "businessKeys": ["manufacturing_order", "cost_element"],
      "facts": ["company_code", "controlling_area", "ledger", "currency_role", "currency", "cost_status", "business_status"],
      "metrics": ["plan_cost_total", "target_cost_total", "actual_cost_total", "actual_target_variance"],
      "decimalFields": ["plan_cost", "target_cost", "actual_cost", "actual_target_variance"],
      "decimalMetricIds": ["plan_cost_total", "target_cost_total", "actual_cost_total", "actual_target_variance"],
      "currencyFields": ["currency"],
      "unitFields": [],
      "dateFields": [],
      "codeSetFields": [],
      "zeroPadFields": {},
      "booleanFields": [],
      "inputDefaults": {"manufacturing_order": "manufacturing_order"},
      "constantDefaults": {"ledger": "0L", "currency_role": "10"},
      "fieldAliases": {},
      "fieldExtractors": {},
      "currencyFromDecimal": {},
      "valueMappings": {},
      "limitationKeywords": {
        "source_incomplete": ["source incomplete", "paging incomplete", "范围限制", "分页未完成"],
        "capability_gap": ["capability gap", "inconclusive", "能力缺口", "无法确认"],
        "production_cost_evidence": ["production_cost_evidence", "plan target actual cost", "计划目标实际成本"],
        "production_cost_relationship": ["production_cost_relationship", "aufk", "成本对象关系"]
      },
      "summaryRecord": false,
      "currencyAndUnitPolicy": "compare_only_when_same_or_conversion_validated",
      "requiredLimitations": ["production_cost_evidence", "production_cost_relationship"],
      "businessStatusFromMetric": {},
      "limitationsFromMetrics": {},
      "blankValueKeywords": {},
      "blockingLimitations": ["production_cost_evidence", "production_cost_relationship"],
      "ignoredNoticeKeywords": [],
      "zeroFactWhenMetricZero": {},
      "recordScope": "one_record_per_manufacturing_order_cost_element_ledger_currency_period_scope",
      "factDefinitions": {"cost_status": "normal within absolute 0.01; positive actual-minus-target is unfavorable, negative is favorable; target zero with actual cost is unplanned_cost; target with zero actual is planned_cost_not_consumed"},
      "metricDefinitions": {
        "plan_cost_total": "Released production-order cost CDS plan cost summed only within one ledger, currency role, and currency",
        "target_cost_total": "TargetCostVariant 1 target cost summed only within one comparable scope",
        "actual_cost_total": "Released production-order cost CDS actual cost summed only within one comparable scope",
        "actual_target_variance": "actual_cost_total minus target_cost_total"
      },
      "businessStatusDefinition": "normal only with complete comparable evidence and absolute actual-minus-target variance at most 0.01; attention for a complete confirmed variance; inconclusive whenever relationship, period, plan, target, actual, ledger, currency, or paging evidence is incomplete",
      "businessStatusFromAnyPositiveMetric": {}
    }
  },
  "validation": {
    "verdict": "BLOCKED",
    "testedAt": "2026-08-25T23:18:00+08:00",
    "evidenceScope": "complete",
    "providers": ["codex-app-direct-sap", "embedded-sap-odata", "sap-production-order-cost-analysis"],
    "summary": {
      "zh": "直接ADT、独立Skill和固定Agent已对账一致并形成完整成本证据；自由查询的Skill调用被Harness单次gap token门禁拒绝，因此仍保持BLOCKED。",
      "en": "Direct ADT, the standalone Skill, and the fixed Agent reconcile with complete cost evidence; the free-query Skill call was rejected by the Harness single-use gap-token gate, so the Agent remains BLOCKED."
    },
    "reportPath": "docs/three-stage-live-acceptance.md",
    "executable": false,
    "freeQueryComparison": "BLOCKED",
    "fixedAgentComparison": "MATCH",
    "baselineRuntime": "codex_app_direct_sap",
    "usedSapBusinessAgentsForBaseline": false,
    "blockingLimitations": ["free_query_skill_execution"]
  }
}
