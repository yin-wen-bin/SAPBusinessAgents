        "en": "Run manifest step `read_order` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_PRODUCTION_ORDER_2_SRV@2.0/A_ProductionOrder_2"
        ],
        "en": [
          "GET API_PRODUCTION_ORDER_2_SRV@2.0/A_ProductionOrder_2"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
