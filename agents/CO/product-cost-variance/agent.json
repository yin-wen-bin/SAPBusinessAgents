{
  "schemaVersion": 2,
  "slug": "product-cost-variance",
  "module": "CO",
  "title": {
    "zh": "产品成本差异助手",
    "en": "Product Cost Variance Assistant"
  },
  "summary": {
    "zh": "结合生产订单实际发生额与物料分类账标准/周期价格分析成本差异。",
    "en": "Combines production-order actual postings with Material Ledger standard and periodic prices to analyze cost variance."
  },
  "status": "Three-stage live acceptance blocked",
  "version": "0.1.0",
  "owner": "CO-PC / Product Cost Controlling",
  "tags": [
    "Product Cost",
    "Material Ledger",
    "Variance",
    "Production Order"
  ],
  "sapModules": [
    "CO-PC",
    "PP-SFC"
  ],
  "transactions": [],
  "tables": [
    "AUFK",
    "ACDOCA",
    "CKMLHD",
    "CKMLCR"
  ],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "公司代码",
      "fiscal year",
      "period",
      "manufacturing order",
      "物料",
      "valuation area"
    ],
    "en": [
      "Company code",
      "Fiscal Year",
      "Period",
      "Manufacturing Order",
      "Material",
      "Valuation Area"
    ]
  },
  "outputs": {
    "zh": [
      "业务状态",
      "查询源完整性",
      "结构化业务报告"
    ],
    "en": [
      "Business status",
      "Query-source completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "全部 SAP 访问严格只读",
      "Embedded OData 为唯一主 provider",
      "仅 schema 能力缺口触发 ADT",
      "不启用自动 Provider 回退或 SE16N",
      "不完整证据不得生成确定结论"
    ],
    "en": [
      "All SAP access is strictly read-only",
      "Embedded OData is the sole primary provider",
      "Only schema capability gaps trigger ADT",
      "Never use automatic Provider fallback or SE16N",
      "Incomplete evidence cannot produce a confirmed conclusion"
    ]
  },
  "workflow": [
    {
