      },
      "description": {
        "zh": "执行清单步骤 `evaluate`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate` / `evaluate_business_agent`",
            "en": "Execute `evaluate` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          }
        },
        "fiscal_year": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$",
          "title": {
            "zh": "fiscal year",
            "en": "Fiscal Year"
          }
        },
        "period": {
          "type": "string",
          "pattern": "^[0-9]{1,3}$",
          "title": {
            "zh": "period",
            "en": "Period"
          }
        },
        "manufacturing_order": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "manufacturing order",
            "en": "Manufacturing Order"
          }
        },
        "material": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "物料",
            "en": "Material"
          }
        },
        "valuation_area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "valuation area",
            "en": "Valuation Area"
          }
        }
      },
      "required": [
        "company_code",
        "fiscal_year",
        "period",
        "manufacturing_order",
        "material",
        "valuation_area"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "business_status",
        "source_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "business_status": "{{steps.evaluate.output.workflow_output.business_status}}",
      "source_complete": "{{steps.evaluate.output.workflow_output.source_complete}}",
      "business_report": "{{steps.evaluate.output.workflow_output.business_report}}"
    },
    "steps": [
      {
        "id": "read_order",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_PRODUCTION_ORDER_2_SRV",
            "odata_version": "2.0",
            "entity_set": "A_ProductionOrder_2",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "ManufacturingOrder",
              "ManufacturingOrderType",
              "Material",
              "ProductionPlant",
              "CompanyCode",
              "OrderIsReleased",
              "OrderIsDelivered",
              "OrderIsTechnicallyCompleted",
              "OrderIsClosed",
              "SettlementRuleIsCreated",
              "MfgOrderConfirmedYieldQty"
            ],
            "filters": [
              {
                "field": "ManufacturingOrder",
                "operator": "eq",
                "value": "{{input.manufacturing_order}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read one production order and settlement status."
          }
        }
      },
      {
        "id": "read_actual",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "CompanyCode",
              "FiscalYear",
              "FiscalPeriod",
              "AccountingDocument",
              "AccountingDocumentItem",
              "ControllingArea",
              "CostCenter",
              "OrderID",
              "WBSElementInternalID",
              "Material",
              "Plant",
              "GLAccount",
              "PostingDate",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "FiscalYear",
                "operator": "eq",
                "value": "{{input.fiscal_year}}",
                "value_type": "string"
              },
              {
                "field": "FiscalPeriod",
                "operator": "eq",
                "value": "{{input.period}}",
                "value_type": "string"
              },
              {
                "field": "OrderID",
                "operator": "eq",
                "value": "{{input.manufacturing_order}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read actual order-cost postings."
          }
        }
      },
      {
        "id": "assess",
        "executor": "rule",
        "operation": "assess_api_evidence",
        "inputMapping": {
          "checks": {
            "order": "{{steps.read_order.output}}",
            "actual_cost": "{{steps.read_actual.output}}"
          },
          "capability_gaps": [
            "standard_cost"
          ]
        }
      },
      {
        "id": "adt_order",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess.output.needs_adt.order}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "AUFK",
          "fields": [
            "AUFNR",
            "OBJNR",
            "KOKRS",
            "BUKRS",
            "LOEKZ",
            "PHAS3"
          ],
          "filters": [
            {
              "field": "AUFNR",
              "operator": "eq",
              "value": "{{input.manufacturing_order}}"
            }
          ],
          "order_by": [
            "AUFNR"
          ],
          "max_rows": 10
        }
      },
      {
        "id": "adt_actual",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess.output.needs_adt.actual_cost}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "ACDOCA",
          "fields": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN",
            "POPER",
            "AUFNR",
            "RACCT",
            "HSL",
            "RHCUR"
          ],
          "filters": [
            {
              "field": "RBUKRS",
              "operator": "eq",
              "value": "{{input.company_code}}"
            },
            {
              "field": "GJAHR",
              "operator": "eq",
              "value": "{{input.fiscal_year}}"
            },
            {
              "field": "POPER",
              "operator": "eq",
              "value": "{{input.period}}"
            },
            {
              "field": "AUFNR",
              "operator": "eq",
              "value": "{{input.manufacturing_order}}"
            }
          ],
          "order_by": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN"
          ],
          "max_rows": 10000
        }
      },
      {
        "id": "adt_cost_header",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess.output.needs_adt.standard_cost}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "CKMLHD",
          "fields": [
            "KALNR",
            "MATNR",
            "BWKEY",
            "BWTAR"
          ],
          "filters": [
            {
              "field": "MATNR",
              "operator": "eq",
              "value": "{{input.material}}"
            },
            {
              "field": "BWKEY",
              "operator": "eq",
              "value": "{{input.valuation_area}}"
            }
          ],
          "order_by": [
            "KALNR"
          ],
          "max_rows": 100
        }
      },
      {
        "id": "cost_numbers",
        "executor": "rule",
        "operation": "extract_bounded_values",
        "inputMapping": {
          "payload": "{{steps.adt_cost_header.output}}",
          "field": "KALNR",
          "max_values": 100
        }
      },
      {
        "id": "adt_cost_period",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.cost_numbers.output.has_values}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "CKMLCR",
          "fields": [
            "KALNR",
            "BDATJ",
            "POPER",
            "UNTPER",
            "CURTP",
            "PVPRS",
            "STPRS"
          ],
          "filters": [
            {
              "field": "KALNR",
              "operator": "in",
              "values": "{{steps.cost_numbers.output.values}}"
            },
            {
              "field": "BDATJ",
              "operator": "eq",
              "value": "{{input.fiscal_year}}"
            },
            {
              "field": "POPER",
              "operator": "eq",
              "value": "{{input.period}}"
            }
          ],
          "order_by": [
            "KALNR",
            "BDATJ",
            "POPER",
            "UNTPER",
            "CURTP"
          ],
          "max_rows": 1000
        }
      },
      {
        "id": "evaluate",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "product-cost-variance",
          "run_input": "{{input}}",
          "assessment": "{{steps.assess.output}}",
          "evidence": {
            "production_orders": "{{steps.read_order.output}}",
            "actual_cost_items": "{{steps.read_actual.output}}"
          },
          "fallbacks": {
            "order": "{{steps.adt_order.output}}",
            "actual_cost": "{{steps.adt_actual.output}}",
            "standard_cost": {
              "header": "{{steps.adt_cost_header.output}}",
              "period": "{{steps.adt_cost_period.output}}"
            }
          },
          "known_gaps": []
        }
      }
    ],
    "acceptance": {
      "schemaVersion": "2.0",
      "comparisonMode": "business_semantic",
      "businessKeys": [
        "company_code",
        "manufacturing_order",
        "material",
        "fiscal_year",
        "period"
      ],
      "facts": [
        "business_status"
      ],
      "metrics": [
        "order_actual_amount",
        "standard_unit_price",
        "periodic_unit_price",
        "unit_price_variance"
      ],
      "decimalFields": [],
      "decimalMetricIds": [
        "order_actual_amount",
        "standard_unit_price",
        "periodic_unit_price",
        "unit_price_variance"
      ],
      "currencyFields": [],
      "unitFields": [],
      "dateFields": [],
      "codeSetFields": [],
      "zeroPadFields": {},
      "booleanFields": [],
      "inputDefaults": {
        "company_code": "company_code",
