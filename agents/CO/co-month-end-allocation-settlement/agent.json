  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 600,
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "公司代码",
            "en": "Company code"
          }
        },
        "fiscal_year": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$",
          "title": {
            "zh": "会计年度",
            "en": "Fiscal Year"
          }
        },
        "controlling_area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "title": {
            "zh": "控制范围",
            "en": "Controlling Area"
          }
        },
        "period": {
          "type": "string",
          "pattern": "^[0-9]{1,3}$",
          "title": {
            "zh": "会计期间",
            "en": "Period"
          }
        },
        "internal_order": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "内部订单",
            "en": "Internal Order"
          }
        },
        "allocation_cycle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9A-Za-z_-]+$",
          "title": {
            "zh": "分配循环",
            "en": "Allocation Cycle"
          }
        }
      },
      "required": [
        "controlling_area",
        "company_code",
        "fiscal_year",
        "period",
        "internal_order",
        "allocation_cycle"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "business_status",
        "source_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "business_status": "{{steps.evaluate.output.workflow_output.business_status}}",
      "source_complete": "{{steps.evaluate.output.workflow_output.source_complete}}",
      "business_report": "{{steps.evaluate.output.workflow_output.business_report}}"
    },
    "steps": [
      {
        "id": "read_posting",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OperationalAcctgDocItemCube",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "CompanyCode",
              "FiscalYear",
              "FiscalPeriod",
              "AccountingDocument",
              "AccountingDocumentItem",
              "ControllingArea",
              "CostCenter",
              "OrderID",
              "WBSElementInternalID",
              "Material",
              "Plant",
              "GLAccount",
              "PostingDate",
              "AmountInCompanyCodeCurrency",
              "CompanyCodeCurrency"
            ],
            "filters": [
              {
                "field": "CompanyCode",
                "operator": "eq",
                "value": "{{input.company_code}}",
                "value_type": "string"
              },
              {
                "field": "FiscalYear",
                "operator": "eq",
                "value": "{{input.fiscal_year}}",
                "value_type": "string"
              },
              {
                "field": "FiscalPeriod",
                "operator": "eq",
                "value": "{{input.period}}",
                "value_type": "string"
              },
              {
                "field": "OrderID",
                "operator": "eq",
                "value": "{{input.internal_order}}",
                "value_type": "string"
              }
            ],
            "rationale": "Read period postings for one CO object."
          }
        }
      },
      {
        "id": "assess",
        "executor": "rule",
        "operation": "assess_api_evidence",
        "inputMapping": {
          "checks": {
            "posting": "{{steps.read_posting.output}}"
          },
          "capability_gaps": [
            "allocation_cycle",
            "settlement_rule",
            "object_status"
          ]
        }
      },
      {
        "id": "adt_posting",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess.output.needs_adt.posting}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "ACDOCA",
          "fields": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN",
            "POPER",
            "AUFNR",
            "RACCT",
            "HSL",
            "RHCUR"
          ],
          "filters": [
            {
              "field": "RBUKRS",
              "operator": "eq",
              "value": "{{input.company_code}}"
            },
            {
              "field": "GJAHR",
              "operator": "eq",
              "value": "{{input.fiscal_year}}"
            },
            {
              "field": "POPER",
              "operator": "eq",
              "value": "{{input.period}}"
            },
            {
              "field": "AUFNR",
              "operator": "eq",
              "value": "{{input.internal_order}}"
            }
          ],
          "order_by": [
            "RLDNR",
            "RBUKRS",
            "GJAHR",
            "BELNR",
            "DOCLN"
          ],
          "max_rows": 10000
        }
      },
      {
        "id": "adt_cycle",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess.output.needs_adt.allocation_cycle}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "T811C",
          "fields": [
            "KOKRS",
            "CYCLE",
            "SDATE"
          ],
          "filters": [
            {
              "field": "KOKRS",
              "operator": "eq",
              "value": "{{input.controlling_area}}"
            },
            {
              "field": "CYCLE",
              "operator": "eq",
              "value": "{{input.allocation_cycle}}"
            }
          ],
          "order_by": [
            "KOKRS",
            "CYCLE",
            "SDATE"
          ],
          "max_rows": 100
        }
      },
      {
        "id": "adt_object",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess.output.needs_adt.object_status}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "AUFK",
          "fields": [
            "AUFNR",
            "OBJNR",
            "KOKRS",
            "BUKRS",
            "LOEKZ",
            "PHAS0",
            "PHAS1",
            "PHAS2",
            "PHAS3"
          ],
          "filters": [
            {
              "field": "AUFNR",
              "operator": "eq",
              "value": "{{input.internal_order}}"
            }
          ],
          "order_by": [
            "AUFNR"
          ],
          "max_rows": 10
        }
      },
      {
        "id": "object_numbers",
        "executor": "rule",
        "operation": "extract_bounded_values",
        "inputMapping": {
          "payload": "{{steps.adt_object.output}}",
          "field": "OBJNR",
          "max_values": 10
        }
      },
      {
        "id": "adt_settlement",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.object_numbers.output.has_values}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "COBRA",
          "fields": [
            "OBJNR",
            "GABJA",
            "GABPE",
            "GBISP",
            "LETJA",
            "LETPE"
          ],
          "filters": [
            {
              "field": "OBJNR",
              "operator": "in",
              "values": "{{steps.object_numbers.output.values}}"
            }
          ],
          "order_by": [
            "OBJNR"
          ],
          "max_rows": 100
        }
      },
      {
        "id": "evaluate",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "co-month-end-allocation-settlement",
          "run_input": "{{input}}",
          "assessment": "{{steps.assess.output}}",
          "evidence": {
            "actual_items": "{{steps.read_posting.output}}"
          },
          "fallbacks": {
            "posting": "{{steps.adt_posting.output}}",
            "allocation_cycle": "{{steps.adt_cycle.output}}",
            "object_status": "{{steps.adt_object.output}}",
            "settlement_rule": "{{steps.adt_settlement.output}}"
          },
          "known_gaps": []
        }
      }
    ],
