      "properties": {
        "plant": {
          "type": "string",
          "title": {
            "zh": "MRP 工厂",
            "en": "MRP plant"
          },
          "description": {
            "zh": "请输入MRP 工厂。",
            "en": "Enter the mrp plant."
          },
          "placeholder": {
            "zh": "例如：1010",
            "en": "Example: 1010"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "mrp_area": {
          "type": "string",
          "title": {
            "zh": "MRP 范围",
            "en": "MRP area"
          },
          "description": {
            "zh": "请输入MRP 范围。",
            "en": "Enter the mrp area."
          },
          "placeholder": {
            "zh": "例如：1010",
            "en": "Example: 1010"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "material": {
          "type": "string",
          "title": {
            "zh": "物料",
            "en": "Material"
          },
          "description": {
            "zh": "请输入物料。",
            "en": "Enter the material."
          },
          "placeholder": {
            "zh": "例如：SG21",
            "en": "Example: SG21"
          },
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "shortage_profile": {
          "type": "string",
          "title": {
            "zh": "短缺参数文件",
            "en": "Shortage profile"
          },
          "description": {
            "zh": "请输入短缺参数文件。",
            "en": "Enter the shortage profile."
          },
          "placeholder": {
            "zh": "例如：SAP000000001",
            "en": "Example: SAP000000001"
          },
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "shortage_counter": {
          "type": "string",
          "title": {
            "zh": "短缺计数器",
            "en": "Shortage profile counter"
