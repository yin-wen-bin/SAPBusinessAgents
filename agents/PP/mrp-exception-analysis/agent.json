{
  "schemaVersion": 2,
  "slug": "mrp-exception-analysis",
  "module": "PP",
  "title": {
    "zh": "MRP 异常分析助手",
    "en": "MRP Exception Analysis Assistant"
  },
  "summary": {
    "zh": "分析物料覆盖、供需项目和 MRP 异常消息，解释缺料与重排原因并给出处理优先级。",
    "en": "Analyzes material coverage, supply-demand items and MRP exception messages to explain shortages, rescheduling needs and priorities."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.2.0",
  "owner": "PP-MRP / Material Planning",
  "tags": [
    "MRP",
    "Shortage",
    "Exception",
    "Rescheduling"
  ],
  "sapModules": [
    "PP-MRP",
    "MM-IM"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "MRP 工厂",
      "MRP 范围",
      "物料",
      "短缺参数文件",
      "短缺计数器"
    ],
    "en": [
      "MRP plant",
      "MRP area",
      "Material",
      "Shortage profile",
      "Shortage profile counter"
    ]
  },
  "outputs": {
    "zh": [
      "MRP 工厂",
      "MRP 范围",
      "物料",
      "短缺参数文件",
      "短缺计数器",
      "分析日期",
      "短缺状态",
      "短缺数量",
      "短缺开始日期",
      "短缺结束日期",
      "库存覆盖天数",
      "SAPBusinessAgents 业务处理优先级",
      "重排状态",
      "受影响 MRP 元素数",
      "异常消息数",
      "业务证据完整性",
      "MRP 异常明细",
      "业务状态",
      "查询源完整性",
      "结构化业务报告"
    ],
    "en": [
      "MRP plant",
      "MRP area",
      "Material",
      "Shortage profile",
      "Shortage profile counter",
      "Analysis date",
      "Shortage status",
      "Shortage quantity",
      "Shortage start date",
      "Shortage end date",
      "Days of supply",
      "SAPBusinessAgents business priority",
      "Rescheduling status",
      "Affected MRP elements",
      "Exception messages",
      "Business-evidence completeness",
      "MRP exception details",
      "Business status",
      "Query-source completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "必须显式提供短缺参数文件和计数器",
      "空结果与超时不得解释为无短缺",
      "只建议处理动作，不运行 MRP 或修改凭证",
      "分页或关键字段不完整时返回 INCONCLUSIVE"
    ],
    "en": [
      "Require an explicit shortage profile and counter",
      "Never interpret empty or timed-out results as no shortage",
      "Recommend actions only; do not run MRP or change documents",
      "Return INCONCLUSIVE for incomplete pages or key fields"
    ]
  },
  "workflow": [
    {
      "id": "execute-resolve_analysis_context",
      "title": {
        "zh": "确定分析日期",
        "en": "Resolve analysis date"
      },
      "description": {
        "zh": "在读取 SAP 前固定本次运行的本地业务日期。",
        "en": "Capture the run's local business date before reading SAP."
      },
      "operations": {
        "zh": [
          "rule.resolve_mrp_analysis_context"
        ],
        "en": [
          "rule.resolve_mrp_analysis_context"
        ]
      },
      "tools": [
        {
          "name": "resolve_mrp_analysis_context",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "固定分析日期",
            "en": "Capture the analysis date"
          }
        }
      ],
      "executionStepIds": [
        "resolve_analysis_context"
      ]
    },
    {
      "id": "execute-collect_mrp_master",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_mrp_master`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_mrp_master` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_MRP_MATERIALS_SRV_01@2.0/A_MRPMaterial"
        ],
        "en": [
          "GET API_MRP_MATERIALS_SRV_01@2.0/A_MRPMaterial"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_mrp_master` / `execute_plan`",
            "en": "Execute `collect_mrp_master` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_mrp_master"
      ]
    },
    {
      "id": "execute-collect_mrp_coverage",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_mrp_coverage`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_mrp_coverage` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_MRP_MATERIALS_SRV_01@2.0/MaterialCoverages"
        ],
        "en": [
          "GET API_MRP_MATERIALS_SRV_01@2.0/MaterialCoverages"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_mrp_coverage` / `execute_plan`",
            "en": "Execute `collect_mrp_coverage` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_mrp_coverage"
      ]
    },
    {
      "id": "execute-collect_mrp_elements",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_mrp_elements`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_mrp_elements` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_MRP_MATERIALS_SRV_01@2.0/SupplyDemandItems"
        ],
        "en": [
          "GET API_MRP_MATERIALS_SRV_01@2.0/SupplyDemandItems"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_mrp_elements` / `execute_plan`",
            "en": "Execute `collect_mrp_elements` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_mrp_elements"
      ]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate_business_result`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate_business_result` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "plant": {
          "type": "string",
          "title": {
            "zh": "MRP 工厂",
            "en": "MRP plant"
          },
          "description": {
            "zh": "请输入MRP 工厂。",
            "en": "Enter the mrp plant."
          },
          "placeholder": {
            "zh": "例如：1010",
            "en": "Example: 1010"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "mrp_area": {
          "type": "string",
          "title": {
            "zh": "MRP 范围",
            "en": "MRP area"
          },
          "description": {
            "zh": "请输入MRP 范围。",
            "en": "Enter the mrp area."
          },
          "placeholder": {
            "zh": "例如：1010",
            "en": "Example: 1010"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "material": {
          "type": "string",
          "title": {
            "zh": "物料",
            "en": "Material"
          },
          "description": {
            "zh": "请输入物料。",
            "en": "Enter the material."
          },
          "placeholder": {
            "zh": "例如：SG21",
            "en": "Example: SG21"
          },
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "shortage_profile": {
          "type": "string",
          "title": {
            "zh": "短缺参数文件",
            "en": "Shortage profile"
          },
          "description": {
            "zh": "请输入短缺参数文件。",
            "en": "Enter the shortage profile."
          },
          "placeholder": {
            "zh": "例如：SAP000000001",
            "en": "Example: SAP000000001"
          },
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "shortage_counter": {
          "type": "string",
          "title": {
            "zh": "短缺计数器",
            "en": "Shortage profile counter"
          },
          "description": {
            "zh": "请输入短缺计数器。",
            "en": "Enter the shortage profile counter."
          },
          "placeholder": {
            "zh": "例如：001",
            "en": "Example: 001"
          },
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "plant",
        "mrp_area",
        "material",
        "shortage_profile",
        "shortage_counter"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "id": "resolve_analysis_context",
        "executor": "rule",
        "operation": "resolve_mrp_analysis_context",
        "inputMapping": {
          "run_input": "{{input}}"
        }
      },
      {
        "id": "collect_mrp_master",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_MRP_MATERIALS_SRV_01",
            "odata_version": "2.0",
            "entity_set": "A_MRPMaterial",
            "http_method": "GET",
            "plan_kind": "direct",
            "step_id": "mrp_material",
            "select_fields": [
              "Material",
              "MRPArea",
              "MRPPlant",
              "MRPController",
              "MRPType",
              "MaterialProcurementCategory",
              "PlanningTimeFenceInDays",
              "SafetyStockQuantity",
              "MaterialPlannedDeliveryDurn",
              "MaterialPlannedProductionDurn",
              "TotalReplenishmentLeadDuration",
              "BaseUnit"
            ],
            "filters": [
              {
                "field": "Material",
                "operator": "eq",
                "value": "{{input.material}}",
                "value_type": "string"
              },
              {
                "field": "MRPArea",
                "operator": "eq",
                "value": "{{input.mrp_area}}",
                "value_type": "string"
              },
              {
                "field": "MRPPlant",
                "operator": "eq",
                "value": "{{input.plant}}",
                "value_type": "string"
              }
            ],
            "rationale": "Collect MRP master evidence."
          }
        }
      },
      {
        "id": "collect_mrp_coverage",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_MRP_MATERIALS_SRV_01",
            "odata_version": "2.0",
            "entity_set": "MaterialCoverages",
            "http_method": "GET",
            "plan_kind": "direct",
            "step_id": "material_coverages",
            "select_fields": [
              "Material",
              "MaterialShortageProfile",
              "MaterialShortageProfileCount",
              "MRPArea",
              "MRPPlant",
              "MRPPlanningSegmentNumber",
              "MRPPlanningSegmentType",
              "MaterialShortageDuration",
              "MaterialShortageDurnInWorkdays",
              "DaysOfSupplyDuration",
              "MaterialShortageQuantity",
              "MaterialShortageStartDate",
              "MaterialShortageEndDate",
              "MaterialReplnmtLeadDurnEndDate",
              "TimeHorizonInDays",
              "HasAcceptedShortage",
              "MaterialBaseUnit"
            ],
            "filters": [
              {
                "field": "Material",
                "operator": "eq",
                "value": "{{input.material}}",
                "value_type": "string"
              },
              {
                "field": "MRPArea",
                "operator": "eq",
                "value": "{{input.mrp_area}}",
                "value_type": "string"
              },
              {
                "field": "MRPPlant",
                "operator": "eq",
                "value": "{{input.plant}}",
                "value_type": "string"
              },
              {
                "field": "MaterialShortageProfile",
                "operator": "eq",
                "value": "{{input.shortage_profile}}",
                "value_type": "string"
              },
              {
                "field": "MaterialShortageProfileCount",
                "operator": "eq",
                "value": "{{input.shortage_counter}}",
                "value_type": "string"
              }
            ],
            "rationale": "Collect MRP coverage evidence."
          }
        },
        "failurePolicy": "record_gap"
      },
      {
        "id": "collect_mrp_elements",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_MRP_MATERIALS_SRV_01",
            "odata_version": "2.0",
            "entity_set": "SupplyDemandItems",
            "http_method": "GET",
            "plan_kind": "direct",
            "step_id": "supply_demand_items",
            "select_fields": [
              "Material",
              "MRPArea",
              "MRPPlant",
              "MaterialShortageProfile",
              "MaterialShortageProfileCount",
              "MRPElement",
              "MRPElementItem",
              "MRPElementScheduleLine",
              "MRPElementCategory",
              "MRPElementCategoryName",
              "MRPElementCategoryShortName",
              "MRPElementDocumentType",
              "MRPElementDocumentTypeName",
              "MRPElementAvailyOrRqmtDate",
              "MRPElementReschedulingDate",
              "MRPElementOpenQuantity",
              "MRPElementQuantityIsFirm",
              "MRPElementIsReleased",
              "MRPAvailableQuantity",
              "MaterialBaseUnit",
              "ExceptionMessageNumber",
              "ExceptionMessageText",
              "ExceptionMessageNumber2",
              "ExceptionMessageText2"
            ],
            "filters": [
              {
                "field": "Material",
                "operator": "eq",
                "value": "{{input.material}}",
                "value_type": "string"
              },
              {
                "field": "MRPArea",
                "operator": "eq",
                "value": "{{input.mrp_area}}",
                "value_type": "string"
              },
              {
                "field": "MRPPlant",
                "operator": "eq",
                "value": "{{input.plant}}",
                "value_type": "string"
              },
              {
                "field": "MaterialShortageProfile",
                "operator": "eq",
                "value": "{{input.shortage_profile}}",
                "value_type": "string"
              },
              {
                "field": "MaterialShortageProfileCount",
                "operator": "eq",
                "value": "{{input.shortage_counter}}",
                "value_type": "string"
              }
            ],
            "rationale": "Collect supply-demand evidence."
          }
        },
        "failurePolicy": "record_gap"
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "mrp-exception-analysis",
          "run_input": "{{input}}",
          "analysis_context": "{{steps.resolve_analysis_context.output}}",
          "evidence": {
            "mrp_material": "{{steps.collect_mrp_master.output}}",
            "material_coverages": "{{steps.collect_mrp_coverage.output}}",
            "supply_demand_items": "{{steps.collect_mrp_elements.output}}"
          },
          "known_gaps": []
        }
      }
    ],
    "outputSchema": {
      "type": "object",
      "properties": {
        "plant": {
          "type": "string",
          "title": {
            "zh": "MRP 工厂",
            "en": "MRP plant"
          },
          "description": {
            "zh": "请输入MRP 工厂。",
            "en": "Enter the mrp plant."
          },
          "placeholder": {
            "zh": "例如：1010",
            "en": "Example: 1010"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "mrp_area": {
          "type": "string",
          "title": {
            "zh": "MRP 范围",
            "en": "MRP area"
          },
          "description": {
            "zh": "请输入MRP 范围。",
            "en": "Enter the mrp area."
          },
          "placeholder": {
            "zh": "例如：1010",
            "en": "Example: 1010"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "material": {
          "type": "string",
          "title": {
            "zh": "物料",
            "en": "Material"
          },
          "description": {
            "zh": "请输入物料。",
            "en": "Enter the material."
          },
          "placeholder": {
            "zh": "例如：SG21",
            "en": "Example: SG21"
          },
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "shortage_profile": {
          "type": "string",
          "title": {
            "zh": "短缺参数文件",
            "en": "Shortage profile"
          },
          "description": {
            "zh": "请输入短缺参数文件。",
            "en": "Enter the shortage profile."
          },
          "placeholder": {
            "zh": "例如：SAP000000001",
            "en": "Example: SAP000000001"
          },
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "shortage_counter": {
          "type": "string",
          "title": {
            "zh": "短缺计数器",
            "en": "Shortage profile counter"
          },
          "description": {
            "zh": "请输入短缺计数器。",
            "en": "Enter the shortage profile counter."
          },
          "placeholder": {
            "zh": "例如：001",
            "en": "Example: 001"
          },
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[0-9]+$"
        },
        "analysis_date": {
          "type": "string",
          "format": "date",
          "title": {
            "zh": "分析日期",
            "en": "Analysis date"
          }
        },
        "shortage_status": {
          "type": "string",
          "enum": [
            "active",
            "imminent",
            "future",
            "none",
            "unknown"
          ],
          "title": {
            "zh": "短缺状态",
            "en": "Shortage status"
          },
          "x-sapba-display": {
            "format": "status",
            "labels": {
              "active": {
                "zh": "短缺已经发生",
                "en": "Active shortage"
              },
              "imminent": {
                "zh": "短缺进入补货窗口",
                "en": "Within replenishment window"
              },
              "future": {
                "zh": "未来短缺",
                "en": "Future shortage"
              },
              "none": {
                "zh": "当前范围未发现短缺",
                "en": "No shortage in current scope"
              },
              "unknown": {
                "zh": "无法确认",
                "en": "Unknown"
              }
            }
          }
        },
        "shortage_quantity": {
          "type": [
            "string",
