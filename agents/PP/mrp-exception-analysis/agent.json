            "none",
            "unknown"
          ],
          "title": {
            "zh": "重排状态",
            "en": "Rescheduling status"
          },
          "x-sapba-display": {
            "format": "status",
            "labels": {
              "bring_forward": {
                "zh": "评估提前供应",
                "en": "Bring-forward review"
              },
              "postpone": {
                "zh": "评估推迟供应",
