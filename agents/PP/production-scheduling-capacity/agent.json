      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_scheduling_objects`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_scheduling_objects` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_WORK_CENTERS@2.0/A_WorkCenterCapPplineOp",
          "GET API_WORK_CENTERS@2.0/A_WorkCenters",
          "GET API_WORK_CENTERS@2.0/A_WorkCenterCapacity"
        ],
        "en": [
          "GET API_WORK_CENTERS@2.0/A_WorkCenterCapPplineOp",
          "GET API_WORK_CENTERS@2.0/A_WorkCenters",
          "GET API_WORK_CENTERS@2.0/A_WorkCenterCapacity"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_scheduling_objects` / `execute_plan`",
            "en": "Execute `collect_scheduling_objects` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_scheduling_objects"
      ]
    },
    {
