        "en": "Run manifest step `collect_capacity_buckets` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_WORK_CENTERS@2.0/A_WorkCenterCapPerBucketSet"
        ],
        "en": [
          "GET API_WORK_CENTERS@2.0/A_WorkCenterCapPerBucketSet"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_capacity_buckets` / `execute_plan`",
            "en": "Execute `collect_capacity_buckets` / `execute_plan`"
          }
        }
