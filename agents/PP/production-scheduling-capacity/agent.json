  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "plant": {
          "type": "string",
          "title": {
            "zh": "工厂",
            "en": "Plant"
          },
          "description": {
            "zh": "请输入工厂。",
            "en": "Enter the plant."
          },
          "placeholder": {
            "zh": "例如：1710",
            "en": "Example: 1710"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "work_center": {
          "type": "string",
          "title": {
            "zh": "工作中心",
            "en": "Work center"
          },
          "description": {
            "zh": "请输入工作中心。",
            "en": "Enter the work center."
          },
          "placeholder": {
            "zh": "例如：ASSEMBLY",
            "en": "Example: ASSEMBLY"
          },
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "date_from": {
          "type": "string",
          "title": {
            "zh": "开始日期",
            "en": "Start date"
          },
          "description": {
            "zh": "请输入开始日期。",
            "en": "Enter the start date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "date_to": {
          "type": "string",
          "title": {
            "zh": "结束日期",
            "en": "End date"
          },
          "description": {
            "zh": "请输入结束日期。",
            "en": "Enter the end date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "plant",
        "work_center",
        "date_from",
        "date_to"
      ],
      "additionalProperties": false,
      "dateRangePairs": [
        {
          "from": "date_from",
          "to": "date_to",
          "maxDays": 31
        }
      ]
    },
    "steps": [
      {
        "id": "collect_scheduling_objects",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_WORK_CENTERS",
            "odata_version": "2.0",
            "entity_set": "A_WorkCenterCapPplineOp",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "planned_pipeline_operations",
                "service_name": "API_WORK_CENTERS",
                "odata_version": "2.0",
                "entity_set": "A_WorkCenterCapPplineOp",
                "http_method": "GET",
                "select_fields": [
                  "Plant",
                  "MRPController",
                  "WorkCenter",
                  "CapacityInternalID",
                  "CapacityRequirement",
                  "Material",
                  "OrderID",
                  "Operation",
                  "OperationLatestStartDate",
                  "OperationLatestEndDate",
                  "CapacityRequirementUnit",
                  "RemainingCapReqExecutionDurn"
                ],
                "rationale": "Load exact work-center planned pipeline operations in the scheduling horizon.",
                "filters": [
                  {
                    "field": "Plant",
                    "operator": "eq",
                    "value": "{{input.plant}}",
                    "value_type": "string"
                  },
                  {
                    "field": "WorkCenter",
                    "operator": "eq",
                    "value": "{{input.work_center}}",
                    "value_type": "string"
                  },
                  {
                    "field": "OperationLatestStartDate",
                    "operator": "ge",
                    "value": "{{input.date_from}}",
                    "value_type": "date_compact"
                  },
                  {
                    "field": "OperationLatestStartDate",
                    "operator": "le",
                    "value": "{{input.date_to}}",
                    "value_type": "date_compact"
                  }
                ]
              },
              {
                "step_id": "work_centers",
                "service_name": "API_WORK_CENTERS",
                "odata_version": "2.0",
                "entity_set": "A_WorkCenters",
                "http_method": "GET",
                "select_fields": [
                  "WorkCenterInternalID",
                  "WorkCenterTypeCode",
                  "WorkCenter",
                  "Plant",
                  "CapacityInternalID",
                  "ValidityStartDate",
                  "ValidityEndDate"
                ],
                "rationale": "Load work-center master data.",
                "filters": [
                  {
                    "field": "Plant",
                    "operator": "eq",
                    "value": "{{input.plant}}",
                    "value_type": "string"
                  },
                  {
                    "field": "WorkCenter",
                    "operator": "eq",
                    "value": "{{input.work_center}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "work_center_capacities",
                "service_name": "API_WORK_CENTERS",
                "odata_version": "2.0",
                "entity_set": "A_WorkCenterCapacity",
                "http_method": "GET",
                "select_fields": [
                  "CapacityInternalID",
                  "Capacity",
                  "CapacityCategoryCode",
                  "CapacityNumberOfCapacities",
                  "CapacityPlanUtilizationPercent",
                  "CapacityStartTime",
                  "CapacityEndTime",
                  "Plant"
                ],
                "rationale": "Load work-center capacity master data.",
                "filter_from_previous": [
                  {
                    "field": "CapacityInternalID",
                    "source_step_id": "work_centers",
                    "source_field": "CapacityInternalID",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              }
            ],
            "rationale": "Collect orders, operations, and work-center evidence."
          }
        }
      },
      {
        "id": "collect_capacity_buckets",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_WORK_CENTERS",
            "odata_version": "2.0",
            "entity_set": "A_WorkCenterCapPerBucketSet",
            "http_method": "GET",
            "plan_kind": "direct",
            "step_id": "capacity_buckets",
            "select_fields": [
              "P_CapEvalStartDate",
              "P_CapEvalEndDate",
              "P_CapEvalBucketType",
              "Plant",
              "WorkCenter",
              "CapacityInternalID",
              "CapacityEvaluationTimePeriod",
              "WorkCenterAvailableCapacity",
              "WorkCenterCapRqmtInCapUnit",
              "WrkCtrRmngCapInCapUnit",
              "WorkCenterTotUtilznInTmePerd",
              "WorkCenterCapacityUnit"
            ],
            "filters": [
              {
                "field": "P_CapEvalStartDate",
                "operator": "eq",
                "value": "{{input.date_from}}",
                "value_type": "date_start"
              },
              {
                "field": "P_CapEvalEndDate",
                "operator": "eq",
                "value": "{{input.date_to}}",
                "value_type": "date_end"
              },
              {
                "field": "P_CapEvalBucketType",
                "operator": "eq",
                "value": "D",
                "value_type": "string"
              },
              {
                "field": "Plant",
                "operator": "eq",
                "value": "{{input.plant}}",
                "value_type": "string"
              },
              {
                "field": "WorkCenter",
                "operator": "eq",
                "value": "{{input.work_center}}",
                "value_type": "string"
              }
            ],
            "rationale": "Collect parameterized capacity buckets."
          }
        },
        "failurePolicy": "record_gap"
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "production-scheduling-capacity",
          "run_input": "{{input}}",
          "evidence": {
            "collect_scheduling_objects": "{{steps.collect_scheduling_objects.output}}",
            "capacity_buckets": "{{steps.collect_capacity_buckets.output}}"
          },
          "known_gaps": []
        }
      }
    ],
