{
  "schemaVersion": 2,
  "slug": "demand-forecast-planning",
  "module": "PP",
  "title": {
    "zh": "计划订单与计划独立需求覆盖度助手",
    "en": "Planned Order and PIR Coverage Assistant"
  },
  "summary": {
    "zh": "批量比较销售需求与PIR偏差，并使用SAP累计MRP可用量检查计划供给覆盖，先复核PIR再处理计划订单。",
    "en": "Batch-compares sales demand with PIR and uses SAP cumulative MRP availability to review planned coverage, reviewing PIR before planned orders."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.3.0",
  "owner": "PP Demand Planning / Sales Planning",
  "tags": [
    "Demand Forecast",
    "PIR",
    "Sales Demand",
    "Planning"
  ],
  "sapModules": [
    "PP-MP",
    "SD-SLS"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "工厂",
      "物料列表",
      "开始日期",
      "结束日期",
      "PIR版本",
      "PIR需求类型",
      "MRP范围",
      "需求计划",
      "需求段",
      "偏差关注阈值（%）"
    ],
    "en": [
      "Plant",
      "Materials",
      "Start date",
      "End date",
      "PIR version",
      "PIR requirement type",
      "MRP area",
      "Requirement plan",
      "Requirement segment",
      "Variance attention threshold (%)"
    ]
  },
  "outputs": {
    "zh": [
      "请求物料数",
      "已处理物料数",
      "正常物料数",
      "需关注物料数",
      "无法确认物料数",
      "逐物料结果",
      "查询源完整性",
      "业务证据完整性",
      "证据缺口",
      "业务状态",
      "结构化业务报告"
    ],
    "en": [
      "Requested material count",
      "Processed material count",
      "Normal material count",
      "Attention material count",
      "Inconclusive material count",
      "Per-material results",
      "Query-source completeness",
      "Business-evidence completeness",
      "Evidence gaps",
      "Business status",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "默认只读，不自动修改 PIR",
      "销售订单与 PIR 必须按工厂、物料、单位和期间对齐",
      "PIR属于需求，不得作为供给或与计划订单相加",
      "SAP累计MRP可用量是净供需覆盖的权威余额",
      "样本不足或数据过旧时返回 INCONCLUSIVE",
      "任何写回必须由计划员审批"
    ],
    "en": [
      "Read-only by default; never change PIRs automatically",
      "Align sales orders and PIRs by plant, material, unit and period",
      "PIR is demand and is never treated as supply or added to planned orders",
      "SAP cumulative MRP availability is authoritative for net coverage",
      "Return INCONCLUSIVE for sparse or stale data",
      "Require planner approval before any write-back"
    ]
  },
  "workflow": [
    {
      "id": "execute-resolve_analysis_context",
      "title": {"zh": "确定批量分析范围", "en": "Resolve batch analysis scope"},
      "description": {"zh": "校验1至50个物料、公共期间、MRP范围和PIR选择条件。", "en": "Validate 1 to 50 materials, the shared horizon, MRP area, and PIR selectors."},
      "operations": {"zh": ["rule.resolve_demand_forecast_context"], "en": ["rule.resolve_demand_forecast_context"]},
      "tools": [{"name": "resolve_demand_forecast_context", "kind": "Local deterministic rule", "purpose": {"zh": "校验输入并解析执行分支", "en": "Validate inputs and resolve execution branches"}}],
      "executionStepIds": ["resolve_analysis_context"]
    },
    {
      "id": "execute-read_pir",
      "title": {"zh": "读取计划独立需求", "en": "Read planned independent requirements"},
      "description": {"zh": "读取有效PIR抬头及原生期间项目。", "en": "Read active PIR headers and native-period items."},
      "operations": {"zh": ["GET API_PLND_INDEP_RQMT_SRV@2.0/PlannedIndepRqmt", "GET API_PLND_INDEP_RQMT_SRV@2.0/PlannedIndepRqmtItem"], "en": ["GET API_PLND_INDEP_RQMT_SRV@2.0/PlannedIndepRqmt", "GET API_PLND_INDEP_RQMT_SRV@2.0/PlannedIndepRqmtItem"]},
      "tools": [{"name": "Embedded SAP OData Provider", "kind": "GET-only SAP Provider", "purpose": {"zh": "读取PIR证据", "en": "Read PIR evidence"}}],
      "executionStepIds": ["read_pir"]
    },
    {
      "id": "execute-read_sales_demand",
      "title": {"zh": "读取销售需求", "en": "Read sales demand"},
      "description": {"zh": "先筛选物料和工厂的销售订单项目，再展开期间内计划行。", "en": "Filter sales-order items by material and plant, then expand schedule lines in the horizon."},
      "operations": {"zh": ["GET API_SALES_ORDER_SRV@2.0/A_SalesOrderItem", "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderScheduleLine"], "en": ["GET API_SALES_ORDER_SRV@2.0/A_SalesOrderItem", "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderScheduleLine"]},
      "tools": [{"name": "Embedded SAP OData Provider", "kind": "GET-only SAP Provider", "purpose": {"zh": "读取销售订单计划行需求", "en": "Read sales-order schedule-line demand"}}],
      "executionStepIds": ["read_sales_demand"]
    },
    {
      "id": "execute-read_planned_orders",
      "title": {"zh": "读取计划订单", "en": "Read planned orders"},
      "description": {"zh": "按计划结束日读取期间内的计划订单未来入库。", "en": "Read planned-order receipts in the horizon by planned end date."},
      "operations": {"zh": ["GET API_PLANNED_ORDERS@2.0/A_PlannedOrder"], "en": ["GET API_PLANNED_ORDERS@2.0/A_PlannedOrder"]},
      "tools": [{"name": "Embedded SAP OData Provider", "kind": "GET-only SAP Provider", "purpose": {"zh": "读取计划订单证据", "en": "Read planned-order evidence"}}],
      "executionStepIds": ["read_planned_orders"]
    },
    {
      "id": "execute-read_mrp_material",
      "title": {"zh": "读取MRP物料主数据", "en": "Read MRP material master"},
      "description": {"zh": "核对每个物料的工厂、MRP范围和基本单位。", "en": "Verify each material's plant, MRP area, and base unit."},
      "operations": {"zh": ["GET API_MRP_MATERIALS_SRV_01@2.0/A_MRPMaterial"], "en": ["GET API_MRP_MATERIALS_SRV_01@2.0/A_MRPMaterial"]},
      "tools": [{"name": "Embedded SAP OData Provider", "kind": "GET-only SAP Provider", "purpose": {"zh": "读取MRP范围和单位", "en": "Read MRP scope and unit"}}],
      "executionStepIds": ["read_mrp_material"]
    },
    {
      "id": "execute-read_supply_demand",
      "title": {"zh": "读取MRP供需序列", "en": "Read MRP supply-demand sequence"},
      "description": {"zh": "读取完整供需元素和SAP累计可用量，不自行重算MRP余额。", "en": "Read complete supply-demand elements and SAP cumulative availability without recalculating the MRP balance."},
      "operations": {"zh": ["GET API_MRP_MATERIALS_SRV_01@2.0/SupplyDemandItems"], "en": ["GET API_MRP_MATERIALS_SRV_01@2.0/SupplyDemandItems"]},
      "tools": [{"name": "Embedded SAP OData Provider", "kind": "GET-only SAP Provider", "purpose": {"zh": "读取MRP供需与累计余额", "en": "Read MRP supply-demand and cumulative balances"}}],
      "executionStepIds": ["read_supply_demand"]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate_business_result`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate_business_result` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "plant": {
          "type": "string",
          "title": {
            "zh": "工厂",
            "en": "Plant"
          },
          "description": {
            "zh": "请输入工厂。",
            "en": "Enter the plant."
          },
          "placeholder": {
            "zh": "例如：1710",
            "en": "Example: 1710"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "materials": {
          "type": "array",
          "title": {
            "zh": "物料列表",
            "en": "Materials"
          },
          "description": {
            "zh": "每行、逗号或分号分隔输入1至50个物料。",
            "en": "Enter 1 to 50 materials separated by lines, commas, or semicolons."
          },
          "placeholder": {
            "zh": "例如：TG10、SG21",
            "en": "Example: TG10, SG21"
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[0-9A-Za-z_-]+$",
            "x-sapba-input-normalization": "uppercase"
          }
        },
        "date_from": {
          "type": "string",
          "title": {
            "zh": "开始日期",
            "en": "Start date"
          },
          "description": {
            "zh": "请输入开始日期。",
            "en": "Enter the start date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "date_to": {
          "type": "string",
          "title": {
            "zh": "结束日期",
            "en": "End date"
          },
          "description": {
            "zh": "请输入结束日期。",
            "en": "Enter the end date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "pir_version": {
          "type": "string",
          "title": {"zh": "PIR版本", "en": "PIR version"},
          "description": {"zh": "留空时使用SAP默认版本00。", "en": "Leave blank to use SAP default version 00."},
          "default": "00",
          "minLength": 1,
          "maxLength": 2,
          "pattern": "^[0-9A-Za-z]{1,2}$"
        },
        "pir_requirement_type": {
          "type": "string",
          "title": {"zh": "PIR需求类型", "en": "PIR requirement type"},
          "description": {"zh": "仅在存在多个PIR范围时填写。", "en": "Use only when multiple PIR scopes exist."},
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]*$"
        },
        "mrp_area": {
          "type": "string",
          "title": {"zh": "MRP范围", "en": "MRP area"},
          "description": {"zh": "留空时使用工厂。", "en": "Leave blank to use the plant."},
          "maxLength": 10,
          "pattern": "^[0-9A-Za-z_-]*$"
        },
        "requirement_plan": {
          "type": "string",
          "title": {"zh": "需求计划", "en": "Requirement plan"},
          "description": {"zh": "仅在存在多个PIR范围时填写。", "en": "Use only when multiple PIR scopes exist."},
          "maxLength": 10
        },
        "requirement_segment": {
          "type": "string",
          "title": {"zh": "需求段", "en": "Requirement segment"},
          "description": {"zh": "仅在业务使用需求段时填写。", "en": "Use only when requirement segments apply."},
          "maxLength": 40
        },
        "deviation_threshold_percent": {
          "type": "number",
          "title": {"zh": "偏差关注阈值（%）", "en": "Variance attention threshold (%)"},
          "description": {"zh": "留空时使用20%。", "en": "Leave blank to use 20%."},
          "default": 20,
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "plant",
        "materials",
        "date_from",
        "date_to"
      ],
      "additionalProperties": false,
      "dateRangePairs": [
        {
          "from": "date_from",
          "to": "date_to",
          "maxDays": 366
        }
      ]
    },
    "steps": [
      {
        "id": "resolve_analysis_context",
        "executor": "rule",
        "operation": "resolve_demand_forecast_context",
        "inputMapping": {
          "run_input": "{{input}}"
        }
      },
      {
        "id": "read_pir",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_PLND_INDEP_RQMT_SRV",
            "odata_version": "2.0",
            "entity_set": "PlannedIndepRqmt",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "pir_headers",
                "service_name": "API_PLND_INDEP_RQMT_SRV",
                "odata_version": "2.0",
                "entity_set": "PlannedIndepRqmt",
                "http_method": "GET",
                "select_fields": [
                  "Product",
                  "Plant",
                  "MRPArea",
                  "PlndIndepRqmtType",
                  "PlndIndepRqmtVersion",
                  "RequirementPlan",
                  "RequirementSegment",
                  "PlndIndepRqmtIsActive"
                ],
                "order_by": [
                  "Product",
                  "Plant",
                  "MRPArea",
                  "PlndIndepRqmtType",
                  "PlndIndepRqmtVersion",
                  "RequirementPlan",
                  "RequirementSegment"
                ],
                "filters": [
                  {
                    "field": "Product",
                    "operator": "in",
                    "value": "{{steps.resolve_analysis_context.output.materials}}",
                    "value_type": "string",
                    "chunk_size": 10
                  },
                  {
                    "field": "Plant",
                    "operator": "eq",
                    "value": "{{input.plant}}",
                    "value_type": "string"
                  },
                  {
                    "field": "PlndIndepRqmtVersion",
                    "operator": "eq",
                    "value": "{{steps.resolve_analysis_context.output.pir_version}}",
                    "value_type": "string"
                  },
                  {
                    "field": "PlndIndepRqmtIsActive",
                    "operator": "eq",
                    "value": "X",
                    "value_type": "string"
                  }
                ],
                "max_concurrent_chunks": 2,
                "chunk_error_policy": "record_gap",
                "rationale": "Read active planned-independent-requirement scopes for the requested materials and plant."
              },
              {
                "step_id": "pir_items",
                "service_name": "API_PLND_INDEP_RQMT_SRV",
                "odata_version": "2.0",
                "entity_set": "PlannedIndepRqmtItem",
                "http_method": "GET",
                "select_fields": [
                  "Product",
                  "Plant",
                  "MRPArea",
                  "PlndIndepRqmtType",
                  "PlndIndepRqmtVersion",
                  "RequirementPlan",
                  "RequirementSegment",
                  "PlndIndepRqmtPeriod",
                  "PeriodType",
                  "PlndIndepRqmtPeriodStartDate",
                  "WorkingDayDate",
                  "PlannedQuantity",
                  "WithdrawalQuantity",
                  "UnitOfMeasure"
                ],
                "order_by": [
                  "Product",
                  "Plant",
                  "MRPArea",
                  "PlndIndepRqmtType",
                  "PlndIndepRqmtVersion",
                  "RequirementPlan",
                  "RequirementSegment",
                  "PlndIndepRqmtPeriod",
                  "PeriodType"
                ],
                "filters": [
                  {
                    "field": "Product",
                    "operator": "in",
                    "value": "{{steps.resolve_analysis_context.output.materials}}",
                    "value_type": "string",
                    "chunk_size": 10
                  },
                  {
                    "field": "Plant",
                    "operator": "eq",
                    "value": "{{input.plant}}",
                    "value_type": "string"
                  },
                  {
                    "field": "PlndIndepRqmtVersion",
                    "operator": "eq",
                    "value": "{{steps.resolve_analysis_context.output.pir_version}}",
                    "value_type": "string"
                  },
                  {
                    "field": "PlndIndepRqmtPeriodStartDate",
                    "operator": "ge",
                    "value": "{{steps.resolve_analysis_context.output.pir_query_from}}",
                    "value_type": "date_start"
                  },
                  {
                    "field": "PlndIndepRqmtPeriodStartDate",
                    "operator": "le",
                    "value": "{{steps.resolve_analysis_context.output.date_to}}",
                    "value_type": "date_end"
                  }
                ],
                "max_concurrent_chunks": 2,
                "chunk_error_policy": "record_gap",
                "rationale": "Read native PIR period quantities for the active scopes."
              }
            ],
            "rationale": "Read active PIR scopes and their native period items."
          }
        }
      },
      {
        "id": "read_sales_demand",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_SALES_ORDER_SRV",
            "odata_version": "2.0",
            "entity_set": "A_SalesOrderItem",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "sales_order_items",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrderItem",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrderItem",
                  "Material",
                  "ProductionPlant",
                  "RequestedQuantity",
                  "RequestedQuantityUnit",
                  "SalesDocumentRjcnReason"
                ],
                "order_by": ["Material", "SalesOrder", "SalesOrderItem"],
                "filters": [
                  {
                    "field": "ProductionPlant",
                    "operator": "eq",
                    "value": "{{input.plant}}",
                    "value_type": "string"
                  },
                  {
                    "field": "Material",
                    "operator": "in",
                    "value": "{{steps.resolve_analysis_context.output.materials}}",
                    "value_type": "string",
                    "chunk_size": 10
                  }
                ],
                "max_concurrent_chunks": 2,
                "chunk_error_policy": "record_gap",
                "rationale": "Read exact sales-order items for the requested materials and supplying plant."
              },
              {
                "step_id": "sales_schedule_lines",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrderScheduleLine",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrderItem",
                  "ScheduleLine",
                  "RequestedDeliveryDate",
                  "ScheduleLineOrderQuantity",
                  "OrderQuantityUnit"
                ],
                "order_by": ["SalesOrder", "SalesOrderItem", "ScheduleLine"],
                "filters": [
                  {
                    "field": "RequestedDeliveryDate",
                    "operator": "ge",
                    "value": "{{steps.resolve_analysis_context.output.date_from}}",
                    "value_type": "date_start"
                  },
                  {
                    "field": "RequestedDeliveryDate",
                    "operator": "le",
                    "value": "{{steps.resolve_analysis_context.output.date_to}}",
                    "value_type": "date_end"
                  }
                ],
                "filter_from_previous": [
                  {"field": "SalesOrder", "source_step_id": "sales_order_items", "source_field": "SalesOrder", "fanout": true, "fetch_all_for_binding": true},
                  {"field": "SalesOrderItem", "source_step_id": "sales_order_items", "source_field": "SalesOrderItem", "fanout": true, "fetch_all_for_binding": true}
                ],
                "rationale": "Read dated schedule-line demand for the selected items."
              }
            ],
            "rationale": "Read sales demand at schedule-line date grain."
          }
        }
      },
      {
        "id": "read_planned_orders",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_PLANNED_ORDERS",
            "odata_version": "2.0",
            "entity_set": "A_PlannedOrder",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "PlannedOrder",
              "Material",
              "ProductionPlant",
              "TotalQuantity",
              "BaseUnit",
              "PlndOrderPlannedStartDate",
              "PlndOrderPlannedEndDate",
              "PlannedOrderIsFirm",
              "PlannedOrderIsConvertible"
            ],
            "order_by": ["Material", "PlannedOrder"],
            "filters": [
              {"field": "ProductionPlant", "operator": "eq", "value": "{{input.plant}}", "value_type": "string"},
              {"field": "Material", "operator": "in", "value": "{{steps.resolve_analysis_context.output.materials}}", "value_type": "string", "chunk_size": 10},
              {"field": "PlndOrderPlannedEndDate", "operator": "ge", "value": "{{steps.resolve_analysis_context.output.date_from}}", "value_type": "date_start"},
              {"field": "PlndOrderPlannedEndDate", "operator": "le", "value": "{{steps.resolve_analysis_context.output.date_to}}", "value_type": "date_end"}
            ],
            "max_concurrent_chunks": 2,
            "chunk_error_policy": "record_gap",
            "rationale": "Read planned receipts whose planned completion date falls in the comparison period."
          }
        }
      },
      {
        "id": "read_mrp_material",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "request": {
          "plan": {
            "service_name": "API_MRP_MATERIALS_SRV_01",
            "odata_version": "2.0",
            "entity_set": "A_MRPMaterial",
            "http_method": "GET",
            "plan_kind": "direct",
            "select_fields": [
              "Material",
              "MRPPlant",
              "MRPArea",
              "BaseUnit",
              "MRPType",
              "MRPController",
              "MaterialProcurementCategory"
            ],
            "order_by": ["Material", "MRPPlant", "MRPArea"],
            "filters": [
              {"field": "Material", "operator": "in", "value": "{{steps.resolve_analysis_context.output.materials}}", "value_type": "string", "chunk_size": 10},
              {"field": "MRPPlant", "operator": "eq", "value": "{{input.plant}}", "value_type": "string"},
