        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "plant": "{{steps.evaluate_business_result.output.workflow_output.plant}}",
      "material": "{{steps.evaluate_business_result.output.workflow_output.material}}",
      "date_from": "{{steps.evaluate_business_result.output.workflow_output.date_from}}",
      "date_to": "{{steps.evaluate_business_result.output.workflow_output.date_to}}",
