            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "plant",
        "material",
        "date_from",
        "date_to",
        "business_status",
