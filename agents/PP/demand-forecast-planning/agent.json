    "zh": [
      "工厂",
      "物料",
      "开始日期",
      "结束日期"
    ],
    "en": [
      "Plant",
      "Material",
      "Start date",
      "End date"
    ]
  },
  "outputs": {
    "zh": [
      "工厂",
      "物料",
      "开始日期",
      "结束日期",
      "业务状态",
      "查询源完整性",
      "结构化业务报告"
    ],
    "en": [
      "Plant",
      "Material",
      "Start date",
      "End date",
      "Business status",
      "Query-source completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "默认只读，不自动修改 PIR",
      "销售订单与 PIR 必须按工厂、物料、单位和期间对齐",
      "样本不足或数据过旧时返回 INCONCLUSIVE",
      "任何写回必须由计划员审批"
    ],
    "en": [
      "Read-only by default; never change PIRs automatically",
      "Align sales orders and PIRs by plant, material, unit and period",
      "Return INCONCLUSIVE for sparse or stale data",
      "Require planner approval before any write-back"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_forecast_evidence",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_forecast_evidence`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_forecast_evidence` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderItem",
          "GET API_PLANNED_ORDERS@2.0/A_PlannedOrder"
        ],
        "en": [
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderItem",
          "GET API_PLANNED_ORDERS@2.0/A_PlannedOrder"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_forecast_evidence` / `execute_plan`",
            "en": "Execute `collect_forecast_evidence` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_forecast_evidence"
      ]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate_business_result`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate_business_result` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "plant": {
          "type": "string",
          "title": {
            "zh": "工厂",
            "en": "Plant"
          },
          "description": {
            "zh": "请输入工厂。",
            "en": "Enter the plant."
          },
          "placeholder": {
            "zh": "例如：1710",
            "en": "Example: 1710"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "material": {
          "type": "string",
          "title": {
            "zh": "物料",
            "en": "Material"
          },
          "description": {
            "zh": "请输入物料。",
            "en": "Enter the material."
          },
          "placeholder": {
            "zh": "例如：SG21",
            "en": "Example: SG21"
          },
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "date_from": {
          "type": "string",
          "title": {
            "zh": "开始日期",
            "en": "Start date"
          },
          "description": {
            "zh": "请输入开始日期。",
            "en": "Enter the start date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "date_to": {
          "type": "string",
          "title": {
            "zh": "结束日期",
            "en": "End date"
          },
          "description": {
            "zh": "请输入结束日期。",
            "en": "Enter the end date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "plant",
        "material",
        "date_from",
        "date_to"
      ],
      "additionalProperties": false,
      "dateRangePairs": [
        {
          "from": "date_from",
          "to": "date_to",
          "maxDays": 366
        }
      ]
    },
    "steps": [
      {
        "id": "collect_forecast_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_SALES_ORDER_SRV",
            "odata_version": "2.0",
            "entity_set": "A_SalesOrderItem",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "sales_demand",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrderItem",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrderItem",
                  "Material",
                  "ProductionPlant",
                  "RequestedQuantity",
                  "RequestedQuantityUnit",
                  "ConfdDelivQtyInOrderQtyUnit"
                ],
                "rationale": "Load historical sales demand.",
                "filters": [
                  {
                    "field": "ProductionPlant",
                    "operator": "eq",
                    "value": "{{input.plant}}",
                    "value_type": "string"
                  },
                  {
                    "field": "Material",
                    "operator": "eq",
                    "value": "{{input.material}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "planned_orders",
                "service_name": "API_PLANNED_ORDERS",
                "odata_version": "2.0",
                "entity_set": "A_PlannedOrder",
                "http_method": "GET",
                "select_fields": [
                  "PlannedOrder",
                  "Material",
                  "ProductionPlant",
                  "TotalQuantity",
                  "PlndOrderPlannedStartDate",
                  "PlndOrderPlannedEndDate",
                  "PlannedOrderIsFirm",
                  "PlannedOrderIsConvertible"
                ],
                "rationale": "Load planned orders in the comparison period.",
                "filters": [
                  {
                    "field": "ProductionPlant",
                    "operator": "eq",
                    "value": "{{input.plant}}",
                    "value_type": "string"
                  },
                  {
                    "field": "Material",
                    "operator": "eq",
                    "value": "{{input.material}}",
                    "value_type": "string"
                  },
                  {
                    "field": "PlndOrderPlannedStartDate",
                    "operator": "ge",
                    "value": "{{input.date_from}}",
                    "value_type": "date_start"
                  },
                  {
                    "field": "PlndOrderPlannedStartDate",
                    "operator": "le",
                    "value": "{{input.date_to}}",
                    "value_type": "date_end"
                  }
                ]
              }
            ],
            "rationale": "Collect demand and planned-order evidence."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "demand-forecast-planning",
          "run_input": "{{input}}",
          "evidence": {
            "collect_forecast_evidence": "{{steps.collect_forecast_evidence.output}}"
          },
          "known_gaps": [
            "pir_evidence"
          ]
        }
      }
    ],
    "outputSchema": {
      "type": "object",
      "properties": {
        "plant": {
          "type": "string",
          "title": {
            "zh": "工厂",
            "en": "Plant"
