  "guardrails": {
    "zh": [
      "相关性不得表述为确定因果",
      "计划、确认、入库和组件数量必须分开核对",
      "不同物料、项目或单位不得合计",
      "成本由独立Agent分析",
      "不自动确认、收发货、冲销或TECO"
    ],
    "en": [
      "Do not present correlation as proven causation",
      "Validate plan, confirmation, receipt, and component quantities separately",
      "Do not aggregate different materials, items, or units",
      "Analyze cost through the separate cost Agent",
      "Never confirm, post goods movements, reverse, or TECO an order"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_production_variance",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_production_variance`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_production_variance` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_PRODUCTION_ORDER_2_SRV@2.0/A_ProductionOrder_2",
          "GET API_PRODUCTION_ORDER_2_SRV@2.0/A_ProductionOrderItem_2",
          "GET API_PRODUCTION_ORDER_2_SRV@2.0/A_ProductionOrderOperation_2",
          "GET API_PRODUCTION_ORDER_2_SRV@2.0/A_ProductionOrderComponent_2",
          "GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentItem"
        ],
        "en": [
          "GET API_PRODUCTION_ORDER_2_SRV@2.0/A_ProductionOrder_2",
          "GET API_PRODUCTION_ORDER_2_SRV@2.0/A_ProductionOrderItem_2",
          "GET API_PRODUCTION_ORDER_2_SRV@2.0/A_ProductionOrderOperation_2",
          "GET API_PRODUCTION_ORDER_2_SRV@2.0/A_ProductionOrderComponent_2",
          "GET API_MATERIAL_DOCUMENT_SRV@2.0/A_MaterialDocumentItem"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_production_variance` / `execute_plan`",
            "en": "Execute `collect_production_variance` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_production_variance"
      ]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate_business_result`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate_business_result` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "manufacturing_order": {
          "type": "string",
          "title": {
            "zh": "生产订单号",
            "en": "Manufacturing order"
          },
          "description": {
            "zh": "请输入生产订单号。",
            "en": "Enter the manufacturing order."
          },
          "placeholder": {
            "zh": "例如：1000000",
            "en": "Example: 1000000"
          },
          "minLength": 1,
          "maxLength": 12,
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "manufacturing_order"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "id": "collect_production_variance",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_PRODUCTION_ORDER_2_SRV",
            "odata_version": "2.0",
            "entity_set": "A_ProductionOrder_2",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "production_order_header",
                "service_name": "API_PRODUCTION_ORDER_2_SRV",
                "odata_version": "2.0",
                "entity_set": "A_ProductionOrder_2",
                "http_method": "GET",
                "select_fields": [
                  "ManufacturingOrder",
                  "ManufacturingOrderType",
                  "Material",
                  "ProductionPlant",
                  "CompanyCode",
                  "ProductionUnit",
                  "OrderIsConfirmed",
                  "OrderIsPartiallyConfirmed",
                  "OrderIsDelivered",
                  "OrderIsTechnicallyCompleted",
                  "OrderIsClosed"
                ],
                "rationale": "Load the exact production-order identity and completion state.",
                "filters": [
                  {
                    "field": "ManufacturingOrder",
                    "operator": "eq",
                    "value": "{{input.manufacturing_order}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "production_order_items",
                "service_name": "API_PRODUCTION_ORDER_2_SRV",
                "odata_version": "2.0",
                "entity_set": "A_ProductionOrderItem_2",
                "http_method": "GET",
                "select_fields": [
                  "ManufacturingOrder",
                  "ManufacturingOrderItem",
                  "Material",
                  "ProductionPlant",
                  "MfgOrderItemPlannedTotalQty",
                  "MfgOrderItemGoodsReceiptQty",
                  "MfgOrderItemActualDeviationQty",
                  "ProductionUnit"
                ],
                "rationale": "Load production-order items.",
                "filters": [
                  {
                    "field": "ManufacturingOrder",
                    "operator": "eq",
                    "value": "{{input.manufacturing_order}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "production_operations",
                "service_name": "API_PRODUCTION_ORDER_2_SRV",
                "odata_version": "2.0",
                "entity_set": "A_ProductionOrderOperation_2",
                "http_method": "GET",
                "select_fields": [
                  "ManufacturingOrder",
                  "ManufacturingOrderOperation",
                  "WorkCenter",
                  "OperationIsConfirmed",
                  "OperationIsPartiallyConfirmed",
                  "OpPlannedTotalQuantity",
                  "OpTotalConfirmedYieldQty",
                  "OperationUnit",
                  "OpErlstSchedldExecStrtDte",
                  "OpErlstSchedldExecEndDte"
                ],
                "rationale": "Load production operations, planned dates, and confirmations.",
                "filters": [
                  {
                    "field": "ManufacturingOrder",
                    "operator": "eq",
                    "value": "{{input.manufacturing_order}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "production_components",
                "service_name": "API_PRODUCTION_ORDER_2_SRV",
                "odata_version": "2.0",
                "entity_set": "A_ProductionOrderComponent_2",
                "http_method": "GET",
                "select_fields": [
                  "ManufacturingOrder",
                  "Reservation",
                  "ReservationItem",
                  "Material",
                  "Plant",
                  "RequiredQuantity",
                  "WithdrawnQuantity",
                  "ConfirmedAvailableQuantity",
                  "BaseUnit"
                ],
                "rationale": "Load production-order components.",
                "filters": [
                  {
                    "field": "ManufacturingOrder",
                    "operator": "eq",
                    "value": "{{input.manufacturing_order}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "material_documents",
                "service_name": "API_MATERIAL_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_MaterialDocumentItem",
                "http_method": "GET",
                "select_fields": [
                  "MaterialDocumentYear",
                  "MaterialDocument",
                  "MaterialDocumentItem",
                  "ManufacturingOrder",
                  "Material",
                  "Plant",
                  "GoodsMovementType",
                  "QuantityInBaseUnit",
                  "MaterialBaseUnit",
                  "DebitCreditCode",
                  "ReversedMaterialDocument",
                  "ReversedMaterialDocumentYear",
                  "ReversedMaterialDocumentItem"
                ],
                "rationale": "Load material issues, receipts, and reversals.",
                "filters": [
                  {
                    "field": "ManufacturingOrder",
                    "operator": "eq",
                    "value": "{{input.manufacturing_order}}",
                    "value_type": "string"
                  }
                ]
              }
            ],
            "rationale": "Collect quantity and material variance evidence."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "production-variance-analysis",
          "run_input": "{{input}}",
          "evidence": {
            "collect_production_variance": "{{steps.collect_production_variance.output}}"
          },
          "known_gaps": []
        }
      }
    ],
