{
  "schemaVersion": 2,
  "slug": "production-variance-analysis",
  "module": "PP",
  "title": {
    "zh": "生产数量与物料差异根因分析助手",
    "en": "Production Quantity and Material Variance Analysis Assistant"
  },
  "summary": {
    "zh": "比较生产订单计划、最终工序确认、成品入库、组件领料和冲销，定位数量与物料差异的候选原因。",
    "en": "Compares production-order plan, final-operation confirmation, finished-goods receipt, component issues, and reversals to identify candidate quantity and material variance causes."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.2.0",
  "owner": "PP-SFC / MM-IM",
  "tags": [
    "Variance",
    "Consumption",
    "Root Cause"
  ],
