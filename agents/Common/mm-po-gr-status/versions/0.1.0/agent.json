  },
  "guardrails": {
    "zh": [
      "严格只读；仅执行SAP OData GET。",
      "不执行单位换算；单位不可直接比较时返回无法确认。",
      "SAP交货完成标识不替代物料凭证收货证据。"
    ],
    "en": [
      "Strictly read-only; only SAP OData GET is used.",
      "No unit conversion is performed; non-comparable units produce an inconclusive result.",
      "The SAP delivery-complete flag does not replace material-document receipt evidence."
    ]
  },
  "workflow": [
    {
      "id": "read-po-receipt-evidence",
      "title": {
        "zh": "读取采购订单与入库证据",
        "en": "Read purchase-order and receipt evidence"
      },
      "description": {
        "zh": "按目标日期读取计划行、采购订单项目与抬头、全部计划行以及物料凭证项目与抬头。",
        "en": "Read target and complete schedule lines, purchase-order items and headers, and material-document items and headers."
      },
      "tools": [
        {
          "name": "sap_read_execute_plan",
          "kind": "SAP Read Provider",
          "purpose": {
            "zh": "执行确定性的OData GET计划。",
            "en": "Execute the deterministic OData GET plan."
          }
        }
      ],
      "executionStepIds": [
        "collect_po_receipt_evidence"
      ]
    },
    {
      "id": "assess-po-receipt-status",
      "title": {
        "zh": "计算计划行入库状态",
        "en": "Calculate schedule-line receipt status"
      },
      "description": {
        "zh": "按稳定业务键去重，计算收货与冲销净额，并按计划行顺序分配后形成业务结果。",
        "en": "Deduplicate stable business keys, calculate net receipts and reversals, and allocate them by schedule-line order to produce the business result."
      },
      "tools": [
        {
          "name": "managed_agent_rule",
          "kind": "Managed deterministic rule",
          "purpose": {
            "zh": "生成入库指标、明细与建议。",
            "en": "Produce receipt metrics, details, and recommendations."
          }
        }
      ],
      "executionStepIds": [
        "evaluate_receipt_status"
      ]
    }
  ],
