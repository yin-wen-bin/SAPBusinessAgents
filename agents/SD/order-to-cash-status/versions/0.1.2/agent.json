    "steps": [
      {
        "id": "collect_o2c_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_SALES_ORDER_SRV",
            "odata_version": "2.0",
            "entity_set": "A_SalesOrder",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "target_entity_set": "A_OperationalAcctgDocItemCube",
            "steps": [
              {
                "step_id": "sales_order",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrder",
                "http_method": "GET",
                "filters": [
                  {
                    "field": "SalesOrder",
                    "operator": "eq",
                    "value": "{{input.sales_order}}",
                    "value_type": "string"
                  }
                ],
                "rationale": "Load the requested sales order."
              },
              {
                "step_id": "sales_order_items",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrderItem",
                "http_method": "GET",
                "filters": [
                  {
                    "field": "SalesOrder",
                    "operator": "eq",
                    "value": "{{input.sales_order}}",
                    "value_type": "string"
                  }
                ],
                "rationale": "Load every sales-order item."
              },
              {
                "step_id": "delivery_items",
                "service_name": "API_OUTBOUND_DELIVERY_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OutbDeliveryItem",
                "http_method": "GET",
                "select_fields": [
                  "DeliveryDocument",
                  "DeliveryDocumentItem",
                  "ReferenceSDDocument",
                  "ReferenceSDDocumentItem",
                  "ActualDeliveryQuantity",
                  "GoodsMovementStatus",
                  "DeliveryRelatedBillingStatus"
                ],
                "filters": [
                  {
                    "field": "ReferenceSDDocument",
                    "operator": "eq",
                    "value": "{{input.sales_order}}",
                    "value_type": "string"
                  }
                ],
                "rationale": "Load outbound-delivery items referencing the sales order."
              },
              {
                "step_id": "delivery_headers",
                "service_name": "API_OUTBOUND_DELIVERY_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OutbDeliveryHeader",
                "http_method": "GET",
                "select_fields": [
                  "DeliveryDocument",
                  "ActualGoodsMovementDate",
                  "OverallGoodsMovementStatus",
                  "OverallSDProcessStatus"
                ],
                "filter_from_previous": [
                  {
                    "field": "DeliveryDocument",
                    "source_step_id": "delivery_items",
                    "source_field": "DeliveryDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ],
                "rationale": "Load delivery-header PGI evidence for every related delivery."
              },
              {
                "step_id": "billing_items_by_order",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocumentItem",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentItem",
                  "ReferenceSDDocument",
                  "ReferenceSDDocumentItem",
                  "SalesDocument",
                  "SalesDocumentItem",
                  "NetAmount",
                  "TransactionCurrency"
                ],
                "filters": [
                  {
                    "field": "ReferenceSDDocument",
                    "operator": "eq",
                    "value": "{{input.sales_order}}",
                    "value_type": "string"
                  }
                ],
                "rationale": "Load order-related billing items that directly reference the sales order."
              },
              {
                "step_id": "billing_items_by_delivery",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocumentItem",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentItem",
                  "ReferenceSDDocument",
                  "ReferenceSDDocumentItem",
                  "SalesDocument",
                  "SalesDocumentItem",
                  "NetAmount",
                  "TransactionCurrency"
                ],
                "filter_from_previous": [
                  {
                    "field": "ReferenceSDDocument",
                    "source_step_id": "delivery_items",
                    "source_field": "DeliveryDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ],
                "rationale": "Load delivery-related billing items by binding each delivery document to ReferenceSDDocument."
              },
              {
                "step_id": "billing_headers_by_order",
