                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "BillingDocument",
                  "SalesDocument",
                  "Customer",
                  "AccountingDocumentType",
                  "ClearingAccountingDocument",
                  "ClearingDocFiscalYear",
                  "IsCleared",
                  "PaymentMethod",
                  "HouseBank",
                  "HouseBankAccount"
                ],
                "filters": [
                  {
                    "field": "SalesDocument",
                    "operator": "eq",
                    "value": "{{input.sales_order}}",
                    "value_type": "string"
                  }
                ],
                "rationale": "Load FI evidence directly associated with the sales order."
              },
              {
