                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "BillingDocument",
                  "SalesDocument",
                  "Customer",
                  "AccountingDocumentType",
                  "ClearingAccountingDocument",
                  "ClearingDocFiscalYear",
                  "IsCleared",
                  "PaymentMethod",
                  "HouseBank",
                  "HouseBankAccount"
                ],
                "filter_from_previous": [
                  {
                    "field": "BillingDocument",
                    "source_step_id": "billing_items_by_delivery",
                    "source_field": "BillingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ],
                "rationale": "Load FI receivable and clearing evidence for delivery-related billing documents."
              },
              {
                "step_id": "clearing_documents_by_order_billing",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "FiscalYear",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "AccountingDocumentType",
                  "ClearingAccountingDocument",
