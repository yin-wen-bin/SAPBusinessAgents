                "entity_set": "A_BillingDocument",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentType",
                  "BillingDocumentDate",
                  "AccountingDocument",
                  "OverallBillingStatus",
                  "TotalNetAmount",
                  "TransactionCurrency"
