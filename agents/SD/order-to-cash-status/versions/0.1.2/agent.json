                "filter_from_previous": [
                  {
                    "field": "BillingDocument",
                    "source_step_id": "billing_items_by_order",
                    "source_field": "BillingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ],
                "rationale": "Load headers for direct order-related billing documents."
              },
              {
                "step_id": "billing_headers_by_delivery",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocument",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentType",
                  "BillingDocumentDate",
                  "AccountingDocument",
                  "OverallBillingStatus",
                  "TotalNetAmount",
                  "TransactionCurrency"
                ],
                "filter_from_previous": [
                  {
                    "field": "BillingDocument",
                    "source_step_id": "billing_items_by_delivery",
                    "source_field": "BillingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ],
                "rationale": "Load headers for delivery-related billing documents."
              },
              {
                "step_id": "accounting_items_by_sales_order",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
