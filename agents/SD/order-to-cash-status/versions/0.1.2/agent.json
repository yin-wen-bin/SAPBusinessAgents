        "sales_order": {
          "type": "string",
          "title": {
            "zh": "销售订单号",
            "en": "Sales order"
          },
          "description": {
            "zh": "只输入销售订单号，例如 5814；不要输入完整句子。",
            "en": "Enter only the sales-order number, for example 5814; do not enter a sentence."
          },
          "placeholder": {
            "zh": "例如：5814",
            "en": "Example: 5814"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "sales_order"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
