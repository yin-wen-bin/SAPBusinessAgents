{
  "schemaVersion": 2,
  "slug": "order-to-cash-status",
  "module": "SD",
  "title": {
    "zh": "订单到收款状态助手",
    "en": "Order-to-Cash Status"
  },
  "summary": {
    "zh": "从销售订单、客户PO、交货或发票出发，追踪到FI清账和回款状态。",
    "en": "Traces a sales order, customer PO, delivery or invoice through FI clearing and collection status."
  },
  "status": "Runnable prototype",
  "version": "0.1.0",
  "owner": "SD / FI-AR",
  "tags": [
    "Order-to-Cash",
    "SAP SD",
    "Read-only",
    "Explainable AI"
  ],
  "sapModules": [
    "SD",
    "FI-AR"
  ],
  "transactions": [
    "VA03",
    "VL03N",
    "VF03",
    "FBL5N",
    "FB03"
  ],
  "tables": [
    "VBAK",
    "VBAP",
    "LIKP",
    "LIPS",
    "VBRK",
    "VBRP",
    "BKPF",
    "BSEG",
    "BSID",
    "BSAD"
  ],
  "systems": [
    "SAP ECC",
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "自然语言业务问题",
      "可选业务对象标识",
      "查询基准日",
      "SAP只读证据"
    ],
    "en": [
      "Natural-language business question",
      "Optional business-object identifier",
      "As-of date",
      "Read-only SAP evidence"
    ]
  },
  "outputs": {
    "zh": [
      "状态与可解释分析",
      "异常和阻塞原因",
      "建议动作",
      "Markdown或JSON"
    ],
    "en": [
      "Status and explainable analysis",
      "Anomalies and blockers",
      "Recommended actions",
      "Markdown or JSON"
    ]
  },
  "guardrails": {
    "zh": [
      "严格只读，不创建或修改SAP凭证",
      "Fixture不得冒充真机证据",
      "凭据和敏感业务数据不得写入报告"
    ],
    "en": [
      "Strictly read-only; never creates or changes SAP documents",
      "Fixtures never masquerade as live evidence",
      "Credentials and sensitive business data are excluded from reports"
    ]
  },
  "workflow": [
    {
      "id": "parse-user-input",
      "title": {
        "zh": "解析输入和范围",
        "en": "Parse input and scope"
      },
      "description": {
        "zh": "解析自然语言对象标识、日期和组织范围。",
        "en": "Parse natural-language identifiers, dates and organizational scope."
      },
      "operations": {
        "zh": [
          "解析自然语言对象标识、日期和组织范围。"
        ],
        "en": [
          "Parse natural-language identifiers, dates and organizational scope."
        ]
      },
      "tools": [
        {
          "name": "QueryExtractor",
          "kind": "Agent component",
          "purpose": {
            "zh": "提取查询对象并保留歧义。",
            "en": "Extract query objects while preserving ambiguity."
          }
        }
      ]
    },
    {
      "id": "check-thin-runtime",
      "title": {
        "zh": "检查SAP只读Provider",
        "en": "Check the SAP read Provider"
      },
      "description": {
        "zh": "确认Runtime健康、启用、只读且schema可执行。",
        "en": "Require a healthy, enabled, read-only runtime and executable schemas."
      },
      "operations": {
        "zh": [
          "确认Runtime健康、启用、只读且schema可执行。"
        ],
        "en": [
          "Require a healthy, enabled, read-only runtime and executable schemas."
        ]
      },
      "tools": [
        {
          "name": "sap_read.health / sap_read.schema",
          "kind": "SAP Read Provider",
          "purpose": {
            "zh": "执行健康和权威schema检查。",
            "en": "Run health and authoritative schema checks."
          }
        }
      ]
    },
    {
      "id": "load-sap-data",
      "title": {
        "zh": "读取SAP证据",
        "en": "Load SAP evidence"
      },
      "description": {
        "zh": "使用服务端过滤、窄字段和完整分页读取业务证据。",
        "en": "Read business evidence with server filters, narrow fields and complete pagination."
      },
      "operations": {
        "zh": [
          "使用服务端过滤、窄字段和完整分页读取业务证据。"
        ],
        "en": [
          "Read business evidence with server filters, narrow fields and complete pagination."
        ]
      },
      "tools": [
        {
          "name": "API_SALES_ORDER_SRV + API_OUTBOUND_DELIVERY_SRV + API_BILLING_DOCUMENT_SRV + API_OPLACCTGDOCITEMCUBE_SRV",
          "kind": "SAP OData via sap_read.execute_get",
          "purpose": {
            "zh": "执行批准的只读GET。",
            "en": "Execute approved read-only GET requests."
          }
        }
      ],
      "sapScope": {
        "modules": [
          "SD",
          "FI-AR"
        ],
        "transactions": [
          "VA03",
          "VL03N",
          "VF03",
          "FBL5N",
          "FB03"
        ],
        "tables": [
          "VBAK",
          "VBAP",
          "LIKP",
          "LIPS",
          "VBRK",
          "VBRP",
          "BKPF",
          "BSEG",
          "BSID",
          "BSAD"
        ]
      }
    },
    {
      "id": "supplement-with-skill",
      "title": {
        "zh": "按需补充SAPSkillhub证据",
        "en": "Supplement with SAPSkillhub"
      },
      "description": {
        "zh": "仅当标准OData缺少必要证据时调用明确匹配的只读skill。",
        "en": "Call an explicitly matched read-only skill only when standard OData lacks required evidence."
      },
      "operations": {
        "zh": [
          "仅当标准OData缺少必要证据时调用明确匹配的只读skill。"
        ],
        "en": [
          "Call an explicitly matched read-only skill only when standard OData lacks required evidence."
        ]
      },
      "tools": [
        {
          "name": "SAPSkillhub read-only skill",
          "kind": "SAPSkill",
          "purpose": {
            "zh": "补充GUI、CDS或输出管理证据。",
            "en": "Supplement GUI, CDS or output-management evidence."
          }
        }
      ]
    },
    {
      "id": "assemble-evidence",
      "title": {
        "zh": "组装脱敏证据",
        "en": "Assemble sanitized evidence"
      },
      "description": {
        "zh": "生成带run id、来源、只读标志和分页状态的evidence。",
        "en": "Create evidence with run id, provenance, read-only flag and pagination state."
      },
      "operations": {
        "zh": [
          "生成带run id、来源、只读标志和分页状态的evidence。"
        ],
        "en": [
          "Create evidence with run id, provenance, read-only flag and pagination state."
        ]
      },
      "tools": [
        {
          "name": "Evidence snapshot builder",
          "kind": "Agent component",
          "purpose": {
            "zh": "验证并脱敏证据快照。",
            "en": "Validate and sanitize the evidence snapshot."
          }
        }
      ]
    },
    {
      "id": "validate-evidence",
      "title": {
        "zh": "校验证据质量",
        "en": "Validate evidence quality"
      },
      "description": {
        "zh": "检查必填字段、单位、币种、冲销、重复与来源完整性。",
        "en": "Check required fields, units, currencies, reversals, duplicates and provenance."
      },
      "operations": {
        "zh": [
          "检查必填字段、单位、币种、冲销、重复与来源完整性。"
        ],
        "en": [
          "Check required fields, units, currencies, reversals, duplicates and provenance."
        ]
      },
      "tools": [
        {
          "name": "EvidenceValidator",
          "kind": "Agent component",
          "purpose": {
            "zh": "阻止不完整证据被误判为正常。",
            "en": "Prevent incomplete evidence from being treated as normal."
          }
        }
      ]
    },
    {
      "id": "analyze-business-rule",
      "title": {
        "zh": "执行可解释分析",
        "en": "Run explainable analysis"
      },
      "description": {
        "zh": "运行确定性规则、分类或版本化评分，不生成SAP写操作。",
        "en": "Run deterministic rules, classification or versioned scoring without SAP writes."
      },
      "operations": {
        "zh": [
          "运行确定性规则、分类或版本化评分，不生成SAP写操作。"
        ],
        "en": [
          "Run deterministic rules, classification or versioned scoring without SAP writes."
        ]
      },
      "tools": [
        {
          "name": "SD O2C analyzer",
          "kind": "Agent component",
          "purpose": {
            "zh": "生成状态、评分、发现和建议动作。",
            "en": "Produce status, score, findings and recommended actions."
          }
        }
      ]
    },
    {
      "id": "present-report",
      "title": {
        "zh": "输出报告",
        "en": "Present report"
      },
      "description": {
        "zh": "输出Markdown和JSON，并区分真机、Fixture与推断证据。",
        "en": "Output Markdown and JSON while separating live, fixture and inferred evidence."
      },
      "operations": {
        "zh": [
          "输出Markdown和JSON，并区分真机、Fixture与推断证据。"
        ],
        "en": [
          "Output Markdown and JSON while separating live, fixture and inferred evidence."
        ]
      },
      "tools": [
        {
          "name": "Markdown / JSON formatter",
          "kind": "Presentation",
          "purpose": {
            "zh": "生成可审计的双格式结果。",
            "en": "Generate auditable dual-format results."
          }
        }
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "sales_order": {
          "type": "string",
          "title": { "zh": "销售订单号", "en": "Sales order" },
          "description": { "zh": "只输入销售订单号，例如 5814；不要输入完整句子。", "en": "Enter only the sales-order number, for example 5814; do not enter a sentence." },
          "placeholder": { "zh": "例如：5814", "en": "Example: 5814" },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]+$"
        }
      },
      "required": ["sales_order"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "sales_order": { "type": "string" },
        "company_code": { "type": "string" },
        "customer": { "type": "string" },
        "business_status": { "type": "string" },
        "source_complete": { "type": "boolean" },
        "business_report": { "type": "object" }
      },
      "required": ["sales_order", "business_status", "source_complete", "business_report"],
      "additionalProperties": false
    },
    "outputMapping": {
      "sales_order": "{{steps.validate_o2c_evidence.output.workflow_output.sales_order}}",
      "company_code": "{{steps.validate_o2c_evidence.output.workflow_output.company_code}}",
      "customer": "{{steps.validate_o2c_evidence.output.workflow_output.customer}}",
      "business_status": "{{steps.validate_o2c_evidence.output.workflow_output.business_status}}",
      "source_complete": "{{steps.validate_o2c_evidence.output.workflow_output.source_complete}}",
      "business_report": "{{steps.validate_o2c_evidence.output.workflow_output.business_report}}"
    },
    "steps": [
      {
        "id": "collect_o2c_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_SALES_ORDER_SRV",
            "entity_set": "A_SalesOrder",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "target_entity_set": "A_OperationalAcctgDocItemCube",
            "steps": [
              {
                "step_id": "sales_order",
                "service_name": "API_SALES_ORDER_SRV",
                "entity_set": "A_SalesOrder",
                "http_method": "GET",
                "filters": [{ "field": "SalesOrder", "operator": "eq", "value": "{{input.sales_order}}", "value_type": "string" }],
                "rationale": "Load the requested sales order."
              },
              {
                "step_id": "sales_order_items",
                "service_name": "API_SALES_ORDER_SRV",
                "entity_set": "A_SalesOrderItem",
                "http_method": "GET",
                "filters": [{ "field": "SalesOrder", "operator": "eq", "value": "{{input.sales_order}}", "value_type": "string" }],
                "rationale": "Load every sales-order item."
              },
              {
                "step_id": "delivery_items",
                "service_name": "API_OUTBOUND_DELIVERY_SRV",
                "entity_set": "A_OutbDeliveryItem",
                "http_method": "GET",
                "select_fields": ["DeliveryDocument", "DeliveryDocumentItem", "ReferenceSDDocument", "ReferenceSDDocumentItem", "ActualDeliveryQuantity", "GoodsMovementStatus", "DeliveryRelatedBillingStatus"],
                "filters": [{ "field": "ReferenceSDDocument", "operator": "eq", "value": "{{input.sales_order}}", "value_type": "string" }],
                "rationale": "Load outbound-delivery items referencing the sales order."
              },
              {
                "step_id": "delivery_headers",
                "service_name": "API_OUTBOUND_DELIVERY_SRV",
                "entity_set": "A_OutbDeliveryHeader",
                "http_method": "GET",
                "select_fields": ["DeliveryDocument", "ActualGoodsMovementDate", "OverallGoodsMovementStatus", "OverallSDProcessStatus"],
                "filter_from_previous": [
                  { "field": "DeliveryDocument", "source_step_id": "delivery_items", "source_field": "DeliveryDocument", "fanout": true, "fetch_all_for_binding": true }
                ],
                "rationale": "Load delivery-header PGI evidence for every related delivery."
              },
              {
                "step_id": "billing_items_by_order",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "entity_set": "A_BillingDocumentItem",
                "http_method": "GET",
                "select_fields": ["BillingDocument", "BillingDocumentItem", "ReferenceSDDocument", "ReferenceSDDocumentItem", "SalesDocument", "SalesDocumentItem"],
                "filters": [{ "field": "ReferenceSDDocument", "operator": "eq", "value": "{{input.sales_order}}", "value_type": "string" }],
                "rationale": "Load order-related billing items that directly reference the sales order."
              },
              {
                "step_id": "billing_items_by_delivery",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "entity_set": "A_BillingDocumentItem",
                "http_method": "GET",
                "select_fields": ["BillingDocument", "BillingDocumentItem", "ReferenceSDDocument", "ReferenceSDDocumentItem", "SalesDocument", "SalesDocumentItem"],
                "filter_from_previous": [
                  { "field": "ReferenceSDDocument", "source_step_id": "delivery_items", "source_field": "DeliveryDocument", "fanout": true, "fetch_all_for_binding": true }
                ],
                "rationale": "Load delivery-related billing items by binding each delivery document to ReferenceSDDocument."
              },
              {
                "step_id": "billing_headers_by_order",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "entity_set": "A_BillingDocument",
                "http_method": "GET",
                "select_fields": ["BillingDocument", "BillingDocumentType", "BillingDocumentDate", "AccountingDocument", "OverallBillingStatus"],
                "filter_from_previous": [
                  { "field": "BillingDocument", "source_step_id": "billing_items_by_order", "source_field": "BillingDocument", "fanout": true, "fetch_all_for_binding": true }
                ],
                "rationale": "Load headers for direct order-related billing documents."
              },
              {
                "step_id": "billing_headers_by_delivery",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "entity_set": "A_BillingDocument",
                "http_method": "GET",
                "select_fields": ["BillingDocument", "BillingDocumentType", "BillingDocumentDate", "AccountingDocument", "OverallBillingStatus"],
                "filter_from_previous": [
                  { "field": "BillingDocument", "source_step_id": "billing_items_by_delivery", "source_field": "BillingDocument", "fanout": true, "fetch_all_for_binding": true }
                ],
                "rationale": "Load headers for delivery-related billing documents."
              },
              {
                "step_id": "accounting_items_by_sales_order",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": ["CompanyCode", "FiscalYear", "AccountingDocument", "AccountingDocumentItem", "BillingDocument", "SalesDocument", "Customer", "AccountingDocumentType", "ClearingAccountingDocument", "ClearingDocFiscalYear", "IsCleared", "PaymentMethod", "HouseBank", "HouseBankAccount"],
                "filters": [{ "field": "SalesDocument", "operator": "eq", "value": "{{input.sales_order}}", "value_type": "string" }],
                "rationale": "Load FI evidence directly associated with the sales order."
              },
              {
                "step_id": "accounting_by_order_billing",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": ["CompanyCode", "FiscalYear", "AccountingDocument", "AccountingDocumentItem", "BillingDocument", "SalesDocument", "Customer", "AccountingDocumentType", "ClearingAccountingDocument", "ClearingDocFiscalYear", "IsCleared", "PaymentMethod", "HouseBank", "HouseBankAccount"],
                "filter_from_previous": [
                  { "field": "BillingDocument", "source_step_id": "billing_items_by_order", "source_field": "BillingDocument", "fanout": true, "fetch_all_for_binding": true }
                ],
                "rationale": "Load FI receivable and clearing evidence for direct order-related billing documents."
              },
              {
                "step_id": "accounting_by_delivery_billing",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": ["CompanyCode", "FiscalYear", "AccountingDocument", "AccountingDocumentItem", "BillingDocument", "SalesDocument", "Customer", "AccountingDocumentType", "ClearingAccountingDocument", "ClearingDocFiscalYear", "IsCleared", "PaymentMethod", "HouseBank", "HouseBankAccount"],
                "filter_from_previous": [
                  { "field": "BillingDocument", "source_step_id": "billing_items_by_delivery", "source_field": "BillingDocument", "fanout": true, "fetch_all_for_binding": true }
                ],
                "rationale": "Load FI receivable and clearing evidence for delivery-related billing documents."
              },
              {
                "step_id": "clearing_documents_by_order_billing",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": ["CompanyCode", "FiscalYear", "AccountingDocument", "AccountingDocumentItem", "AccountingDocumentType", "ClearingAccountingDocument", "IsCleared", "Customer", "PaymentMethod", "HouseBank", "HouseBankAccount"],
                "filter_from_previous": [
                  { "field": "AccountingDocument", "source_step_id": "accounting_by_order_billing", "source_field": "ClearingAccountingDocument", "fanout": true, "fetch_all_for_binding": true },
                  { "field": "CompanyCode", "source_step_id": "accounting_by_order_billing", "source_field": "CompanyCode", "fanout": true, "fetch_all_for_binding": true },
                  { "field": "FiscalYear", "source_step_id": "accounting_by_order_billing", "source_field": "ClearingDocFiscalYear", "fanout": true, "fetch_all_for_binding": true }
                ],
                "rationale": "Load clearing-document evidence for direct order-related billing."
              },
              {
                "step_id": "clearing_documents_by_delivery_billing",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": ["CompanyCode", "FiscalYear", "AccountingDocument", "AccountingDocumentItem", "AccountingDocumentType", "ClearingAccountingDocument", "IsCleared", "Customer", "PaymentMethod", "HouseBank", "HouseBankAccount"],
                "filter_from_previous": [
                  { "field": "AccountingDocument", "source_step_id": "accounting_by_delivery_billing", "source_field": "ClearingAccountingDocument", "fanout": true, "fetch_all_for_binding": true },
                  { "field": "CompanyCode", "source_step_id": "accounting_by_delivery_billing", "source_field": "CompanyCode", "fanout": true, "fetch_all_for_binding": true },
                  { "field": "FiscalYear", "source_step_id": "accounting_by_delivery_billing", "source_field": "ClearingDocFiscalYear", "fanout": true, "fetch_all_for_binding": true }
                ],
                "rationale": "Load clearing-document evidence for delivery-related billing without treating clearing as bank receipt."
              }
            ],
            "rationale": "Trace the selected sales order through delivery, billing and FI clearing using GET-only SAP APIs."
          }
        }
      },
      {
        "id": "validate_o2c_evidence",
        "executor": "rule",
        "operation": "evaluate_o2c_status",
        "inputMapping": {
          "run_input": "{{input}}",
          "sap_read": "{{steps.collect_o2c_evidence.output}}"
        }
      }
    ]
  }
}
