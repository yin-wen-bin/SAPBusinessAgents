{
  "schemaVersion": 2,
  "slug": "delivery-delay-prediction",
  "module": "SD",
  "title": {
    "zh": "交货延期预测",
    "en": "Delivery Delay Prediction"
  },
  "summary": {
    "zh": "使用可解释规则对未完成交货生成0到100的延期风险评分。",
    "en": "Uses explainable rules to assign a 0-to-100 delay-risk score to incomplete deliveries."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.1.0",
  "owner": "SD / FI-AR",
  "tags": [
    "Order-to-Cash",
    "SAP SD",
    "Read-only",
    "Explainable AI"
  ],
  "sapModules": [
    "SD"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "销售组织",
      "开始日期",
      "结束日期"
    ],
    "en": [
      "Sales organization",
      "Start date",
      "End date"
    ]
  },
  "outputs": {
    "zh": [
      "销售组织",
      "开始日期",
      "结束日期",
      "业务状态",
      "查询源完整性",
      "结构化业务报告"
    ],
    "en": [
      "Sales organization",
      "Start date",
      "End date",
      "Business status",
      "Query-source completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "严格只读，不创建或修改SAP凭证",
      "Fixture不得冒充真机证据",
      "凭据和敏感业务数据不得写入报告"
    ],
    "en": [
      "Strictly read-only; never creates or changes SAP documents",
      "Fixtures never masquerade as live evidence",
      "Credentials and sensitive business data are excluded from reports"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_delivery_delay_evidence",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_delivery_delay_evidence`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_delivery_delay_evidence` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrder",
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderItem",
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderScheduleLine",
          "GET API_OUTBOUND_DELIVERY_SRV@2.0/A_OutbDeliveryItem",
          "GET API_OUTBOUND_DELIVERY_SRV@2.0/A_OutbDeliveryHeader"
        ],
        "en": [
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrder",
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderItem",
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderScheduleLine",
          "GET API_OUTBOUND_DELIVERY_SRV@2.0/A_OutbDeliveryItem",
          "GET API_OUTBOUND_DELIVERY_SRV@2.0/A_OutbDeliveryHeader"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_delivery_delay_evidence` / `execute_plan`",
            "en": "Execute `collect_delivery_delay_evidence` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_delivery_delay_evidence"
      ]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate_business_result`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate_business_result` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "sales_organization": {
          "type": "string",
          "title": {
            "zh": "销售组织",
            "en": "Sales organization"
          },
          "description": {
            "zh": "请输入销售组织。",
            "en": "Enter the sales organization."
          },
          "placeholder": {
            "zh": "例如：1710",
            "en": "Example: 1710"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "date_from": {
          "type": "string",
          "title": {
            "zh": "开始日期",
            "en": "Start date"
          },
          "description": {
            "zh": "请输入开始日期。",
            "en": "Enter the start date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "date_to": {
          "type": "string",
          "title": {
            "zh": "结束日期",
            "en": "End date"
          },
          "description": {
            "zh": "请输入结束日期。",
            "en": "Enter the end date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "sales_organization",
        "date_from",
        "date_to"
      ],
      "additionalProperties": false,
      "dateRangePairs": [
        {
          "from": "date_from",
          "to": "date_to",
          "maxDays": 31
        }
      ]
    },
    "steps": [
      {
        "id": "collect_delivery_delay_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_SALES_ORDER_SRV",
            "odata_version": "2.0",
            "entity_set": "A_SalesOrder",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "sales_orders",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrder",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrganization",
                  "RequestedDeliveryDate",
                  "TotalBlockStatus",
                  "TotalCreditCheckStatus",
                  "DeliveryBlockReason"
                ],
                "rationale": "Load sales orders in the requested-delivery range.",
                "filters": [
                  {
                    "field": "SalesOrganization",
                    "operator": "eq",
                    "value": "{{input.sales_organization}}",
                    "value_type": "string"
                  },
                  {
                    "field": "RequestedDeliveryDate",
                    "operator": "ge",
                    "value": "{{input.date_from}}",
                    "value_type": "date_start"
                  },
                  {
                    "field": "RequestedDeliveryDate",
                    "operator": "le",
                    "value": "{{input.date_to}}",
                    "value_type": "date_end"
                  }
                ]
              },
              {
                "step_id": "sales_order_items",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrderItem",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrderItem",
                  "Material",
                  "ProductionPlant",
                  "RequestedQuantity",
                  "RequestedQuantityUnit",
                  "OrderQuantityUnit",
                  "ConfdDelivQtyInOrderQtyUnit",
                  "DeliveryPriority",
                  "DeliveryStatus"
                ],
                "rationale": "Load items for selected sales orders.",
                "filter_from_previous": [
                  {
                    "field": "SalesOrder",
                    "source_step_id": "sales_orders",
                    "source_field": "SalesOrder",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "schedule_lines",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrderScheduleLine",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrderItem",
                  "ScheduleLine",
                  "RequestedDeliveryDate",
                  "ConfirmedDeliveryDate",
                  "ScheduleLineOrderQuantity",
                  "ConfdOrderQtyByMatlAvailCheck",
                  "DeliveredQtyInOrderQtyUnit",
                  "DelivBlockReasonForSchedLine"
                ],
                "rationale": "Load schedule-line commitment evidence.",
                "filter_from_previous": [
                  {
                    "field": "SalesOrder",
                    "source_step_id": "sales_order_items",
                    "source_field": "SalesOrder",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "SalesOrderItem",
                    "source_step_id": "sales_order_items",
                    "source_field": "SalesOrderItem",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "delivery_items",
                "service_name": "API_OUTBOUND_DELIVERY_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OutbDeliveryItem",
                "http_method": "GET",
                "select_fields": [
                  "DeliveryDocument",
                  "DeliveryDocumentItem",
                  "ReferenceSDDocument",
                  "ReferenceSDDocumentItem",
                  "ActualDeliveryQuantity",
                  "GoodsMovementStatus"
                ],
                "rationale": "Load deliveries that actually reference the selected sales orders; the rule joins item keys from the returned evidence.",
                "filter_from_previous": [
                  {
                    "field": "ReferenceSDDocument",
                    "source_step_id": "sales_orders",
                    "source_field": "SalesOrder",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "delivery_headers",
                "service_name": "API_OUTBOUND_DELIVERY_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OutbDeliveryHeader",
                "http_method": "GET",
                "select_fields": [
                  "DeliveryDocument",
                  "SalesOrganization",
                  "PlannedGoodsIssueDate",
                  "ActualGoodsMovementDate",
                  "OverallGoodsMovementStatus",
                  "DeliveryBlockReason",
                  "TotalCreditCheckStatus"
                ],
                "rationale": "Load execution dates for deliveries linked by stable document references.",
                "filter_from_previous": [
                  {
                    "field": "DeliveryDocument",
                    "source_step_id": "delivery_items",
                    "source_field": "DeliveryDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              }
            ],
            "rationale": "Collect deterministic delivery-risk evidence."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "delivery-delay-prediction",
          "run_input": "{{input}}",
          "evidence": {
            "collect_delivery_delay_evidence": "{{steps.collect_delivery_delay_evidence.output}}"
          },
          "known_gaps": []
        }
      }
    ],
    "outputSchema": {
      "type": "object",
      "properties": {
        "sales_organization": {
