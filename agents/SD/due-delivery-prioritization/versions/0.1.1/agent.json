      "严格只读，不创建或修改SAP凭证",
      "Fixture不得冒充真机证据",
      "凭据和敏感业务数据不得写入报告"
    ],
    "en": [
      "Strictly read-only; never creates or changes SAP documents",
      "Fixtures never masquerade as live evidence",
      "Credentials and sensitive business data are excluded from reports"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_due_priority_evidence",
      "title": {
        "zh": "读取到期交货与执行状态",
        "en": "Read due deliveries and execution status"
      },
      "description": {
        "zh": "读取到期交货与执行状态，按本次输入范围取得只读证据并保留来源和缺口。",
        "en": "Read due deliveries and execution status within the requested scope, preserving read-only evidence references and gaps."
      },
      "operations": {
        "zh": [
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrder",
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderItem",
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderScheduleLine",
          "GET API_MATERIAL_STOCK_SRV@2.0/A_MatlStkInAcctMod"
        ],
        "en": [
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrder",
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderItem",
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderScheduleLine",
          "GET API_MATERIAL_STOCK_SRV@2.0/A_MatlStkInAcctMod"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_due_priority_evidence` / `execute_plan`",
            "en": "Execute `collect_due_priority_evidence` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_due_priority_evidence"
      ]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "生成到期交货处理顺序",
        "en": "Prioritize due-delivery follow-up"
      },
      "description": {
        "zh": "生成到期交货处理顺序；只解释已取得的证据，不新增SAP查询或执行业务写入。",
        "en": "Prioritize due-delivery follow-up using acquired evidence only; this step adds no SAP query or business write."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "sales_organization": {
          "type": "string",
          "title": {
            "zh": "销售组织",
            "en": "Sales organization"
          },
          "description": {
            "zh": "请输入销售组织。",
            "en": "Enter the sales organization."
          },
          "placeholder": {
            "zh": "例如：1710",
            "en": "Example: 1710"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "plant": {
          "type": "string",
          "title": {
            "zh": "工厂",
            "en": "Plant"
          },
          "description": {
            "zh": "请输入工厂。",
            "en": "Enter the plant."
          },
          "placeholder": {
            "zh": "例如：1710",
            "en": "Example: 1710"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "date_from": {
          "type": "string",
