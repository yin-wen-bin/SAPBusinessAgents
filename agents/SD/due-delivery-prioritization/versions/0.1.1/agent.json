    "steps": [
      {
        "id": "collect_due_priority_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_SALES_ORDER_SRV",
            "odata_version": "2.0",
            "entity_set": "A_SalesOrder",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "sales_orders",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrder",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrganization",
                  "RequestedDeliveryDate",
                  "TotalBlockStatus",
                  "TotalCreditCheckStatus",
                  "DeliveryBlockReason"
                ],
                "rationale": "Load sales orders in the requested-delivery range.",
                "filters": [
                  {
                    "field": "SalesOrganization",
                    "operator": "eq",
                    "value": "{{input.sales_organization}}",
                    "value_type": "string"
                  },
                  {
                    "field": "RequestedDeliveryDate",
                    "operator": "ge",
                    "value": "{{input.date_from}}",
                    "value_type": "date_start"
                  },
                  {
                    "field": "RequestedDeliveryDate",
                    "operator": "le",
                    "value": "{{input.date_to}}",
                    "value_type": "date_end"
                  }
                ]
              },
              {
                "step_id": "sales_order_items",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrderItem",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrderItem",
                  "Material",
                  "ProductionPlant",
                  "RequestedQuantity",
                  "RequestedQuantityUnit",
                  "OrderQuantityUnit",
                  "ConfdDelivQtyInOrderQtyUnit",
                  "DeliveryPriority",
                  "DeliveryStatus"
                ],
                "rationale": "Load items for selected sales orders.",
                "filter_from_previous": [
                  {
                    "field": "SalesOrder",
                    "source_step_id": "sales_orders",
                    "source_field": "SalesOrder",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "schedule_lines",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrderScheduleLine",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrderItem",
                  "ScheduleLine",
                  "RequestedDeliveryDate",
                  "ConfirmedDeliveryDate",
                  "ScheduleLineOrderQuantity",
                  "ConfdOrderQtyByMatlAvailCheck",
                  "DeliveredQtyInOrderQtyUnit",
                  "DelivBlockReasonForSchedLine"
                ],
                "rationale": "Load schedule-line commitment evidence.",
                "filter_from_previous": [
                  {
                    "field": "SalesOrder",
                    "source_step_id": "sales_order_items",
                    "source_field": "SalesOrder",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "SalesOrderItem",
                    "source_step_id": "sales_order_items",
                    "source_field": "SalesOrderItem",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "material_stock",
                "service_name": "API_MATERIAL_STOCK_SRV",
                "odata_version": "2.0",
                "entity_set": "A_MatlStkInAcctMod",
                "http_method": "GET",
                "select_fields": [
                  "Material",
                  "Plant",
                  "StorageLocation",
                  "MaterialBaseUnit",
                  "MatlWrhsStkQtyInMatlBaseUnit",
                  "InventoryStockType"
                ],
                "rationale": "Load plant stock used as supporting prioritization evidence.",
                "filters": [
                  {
                    "field": "Plant",
                    "operator": "eq",
                    "value": "{{input.plant}}",
                    "value_type": "string"
                  }
                ]
              }
            ],
            "rationale": "Collect due-delivery priority evidence."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "due-delivery-prioritization",
          "run_input": "{{input}}",
          "evidence": {
            "collect_due_priority_evidence": "{{steps.collect_due_priority_evidence.output}}"
          },
          "known_gaps": []
        }
      }
    ],
