{
  "schemaVersion": 2,
  "slug": "shortage-allocation-advisor",
  "module": "SD",
  "title": {
    "zh": "缺货分配建议",
    "en": "Shortage Allocation Advisor"
  },
  "summary": {
    "zh": "结合确认数量、物料库存和ATP，生成严格只读的短缺分配建议。",
    "en": "Combines confirmed quantities, material stock and ATP evidence to produce strictly read-only shortage-allocation recommendations."
  },
  "status": "Three-stage live acceptance blocked",
  "version": "0.1.0",
  "owner": "SD / FI-AR",
  "tags": [
    "Order-to-Cash",
    "SAP SD",
    "Read-only",
    "Explainable AI"
  ],
  "sapModules": [
    "SD"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "工厂",
      "物料",
      "开始日期",
      "结束日期"
    ],
    "en": [
      "Plant",
      "Material",
      "Start date",
      "End date"
    ]
  },
  "outputs": {
    "zh": [
      "工厂",
      "物料",
      "开始日期",
      "结束日期",
      "业务状态",
      "查询源完整性",
      "结构化业务报告"
    ],
    "en": [
      "Plant",
      "Material",
      "Start date",
      "End date",
      "Business status",
      "Query-source completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "严格只读，不创建或修改SAP凭证",
      "Fixture不得冒充真机证据",
      "凭据和敏感业务数据不得写入报告"
    ],
    "en": [
      "Strictly read-only; never creates or changes SAP documents",
      "Fixtures never masquerade as live evidence",
      "Credentials and sensitive business data are excluded from reports"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_shortage_evidence",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_shortage_evidence`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_shortage_evidence` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderItem",
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderScheduleLine",
          "GET API_MATERIAL_STOCK_SRV@2.0/A_MatlStkInAcctMod"
        ],
        "en": [
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderItem",
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderScheduleLine",
          "GET API_MATERIAL_STOCK_SRV@2.0/A_MatlStkInAcctMod"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_shortage_evidence` / `execute_plan`",
            "en": "Execute `collect_shortage_evidence` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_shortage_evidence"
      ]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate_business_result`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate_business_result` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "plant": {
          "type": "string",
          "title": {
            "zh": "工厂",
            "en": "Plant"
          },
          "description": {
            "zh": "请输入工厂。",
            "en": "Enter the plant."
          },
          "placeholder": {
            "zh": "例如：1710",
            "en": "Example: 1710"
          },
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "material": {
          "type": "string",
          "title": {
            "zh": "物料",
            "en": "Material"
          },
          "description": {
            "zh": "请输入物料。",
            "en": "Enter the material."
          },
          "placeholder": {
            "zh": "例如：SG21",
            "en": "Example: SG21"
          },
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "date_from": {
          "type": "string",
          "title": {
            "zh": "开始日期",
            "en": "Start date"
          },
          "description": {
            "zh": "请输入开始日期。",
            "en": "Enter the start date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "date_to": {
          "type": "string",
          "title": {
            "zh": "结束日期",
            "en": "End date"
          },
          "description": {
            "zh": "请输入结束日期。",
            "en": "Enter the end date."
          },
          "placeholder": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "plant",
        "material",
        "date_from",
        "date_to"
      ],
      "additionalProperties": false,
      "dateRangePairs": [
        {
          "from": "date_from",
          "to": "date_to",
          "maxDays": 31
        }
      ]
    },
    "steps": [
      {
        "id": "collect_shortage_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_SALES_ORDER_SRV",
            "odata_version": "2.0",
            "entity_set": "A_SalesOrderItem",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "sales_order_items",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrderItem",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrderItem",
                  "Material",
                  "ProductionPlant",
                  "RequestedQuantity",
                  "RequestedQuantityUnit",
                  "ConfdDelivQtyInOrderQtyUnit",
                  "DeliveryPriority"
                ],
                "rationale": "Load demand for the selected material and plant.",
                "filters": [
                  {
                    "field": "ProductionPlant",
                    "operator": "eq",
                    "value": "{{input.plant}}",
                    "value_type": "string"
                  },
                  {
                    "field": "Material",
                    "operator": "eq",
                    "value": "{{input.material}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "schedule_lines",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrderScheduleLine",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrderItem",
                  "ScheduleLine",
                  "RequestedDeliveryDate",
                  "ConfirmedDeliveryDate",
                  "ScheduleLineOrderQuantity",
                  "ConfdOrderQtyByMatlAvailCheck",
                  "DeliveredQtyInOrderQtyUnit"
                ],
                "rationale": "Load schedule-line demand and confirmations.",
                "filter_from_previous": [
                  {
                    "field": "SalesOrder",
                    "source_step_id": "sales_order_items",
                    "source_field": "SalesOrder",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "SalesOrderItem",
                    "source_step_id": "sales_order_items",
                    "source_field": "SalesOrderItem",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "material_stock",
                "service_name": "API_MATERIAL_STOCK_SRV",
                "odata_version": "2.0",
                "entity_set": "A_MatlStkInAcctMod",
                "http_method": "GET",
                "select_fields": [
                  "Material",
                  "Plant",
                  "StorageLocation",
                  "MaterialBaseUnit",
                  "MatlWrhsStkQtyInMatlBaseUnit",
                  "InventoryStockType"
                ],
                "rationale": "Load the current stock snapshot.",
                "filters": [
                  {
                    "field": "Plant",
                    "operator": "eq",
                    "value": "{{input.plant}}",
                    "value_type": "string"
                  },
                  {
                    "field": "Material",
                    "operator": "eq",
                    "value": "{{input.material}}",
                    "value_type": "string"
                  }
                ]
              }
            ],
            "rationale": "Collect demand and stock evidence."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "shortage-allocation-advisor",
          "run_input": "{{input}}",
          "evidence": {
            "collect_shortage_evidence": "{{steps.collect_shortage_evidence.output}}"
          },
          "known_gaps": [
            "atp_availability_evidence"
          ]
        }
      }
    ],
    "outputSchema": {
      "type": "object",
