    "steps": [
      {
        "id": "collect_delivered_not_billed",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_OUTBOUND_DELIVERY_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OutbDeliveryHeader",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "delivery_headers",
                "service_name": "API_OUTBOUND_DELIVERY_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OutbDeliveryHeader",
                "http_method": "GET",
                "select_fields": [
                  "DeliveryDocument",
                  "SalesOrganization",
                  "ActualGoodsMovementDate",
                  "OverallGoodsMovementStatus",
                  "OverallDelivReltdBillgStatus",
                  "DeliveryBlockReason",
                  "HeaderBillingBlockReason",
                  "PlannedGoodsIssueDate"
                ],
                "rationale": "Load deliveries in the selected PGI period; the Embedded Provider follows server next links and reports paging completeness.",
                "filters": [
                  {
                    "field": "SalesOrganization",
                    "operator": "eq",
                    "value": "{{input.sales_organization}}",
                    "value_type": "string"
                  },
                  {
                    "field": "ActualGoodsMovementDate",
                    "operator": "ge",
                    "value": "{{input.date_from}}",
                    "value_type": "date_start"
                  },
                  {
                    "field": "ActualGoodsMovementDate",
                    "operator": "le",
                    "value": "{{input.date_to}}",
                    "value_type": "date_end"
                  }
                ]
              },
              {
                "step_id": "delivery_items",
                "service_name": "API_OUTBOUND_DELIVERY_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OutbDeliveryItem",
                "http_method": "GET",
                "select_fields": [
                  "DeliveryDocument",
                  "DeliveryDocumentItem",
                  "ReferenceSDDocument",
                  "ReferenceSDDocumentItem",
                  "Plant",
                  "Material",
                  "ActualDeliveryQuantity",
                  "DeliveryQuantityUnit",
                  "GoodsMovementStatus",
                  "DeliveryRelatedBillingStatus"
                ],
                "rationale": "Load items for selected deliveries; deterministic output sorting is applied after complete retrieval because live metadata does not advertise delivery keys as sortable.",
                "filter_from_previous": [
                  {
                    "field": "DeliveryDocument",
                    "source_step_id": "delivery_headers",
                    "source_field": "DeliveryDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "billing_items",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocumentItem",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentItem",
                  "ReferenceSDDocument",
                  "ReferenceSDDocumentItem",
                  "BillingQuantity",
                  "BillingQuantityUnit",
                  "NetAmount",
                  "TransactionCurrency"
                ],
                "order_by": [
                  "BillingDocument",
                  "BillingDocumentItem"
                ],
                "rationale": "Load billing items referencing selected deliveries.",
                "filter_from_previous": [
                  {
                    "field": "ReferenceSDDocument",
                    "source_step_id": "delivery_items",
                    "source_field": "DeliveryDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "ReferenceSDDocumentItem",
                    "source_step_id": "delivery_items",
                    "source_field": "DeliveryDocumentItem",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "billing_headers",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocument",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentDate",
                  "BillingDocumentIsCancelled",
                  "CancelledBillingDocument",
                  "BillingDocumentCategory"
                ],
                "order_by": [
                  "BillingDocument"
                ],
                "rationale": "Load billing dates and cancellation relationships for the referenced billing items.",
                "filter_from_previous": [
                  {
                    "field": "BillingDocument",
                    "source_step_id": "billing_items",
                    "source_field": "BillingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "cancellation_documents_by_reference",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocument",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentDate",
                  "BillingDocumentIsCancelled",
                  "CancelledBillingDocument",
                  "BillingDocumentCategory"
                ],
                "order_by": [
                  "BillingDocument"
                ],
                "rationale": "Load cancellation documents referenced by billing headers.",
                "filter_from_previous": [
                  {
                    "field": "BillingDocument",
                    "source_step_id": "billing_headers",
                    "source_field": "CancelledBillingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "cancellation_documents_by_target",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocument",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentDate",
                  "BillingDocumentIsCancelled",
                  "CancelledBillingDocument",
                  "BillingDocumentCategory"
                ],
                "order_by": [
                  "BillingDocument"
                ],
                "rationale": "Load cancellation documents that point back to billing headers.",
                "filter_from_previous": [
                  {
                    "field": "CancelledBillingDocument",
                    "source_step_id": "billing_headers",
                    "source_field": "BillingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "source_sales_items",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrderItem",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrderItem",
                  "RequestedQuantity",
                  "RequestedQuantityUnit",
                  "NetAmount",
                  "TransactionCurrency"
                ],
                "order_by": [
                  "SalesOrder",
                  "SalesOrderItem"
                ],
                "rationale": "Load source sales-order quantities and net amounts for transparent amount proration.",
                "filter_from_previous": [
                  {
                    "field": "SalesOrder",
                    "source_step_id": "delivery_items",
                    "source_field": "ReferenceSDDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  },
                  {
                    "field": "SalesOrderItem",
                    "source_step_id": "delivery_items",
                    "source_field": "ReferenceSDDocumentItem",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              }
            ],
            "rationale": "Collect delivered-not-billed evidence."
          }
        }
      },
