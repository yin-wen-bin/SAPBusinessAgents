            "en": "YYYY-MM-DD"
          },
          "minLength": 1,
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "sales_organization",
        "date_from",
        "date_to"
      ],
      "additionalProperties": false,
      "dateRangePairs": [
        {
          "from": "date_from",
          "to": "date_to",
          "maxDays": 31
        }
      ]
    },
    "steps": [
      {
        "id": "collect_delivered_not_billed",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_OUTBOUND_DELIVERY_SRV",
            "odata_version": "2.0",
            "entity_set": "A_OutbDeliveryHeader",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "delivery_headers",
                "service_name": "API_OUTBOUND_DELIVERY_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OutbDeliveryHeader",
                "http_method": "GET",
                "select_fields": [
                  "DeliveryDocument",
                  "SalesOrganization",
                  "ActualGoodsMovementDate",
                  "OverallGoodsMovementStatus",
                  "OverallDelivReltdBillgStatus",
                  "DeliveryBlockReason",
                  "HeaderBillingBlockReason",
                  "PlannedGoodsIssueDate"
                ],
                "rationale": "Load deliveries in the selected PGI period.",
                "filters": [
                  {
                    "field": "SalesOrganization",
                    "operator": "eq",
                    "value": "{{input.sales_organization}}",
                    "value_type": "string"
                  },
                  {
                    "field": "ActualGoodsMovementDate",
                    "operator": "ge",
                    "value": "{{input.date_from}}",
                    "value_type": "date_start"
                  },
                  {
                    "field": "ActualGoodsMovementDate",
                    "operator": "le",
                    "value": "{{input.date_to}}",
                    "value_type": "date_end"
                  }
                ]
              },
              {
                "step_id": "delivery_items",
                "service_name": "API_OUTBOUND_DELIVERY_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OutbDeliveryItem",
                "http_method": "GET",
                "select_fields": [
                  "DeliveryDocument",
                  "DeliveryDocumentItem",
                  "ReferenceSDDocument",
                  "ReferenceSDDocumentItem",
                  "Plant",
                  "Material",
                  "ActualDeliveryQuantity",
                  "GoodsMovementStatus",
                  "DeliveryRelatedBillingStatus"
                ],
                "rationale": "Load items for selected deliveries.",
                "filter_from_previous": [
                  {
                    "field": "DeliveryDocument",
                    "source_step_id": "delivery_headers",
                    "source_field": "DeliveryDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "billing_items",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocumentItem",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentItem",
                  "ReferenceSDDocument",
                  "ReferenceSDDocumentItem",
                  "BillingQuantity",
                  "NetAmount",
                  "TransactionCurrency"
                ],
                "rationale": "Load billing items referencing selected deliveries.",
                "filter_from_previous": [
                  {
                    "field": "ReferenceSDDocument",
                    "source_step_id": "delivery_items",
                    "source_field": "DeliveryDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              }
            ],
            "rationale": "Collect delivered-not-billed evidence."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "delivered-not-billed",
          "run_input": "{{input}}",
          "evidence": {
            "collect_delivered_not_billed": "{{steps.collect_delivered_not_billed.output}}"
          },
          "known_gaps": []
        }
      }
