{
  "schemaVersion": 2,
  "slug": "billing-block-diagnosis",
  "module": "SD",
  "title": {
    "zh": "开票冻结诊断",
    "en": "Billing Block Diagnosis"
  },
  "summary": {
    "zh": "诊断销售订单、项目与交货层的开票冻结、信用检查及不完整状态。",
    "en": "Diagnoses billing blocks, credit checks and incompletion statuses at sales-order header, item and delivery levels."
  },
  "status": "Three-stage live acceptance blocked",
  "version": "0.1.0",
  "owner": "SD / FI-AR",
  "tags": [
    "Order-to-Cash",
    "SAP SD",
    "Read-only",
    "Explainable AI"
  ],
  "sapModules": [
    "SD"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "销售订单号"
    ],
    "en": [
      "Sales order"
    ]
  },
  "outputs": {
    "zh": [
      "销售订单号",
      "业务状态",
      "查询源完整性",
      "结构化业务报告"
    ],
    "en": [
      "Sales order",
      "Business status",
      "Query-source completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "严格只读，不创建或修改SAP凭证",
      "Fixture不得冒充真机证据",
      "凭据和敏感业务数据不得写入报告"
    ],
    "en": [
      "Strictly read-only; never creates or changes SAP documents",
      "Fixtures never masquerade as live evidence",
      "Credentials and sensitive business data are excluded from reports"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_billing_block_evidence",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_billing_block_evidence`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_billing_block_evidence` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrder",
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderItem",
          "GET API_OUTBOUND_DELIVERY_SRV@2.0/A_OutbDeliveryItem",
          "GET API_OUTBOUND_DELIVERY_SRV@2.0/A_OutbDeliveryHeader",
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocumentItem",
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocument"
        ],
        "en": [
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrder",
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderItem",
          "GET API_OUTBOUND_DELIVERY_SRV@2.0/A_OutbDeliveryItem",
          "GET API_OUTBOUND_DELIVERY_SRV@2.0/A_OutbDeliveryHeader",
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocumentItem",
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocument"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_billing_block_evidence` / `execute_plan`",
            "en": "Execute `collect_billing_block_evidence` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_billing_block_evidence"
      ]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate_business_result`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate_business_result` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "sales_order": {
          "type": "string",
          "title": {
            "zh": "销售订单号",
            "en": "Sales order"
          },
          "description": {
            "zh": "请输入销售订单号。",
            "en": "Enter the sales order."
          },
          "placeholder": {
            "zh": "例如：5814",
            "en": "Example: 5814"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "sales_order"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "id": "collect_billing_block_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_SALES_ORDER_SRV",
            "odata_version": "2.0",
            "entity_set": "A_SalesOrder",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "sales_orders",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrder",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrganization",
                  "RequestedDeliveryDate",
                  "TotalBlockStatus",
                  "TotalCreditCheckStatus",
                  "HeaderBillingBlockReason",
                  "DeliveryBlockReason",
                  "OverallDeliveryStatus",
                  "OverallOrdReltdBillgStatus"
                ],
                "rationale": "Load the requested sales order.",
                "filters": [
                  {
                    "field": "SalesOrder",
                    "operator": "eq",
                    "value": "{{input.sales_order}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "sales_order_items",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrderItem",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrderItem",
                  "Material",
                  "ProductionPlant",
                  "RequestedQuantity",
                  "ConfdDelivQtyInOrderQtyUnit",
                  "DeliveryPriority",
                  "ItemBillingBlockReason",
                  "DeliveryStatus"
                ],
                "rationale": "Load sales-order items.",
                "filters": [
                  {
                    "field": "SalesOrder",
                    "operator": "eq",
                    "value": "{{input.sales_order}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "delivery_items",
                "service_name": "API_OUTBOUND_DELIVERY_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OutbDeliveryItem",
                "http_method": "GET",
                "select_fields": [
                  "DeliveryDocument",
                  "DeliveryDocumentItem",
                  "ReferenceSDDocument",
                  "ReferenceSDDocumentItem",
                  "Plant",
                  "Material",
                  "ActualDeliveryQuantity",
                  "GoodsMovementStatus",
                  "DeliveryRelatedBillingStatus",
                  "ItemBillingBlockReason"
                ],
                "rationale": "Load deliveries referencing the sales order.",
                "filters": [
                  {
                    "field": "ReferenceSDDocument",
                    "operator": "eq",
                    "value": "{{input.sales_order}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "delivery_headers",
                "service_name": "API_OUTBOUND_DELIVERY_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OutbDeliveryHeader",
                "http_method": "GET",
                "select_fields": [
                  "DeliveryDocument",
                  "ActualGoodsMovementDate",
                  "OverallGoodsMovementStatus",
                  "OverallDelivReltdBillgStatus",
                  "DeliveryBlockReason",
                  "HeaderBillingBlockReason",
                  "TotalCreditCheckStatus"
                ],
                "rationale": "Load delivery header status.",
                "filter_from_previous": [
                  {
                    "field": "DeliveryDocument",
                    "source_step_id": "delivery_items",
                    "source_field": "DeliveryDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "billing_items",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocumentItem",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentItem",
                  "ReferenceSDDocument",
                  "ReferenceSDDocumentItem",
                  "SalesDocument",
                  "SalesDocumentItem",
                  "BillingQuantity",
                  "NetAmount",
                  "TransactionCurrency"
                ],
                "rationale": "Load billing items associated with the sales order.",
                "filters": [
                  {
                    "field": "SalesDocument",
                    "operator": "eq",
                    "value": "{{input.sales_order}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "billing_headers",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocument",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentDate",
                  "BillingDocumentIsCancelled",
                  "AccountingPostingStatus",
                  "OverallBillingStatus",
                  "TotalNetAmount",
                  "TransactionCurrency"
                ],
                "rationale": "Load billing headers.",
                "filter_from_previous": [
                  {
                    "field": "BillingDocument",
                    "source_step_id": "billing_items",
                    "source_field": "BillingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              }
            ],
            "rationale": "Collect sales-order and delivery block evidence."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "billing-block-diagnosis",
          "run_input": "{{input}}",
          "evidence": {
            "collect_billing_block_evidence": "{{steps.collect_billing_block_evidence.output}}"
          },
          "known_gaps": [
            "sales_order_item_incompletion_evidence"
          ]
        }
      }
    ],
    "outputSchema": {
      "type": "object",
      "properties": {
        "sales_order": {
          "type": "string",
          "title": {
            "zh": "销售订单号",
            "en": "Sales order"
          },
          "description": {
            "zh": "请输入销售订单号。",
            "en": "Enter the sales order."
          },
          "placeholder": {
            "zh": "例如：5814",
            "en": "Example: 5814"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]+$"
        },
        "business_status": {
