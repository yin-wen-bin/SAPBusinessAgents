{
  "schemaVersion": 2,
  "slug": "billing-block-diagnosis",
  "module": "SD",
  "title": {
    "zh": "开票冻结诊断",
    "en": "Billing Block Diagnosis"
  },
  "summary": {
    "zh": "诊断销售订单、项目与交货层的开票冻结、信用检查及不完整状态。",
    "en": "Diagnoses billing blocks, credit checks and incompletion statuses at sales-order header, item and delivery levels."
  },
  "status": "Three-stage live acceptance passed",
  "version": "0.1.0",
  "owner": "SD / FI-AR",
  "tags": [
    "Order-to-Cash",
    "SAP SD",
    "Read-only",
    "Explainable AI"
  ],
  "sapModules": [
    "SD"
  ],
  "transactions": [],
  "tables": [
    "VBUV"
  ],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "销售订单号"
    ],
    "en": [
      "Sales order"
    ]
  },
  "outputs": {
    "zh": [
      "销售订单号",
      "业务状态",
      "查询源完整性",
      "结构化业务报告"
    ],
    "en": [
      "Sales order",
      "Business status",
      "Query-source completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "严格只读，不创建或修改SAP凭证",
      "Fixture不得冒充真机证据",
      "凭据和敏感业务数据不得写入报告"
    ],
    "en": [
      "Strictly read-only; never creates or changes SAP documents",
      "Fixtures never masquerade as live evidence",
      "Credentials and sensitive business data are excluded from reports"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_billing_block_evidence",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_billing_block_evidence`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_billing_block_evidence` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrder",
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderItem",
          "GET API_OUTBOUND_DELIVERY_SRV@2.0/A_OutbDeliveryItem",
          "GET API_OUTBOUND_DELIVERY_SRV@2.0/A_OutbDeliveryHeader",
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocumentItem",
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocument"
        ],
        "en": [
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrder",
          "GET API_SALES_ORDER_SRV@2.0/A_SalesOrderItem",
          "GET API_OUTBOUND_DELIVERY_SRV@2.0/A_OutbDeliveryItem",
          "GET API_OUTBOUND_DELIVERY_SRV@2.0/A_OutbDeliveryHeader",
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocumentItem",
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocument"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_billing_block_evidence` / `execute_plan`",
            "en": "Execute `collect_billing_block_evidence` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_billing_block_evidence"
      ]
    },
    {
      "id": "execute-assess_item_incompletion",
      "title": {
        "zh": "判断项目不完整证据缺口",
        "en": "Assess the item-incompletion evidence gap"
      },
      "description": {
        "zh": "只有Embedded查询完整、订单项目存在且实时Schema未提供项目不完整状态时，才申请ADT补证。",
        "en": "Request ADT evidence only when Embedded is complete, items exist, and live schema does not expose item incompletion status."
      },
      "operations": {
        "zh": ["rule.assess_billing_block_incompletion"],
        "en": ["rule.assess_billing_block_incompletion"]
      },
      "tools": [
        {
          "name": "assess_billing_block_incompletion",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行OData优先门控并生成精确订单与预检项目键。",
            "en": "Apply the OData-first gate and produce exact order and preflight item keys."
          }
        }
      ],
      "executionStepIds": ["assess_item_incompletion"]
    },
    {
      "id": "execute-preflight_item_incompletion_fallback",
      "title": {
        "zh": "预检VBUV读取能力",
        "en": "Preflight VBUV read capability"
      },
      "description": {
        "zh": "按精确订单和项目读取最多2行，验证实时DDIC、TLS、只读契约、分页和Hash链。",
        "en": "Read at most two rows for one exact order item to validate live DDIC, TLS, read-only policy, paging, and hash chain."
      },
      "operations": {
        "zh": ["skill.sap-adt-table-export: VBUV精确预检(max_rows=2)"],
        "en": ["skill.sap-adt-table-export: exact VBUV preflight (max_rows=2)"]
      },
      "tools": [
        {
          "name": "sap-adt-table-export",
          "kind": "Conditional read-only ADT evidence skill",
          "purpose": {
            "zh": "不接受调用方连接配置，按实时DDIC解析稳定键。",
            "en": "Reject caller connection settings and resolve the stable key from live DDIC."
          }
        }
      ],
      "executionStepIds": ["preflight_item_incompletion_fallback"]
    },
    {
      "id": "execute-assess_item_incompletion_preflight",
      "title": {
        "zh": "评估ADT预检结果",
        "en": "Assess the ADT preflight result"
      },
      "description": {
        "zh": "仅当预检完整、只读、已验证且Hash有效时允许正式查询。",
        "en": "Allow the formal query only when the preflight is complete, read-only, validated, and hash verified."
      },
      "operations": {
        "zh": ["rule.assess_adt_preflight"],
        "en": ["rule.assess_adt_preflight"]
      },
      "tools": [
        {
          "name": "assess_adt_preflight",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "失败闭合地决定是否继续正式ADT读取。",
            "en": "Fail closed when deciding whether the formal ADT read may proceed."
          }
        }
      ],
      "executionStepIds": ["assess_item_incompletion_preflight"]
    },
    {
      "id": "execute-read_item_incompletion_fallback",
      "title": {
        "zh": "读取VBUV不完整日志",
        "en": "Read the VBUV incompletion log"
      },
      "description": {
        "zh": "按精确订单读取最多200行缺失字段日志；完整零行表示该范围未记录缺失字段。",
        "en": "Read at most 200 missing-field rows for the exact order; a complete zero-row result means no missing field is logged in scope."
      },
      "operations": {
        "zh": ["skill.sap-adt-table-export: VBUV有界读取(max_rows=200)"],
        "en": ["skill.sap-adt-table-export: bounded VBUV read (max_rows=200)"]
      },
      "tools": [
        {
          "name": "sap-adt-table-export",
          "kind": "Conditional read-only ADT evidence skill",
          "purpose": {
            "zh": "按销售订单精确读取VBUV缺失字段日志，不接受调用方连接配置。",
            "en": "Read the exact VBUV missing-field log by sales order without caller-supplied connection settings."
          }
        }
      ],
      "executionStepIds": ["read_item_incompletion_fallback"]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate_business_result`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate_business_result` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "sales_order": {
          "type": "string",
          "title": {
            "zh": "销售订单号",
            "en": "Sales order"
          },
          "description": {
            "zh": "请输入销售订单号。",
            "en": "Enter the sales order."
          },
          "placeholder": {
            "zh": "例如：5814",
            "en": "Example: 5814"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "sales_order"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "id": "collect_billing_block_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_SALES_ORDER_SRV",
            "odata_version": "2.0",
            "entity_set": "A_SalesOrder",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "sales_orders",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrder",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrganization",
                  "RequestedDeliveryDate",
                  "TotalBlockStatus",
                  "TotalCreditCheckStatus",
                  "HeaderBillingBlockReason",
                  "DeliveryBlockReason",
                  "OverallDeliveryStatus",
                  "OverallOrdReltdBillgStatus"
                ],
                "rationale": "Load the requested sales order.",
                "filters": [
                  {
                    "field": "SalesOrder",
                    "operator": "eq",
                    "value": "{{input.sales_order}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "sales_order_items",
                "service_name": "API_SALES_ORDER_SRV",
                "odata_version": "2.0",
                "entity_set": "A_SalesOrderItem",
                "http_method": "GET",
                "select_fields": [
                  "SalesOrder",
                  "SalesOrderItem",
                  "Material",
                  "ProductionPlant",
                  "RequestedQuantity",
                  "ConfdDelivQtyInOrderQtyUnit",
                  "DeliveryPriority",
                  "ItemBillingBlockReason",
                  "DeliveryStatus"
                ],
                "rationale": "Load sales-order items.",
                "filters": [
                  {
                    "field": "SalesOrder",
                    "operator": "eq",
                    "value": "{{input.sales_order}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "delivery_items",
                "service_name": "API_OUTBOUND_DELIVERY_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OutbDeliveryItem",
                "http_method": "GET",
                "select_fields": [
                  "DeliveryDocument",
                  "DeliveryDocumentItem",
                  "ReferenceSDDocument",
                  "ReferenceSDDocumentItem",
                  "Plant",
                  "Material",
                  "ActualDeliveryQuantity",
                  "GoodsMovementStatus",
                  "DeliveryRelatedBillingStatus",
                  "ItemBillingBlockReason"
                ],
                "rationale": "Load deliveries referencing the sales order.",
                "filters": [
                  {
                    "field": "ReferenceSDDocument",
                    "operator": "eq",
                    "value": "{{input.sales_order}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "delivery_headers",
                "service_name": "API_OUTBOUND_DELIVERY_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OutbDeliveryHeader",
                "http_method": "GET",
                "select_fields": [
                  "DeliveryDocument",
                  "ActualGoodsMovementDate",
                  "OverallGoodsMovementStatus",
                  "OverallDelivReltdBillgStatus",
                  "DeliveryBlockReason",
                  "HeaderBillingBlockReason",
                  "TotalCreditCheckStatus"
                ],
                "rationale": "Load delivery header status.",
                "filter_from_previous": [
                  {
                    "field": "DeliveryDocument",
                    "source_step_id": "delivery_items",
                    "source_field": "DeliveryDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              },
              {
                "step_id": "billing_items",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocumentItem",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentItem",
                  "ReferenceSDDocument",
                  "ReferenceSDDocumentItem",
                  "SalesDocument",
                  "SalesDocumentItem",
                  "BillingQuantity",
                  "NetAmount",
                  "TransactionCurrency"
                ],
                "rationale": "Load billing items associated with the sales order.",
                "filters": [
                  {
                    "field": "SalesDocument",
                    "operator": "eq",
                    "value": "{{input.sales_order}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "billing_headers",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocument",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentDate",
                  "BillingDocumentIsCancelled",
                  "AccountingPostingStatus",
                  "OverallBillingStatus",
                  "TotalNetAmount",
                  "TransactionCurrency"
                ],
                "rationale": "Load billing headers.",
                "filter_from_previous": [
                  {
                    "field": "BillingDocument",
                    "source_step_id": "billing_items",
                    "source_field": "BillingDocument",
                    "fanout": true,
                    "fetch_all_for_binding": true
                  }
                ]
              }
            ],
            "rationale": "Collect sales-order and delivery block evidence."
          }
        }
      },
      {
        "id": "assess_item_incompletion",
        "executor": "rule",
        "operation": "assess_billing_block_incompletion",
        "inputMapping": {
          "run_input": "{{input}}",
          "sap_read": "{{steps.collect_billing_block_evidence.output}}"
        }
      },
      {
        "id": "preflight_item_incompletion_fallback",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess_item_incompletion.output.needs_adt.item_incompletion}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "VBUV",
          "fields": [
            "VBELN",
            "POSNR",
            "ETENR",
            "TBNAM",
            "FDNAM",
            "FEHGR",
            "STATG"
          ],
          "filters": [
            {
              "field": "VBELN",
              "operator": "eq",
              "value": "{{steps.assess_item_incompletion.output.adt_sales_order}}"
            },
            {
              "field": "POSNR",
              "operator": "eq",
              "value": "{{steps.assess_item_incompletion.output.adt_preflight_item}}"
            }
          ],
          "max_rows": 2
        }
      },
      {
        "id": "assess_item_incompletion_preflight",
        "executor": "rule",
        "operation": "assess_adt_preflight",
        "inputMapping": {
          "payload": "{{steps.preflight_item_incompletion_fallback.output}}"
        }
      },
      {
        "id": "read_item_incompletion_fallback",
        "executor": "skill",
        "operation": "execute",
        "skillId": "sap-adt-table-export",
        "readOnly": true,
        "failurePolicy": "record_gap",
        "when": {
          "source": "{{steps.assess_item_incompletion_preflight.output.proceed}}",
          "equals": true
        },
        "inputMapping": {
          "schema_version": 1,
          "source_type": "table",
          "object": "VBUV",
          "fields": [
            "VBELN",
            "POSNR",
            "ETENR",
            "TBNAM",
            "FDNAM",
            "FEHGR",
            "STATG"
          ],
          "filters": [
            {
              "field": "VBELN",
              "operator": "eq",
              "value": "{{steps.assess_item_incompletion.output.adt_sales_order}}"
            }
          ],
          "max_rows": 200
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "billing-block-diagnosis",
          "run_input": "{{input}}",
          "evidence": {
            "collect_billing_block_evidence": "{{steps.collect_billing_block_evidence.output}}"
          },
          "assessment": "{{steps.assess_item_incompletion.output}}",
          "fallbacks": {
            "sales_order_item_incompletion": "{{steps.read_item_incompletion_fallback.output}}"
          },
          "known_gaps": []
        }
      }
    ],
    "outputSchema": {
      "type": "object",
      "properties": {
        "sales_order": {
          "type": "string",
          "title": {
            "zh": "销售订单号",
            "en": "Sales order"
          },
          "description": {
            "zh": "请输入销售订单号。",
            "en": "Enter the sales order."
          },
          "placeholder": {
            "zh": "例如：5814",
            "en": "Example: 5814"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]+$"
        },
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "sales_order",
        "business_status",
        "source_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "sales_order": "{{steps.evaluate_business_result.output.workflow_output.sales_order}}",
      "business_status": "{{steps.evaluate_business_result.output.workflow_output.business_status}}",
      "source_complete": "{{steps.evaluate_business_result.output.workflow_output.source_complete}}",
      "business_report": "{{steps.evaluate_business_result.output.workflow_output.business_report}}"
    },
    "acceptance": {
      "schemaVersion": "2.0",
      "comparisonMode": "business_semantic",
      "businessKeys": [
        "sales_order",
        "sales_order_item"
      ],
      "facts": [
        "billing_block_reason",
        "delivery_block_reason",
        "credit_status",
        "incompletion_status",
        "business_status"
      ],
      "metrics": [
        "blocked_findings"
      ],
      "decimalFields": [],
      "decimalMetricIds": [],
      "currencyFields": [],
      "unitFields": [],
      "dateFields": [],
      "codeSetFields": [],
      "zeroPadFields": {},
      "booleanFields": [],
      "inputDefaults": {},
      "constantDefaults": {},
      "fieldAliases": {
        "sales_order": [
          "Sales Order",
          "销售订单"
        ],
        "sales_order_item": [
          "Sales Order Item",
          "Item",
          "项目",
          "订单项目"
        ],
        "billing_block_reason": [
          "Billing Block Reason",
          "Billing Block",
          "开票冻结原因",
          "项目开票冻结"
        ],
        "delivery_block_reason": [
          "Delivery Block Reason",
          "Delivery Block",
          "交货冻结原因"
        ],
        "credit_status": [
          "Credit Status",
          "Credit Check Status",
          "信用状态",
          "信用检查状态"
        ],
        "incompletion_status": [
          "Incompletion Status",
          "Incompletion",
          "不完整状态"
        ],
        "blocked_findings": [
          "Blocked Findings",
          "Block Findings",
          "冻结发现数"
        ]
      },
      "fieldExtractors": {},
      "currencyFromDecimal": {},
      "valueMappings": {
        "incompletion_status": {
          "complete (vbuv logs no missing field)": "complete_or_not_relevant"
        }
      },
      "limitationKeywords": {
        "source_incomplete": [
          "source incomplete",
          "paging incomplete",
          "range limited",
          "范围限制",
          "分页未完成"
        ],
        "bank_settlement_not_proven": [
          "bank settlement",
          "bank receipt",
          "银行结算",
          "银行到账"
        ],
        "capability_gap": [
          "capability gap",
          "evidence unavailable",
          "inconclusive",
          "能力缺口",
          "证据不足",
          "无法确认"
        ],
        "sales_order_item_incompletion_evidence": [
          "item-level incompletion",
          "dedicated item incompletion",
          "VBUV unavailable",
          "VBUV incomplete",
          "项目级不完整",
          "订单项目不完整"
        ]
      },
      "summaryRecord": false,
      "currencyAndUnitPolicy": "compare_only_when_same_or_conversion_validated",
      "requiredLimitations": [],
      "businessStatusFromMetric": {},
      "limitationsFromMetrics": {},
      "blankValueKeywords": {
        "billing_block_reason": [
          "none:",
          "blank",
          "未设置",
          "空白"
        ],
        "delivery_block_reason": [
          "none:",
          "blank",
          "未设置",
          "空白"
        ],
        "credit_status": [
          "blank",
          "no status code",
          "未返回",
          "空白"
        ],
        "incompletion_status": [
          "not evidenced",
          "not exposed",
          "无法证明",
          "未提供"
        ]
      },
      "blockingLimitations": [
        "sales_order_item_incompletion_evidence"
      ],
      "ignoredNoticeKeywords": [],
      "zeroFactWhenMetricZero": {},
      "recordScope": "",
      "metricDefinitions": {
        "blocked_findings": "Count all detected order, item, delivery, credit, and VBUV missing-field findings; return 0 when every exact source is complete and no finding exists."
