            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "billing_document",
        "business_status",
        "source_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "billing_document": "{{steps.evaluate_business_result.output.workflow_output.billing_document}}",
      "business_status": "{{steps.evaluate_business_result.output.workflow_output.business_status}}",
