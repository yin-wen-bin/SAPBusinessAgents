{
  "schemaVersion": 2,
  "slug": "billing-dispute-classification",
  "module": "SD",
  "title": {
    "zh": "发票争议分类",
    "en": "Billing Dispute Classification"
  },
  "summary": {
    "zh": "将客户拒票与争议文本分类，并关联FI、POD及开票证据。",
    "en": "Classifies customer invoice rejections and dispute text, then links FI, proof-of-delivery and billing evidence."
  },
  "status": "Three-stage live acceptance blocked",
  "version": "0.1.0",
  "owner": "SD / FI-AR",
  "tags": [
    "Order-to-Cash",
    "SAP SD",
    "Read-only",
    "Explainable AI"
  ],
  "sapModules": [
    "SD",
    "FI-AR"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "开票凭证号"
    ],
    "en": [
      "Billing document"
    ]
  },
  "outputs": {
    "zh": [
      "开票凭证号",
      "业务状态",
      "查询源完整性",
      "结构化业务报告"
    ],
    "en": [
      "Billing document",
      "Business status",
      "Query-source completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "严格只读，不创建或修改SAP凭证",
      "Fixture不得冒充真机证据",
      "凭据和敏感业务数据不得写入报告"
    ],
    "en": [
      "Strictly read-only; never creates or changes SAP documents",
      "Fixtures never masquerade as live evidence",
      "Credentials and sensitive business data are excluded from reports"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_dispute_base_evidence",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_dispute_base_evidence`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_dispute_base_evidence` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocument",
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocumentItem",
          "GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube"
        ],
        "en": [
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocument",
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocumentItem",
          "GET API_OPLACCTGDOCITEMCUBE_SRV@2.0/A_OperationalAcctgDocItemCube"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_dispute_base_evidence` / `execute_plan`",
            "en": "Execute `collect_dispute_base_evidence` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_dispute_base_evidence"
      ]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate_business_result`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate_business_result` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "billing_document": {
          "type": "string",
          "title": {
            "zh": "开票凭证号",
            "en": "Billing document"
          },
          "description": {
            "zh": "请输入开票凭证号。",
            "en": "Enter the billing document."
          },
          "placeholder": {
            "zh": "例如：90000025",
            "en": "Example: 90000025"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "billing_document"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "id": "collect_dispute_base_evidence",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_BILLING_DOCUMENT_SRV",
            "odata_version": "2.0",
            "entity_set": "A_BillingDocument",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "billing_headers",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocument",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "SalesOrganization",
                  "BillingDocumentDate",
                  "BillingDocumentIsCancelled",
                  "AccountingPostingStatus",
                  "OverallBillingStatus",
                  "TotalNetAmount",
                  "TransactionCurrency",
                  "TaxAmount"
                ],
                "rationale": "Load the requested billing header.",
                "filters": [
                  {
                    "field": "BillingDocument",
                    "operator": "eq",
                    "value": "{{input.billing_document}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "billing_items",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocumentItem",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentItem",
                  "ReferenceSDDocument",
                  "ReferenceSDDocumentItem",
                  "SalesDocument",
                  "SalesDocumentItem",
                  "BillingQuantity",
                  "NetAmount",
                  "TransactionCurrency",
                  "TaxAmount",
                  "Plant",
                  "Material"
                ],
                "rationale": "Load billing items and source references.",
                "filters": [
                  {
                    "field": "BillingDocument",
                    "operator": "eq",
                    "value": "{{input.billing_document}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "accounting_items",
                "service_name": "API_OPLACCTGDOCITEMCUBE_SRV",
                "odata_version": "2.0",
                "entity_set": "A_OperationalAcctgDocItemCube",
                "http_method": "GET",
                "select_fields": [
                  "CompanyCode",
                  "FiscalYear",
                  "FiscalPeriod",
                  "Ledger",
                  "AccountingDocument",
                  "AccountingDocumentItem",
                  "Supplier",
                  "Customer",
                  "FinancialAccountType",
                  "GLAccount",
                  "OperationalGLAccount",
                  "PurchasingDocument",
                  "PurchasingDocumentItem",
                  "PostingDate",
                  "NetDueDate",
                  "ClearingDate",
                  "ClearingIsReversed",
                  "IsOpenItemManaged",
                  "DebitCreditCode",
                  "IsCleared",
                  "ClearingAccountingDocument",
                  "ClearingDocFiscalYear",
                  "PaymentMethod",
                  "PaymentBlockingReason",
                  "HouseBank",
                  "HouseBankAccount",
                  "AccountingDocumentType",
                  "AmountInTransactionCurrency",
                  "TransactionCurrency",
                  "AmountInCompanyCodeCurrency",
                  "CompanyCodeCurrency",
                  "OrderID"
                ],
                "rationale": "Load accounting evidence for the billing document.",
                "filters": [
                  {
                    "field": "BillingDocument",
                    "operator": "eq",
                    "value": "{{input.billing_document}}",
                    "value_type": "string"
                  }
                ]
              }
            ],
            "rationale": "Collect billing and FI evidence."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "billing-dispute-classification",
          "run_input": "{{input}}",
          "evidence": {
            "collect_dispute_base_evidence": "{{steps.collect_dispute_base_evidence.output}}"
          },
          "known_gaps": [
            "billing_dispute_case_evidence"
          ]
        }
      }
    ],
    "outputSchema": {
      "type": "object",
      "properties": {
        "billing_document": {
          "type": "string",
          "title": {
            "zh": "开票凭证号",
            "en": "Billing document"
          },
          "description": {
            "zh": "请输入开票凭证号。",
            "en": "Enter the billing document."
          },
          "placeholder": {
            "zh": "例如：90000025",
            "en": "Example: 90000025"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]+$"
        },
        "business_status": {
