{
  "schemaVersion": 2,
  "slug": "billing-output-monitor",
  "module": "SD",
  "title": {
    "zh": "发票输出监控",
    "en": "Billing Output Monitor"
  },
  "summary": {
    "zh": "检查发票输出是否生成、发送和成功送达，并明确GUI补证缺口。",
    "en": "Checks whether invoice output was generated, sent and delivered successfully, and identifies GUI evidence gaps."
  },
  "status": "Three-stage live acceptance blocked",
  "version": "0.1.0",
  "owner": "SD / FI-AR",
  "tags": [
    "Order-to-Cash",
    "SAP SD",
    "Read-only",
    "Explainable AI"
  ],
  "sapModules": [
    "SD"
  ],
  "transactions": [],
  "tables": [],
  "systems": [
    "SAP S/4HANA"
  ],
  "inputs": {
    "zh": [
      "开票凭证号"
    ],
    "en": [
      "Billing document"
    ]
  },
  "outputs": {
    "zh": [
      "开票凭证号",
      "业务状态",
      "查询源完整性",
      "结构化业务报告"
    ],
    "en": [
      "Billing document",
      "Business status",
      "Query-source completeness",
      "Structured business report"
    ]
  },
  "guardrails": {
    "zh": [
      "严格只读，不创建或修改SAP凭证",
      "Fixture不得冒充真机证据",
      "凭据和敏感业务数据不得写入报告"
    ],
    "en": [
      "Strictly read-only; never creates or changes SAP documents",
      "Fixtures never masquerade as live evidence",
      "Credentials and sensitive business data are excluded from reports"
    ]
  },
  "workflow": [
    {
      "id": "execute-collect_billing_output_base",
      "title": {
        "zh": "读取 SAP 证据",
        "en": "Read SAP evidence"
      },
      "description": {
        "zh": "执行清单步骤 `collect_billing_output_base`，通过实时 Schema 校验后的 GET 请求读取证据。",
        "en": "Run manifest step `collect_billing_output_base` using GET requests validated against live schema."
      },
      "operations": {
        "zh": [
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocument",
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocumentItem"
        ],
        "en": [
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocument",
          "GET API_BILLING_DOCUMENT_SRV@2.0/A_BillingDocumentItem"
        ]
      },
      "tools": [
        {
          "name": "Embedded SAP OData Provider",
          "kind": "GET-only SAP Provider",
          "purpose": {
            "zh": "执行 `collect_billing_output_base` / `execute_plan`",
            "en": "Execute `collect_billing_output_base` / `execute_plan`"
          }
        }
      ],
      "executionStepIds": [
        "collect_billing_output_base"
      ]
    },
    {
      "id": "execute-evaluate_business_result",
      "title": {
        "zh": "执行确定性业务规则",
        "en": "Run deterministic business rules"
      },
      "description": {
        "zh": "执行清单步骤 `evaluate_business_result`，只解释已经取得的证据，不访问或修改 SAP。",
        "en": "Run manifest step `evaluate_business_result` and interpret collected evidence without accessing or changing SAP."
      },
      "operations": {
        "zh": [
          "rule.evaluate_business_agent"
        ],
        "en": [
          "rule.evaluate_business_agent"
        ]
      },
      "tools": [
        {
          "name": "evaluate_business_agent",
          "kind": "Local deterministic rule",
          "purpose": {
            "zh": "执行 `evaluate_business_result` / `evaluate_business_agent`",
            "en": "Execute `evaluate_business_result` / `evaluate_business_agent`"
          }
        }
      ],
      "executionStepIds": [
        "evaluate_business_result"
      ]
    }
  ],
  "execution": {
    "mode": "deterministic",
    "timeoutSeconds": 300,
    "inputSchema": {
      "type": "object",
      "properties": {
        "billing_document": {
          "type": "string",
          "title": {
            "zh": "开票凭证号",
            "en": "Billing document"
          },
          "description": {
            "zh": "请输入开票凭证号。",
            "en": "Enter the billing document."
          },
          "placeholder": {
            "zh": "例如：90000025",
            "en": "Example: 90000025"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "billing_document"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "id": "collect_billing_output_base",
        "executor": "sap_read",
        "operation": "execute_plan",
        "readOnly": true,
        "request": {
          "plan": {
            "service_name": "API_BILLING_DOCUMENT_SRV",
            "odata_version": "2.0",
            "entity_set": "A_BillingDocument",
            "http_method": "GET",
            "plan_kind": "multi_step",
            "steps": [
              {
                "step_id": "billing_headers",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocument",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "SalesOrganization",
                  "BillingDocumentDate",
                  "BillingDocumentIsCancelled",
                  "AccountingPostingStatus",
                  "OverallBillingStatus",
                  "TotalNetAmount",
                  "TransactionCurrency",
                  "TaxAmount"
                ],
                "rationale": "Load the requested billing header.",
                "filters": [
                  {
                    "field": "BillingDocument",
                    "operator": "eq",
                    "value": "{{input.billing_document}}",
                    "value_type": "string"
                  }
                ]
              },
              {
                "step_id": "billing_items",
                "service_name": "API_BILLING_DOCUMENT_SRV",
                "odata_version": "2.0",
                "entity_set": "A_BillingDocumentItem",
                "http_method": "GET",
                "select_fields": [
                  "BillingDocument",
                  "BillingDocumentItem",
                  "ReferenceSDDocument",
                  "ReferenceSDDocumentItem",
                  "SalesDocument",
                  "SalesDocumentItem",
                  "BillingQuantity",
                  "NetAmount",
                  "TransactionCurrency",
                  "TaxAmount",
                  "Plant",
                  "Material"
                ],
                "rationale": "Load billing items and source references.",
                "filters": [
                  {
                    "field": "BillingDocument",
                    "operator": "eq",
                    "value": "{{input.billing_document}}",
                    "value_type": "string"
                  }
                ]
              }
            ],
            "rationale": "Collect the base billing document."
          }
        }
      },
      {
        "id": "evaluate_business_result",
        "executor": "rule",
        "operation": "evaluate_business_agent",
        "inputMapping": {
          "agent_id": "billing-output-monitor",
          "run_input": "{{input}}",
          "evidence": {
            "collect_billing_output_base": "{{steps.collect_billing_output_base.output}}"
          },
          "known_gaps": [
            "billing_output_status_evidence"
          ]
        }
      }
    ],
    "outputSchema": {
      "type": "object",
      "properties": {
        "billing_document": {
          "type": "string",
          "title": {
            "zh": "开票凭证号",
            "en": "Billing document"
          },
          "description": {
            "zh": "请输入开票凭证号。",
            "en": "Enter the billing document."
          },
          "placeholder": {
            "zh": "例如：90000025",
            "en": "Example: 90000025"
          },
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]+$"
        },
        "business_status": {
          "type": "string",
          "title": {
            "zh": "业务状态",
            "en": "Business status"
          }
        },
        "source_complete": {
          "type": "boolean",
          "title": {
            "zh": "查询源完整性",
            "en": "Query-source completeness"
          }
        },
        "business_report": {
          "type": "object",
          "title": {
            "zh": "结构化业务报告",
            "en": "Structured business report"
          }
        }
      },
      "required": [
        "billing_document",
        "business_status",
        "source_complete",
        "business_report"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "billing_document": "{{steps.evaluate_business_result.output.workflow_output.billing_document}}",
      "business_status": "{{steps.evaluate_business_result.output.workflow_output.business_status}}",
      "source_complete": "{{steps.evaluate_business_result.output.workflow_output.source_complete}}",
      "business_report": "{{steps.evaluate_business_result.output.workflow_output.business_report}}"
    },
